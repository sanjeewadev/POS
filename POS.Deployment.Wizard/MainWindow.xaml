<Window x:Class="POS.Deployment.Wizard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced POS Production Setup"
        Width="760"
        Height="760"
        MinWidth="680"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PrimaryBrush}"
                CornerRadius="4"
                Padding="18,14"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Advanced POS Production Setup"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="White" />
                <TextBlock x:Name="RoleTextBlock"
                           Margin="0,4,0,0"
                           Foreground="#E8F1F8"
                           FontSize="13" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel x:Name="ServerModePanel">
                        <TextBlock Text="Installation mode"
                                   FontWeight="SemiBold" />
                        <ComboBox x:Name="InstallModeComboBox"
                                  Margin="0,5,0,12"
                                  SelectionChanged="InstallModeComboBox_OnSelectionChanged">
                            <ComboBoxItem Content="New store — create an empty production database"
                                          Tag="NewStore" />
                            <ComboBoxItem Content="Migrate an existing standalone SQLite store"
                                          Tag="MigrateSqlite" />
                            <ComboBoxItem Content="Restore an existing SQL Server backup"
                                          Tag="RestoreBackup" />
                        </ComboBox>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="ServerHostLabel"
                                       Text="Server LAN IP address"
                                       FontWeight="SemiBold" />
                            <TextBox x:Name="ServerHostTextBox"
                                     Margin="0,5,0,12" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SQL TCP port"
                                       FontWeight="SemiBold" />
                            <TextBox x:Name="PortTextBox"
                                     Text="1433"
                                     Margin="0,5,0,12" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="ServerAddressHintTextBlock"
                               TextWrapping="Wrap"
                               Foreground="#5B6570"
                               Margin="0,-5,0,12" />

                    <StackPanel x:Name="SqlInstancePanel">
                        <TextBlock Text="SQL Server instance on this computer"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="SqlInstanceTextBox"
                                 Text=".\SQLEXPRESS"
                                 Margin="0,5,0,12" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Production database name"
                                       FontWeight="SemiBold" />
                            <TextBox x:Name="DatabaseNameTextBox"
                                     Text="POS_Production"
                                     Margin="0,5,0,12" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Restricted application login"
                                       FontWeight="SemiBold" />
                            <TextBox x:Name="ApplicationLoginTextBox"
                                     Text="POS_Application"
                                     Margin="0,5,0,12" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SQL application password"
                                       FontWeight="SemiBold" />
                            <PasswordBox x:Name="PasswordBox"
                                         Margin="0,5,0,12" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Confirm password"
                                       FontWeight="SemiBold" />
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         Margin="0,5,0,12" />
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="SourceFilePanel"
                                Margin="0,0,0,12">
                        <TextBlock x:Name="SourceFileLabel"
                                   Text="Source file"
                                   FontWeight="SemiBold" />
                        <DockPanel Margin="0,5,0,0">
                            <Button DockPanel.Dock="Right"
                                    Content="Browse..."
                                    Margin="8,0,0,0"
                                    Click="BrowseSourceButton_OnClick" />
                            <TextBox x:Name="SourceFileTextBox" />
                        </DockPanel>
                    </StackPanel>

                    <CheckBox x:Name="TrustedNetworkCheckBox"
                              Content="This computer is connected to a trusted private store network"
                              Margin="0,0,0,10" />

                    <CheckBox x:Name="InstallCashierOnServerCheckBox"
                              Content="Also configure this server computer as a Cashier terminal"
                              Margin="0,0,0,10"
                              Checked="InstallCashierOnServerCheckBox_OnChanged"
                              Unchecked="InstallCashierOnServerCheckBox_OnChanged" />

                    <Border x:Name="TerminalPanel"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Cashier terminal identity"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Terminal number" />
                                    <TextBox x:Name="TerminalNoTextBox"
                                             Text="01"
                                             Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Terminal name" />
                                    <TextBox x:Name="TerminalNameTextBox"
                                             Text="Cashier Terminal 01"
                                             Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Location"
                                       Margin="0,10,0,0" />
                            <TextBox x:Name="LocationTextBox"
                                     Text="Main Store"
                                     Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Optional signed licence file"
                                   FontWeight="SemiBold" />
                        <DockPanel Margin="0,5,0,0">
                            <Button DockPanel.Dock="Right"
                                    Content="Browse..."
                                    Margin="8,0,0,0"
                                    Click="BrowseLicenseButton_OnClick" />
                            <TextBox x:Name="LicenseFileTextBox" />
                        </DockPanel>
                        <TextBlock Text="The installer can finish without a licence. It will display the machine code needed for terminal licence generation."
                                   TextWrapping="Wrap"
                                   Foreground="#5B6570"
                                   Margin="0,5,0,0" />
                    </StackPanel>

                    <TextBlock Text="Setup progress"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="OutputTextBox"
                             Height="180"
                             Margin="0,5,0,0"
                             FontFamily="Consolas"
                             FontSize="12"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusTextBlock"
                       VerticalAlignment="Center"
                       Foreground="#4C5660" />
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="RunButton"
                        Content="Start Setup"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Click="RunButton_OnClick" />
                <Button Content="Close"
                        Click="CloseButton_OnClick" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
