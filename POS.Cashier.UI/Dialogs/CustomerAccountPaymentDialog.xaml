<Window x:Class="POS.Cashier.UI.Dialogs.CustomerAccountPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer Account Payment"
        Style="{StaticResource CashierDialogWindow}"
        Width="600"
        Height="560"
        MinWidth="520"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierDialogHeader}">
            <Grid>
                <TextBlock Text="CUSTOMER ACCOUNT PAYMENT"
                           Style="{StaticResource CashierDialogTitle}"/>
                <TextBlock Text="Receive an account payment without changing the current sale"
                           Style="{StaticResource CashierShortcutHint}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16">
            <StackPanel>
                <TextBlock Text="Customer" Style="{StaticResource CashierFieldLabel}"/>
                <ComboBox x:Name="CustomerBox"
                          Style="{StaticResource CashierComboBox}"
                          Margin="0,6,0,14"
                          DisplayMemberPath="FullName"
                          SelectionChanged="CustomerBox_SelectionChanged"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CashierStatusPanel}">
                        <StackPanel>
                            <TextBlock Text="Outstanding" Style="{StaticResource CashierMutedText}"/>
                            <TextBlock x:Name="OutstandingText"
                                       Text="Rs. 0.00"
                                       Foreground="{StaticResource CashierDangerBrush}"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CashierStatusPanel}">
                        <StackPanel>
                            <TextBlock Text="Overdue" Style="{StaticResource CashierMutedText}"/>
                            <TextBlock x:Name="OverdueText"
                                       Text="Rs. 0.00"
                                       Foreground="{StaticResource CashierWarningDarkBrush}"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource CashierStatusPanel}">
                        <StackPanel>
                            <TextBlock Text="Open invoices" Style="{StaticResource CashierMutedText}"/>
                            <TextBlock x:Name="InvoiceCountText"
                                       Text="0"
                                       Foreground="{StaticResource CashierPrimaryDarkBrush}"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="Amount" Style="{StaticResource CashierFieldLabel}"/>
                <TextBox x:Name="AmountBox"
                         Style="{StaticResource CashierMoneyInputTextBox}"
                         Margin="0,6,0,14"
                         IsEnabled="False"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Method" Style="{StaticResource CashierFieldLabel}"/>
                        <ComboBox x:Name="MethodBox"
                                  Style="{StaticResource CashierComboBox}"
                                  Margin="0,6,0,0"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Cash"/>
                            <ComboBoxItem Content="Card"/>
                            <ComboBoxItem Content="Cheque"/>
                            <ComboBoxItem Content="Bank Transfer"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Reference" Style="{StaticResource CashierFieldLabel}"/>
                        <TextBox x:Name="ReferenceBox"
                                 Style="{StaticResource CashierTextBox}"
                                 Margin="0,6,0,0"
                                 MaxLength="100"/>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource CashierStatusPanel}">
                    <TextBlock Text="Cash increases the current drawer once. Card, Cheque and Bank Transfer do not affect drawer cash."
                               Style="{StaticResource CashierMutedText}"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource CashierDialogFooter}">
            <Grid>
                <TextBlock x:Name="BusyText"
                           Text="Saving payment..."
                           Style="{StaticResource CashierMutedText}"
                           Visibility="Collapsed"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Content="CANCEL"
                            Style="{StaticResource CashierButton}"
                            IsCancel="True"
                            Margin="0,0,10,0"
                            Click="Cancel_Click"/>
                    <Button x:Name="SaveButton"
                            Content="SAVE PAYMENT"
                            Style="{StaticResource CashierSuccessButton}"
                            MinWidth="150"
                            IsDefault="True"
                            Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
