<Window x:Class="POS.Cashier.UI.Dialogs.CustomerAccountPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer Account Payment"
        Width="560" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#1F2937" BorderBrush="#0EA5E9" BorderThickness="3"
        FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="CUSTOMER ACCOUNT PAYMENT" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Text="Customer" Foreground="#CBD5E1" FontWeight="SemiBold"/>
        <ComboBox x:Name="CustomerBox" Grid.Row="2" Height="34" Margin="0,5,0,12" DisplayMemberPath="FullName" SelectionChanged="CustomerBox_SelectionChanged"/>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#111827" Padding="10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Outstanding" Foreground="#94A3B8"/>
                    <TextBlock x:Name="OutstandingText" Text="Rs. 0.00" Foreground="#FCA5A5" FontSize="17" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#111827" Padding="10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Overdue" Foreground="#94A3B8"/>
                    <TextBlock x:Name="OverdueText" Text="Rs. 0.00" Foreground="#FDBA74" FontSize="17" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#111827" Padding="10">
                <StackPanel>
                    <TextBlock Text="Open Invoices" Foreground="#94A3B8"/>
                    <TextBlock x:Name="InvoiceCountText" Text="0" Foreground="#7DD3FC" FontSize="17" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4" Text="Amount" Foreground="#CBD5E1" FontWeight="SemiBold"/>
        <TextBox x:Name="AmountBox" Grid.Row="5" Height="34" Margin="0,5,0,12" FontSize="16" VerticalContentAlignment="Center"/>

        <Grid Grid.Row="6" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Method" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                <ComboBox x:Name="MethodBox" Height="34" Margin="0,5,0,0" SelectedIndex="0">
                    <ComboBoxItem Content="Cash"/>
                    <ComboBoxItem Content="Card"/>
                    <ComboBoxItem Content="Cheque"/>
                    <ComboBoxItem Content="Bank Transfer"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Reference" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                <TextBox x:Name="ReferenceBox" Height="34" Margin="0,5,0,0" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="7" Text="Cash payments increase the current drawer once. Card, Cheque and Bank Transfer do not affect drawer cash." Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,12"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="CANCEL" Width="110" Height="38" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="SAVE PAYMENT" Width="150" Height="38" Background="#0EA5E9" Foreground="White" FontWeight="Bold" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
