<Window x:Class="POS.Cashier.UI.Dialogs.ShiftSummaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shift Summary"
        Style="{StaticResource CashierDialogWindow}"
        Width="600"
        Height="680"
        MinWidth="500"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="SummaryLabel" TargetType="TextBlock" BasedOn="{StaticResource CashierMutedText}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="SummaryValue" TargetType="TextBlock" BasedOn="{StaticResource CashierReadOnlyValue}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierDialogHeader}">
            <Grid>
                <TextBlock Text="X-READING / SHIFT SUMMARY"
                           Style="{StaticResource CashierDialogTitle}"/>
                <TextBlock Text="ENTER prints · ESC closes"
                           Style="{StaticResource CashierShortcutHint}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16">
            <StackPanel>
                <Border Style="{StaticResource CashierPanel}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SALES SUMMARY" Style="{StaticResource CashierSectionTitle}" Margin="0,0,0,8"/>
                        <Grid><TextBlock Text="Completed sales" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding CompletedSaleCount}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Customer returns" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding CustomerReturnCount}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Gross sales" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding GrossSales, StringFormat=Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Discounts" Style="{StaticResource SummaryLabel}" Foreground="{StaticResource CashierDangerBrush}"/><TextBlock Text="{Binding TotalDiscount, StringFormat=- Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}" Foreground="{StaticResource CashierDangerBrush}"/></Grid>
                        <Grid><TextBlock Text="VAT" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding VatTotal, StringFormat=Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Rectangle Height="1" Fill="{StaticResource CashierBorderBrush}" Margin="0,7"/>
                        <Grid><TextBlock Text="NET SALES" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding NetSales, StringFormat=Rs. \{0:N2\}}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource CashierPrimaryDarkBrush}" HorizontalAlignment="Right"/></Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CashierPanel}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="TENDER BREAKDOWN" Style="{StaticResource CashierSectionTitle}" Margin="0,0,0,8"/>
                        <Grid><TextBlock Text="Cash" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding CashTenderTotal, StringFormat=Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Card" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding CardTenderTotal, StringFormat=Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Cheque" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding ChequeTenderTotal, StringFormat=Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Gift voucher" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding GiftVoucherTenderTotal, StringFormat=Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Customer credit" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding CustomerCreditTenderTotal, StringFormat=Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Other tenders" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding OtherTenderTotal, StringFormat=Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CashierPanel}">
                    <StackPanel>
                        <TextBlock Text="DRAWER RECONCILIATION" Style="{StaticResource CashierSectionTitle}" Margin="0,0,0,8"/>
                        <Grid><TextBlock Text="Opening cash" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding OpeningCash, StringFormat=Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Paid In" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding PaidInTotal, StringFormat=+ Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Float In" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding FloatInTotal, StringFormat=+ Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Paid Out" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding PaidOutTotal, StringFormat=- Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Float Out" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding FloatOutTotal, StringFormat=- Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Cash refunds" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding CashRefundTotal, StringFormat=- Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Rectangle Height="1" Fill="{StaticResource CashierBorderBrush}" Margin="0,7"/>
                        <Grid><TextBlock Text="EXPECTED CASH IN DRAWER" FontSize="17" FontWeight="Bold"/><TextBlock Text="{Binding ExpectedCash, StringFormat=Rs. \{0:N2\}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CashierWarningDarkBrush}" HorizontalAlignment="Right"/></Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource CashierDialogFooter}">
            <Grid>
                <TextBlock x:Name="PrintStatusText"
                           Text="Printing X Report..."
                           Style="{StaticResource CashierMutedText}"
                           Visibility="Collapsed"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CloseButton"
                            Content="CLOSE"
                            Style="{StaticResource CashierButton}"
                            IsCancel="True"
                            Margin="0,0,10,0"
                            Click="CancelBtn_Click"/>
                    <Button x:Name="PrintButton"
                            Content="PRINT X-READING"
                            Style="{StaticResource CashierPrimaryButton}"
                            MinWidth="160"
                            IsDefault="True"
                            Click="PrintBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
