<Window x:Class="POS.Cashier.UI.Dialogs.ShiftSummaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shift Summary" Height="760" Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource MainBgBrush}"
        BorderBrush="{StaticResource HeaderBgBrush}"
        BorderThickness="3"
        FontFamily="Arial">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBgBrush}">
            <TextBlock Text="X-READING / SHIFT SUMMARY"
                       Foreground="{StaticResource TextLightBrush}"
                       FontSize="20" FontWeight="Heavy"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18">
                <Border Background="White" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SALES SUMMARY" FontWeight="Bold" Foreground="{StaticResource TextInactiveBrush}" FontSize="13" Margin="0,0,0,8"/>
                        <Grid><TextBlock Text="Completed sales" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding CompletedSaleCount}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Customer returns" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding CustomerReturnCount}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Gross sales" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding GrossSales, StringFormat=Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Discounts" Style="{StaticResource SummaryLabel}" Foreground="{StaticResource TextDangerBrush}"/><TextBlock Text="{Binding TotalDiscount, StringFormat=- Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}" Foreground="{StaticResource TextDangerBrush}"/></Grid>
                        <Grid><TextBlock Text="VAT" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding VatTotal, StringFormat=Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Rectangle Height="1" Fill="{StaticResource ControlBorderBrush}" Margin="0,7"/>
                        <Grid><TextBlock Text="NET SALES" FontSize="18" FontWeight="Heavy"/><TextBlock Text="{Binding NetSales, StringFormat=Rs. \{0:N2\}}" FontSize="18" FontWeight="Heavy" Foreground="{StaticResource TextHighlightBrush}" HorizontalAlignment="Right"/></Grid>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="TENDER BREAKDOWN" FontWeight="Bold" Foreground="{StaticResource TextInactiveBrush}" FontSize="13" Margin="0,0,0,8"/>
                        <Grid><TextBlock Text="Cash" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding CashTenderTotal, StringFormat=Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Card" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding CardTenderTotal, StringFormat=Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Cheque" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding ChequeTenderTotal, StringFormat=Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Gift voucher" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding GiftVoucherTenderTotal, StringFormat=Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Customer credit" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding CustomerCreditTenderTotal, StringFormat=Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Other tenders" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding OtherTenderTotal, StringFormat=Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" Padding="14">
                    <StackPanel>
                        <TextBlock Text="DRAWER RECONCILIATION" FontWeight="Bold" Foreground="{StaticResource TextInactiveBrush}" FontSize="13" Margin="0,0,0,8"/>
                        <Grid><TextBlock Text="Opening cash" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding OpeningCash, StringFormat=Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Paid In" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding PaidInTotal, StringFormat=+ Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Float In" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding FloatInTotal, StringFormat=+ Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Paid Out" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding PaidOutTotal, StringFormat=- Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Float Out" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding FloatOutTotal, StringFormat=- Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Grid><TextBlock Text="Cash refunds" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding CashRefundTotal, StringFormat=- Rs. \{0:N2\}}" Style="{StaticResource SummaryValue}"/></Grid>
                        <Rectangle Height="1" Fill="{StaticResource ControlBorderBrush}" Margin="0,7"/>
                        <Grid><TextBlock Text="EXPECTED CASH IN DRAWER" FontSize="17" FontWeight="Heavy"/><TextBlock Text="{Binding ExpectedCash, StringFormat=Rs. \{0:N2\}}" FontSize="20" FontWeight="Heavy" Foreground="{StaticResource PaymentDarkOrangeBrush}" HorizontalAlignment="Right"/></Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Background="{StaticResource HeaderBgBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Button Click="CancelBtn_Click" Grid.Column="0" Background="{StaticResource CancelBtnBrush}" Content="CLOSE" FontSize="20" Margin="10,10,5,10"/>
            <Button Grid.Column="1" Background="{StaticResource ActionBtnBrush}" Content="PRINT X-READING" FontSize="20" Margin="5,10,10,10" Click="PrintBtn_Click"/>
        </Grid>
    </Grid>
</Window>
