<Window x:Class="POS.Cashier.UI.Dialogs.FloatCashDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cash Count / Float Entry"
        Style="{StaticResource CashierDialogWindow}"
        Width="900"
        Height="650"
        MinWidth="760"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="82"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierTransactionDialogHeader}" Margin="10,10,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CashierTransactionHeaderIcon}">
                    <TextBlock Text="Rs." Foreground="White" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="CASH COUNT / FLOAT ENTRY" Style="{StaticResource CashierDialogTitle}"/>
                    <TextBlock Text="Count denominations, add float cash, or remove float cash"
                               Style="{StaticResource CashierTransactionHeaderSubtitle}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="ESC = CANCEL"
                           Style="{StaticResource CashierShortcutHint}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CashierTransactionContentPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource CashierGridHeaderBrush}"
                            BorderBrush="{StaticResource CashierGridLineBrush}" BorderThickness="1">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="NOTE / COIN (Rs.)" Style="{StaticResource CashierTransactionFieldLabel}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="QUANTITY" Style="{StaticResource CashierTransactionFieldLabel}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="LINE TOTAL" Style="{StaticResource CashierTransactionFieldLabel}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid MinHeight="52" Margin="10,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock Text="5000" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/><TextBox x:Name="Qty5000TextBox" Grid.Column="1" Text="{Binding Qty5000, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CashierTransactionQuantityTextBox}"/><TextBlock Grid.Column="2" Text="{Binding Total5000, StringFormat=N2}" FontSize="18" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
                            <Separator/>
                            <Grid MinHeight="52" Margin="10,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock Text="1000" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Qty1000, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CashierTransactionQuantityTextBox}"/><TextBlock Grid.Column="2" Text="{Binding Total1000, StringFormat=N2}" FontSize="18" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
                            <Separator/>
                            <Grid MinHeight="52" Margin="10,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock Text="500" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Qty500, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CashierTransactionQuantityTextBox}"/><TextBlock Grid.Column="2" Text="{Binding Total500, StringFormat=N2}" FontSize="18" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
                            <Separator/>
                            <Grid MinHeight="52" Margin="10,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock Text="100" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Qty100, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CashierTransactionQuantityTextBox}"/><TextBlock Grid.Column="2" Text="{Binding Total100, StringFormat=N2}" FontSize="18" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
                            <Separator/>
                            <Grid MinHeight="52" Margin="10,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock Text="50" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Qty50, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CashierTransactionQuantityTextBox}"/><TextBlock Grid.Column="2" Text="{Binding Total50, StringFormat=N2}" FontSize="18" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
                            <Separator/>
                            <Grid MinHeight="52" Margin="10,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock Text="20" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Qty20, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CashierTransactionQuantityTextBox}"/><TextBlock Grid.Column="2" Text="{Binding Total20, StringFormat=N2}" FontSize="18" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
                            <Separator/>
                            <Grid MinHeight="52" Margin="10,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock Text="10" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Qty10, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CashierTransactionQuantityTextBox}"/><TextBlock Grid.Column="2" Text="{Binding Total10, StringFormat=N2}" FontSize="18" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
                            <Separator/>
                            <Grid MinHeight="52" Margin="10,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock Text="5" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Qty5, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CashierTransactionQuantityTextBox}"/><TextBlock Grid.Column="2" Text="{Binding Total5, StringFormat=N2}" FontSize="18" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CashierTransactionContentPanel}">
                <StackPanel>
                    <TextBlock Text="FLOAT OPERATION" Style="{StaticResource CashierSectionTitle}" Margin="0,0,0,12"/>
                    <Button Content="ADD CASH (FLOAT IN)" Command="{Binding FloatInCommand}"
                            Style="{StaticResource CashierTransactionConfirmButton}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                    <Button Content="REMOVE CASH (FLOAT OUT)" Command="{Binding FloatOutCommand}"
                            Style="{StaticResource CashierTransactionWarningButton}" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>
                    <TextBlock Text="REFERENCE NOTE" Style="{StaticResource CashierTransactionFieldLabel}"/>
                    <TextBox Text="{Binding ReferenceNote, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CashierTransactionInputTextBox}" Margin="0,6,0,14" MaxLength="250"/>
                    <Border Style="{StaticResource CashierTransactionSectionPanel}">
                        <TextBlock Text="Use this window only for float cash entering or leaving the till. It is not a sales-payment window."
                                   Style="{StaticResource CashierTransactionFooterHint}"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CashierDialogFooter}" Margin="10,0,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CURRENT FLOAT IN TILL" Style="{StaticResource CashierTransactionMetricLabel}"/>
                    <TextBlock Text="{Binding CurrentSystemFloat, StringFormat=Rs. {0:N2}}"
                               FontSize="23" FontWeight="Bold" Foreground="{StaticResource CashierWarningDarkBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="THIS TRANSACTION ENTRY" Style="{StaticResource CashierTransactionMetricLabel}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding GrandTotal, StringFormat=Rs. {0:N2}}"
                               FontSize="25" FontWeight="Bold" Foreground="{StaticResource CashierSuccessBrush}" HorizontalAlignment="Right"/>
                </StackPanel>
                <Button Grid.Column="3" Content="CANCEL" IsCancel="True" Click="Cancel_Click"
                        Style="{StaticResource CashierTransactionCancelButton}" Margin="18,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
