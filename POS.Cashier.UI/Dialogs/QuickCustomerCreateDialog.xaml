<Window x:Class="POS.Cashier.UI.Dialogs.QuickCustomerCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Customer Registration"
        Style="{StaticResource CashierOperationalWindow}"
        Width="860"
        Height="640"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyboardNavigation.TabNavigation="Cycle">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Style="{StaticResource CashierOperationalHeader}"
                Margin="0,0,0,6">

            <Grid>
                <TextBlock Text="QUICK CUSTOMER REGISTRATION"
                           Foreground="White"
                           FontSize="19"
                           FontWeight="Heavy"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Esc = Close"
                           Foreground="{StaticResource CashierHeaderHintBrush}"
                           FontSize="12"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- BODY -->
        <Border Grid.Row="1"
                Background="{StaticResource CashierPanelAltBrush}"
                BorderBrush="{StaticResource CashierBorderBrush}"
                BorderThickness="1"
                Padding="14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: BASIC CUSTOMER DETAILS -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="1. BASIC DETAILS"
                               FontWeight="Heavy"
                               Foreground="{StaticResource CashierHeaderBrush}"
                               FontSize="15"
                               Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Customer Type *" Style="{StaticResource CashierOperationalInlineLabel}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding CustomerTypes}"
                                  SelectedItem="{Binding InputCustomerType}"
                                  Style="{StaticResource CashierOperationalComboBox}"
                                  FontWeight="Bold"
                                  Background="{StaticResource CashierInputFocusBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Full Name *" Style="{StaticResource CashierOperationalInlineLabel}"/>
                        <TextBox x:Name="FullNameTextBox"
                                 Grid.Column="1"
                                 Text="{Binding InputFullName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CashierOperationalTextBox}"
                                 Background="{StaticResource CashierInputFocusBrush}"
                                 FontWeight="Bold"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Phone *" Style="{StaticResource CashierOperationalInlineLabel}"/>
                        <TextBox x:Name="PhoneTextBox"
                                 Grid.Column="1"
                                 Text="{Binding InputPhone, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CashierOperationalTextBox}"
                                 Background="{StaticResource CashierInputFocusBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Email:" Style="{StaticResource CashierOperationalInlineLabel}"/>
                        <TextBox x:Name="EmailTextBox"
                                 Grid.Column="1"
                                 Text="{Binding InputEmail, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CashierOperationalTextBox}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Birthday:" Style="{StaticResource CashierOperationalInlineLabel}"/>
                        <DatePicker Grid.Column="1"
                                    SelectedDate="{Binding InputBirthday, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource CashierOperationalDatePicker}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Address:" Style="{StaticResource CashierOperationalInlineLabel}"/>
                        <TextBox x:Name="AddressTextBox"
                                 Grid.Column="1"
                                 Text="{Binding InputAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CashierOperationalTextBox}"/>
                    </Grid>

                    <!-- RETAIL NIC -->
                    <Grid Margin="0,0,0,10">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRetail}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="NIC No:" Style="{StaticResource CashierOperationalInlineLabel}"/>
                        <TextBox x:Name="NicTextBox"
                                 Grid.Column="1"
                                 Text="{Binding InputNicNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CashierOperationalTextBox}"/>
                    </Grid>
                </StackPanel>

                <Rectangle Grid.Column="1"
                           Width="1"
                           Fill="{StaticResource CashierBorderBrush}"
                           Margin="8,0"/>

                <!-- RIGHT: WHOLESALE / SECURITY RULES -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="2. BUSINESS DETAILS"
                               FontWeight="Heavy"
                               Foreground="{StaticResource CashierSuccessBrush}"
                               FontSize="15"
                               Margin="0,0,0,14"/>

                    <Border Background="{StaticResource CashierInputBrush}"
                            BorderBrush="{StaticResource CashierGridLineBrush}"
                            BorderThickness="1"
                            Padding="10"
                            Margin="0,0,0,12">

                        <TextBlock Text="{Binding CustomerTypeHelpText}"
                                   Foreground="{StaticResource CashierTextBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWholesale}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Company *" Style="{StaticResource CashierOperationalInlineLabel}"/>
                            <TextBox x:Name="CompanyTextBox"
                                     Grid.Column="1"
                                     Text="{Binding InputCompanyName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CashierOperationalTextBox}"
                                     Background="{StaticResource CashierInputFocusBrush}"
                                     FontWeight="Bold"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="BR No:" Style="{StaticResource CashierOperationalInlineLabel}"/>
                            <TextBox x:Name="BrTextBox"
                                     Grid.Column="1"
                                     Text="{Binding InputBusinessRegistrationNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CashierOperationalTextBox}"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="VAT No:" Style="{StaticResource CashierOperationalInlineLabel}"/>
                            <TextBox x:Name="VatTextBox"
                                     Grid.Column="1"
                                     Text="{Binding InputVatRegistrationNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CashierOperationalTextBox}"/>
                        </Grid>
                    </StackPanel>

                    <Border Background="{StaticResource CashierTransactionBalanceBrush}"
                            BorderBrush="{StaticResource CashierWarningBrush}"
                            BorderThickness="1"
                            Padding="10"
                            Margin="0,8,0,0">

                        <StackPanel>
                            <TextBlock Text="Cashier permission rule"
                                       FontWeight="Heavy"
                                       Foreground="{StaticResource CashierWarningBrush}"
                                       Margin="0,0,0,6"/>

                            <TextBlock Text="This screen creates only a basic customer. Loyalty, discount eligibility, credit limit, credit days and credit approval must be changed from BackOffice/Admin."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource CashierWarningDarkBrush}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{Binding StatusColorHex}"
                            BorderBrush="{StaticResource CashierBorderBrush}"
                            BorderThickness="1"
                            Padding="10"
                            Margin="0,18,0,0">

                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="White"
                                   FontWeight="Heavy"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                Background="{StaticResource CashierNeutralButtonBrush}"
                BorderBrush="{StaticResource CashierBorderBrush}"
                BorderThickness="1"
                Padding="10"
                Margin="0,6,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Required: Full Name, Phone, Customer Type"
                           Foreground="{StaticResource CashierTextBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Content="CLEAR"
                        Command="{Binding ClearCommand}"
                        Style="{StaticResource CashierOperationalSecondaryButton}"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="3"
                        Content="CANCEL"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        Style="{StaticResource CashierOperationalSecondaryButton}"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="4"
        Content="SAVE CUSTOMER"
        Command="{Binding SaveCommand}"
        IsDefault="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CashierOperationalSuccessButton}">
                            <Setter Property="IsEnabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>