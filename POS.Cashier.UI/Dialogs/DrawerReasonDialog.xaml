<Window x:Class="POS.Cashier.UI.Dialogs.DrawerReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cash Drawer Reason"
        Style="{StaticResource CashierDialogWindow}"
        Width="480"
        Height="380"
        MinWidth="440"
        MinHeight="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierDialogHeader}">
            <Grid>
                <TextBlock x:Name="TitleText" Style="{StaticResource CashierDialogTitle}"/>
                <TextBlock Text="ENTER continues · ESC cancels"
                           Style="{StaticResource CashierShortcutHint}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CashierPanel}" Margin="16">
            <StackPanel>
                <TextBlock Text="Reason" Style="{StaticResource CashierFieldLabel}"/>
                <ComboBox x:Name="ReasonCombo"
                          Style="{StaticResource CashierComboBox}"
                          Margin="0,6,0,14"/>

                <TextBlock Text="Note (required for Other)" Style="{StaticResource CashierFieldLabel}"/>
                <TextBox x:Name="NoteBox"
                         Style="{StaticResource CashierTextBox}"
                         Height="82"
                         Margin="0,6,0,0"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         MaxLength="500"
                         VerticalScrollBarVisibility="Auto"/>
                <TextBlock x:Name="ErrorText"
                           Style="{StaticResource CashierValidationText}"
                           MinHeight="18"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CashierDialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL"
                        Style="{StaticResource CashierButton}"
                        IsCancel="True"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>
                <Button Content="CONTINUE"
                        Style="{StaticResource CashierSuccessButton}"
                        MinWidth="120"
                        IsDefault="True"
                        Click="Continue_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
