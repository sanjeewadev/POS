<Window x:Class="POS.Cashier.UI.Dialogs.DrawerReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cash Drawer Reason"
        Style="{StaticResource CashierDialogWindow}"
        Width="520"
        Height="430"
        MinWidth="470"
        MinHeight="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="66"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierTransactionDialogHeader}" Margin="10,10,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CashierTransactionHeaderIcon}">
                    <TextBlock Text="D" Foreground="White" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{StaticResource CashierDialogTitle}"/>
                    <TextBlock Text="Record why the cash drawer is being opened"
                               Style="{StaticResource CashierTransactionHeaderSubtitle}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="ENTER = CONTINUE   |   ESC = CANCEL"
                           Style="{StaticResource CashierShortcutHint}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CashierTransactionContentPanel}" Margin="10">
            <StackPanel>
                <TextBlock Text="REASON" Style="{StaticResource CashierTransactionFieldLabel}"/>
                <ComboBox x:Name="ReasonCombo"
                          Style="{StaticResource CashierTransactionComboBox}"
                          Margin="0,6,0,14"/>

                <TextBlock Text="NOTE (REQUIRED FOR OTHER)" Style="{StaticResource CashierTransactionFieldLabel}"/>
                <TextBox x:Name="NoteBox"
                         Style="{StaticResource CashierTransactionMultilineTextBox}"
                         Margin="0,6,0,0" MaxLength="500"/>
                <TextBlock x:Name="ErrorText"
                           Style="{StaticResource CashierValidationText}"
                           MinHeight="18" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CashierDialogFooter}" Margin="10,0,10,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL" IsCancel="True" Click="Cancel_Click"
                        Style="{StaticResource CashierTransactionCancelButton}" Margin="0,0,10,0"/>
                <Button Content="CONTINUE" IsDefault="True" Click="Continue_Click"
                        Style="{StaticResource CashierTransactionConfirmButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
