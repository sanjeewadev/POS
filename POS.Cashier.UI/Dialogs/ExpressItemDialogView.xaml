<Window x:Class="POS.Cashier.UI.Dialogs.ExpressItemDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Express Items"
        Style="{StaticResource CashierDialogWindow}"
        Width="1000"
        Height="650"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="ExpressItemButton"
               TargetType="Button"
               BasedOn="{StaticResource CashierButton}">
            <Setter Property="MinWidth" Value="170"/>
            <Setter Property="MinHeight" Value="90"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierDialogHeader}">
            <Grid>
                <TextBlock Text="EXPRESS ITEMS" Style="{StaticResource CashierDialogTitle}"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource CashierShortcutHint}"
                           HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="Buttons: " Style="{StaticResource CashierShortcutHint}"/>
                    <TextBlock Text="{Binding ButtonCount}"
                               Style="{StaticResource CashierShortcutHint}"
                               Margin="0,0,12,0"/>
                    <Button x:Name="RefreshButton"
                            Content="REFRESH"
                            Command="{Binding LoadButtonsCommand}"
                            Style="{StaticResource CashierButton}"
                            MinWidth="90"
                            Height="34"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Border Style="{StaticResource CashierPanel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <ItemsControl x:Name="ExpressItemsControl"
                                  ItemsSource="{Binding ExpressButtons}"
                                  KeyboardNavigation.TabNavigation="Continue">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="{Binding ButtonColorHex}"
                                        Foreground="{Binding TextColorHex}"
                                        Style="{StaticResource ExpressItemButton}"
                                        Command="{Binding DataContext.ButtonClickedCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding DisplayLabel}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="17"
                                                   FontWeight="Bold"/>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding RetailPrice, StringFormat=Rs. {0:N2}}"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Margin="0,5,0,0"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Background="#D9FFFFFF"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Loading express buttons..."
                           Foreground="{StaticResource CashierHeaderBrush}"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CashierDialogFooter}">
            <Grid>
                <TextBlock Text="Choose an item to add one unit to the current sale. ESC closes the menu."
                           Style="{StaticResource CashierMutedText}"
                           VerticalAlignment="Center"/>
                <Button Content="CLOSE MENU"
                        Style="{StaticResource CashierButton}"
                        HorizontalAlignment="Right"
                        Width="145"
                        IsCancel="True"
                        Click="CloseBtn_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
