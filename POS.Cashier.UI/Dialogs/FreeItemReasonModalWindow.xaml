<Window x:Class="POS.Cashier.UI.Dialogs.FreeItemReasonModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apply Free Issue"
        Width="720"
        Height="500"
        MinWidth="680"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F3F4F6"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1F2937" Padding="12" CornerRadius="3">
            <StackPanel>
                <TextBlock Text="Apply Free Issue" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Choose a valid rule and enter only the quantity that becomes free."
                           Foreground="#D1D5DB" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,10,0,8" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Item" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding ItemDescription}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="1" Text="SKU / Barcode" Margin="0,6,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SkuCode}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Batch" Margin="0,6,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding BatchNo}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="2" Text="Available Qty" Margin="0,6,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MaximumQuantity, StringFormat=N3}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Unit Price" Margin="0,6,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding OriginalUnitPrice, StringFormat='Rs. {0:N2}'}" Margin="0,6,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Free Issue Rule" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" Grid.ColumnSpan="3"
                          ItemsSource="{Binding ApplicableRules}"
                          SelectedItem="{Binding SelectedRule}"
                          DisplayMemberPath="RuleName"
                          MinHeight="28"/>

                <TextBlock Grid.Row="1" Text="Free Quantity" Margin="0,10,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="QuantityTextBox"
                         Grid.Row="1" Grid.Column="1"
                         Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}"
                         Margin="0,10,10,0" MinHeight="28" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Claim Value" Margin="0,10,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ClaimValue, StringFormat='Rs. {0:N2}'}"
                           Margin="0,10,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2" Text="Cost Value" Margin="0,8,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FreeIssueCostValue, StringFormat='Rs. {0:N2}'}" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Selling Value" Margin="0,8,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding FreeIssueSellingValue, StringFormat='Rs. {0:N2}'}" Margin="0,8,0,0"/>

                <Border Grid.Row="3" Grid.ColumnSpan="4" Margin="0,12,0,0" Padding="9"
                        Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColorHex}" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,4,0,0" Foreground="#4B5563" TextWrapping="Wrap"
                                   Text="Manager or Administrator credentials will be requested after confirmation only when the selected rule requires approval."/>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="4" Grid.ColumnSpan="4" Margin="0,10,0,0" Foreground="#4B5563" TextWrapping="Wrap"
                           Text="The paid quantity remains on the original line. The entered quantity is split into a separate zero-price Free Issue line. Stock is deducted for Stock Items; Services create no inventory movement."/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
            <Button Content="Cancel (Esc)" Command="{Binding CancelCommand}" Width="105" Height="30" Margin="0,0,8,0"/>
            <Button Content="Refresh Rules" Command="{Binding RefreshRulesCommand}" Width="110" Height="30" Margin="0,0,8,0"/>
            <Button Content="Apply Free Issue" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}"
                    Width="135" Height="30" FontWeight="SemiBold"/>
        </DockPanel>
    </Grid>
</Window>
