<Window x:Class="POS.Cashier.UI.Dialogs.FreeItemReasonModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apply Free Issue"
        Style="{StaticResource CashierDialogWindow}"
        Width="760"
        Height="570"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="66"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierTransactionDialogHeader}" Margin="10,10,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CashierTransactionHeaderIcon}">
                    <TextBlock Text="F" Foreground="White" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="APPLY FREE ISSUE" Style="{StaticResource CashierDialogTitle}"/>
                    <TextBlock Text="Choose an applicable rule and enter the free quantity"
                               Style="{StaticResource CashierTransactionHeaderSubtitle}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="ENTER = APPLY   |   ESC = CANCEL"
                           Style="{StaticResource CashierShortcutHint}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="10" Padding="6"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CashierTransactionContentPanel}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="ITEM" Style="{StaticResource CashierTransactionDetailLabel}"/>
                        <TextBlock Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding ItemDescription}"
                                   Style="{StaticResource CashierTransactionDetailValue}"/>
                        <TextBlock Grid.Row="1" Text="SKU / Barcode" Style="{StaticResource CashierTransactionDetailLabel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SkuCode}" Style="{StaticResource CashierTransactionDetailValue}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Batch" Style="{StaticResource CashierTransactionDetailLabel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding BatchNo}" Style="{StaticResource CashierTransactionDetailValue}"/>
                        <TextBlock Grid.Row="2" Text="Available Qty" Style="{StaticResource CashierTransactionDetailLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MaximumQuantity, StringFormat=N3}" Style="{StaticResource CashierTransactionDetailValue}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Unit Price" Style="{StaticResource CashierTransactionDetailLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding OriginalUnitPrice, StringFormat='Rs. {0:N2}'}" Style="{StaticResource CashierTransactionDetailValue}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CashierTransactionContentPanel}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="56"/>
                            <RowDefinition Height="42"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="FREE ISSUE RULE" Style="{StaticResource CashierTransactionFieldLabel}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Grid.ColumnSpan="3"
                                  ItemsSource="{Binding ApplicableRules}"
                                  SelectedItem="{Binding SelectedRule}"
                                  DisplayMemberPath="RuleName"
                                  Style="{StaticResource CashierTransactionComboBox}"/>
                        <TextBlock Grid.Row="1" Text="FREE QUANTITY" Style="{StaticResource CashierTransactionFieldLabel}" VerticalAlignment="Center"/>
                        <TextBox x:Name="QuantityTextBox" Grid.Row="1" Grid.Column="1"
                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}"
                                 Style="{StaticResource CashierTransactionMoneyInputTextBox}" Margin="0,4,10,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="CLAIM VALUE" Style="{StaticResource CashierTransactionFieldLabel}" VerticalAlignment="Center"/>
                        <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource CashierTransactionReadOnlyPanel}" Margin="0,4,0,4">
                            <TextBlock Text="{Binding ClaimValue, StringFormat='Rs. {0:N2}'}"
                                       Style="{StaticResource CashierTransactionReadOnlyValue}"
                                       Foreground="{StaticResource CashierPrimaryDarkBrush}"/>
                        </Border>
                        <TextBlock Grid.Row="2" Text="Cost value" Style="{StaticResource CashierTransactionDetailLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FreeIssueCostValue, StringFormat='Rs. {0:N2}'}" Style="{StaticResource CashierTransactionDetailValue}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Selling value" Style="{StaticResource CashierTransactionDetailLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding FreeIssueSellingValue, StringFormat='Rs. {0:N2}'}" Style="{StaticResource CashierTransactionDetailValue}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CashierTransactionStatusBanner}"
                        Background="{Binding StatusColorHex}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CashierTransactionStatusSymbol}"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="White"
                                   FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CashierTransactionSectionPanel}">
                    <TextBlock Text="The paid quantity stays on the original line. The free quantity is split to a zero-price Free Issue line. Approval is requested only when the selected rule requires it."
                               Style="{StaticResource CashierTransactionFooterHint}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource CashierDialogFooter}" Margin="10,0,10,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL" Command="{Binding CancelCommand}" IsCancel="True"
                        Style="{StaticResource CashierTransactionCancelButton}" Margin="0,0,10,0"/>
                <Button Content="REFRESH RULES" Command="{Binding RefreshRulesCommand}"
                        Style="{StaticResource CashierTransactionSecondaryButton}" Margin="0,0,10,0"/>
                <Button Content="APPLY FREE ISSUE" Command="{Binding ConfirmCommand}"
                        IsDefault="True" IsEnabled="{Binding CanConfirm}"
                        Style="{StaticResource CashierTransactionConfirmButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
