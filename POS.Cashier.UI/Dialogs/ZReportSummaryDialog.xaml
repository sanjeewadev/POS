<Window x:Class="POS.Cashier.UI.Dialogs.ZReportSummaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Z-Report Confirmation"
        Style="{StaticResource CashierSummaryControlWindow}"
        Width="620"
        Height="500"
        MinWidth="540"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        KeyboardNavigation.TabNavigation="Cycle"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CashierSummaryDangerHeader}">
            <DockPanel LastChildFill="True">
                <TextBlock Text="ESC returns"
                           Style="{StaticResource CashierShortcutHint}"
                           DockPanel.Dock="Right"
                           Margin="16,0,0,0"/>
                <StackPanel>
                    <TextBlock Text="Z-REPORT: SHIFT CLOSURE"
                               Style="{StaticResource CashierSummaryHeaderTitle}"/>
                    <TextBlock Text="Review the counted cash and variance before final closure."
                               Style="{StaticResource CashierSummaryHeaderSubtitle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16">
            <StackPanel>
                <UniformGrid Columns="2">
                    <Border Style="{StaticResource CashierSummaryMetricPanel}"
                            Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="EXPECTED SYSTEM CASH"
                                       Style="{StaticResource CashierSummaryMetricLabel}"/>
                            <TextBlock x:Name="ExpectedText"
                                       Text="Rs. 0.00"
                                       Style="{StaticResource CashierSummaryMetricValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CashierSummaryMetricPanel}"
                            Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="ACTUAL COUNTED CASH"
                                       Style="{StaticResource CashierSummaryMetricLabel}"/>
                            <TextBlock x:Name="CountedText"
                                       Text="Rs. 0.00"
                                       Style="{StaticResource CashierSummaryMetricValue}"
                                       Foreground="{StaticResource CashierPrimaryDarkBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource CashierSummaryDangerPanel}"
                        Margin="0,14,0,0">
                    <Grid>
                        <TextBlock Text="CASH VARIANCE"
                                   Style="{StaticResource CashierSummaryTotalLabel}"/>
                        <TextBlock x:Name="VarianceText"
                                   Text="Rs. 0.00"
                                   Style="{StaticResource CashierSummaryTotalValue}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CashierSummaryWarningPanel}"
                        Margin="0,14,0,0">
                    <TextBlock Text="Printing the Z-Report permanently closes this shift and logs off the cashier. A non-zero variance requires manager authorization."
                               Foreground="{StaticResource CashierWarningDarkBrush}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Style="{StaticResource CashierSummaryFooter}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="GO BACK"
                        Style="{StaticResource CashierSummarySecondaryButton}"
                        IsCancel="True"
                        MinWidth="110"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton"
                        Content="PRINT AND CLOSE"
                        Style="{StaticResource CashierSummaryDangerButton}"
                        MinWidth="165"
                        IsDefault="True"
                        Click="Confirm_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
