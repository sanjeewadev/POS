<Window x:Class="POS.Cashier.UI.Dialogs.ZReportSummaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Z-Report Confirmation"
        Style="{StaticResource CashierDialogWindow}"
        Width="460"
        Height="450"
        MinWidth="430"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="68"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource CashierDangerDarkBrush}"
                BorderBrush="{StaticResource CashierDangerBrush}"
                BorderThickness="1"
                Padding="14,6">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Z-REPORT: SHIFT CLOSURE"
                               Foreground="White"
                               FontSize="19"
                               FontWeight="Bold"/>
                    <TextBlock Text="Review the variance before final closure."
                               Foreground="White"
                               FontSize="12"/>
                </StackPanel>
                <TextBlock Text="ESC returns"
                           Style="{StaticResource CashierShortcutHint}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CashierPanel}" Margin="16">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Expected system cash" Style="{StaticResource CashierFieldLabel}"/>
                    <TextBlock x:Name="ExpectedText" Text="Rs. 0.00" Style="{StaticResource CashierReadOnlyValue}" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Actual counted cash" Style="{StaticResource CashierFieldLabel}"/>
                    <TextBlock x:Name="CountedText" Text="Rs. 0.00" Style="{StaticResource CashierReadOnlyValue}" Foreground="{StaticResource CashierPrimaryDarkBrush}" HorizontalAlignment="Right"/>
                </Grid>

                <Rectangle Height="1" Fill="{StaticResource CashierBorderBrush}" Margin="0,5,0,15"/>

                <Grid Margin="0,0,0,18">
                    <TextBlock Text="CASH VARIANCE" FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="VarianceText" Text="Rs. 0.00" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>

                <Border Background="#FFF4E5"
                        BorderBrush="{StaticResource CashierWarningBrush}"
                        BorderThickness="1"
                        Padding="10">
                    <TextBlock Text="Printing the Z-Report permanently closes this shift and logs off the cashier."
                               Foreground="{StaticResource CashierDangerDarkBrush}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CashierDialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="GO BACK"
                        Style="{StaticResource CashierButton}"
                        IsCancel="True"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton"
                        Content="PRINT AND CLOSE"
                        Style="{StaticResource CashierDangerButton}"
                        MinWidth="155"
                        IsDefault="True"
                        Click="Confirm_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
