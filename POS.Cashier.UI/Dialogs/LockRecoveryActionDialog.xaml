<Window x:Class="POS.Cashier.UI.Dialogs.LockRecoveryActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manager Recovery"
        Width="470"
        Height="340"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Segoe UI">

    <Border Margin="12"
            Background="White"
            BorderBrush="#94A3B8"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#1E293B"
                    CornerRadius="5,5,0,0"
                    Padding="16">
                <TextBlock Text="MANAGER RECOVERY"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Row="1"
                        Margin="28,22,28,18">
                <TextBlock Text="Choose the approved recovery action."
                           Foreground="#334155"
                           FontSize="15"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>

                <Border Background="#EFF6FF"
                        BorderBrush="#93C5FD"
                        BorderThickness="1"
                        Padding="12"
                        Margin="0,0,0,18">
                    <TextBlock Text="Unlock and Continue keeps the original cashier and shift ownership. Close Cashier Application saves the active cart and leaves the shift open."
                               Foreground="#1E3A8A"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </Border>

                <Button Content="UNLOCK AND CONTINUE"
                        Height="44"
                        Background="#0F766E"
                        BorderBrush="#0F766E"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="UnlockAndContinue_Click"
                        Margin="0,0,0,10"/>

                <Button Content="CLOSE CASHIER APPLICATION"
                        Height="44"
                        Background="#B45309"
                        BorderBrush="#B45309"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="CloseApplication_Click"/>
            </StackPanel>

            <Button Grid.Row="2"
                    Content="CANCEL"
                    Height="38"
                    Margin="28,0,28,22"
                    Background="#E2E8F0"
                    BorderBrush="#CBD5E1"
                    Foreground="#334155"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="Cancel_Click"/>
        </Grid>
    </Border>
</Window>
