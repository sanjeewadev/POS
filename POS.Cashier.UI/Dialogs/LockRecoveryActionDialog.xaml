<Window x:Class="POS.Cashier.UI.Dialogs.LockRecoveryActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manager Recovery"
        Style="{StaticResource CashierDialogWindow}"
        Width="540"
        Height="440"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="66"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierTransactionDialogHeader}" Margin="10,10,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CashierTransactionHeaderIcon}">
                    <TextBlock Text="R" Foreground="White" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="MANAGER RECOVERY" Style="{StaticResource CashierDialogTitle}"/>
                    <TextBlock Text="Choose the approved lock-screen recovery action"
                               Style="{StaticResource CashierTransactionHeaderSubtitle}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="ESC = CANCEL"
                           Style="{StaticResource CashierShortcutHint}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CashierTransactionContentPanel}" Margin="10">
            <StackPanel>
                <Border Style="{StaticResource CashierTransactionSectionPanel}" Margin="0,0,0,16">
                    <TextBlock Text="Unlock and Continue keeps the original cashier and shift. Close Cashier Application saves the active cart and leaves the shift open."
                               Style="{StaticResource CashierTransactionFooterHint}"
                               TextAlignment="Center"/>
                </Border>
                <Button x:Name="UnlockButton" Content="UNLOCK AND CONTINUE"
                        Style="{StaticResource CashierTransactionConfirmButton}"
                        HorizontalAlignment="Stretch" IsDefault="True"
                        Click="UnlockAndContinue_Click" Margin="0,0,0,12"/>
                <Button Content="CLOSE CASHIER APPLICATION"
                        Style="{StaticResource CashierTransactionWarningButton}"
                        HorizontalAlignment="Stretch" Click="CloseApplication_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CashierDialogFooter}" Margin="10,0,10,10">
            <Button Content="CANCEL" Style="{StaticResource CashierTransactionCancelButton}"
                    HorizontalAlignment="Right" IsCancel="True" Click="Cancel_Click"/>
        </Border>
    </Grid>
</Window>
