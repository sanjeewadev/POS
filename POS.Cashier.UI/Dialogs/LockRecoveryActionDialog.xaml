<Window x:Class="POS.Cashier.UI.Dialogs.LockRecoveryActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manager Recovery"
        Style="{StaticResource CashierDialogWindow}"
        Width="500"
        Height="390"
        MinWidth="460"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierDialogHeader}">
            <Grid>
                <TextBlock Text="MANAGER RECOVERY"
                           Style="{StaticResource CashierDialogTitle}"/>
                <TextBlock Text="ESC cancels"
                           Style="{StaticResource CashierShortcutHint}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CashierPanel}" Margin="16">
            <StackPanel>
                <TextBlock Text="Choose the approved recovery action."
                           Style="{StaticResource CashierSectionTitle}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>

                <Border Style="{StaticResource CashierStatusPanel}" Margin="0,0,0,16">
                    <TextBlock Text="Unlock and Continue keeps the original cashier and shift ownership. Close Cashier Application saves the active cart and leaves the shift open."
                               Style="{StaticResource CashierMutedText}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </Border>

                <Button x:Name="UnlockButton"
                        Content="UNLOCK AND CONTINUE"
                        Style="{StaticResource CashierSuccessButton}"
                        Height="44"
                        IsDefault="True"
                        Click="UnlockAndContinue_Click"
                        Margin="0,0,0,10"/>

                <Button Content="CLOSE CASHIER APPLICATION"
                        Style="{StaticResource CashierProtectedButton}"
                        Height="44"
                        Click="CloseApplication_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CashierDialogFooter}">
            <Button Content="CANCEL"
                    Style="{StaticResource CashierButton}"
                    Width="120"
                    HorizontalAlignment="Right"
                    IsCancel="True"
                    Click="Cancel_Click"/>
        </Border>
    </Grid>
</Window>
