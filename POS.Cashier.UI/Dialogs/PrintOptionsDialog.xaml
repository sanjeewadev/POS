<Window x:Class="POS.Cashier.UI.Dialogs.PrintOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Options"
        Style="{StaticResource CashierSummaryControlWindow}"
        Width="760"
        Height="430"
        MinWidth="660"
        MinHeight="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        KeyboardNavigation.TabNavigation="Cycle"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CashierSummaryHeader}">
            <DockPanel LastChildFill="True">
                <TextBlock Text="ESC closes"
                           Style="{StaticResource CashierShortcutHint}"
                           DockPanel.Dock="Right"
                           Margin="16,0,0,0"/>
                <StackPanel>
                    <TextBlock Text="PRINT OPTIONS"
                               Style="{StaticResource CashierSummaryHeaderTitle}"/>
                    <TextBlock Text="Select the document to preview or print."
                               Style="{StaticResource CashierSummaryHeaderSubtitle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16">
            <UniformGrid Columns="3">
                <Button x:Name="LastReceiptButton"
                        Style="{StaticResource CashierSummaryOptionButton}"
                        Margin="0,0,8,0"
                        Click="PrintLastBill_Click">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LAST RECEIPT"
                                   Style="{StaticResource CashierSummaryActionTitle}"/>
                        <TextBlock Text="Open the most recent completed receipt for this terminal."
                                   Style="{StaticResource CashierSummaryActionSubtitle}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource CashierSummaryOptionButton}"
                        BorderBrush="{StaticResource CashierSuccessDarkBrush}"
                        Margin="8,0"
                        Click="TaxInvoice_Click">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TAX INVOICE"
                                   Style="{StaticResource CashierSummaryActionTitle}"
                                   Foreground="{StaticResource CashierSuccessDarkBrush}"/>
                        <TextBlock Text="Issue or preview a VAT Tax Invoice from eligible sale data."
                                   Style="{StaticResource CashierSummaryActionSubtitle}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource CashierSummaryOptionButton}"
                        BorderBrush="{StaticResource CashierPrimaryDarkBrush}"
                        Margin="8,0,0,0"
                        Click="PrintQuotation_Click">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="QUOTATION"
                                   Style="{StaticResource CashierSummaryActionTitle}"
                                   Foreground="{StaticResource CashierPrimaryDarkBrush}"/>
                        <TextBlock Text="Preview the current cart as a non-posting quotation."
                                   Style="{StaticResource CashierSummaryActionSubtitle}"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Style="{StaticResource CashierSummaryFooter}">
            <Grid>
                <TextBlock Text="Use Tab or arrow keys to choose an option."
                           Style="{StaticResource CashierSummaryStatusText}"/>
                <Button Content="CANCEL"
                        Style="{StaticResource CashierSummarySecondaryButton}"
                        MinWidth="105"
                        HorizontalAlignment="Right"
                        IsCancel="True"
                        Click="Cancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
