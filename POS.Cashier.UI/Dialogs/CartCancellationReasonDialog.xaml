<Window x:Class="POS.Cashier.UI.Dialogs.CartCancellationReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cancel Cashier Cart"
        Style="{StaticResource CashierDialogWindow}"
        Width="540"
        Height="420"
        MinWidth="500"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierDialogHeader}">
            <Grid>
                <TextBlock Text="CANCEL CASHIER CART"
                           Style="{StaticResource CashierDialogTitle}"/>
                <TextBlock Text="ENTER confirms · ESC returns"
                           Style="{StaticResource CashierShortcutHint}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CashierPanel}" Margin="16">
            <StackPanel>
                <TextBlock Text="Cancellation reason" Style="{StaticResource CashierFieldLabel}"/>
                <ComboBox x:Name="ReasonComboBox"
                          Style="{StaticResource CashierComboBox}"
                          Margin="0,6,0,14"
                          SelectionChanged="ReasonComboBox_SelectionChanged">
                    <ComboBoxItem Tag="CustomerChangedMind" Content="Customer Changed Mind"/>
                    <ComboBoxItem Tag="WrongItems" Content="Wrong Items"/>
                    <ComboBoxItem Tag="PricingIssue" Content="Pricing Issue"/>
                    <ComboBoxItem Tag="PaymentNotAvailable" Content="Payment Not Available"/>
                    <ComboBoxItem Tag="DuplicateEntry" Content="Duplicate Entry"/>
                    <ComboBoxItem Tag="Other" Content="Other"/>
                </ComboBox>

                <TextBlock Text="Note" Style="{StaticResource CashierFieldLabel}"/>
                <TextBox x:Name="ReasonTextBox"
                         Style="{StaticResource CashierTextBox}"
                         Height="90"
                         Margin="0,6,0,0"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         MaxLength="250"
                         VerticalScrollBarVisibility="Auto"/>
                <TextBlock x:Name="ValidationText"
                           Style="{StaticResource CashierValidationText}"
                           MinHeight="18"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CashierDialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="BACK"
                        Style="{StaticResource CashierButton}"
                        IsCancel="True"
                        Margin="0,0,10,0"
                        Click="BackButton_Click"/>
                <Button Content="CONFIRM CANCELLATION"
                        Style="{StaticResource CashierDangerButton}"
                        MinWidth="190"
                        IsDefault="True"
                        Click="ConfirmButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
