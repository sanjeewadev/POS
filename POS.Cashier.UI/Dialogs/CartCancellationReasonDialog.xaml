<Window x:Class="POS.Cashier.UI.Dialogs.CartCancellationReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cancel Cart"
        Height="360"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#F4F7FB"
        BorderBrush="#0F3B5D"
        BorderThickness="3"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0F3B5D">
            <TextBlock Text="CANCEL CASHIER CART"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="28,24,28,16">
            <TextBlock Text="Cancellation reason"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <ComboBox x:Name="ReasonComboBox"
                      Height="42"
                      FontSize="16"
                      SelectionChanged="ReasonComboBox_SelectionChanged">
                <ComboBoxItem Tag="CustomerChangedMind" Content="Customer Changed Mind"/>
                <ComboBoxItem Tag="WrongItems" Content="Wrong Items"/>
                <ComboBoxItem Tag="PricingIssue" Content="Pricing Issue"/>
                <ComboBoxItem Tag="PaymentNotAvailable" Content="Payment Not Available"/>
                <ComboBoxItem Tag="DuplicateEntry" Content="Duplicate Entry"/>
                <ComboBoxItem Tag="Other" Content="Other"/>
            </ComboBox>

            <TextBlock Text="Note"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,18,0,8"/>
            <TextBox x:Name="ReasonTextBox"
                     Height="78"
                     FontSize="15"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     MaxLength="250"
                     VerticalScrollBarVisibility="Auto"/>
            <TextBlock x:Name="ValidationText"
                       Foreground="#DC2626"
                       FontWeight="SemiBold"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2" Background="#E7EEF5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="BACK"
                    Margin="18,12,8,12"
                    FontSize="18"
                    FontWeight="Bold"
                    Click="BackButton_Click"/>
            <Button Grid.Column="1"
                    Content="CONFIRM CANCELLATION"
                    Margin="8,12,18,12"
                    Background="#C62828"
                    Foreground="White"
                    FontSize="17"
                    FontWeight="Bold"
                    Click="ConfirmButton_Click"/>
        </Grid>
    </Grid>
</Window>
