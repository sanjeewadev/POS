<Window x:Class="POS.Cashier.UI.Dialogs.CartCancellationReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cancel Cashier Cart"
        Style="{StaticResource CashierDialogWindow}"
        Width="570"
        Height="470"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="66"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierTransactionDialogHeader}" Margin="10,10,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CashierTransactionHeaderIcon}" Background="{StaticResource CashierDangerBrush}">
                    <TextBlock Text="×" Foreground="White" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="CANCEL CASHIER CART" Style="{StaticResource CashierDialogTitle}"/>
                    <TextBlock Text="Record a clear reason before discarding the active cart"
                               Style="{StaticResource CashierTransactionHeaderSubtitle}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="ENTER = CONFIRM   |   ESC = BACK"
                           Style="{StaticResource CashierShortcutHint}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CashierTransactionContentPanel}" Margin="10">
            <StackPanel>
                <TextBlock Text="CANCELLATION REASON" Style="{StaticResource CashierTransactionFieldLabel}"/>
                <ComboBox x:Name="ReasonComboBox"
                          Style="{StaticResource CashierTransactionComboBox}"
                          Margin="0,6,0,14"
                          SelectionChanged="ReasonComboBox_SelectionChanged">
                    <ComboBoxItem Tag="CustomerChangedMind" Content="Customer Changed Mind"/>
                    <ComboBoxItem Tag="WrongItems" Content="Wrong Items"/>
                    <ComboBoxItem Tag="PricingIssue" Content="Pricing Issue"/>
                    <ComboBoxItem Tag="PaymentNotAvailable" Content="Payment Not Available"/>
                    <ComboBoxItem Tag="DuplicateEntry" Content="Duplicate Entry"/>
                    <ComboBoxItem Tag="Other" Content="Other"/>
                </ComboBox>

                <TextBlock Text="NOTE" Style="{StaticResource CashierTransactionFieldLabel}"/>
                <TextBox x:Name="ReasonTextBox"
                         Style="{StaticResource CashierTransactionMultilineTextBox}"
                         Margin="0,6,0,0" MaxLength="250"/>
                <TextBlock x:Name="ValidationText"
                           Style="{StaticResource CashierValidationText}"
                           MinHeight="18" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CashierDialogFooter}" Margin="10,0,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="A note is required when the selected reason is Other."
                           Style="{StaticResource CashierTransactionFooterHint}"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="BACK" IsCancel="True" Click="BackButton_Click"
                            Style="{StaticResource CashierTransactionCancelButton}" Margin="0,0,10,0"/>
                    <Button Content="CONFIRM CANCELLATION" IsDefault="True" Click="ConfirmButton_Click"
                            Style="{StaticResource CashierTransactionDangerButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
