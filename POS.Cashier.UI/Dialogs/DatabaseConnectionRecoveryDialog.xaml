<Window x:Class="POS.Cashier.UI.Dialogs.DatabaseConnectionRecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced POS - Store Connection Required"
        Style="{StaticResource CashierSummaryControlWindow}"
        Width="860"
        Height="650"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="74"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CashierSummaryDangerHeader}"
                Margin="10,10,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CashierTransactionHeaderIcon}">
                    <TextBlock Text="DB"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="STORE CONNECTION REQUIRED"
                               Style="{StaticResource CashierSummaryHeaderTitle}"/>
                    <TextBlock Text="Retry a temporary outage or repair the saved server connection"
                               Style="{StaticResource CashierSummaryHeaderSubtitle}"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="ESC = EXIT"
                           Style="{StaticResource CashierShortcutHint}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource CashierSummaryContentPanel}"
                Margin="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource CashierSummaryDangerPanel}"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="CASHIER COULD NOT REACH THE STORE DATABASE"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="FailureMessageTextBlock"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CashierSummarySectionPanel}"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Saved endpoint"
                                       FontWeight="SemiBold"
                                       Margin="0,0,12,7"/>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       x:Name="EndpointTextBlock"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,7"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Configuration file"
                                       FontWeight="SemiBold"
                                       Margin="0,0,12,7"/>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       x:Name="ProfilePathTextBlock"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,7"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Automatic attempts"
                                       FontWeight="SemiBold"
                                       Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="Up to three controlled connection attempts are made when the saved profile can be loaded."
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CashierSummarySectionPanel}"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="RECOVERY ORDER"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="1. Use RETRY when the server, router, Wi-Fi, cable, or SQL Server was only temporarily unavailable."
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="2. Use REPAIR CONNECTION when the router, server computer name, server IP address, SQL port, or saved profile changed."
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="3. Complete the configuration wizard, then use RESTART CASHIER so the new encrypted profile is loaded."
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="Changing the connection does not delete sales data, terminal history, or licences. The Server PC and local store network must still be working."
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <UniformGrid Columns="2"
                                 Rows="2">
                        <Button x:Name="RetryButton"
                                Content="RETRY CONNECTION"
                                Style="{StaticResource CashierSummaryPrimaryButton}"
                                Margin="0,0,8,8"
                                IsDefault="True"
                                Click="RetryButton_OnClick"/>
                        <Button x:Name="RepairButton"
                                Content="REPAIR CONNECTION"
                                Style="{StaticResource CashierSummarySecondaryButton}"
                                Margin="0,0,0,8"
                                Click="RepairButton_OnClick"/>
                        <Button x:Name="DiagnosticsButton"
                                Content="SAVE DIAGNOSTICS"
                                Style="{StaticResource CashierSummarySecondaryButton}"
                                Margin="0,0,8,0"
                                Click="DiagnosticsButton_OnClick"/>
                        <Button x:Name="RestartButton"
                                Content="RESTART CASHIER"
                                Style="{StaticResource CashierSummarySuccessButton}"
                                IsEnabled="False"
                                Click="RestartButton_OnClick"/>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CashierSummaryFooter}"
                Margin="10,0,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ActionStatusTextBlock"
                           Text="Choose a recovery action."
                           Style="{StaticResource CashierSummaryStatusText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        x:Name="ExitButton"
                        Content="EXIT CASHIER"
                        Style="{StaticResource CashierSummarySecondaryButton}"
                        Margin="12,0,0,0"
                        IsCancel="True"
                        Click="ExitButton_OnClick"/>
            </Grid>
        </Border>
    </Grid>
</Window>
