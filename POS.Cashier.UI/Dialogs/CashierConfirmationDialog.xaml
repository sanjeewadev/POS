<Window x:Class="POS.Cashier.UI.Dialogs.CashierConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Cashier Action"
        Style="{StaticResource CashierDialogWindow}"
        Width="590"
        Height="380"
        MinWidth="540"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="68"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CashierTransactionDialogHeader}"
                Margin="10,10,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="HeaderIconBorder"
                        Grid.Column="0"
                        Style="{StaticResource CashierTransactionHeaderIcon}"
                        Background="{StaticResource CashierDangerBrush}">
                    <TextBlock x:Name="HeaderIconText"
                               Text="!"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="HeadingTextBlock"
                               Text="CONFIRM ACTION"
                               Style="{StaticResource CashierDialogTitle}"/>
                    <TextBlock x:Name="SubtitleTextBlock"
                               Text="Review the action before continuing"
                               Style="{StaticResource CashierTransactionHeaderSubtitle}"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="ENTER = CONFIRM   |   ESC = BACK"
                           Style="{StaticResource CashierShortcutHint}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource CashierTransactionContentPanel}"
                Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="MessageTextBlock"
                           Grid.Row="0"
                           TextWrapping="Wrap"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           Margin="0,0,0,14"/>

                <Border x:Name="DetailBorder"
                        Grid.Row="1"
                        Background="#F8FAFC"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Padding="14"
                        Visibility="Collapsed">
                    <TextBlock x:Name="DetailTextBlock"
                               TextWrapping="Wrap"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CashierDialogFooter}"
                Margin="10,0,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="LEFT / RIGHT = CHOOSE"
                           Style="{StaticResource CashierTransactionFooterHint}"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Content="BACK"
                            IsCancel="True"
                            Click="CancelButton_Click"
                            Style="{StaticResource CashierTransactionCancelButton}"
                            Margin="0,0,10,0"/>
                    <Button x:Name="ConfirmButton"
                            Content="CONFIRM"
                            IsDefault="True"
                            Click="ConfirmButton_Click"
                            Style="{StaticResource CashierTransactionDangerButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
