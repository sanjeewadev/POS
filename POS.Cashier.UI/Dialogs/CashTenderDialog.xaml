<Window x:Class="POS.Cashier.UI.Dialogs.CashTenderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:POS.Cashier.UI.Components"
        Title="Cash Payment"
        Style="{StaticResource CashierDialogWindow}"
        Width="900"
        Height="620"
        MinWidth="820"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        KeyboardNavigation.TabNavigation="Cycle"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- CATEGORY 1 TRANSACTION HEADER -->
        <Border Grid.Row="0"
                Style="{StaticResource CashierTransactionDialogHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CashierTransactionHeaderIcon}">
                    <TextBlock Text="Rs."
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="CASH PAYMENT"
                               Style="{StaticResource CashierDialogTitle}"
                               FontSize="22"/>
                    <TextBlock Text="Apply cash to the current sale"
                               Style="{StaticResource CashierTransactionHeaderSubtitle}"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="ENTER = CONFIRM   |   ESC = CANCEL"
                           Style="{StaticResource CashierShortcutHint}"
                           Foreground="White"
                           FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- TRANSACTION BODY. The scrollbar is a high-scaling safety fallback. -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,10,0,10"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      Focusable="False">
            <Grid MinHeight="390">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CashierPanel}"
                        CornerRadius="3"
                        Padding="14"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="56"/>
                            <RowDefinition Height="56"/>
                            <RowDefinition Height="56"/>
                            <RowDefinition Height="56"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Style="{StaticResource CashierTransactionStatusBanner}"
                                Background="{Binding StatusColorHex}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="26"
                                        Height="26"
                                        CornerRadius="13"
                                        BorderBrush="White"
                                        BorderThickness="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CashierTransactionStatusSymbol}"/>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding StatusText}"
                                           Foreground="White"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource CashierTransactionFieldIcon}">
                                <TextBlock Text="≡"
                                           Foreground="{StaticResource CashierTransactionIconBrush}"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="BALANCE DUE"
                                       Style="{StaticResource CashierTransactionFieldLabel}"/>

                            <Border Grid.Column="2"
                                    Style="{StaticResource CashierTransactionAmountPanel}"
                                    Background="{StaticResource CashierTransactionDueBrush}"
                                    BorderBrush="{StaticResource CashierTransactionDueBorderBrush}">
                                <TextBlock Text="{Binding BalanceDue, StringFormat={}{0:N2}}"
                                           Style="{StaticResource CashierTransactionAmountText}"
                                           Foreground="White"
                                           FontSize="27"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource CashierTransactionFieldIcon}">
                                <TextBlock Text="Rs."
                                           Foreground="{StaticResource CashierTransactionIconBrush}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="CASH TENDERED"
                                       Style="{StaticResource CashierTransactionFieldLabel}"/>

                            <TextBox x:Name="TenderedAmountTextBox"
                                     Grid.Column="2"
                                     Height="52"
                                     MaxLength="12"
                                     TabIndex="0"
                                     AutomationProperties.Name="Cash tendered amount"
                                     Text="{Binding TenderedAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CashierMoneyInputTextBox}"
                                     GotKeyboardFocus="TenderedAmountTextBox_GotKeyboardFocus"
                                     PreviewMouseLeftButtonDown="TenderedAmountTextBox_PreviewMouseLeftButtonDown"
                                     PreviewTextInput="TenderedAmountTextBox_PreviewTextInput"
                                     DataObject.Pasting="TenderedAmountTextBox_Pasting"/>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource CashierTransactionFieldIcon}">
                                <TextBlock Text="✓"
                                           Foreground="{StaticResource CashierTransactionAppliedTextBrush}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="APPLY TO BILL"
                                       Style="{StaticResource CashierTransactionFieldLabel}"/>

                            <Border Grid.Column="2"
                                    Style="{StaticResource CashierTransactionAmountPanel}"
                                    Background="{StaticResource CashierTransactionAppliedBrush}"
                                    BorderBrush="{StaticResource CashierTransactionAppliedBorderBrush}">
                                <TextBlock Text="{Binding AppliedAmount, StringFormat={}{0:N2}}"
                                           Style="{StaticResource CashierTransactionAmountText}"
                                           Foreground="{StaticResource CashierTransactionAppliedTextBrush}"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="4" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource CashierTransactionFieldIcon}">
                                <TextBlock Text="⇄"
                                           Foreground="{StaticResource CashierTransactionBalanceTextBrush}"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="CHANGE / BALANCE"
                                       Style="{StaticResource CashierTransactionFieldLabel}"/>

                            <Border Grid.Column="2"
                                    Style="{StaticResource CashierTransactionAmountPanel}"
                                    Background="{StaticResource CashierTransactionBalanceBrush}"
                                    BorderBrush="{StaticResource CashierTransactionBalanceBorderBrush}">
                                <TextBlock Text="{Binding ChangeOrRemainingText}"
                                           Style="{StaticResource CashierTransactionAmountText}"
                                           Foreground="{StaticResource CashierTransactionBalanceTextBrush}"
                                           FontSize="23"/>
                            </Border>
                        </Grid>

                        <Border Grid.Row="5"
                                Style="{StaticResource CashierStatusPanel}"
                                CornerRadius="3"
                                Margin="0,9,0,0"
                                Padding="10,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource CashierTransactionHelpIcon}">
                                    <TextBlock Text="i"
                                               Foreground="{StaticResource CashierTransactionHelpTextBrush}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1"
                                           Text="Enter the cash received. The applied amount and change are calculated automatically. A lower amount adds a partial cash payment."
                                           Style="{StaticResource CashierMutedText}"
                                           FontWeight="SemiBold"
                                           LineHeight="17"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <components:TenderNumpadControl x:Name="TenderNumpad"
                                                Grid.Column="1"
                                                TargetText="{Binding TenderedAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                HeaderText="CASH ENTRY"
                                                TargetLabel="CASH TENDERED"
                                                ModeText="AMOUNT"
                                                ShowDecimal="True"
                                                ShowDoubleZero="True"
                                                MaxLength="12"
                                                ClearText="0"
                                                SelectAllOnFirstKey="True"
                                                IsEnterEnabled="{Binding CanConfirm}"
                                                EnterPressed="TenderNumpad_EnterPressed"/>
            </Grid>
        </ScrollViewer>

        <!-- STANDARD TRANSACTION FOOTER -->
        <Border Grid.Row="2"
                Style="{StaticResource CashierDialogFooter}"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="178"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="KEYBOARD / TOUCH"
                               Foreground="{StaticResource CashierTransactionHelpBrush}"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Type an amount or use the numpad."
                               Style="{StaticResource CashierMutedText}"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="CANCEL"
                        Style="{StaticResource CashierTransactionCancelButton}"
                        Margin="0,0,8,0"
                        TabIndex="1"
                        IsCancel="True"
                        AutomationProperties.Name="Cancel cash payment"
                        Click="CancelBtn_Click"/>

                <Button Grid.Column="2"
                        Content="CONFIRM CASH"
                        Style="{StaticResource CashierTransactionConfirmButton}"
                        TabIndex="2"
                        IsDefault="True"
                        IsEnabled="{Binding CanConfirm}"
                        AutomationProperties.Name="Confirm cash payment"
                        Click="ConfirmBtn_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
