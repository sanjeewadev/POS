<Window x:Class="POS.Cashier.UI.Dialogs.CashTenderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:POS.Cashier.UI.Components"
        Title="Cash Payment"
        Style="{StaticResource CashierDialogWindow}"
        Width="860"
        Height="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Style="{StaticResource CashierDialogHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="CASH PAYMENT"
                               Style="{StaticResource CashierDialogTitle}"/>
                    <TextBlock Text="Apply cash to the current sale"
                               Foreground="{StaticResource CashierHeaderHintBrush}"
                               FontSize="11"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="ENTER = CONFIRM   |   ESC = CANCEL"
                           Style="{StaticResource CashierShortcutHint}"/>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CashierPanel}"
                    Padding="16"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="62"/>
                        <RowDefinition Height="62"/>
                        <RowDefinition Height="62"/>
                        <RowDefinition Height="62"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{Binding StatusColorHex}"
                            BorderBrush="{StaticResource CashierBorderDarkBrush}"
                            BorderThickness="1"
                            Padding="8,0">
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="BALANCE DUE"
                                   Style="{StaticResource CashierFieldLabel}"/>

                        <Border Grid.Column="1"
                                Background="#151B26"
                                BorderBrush="#080B10"
                                BorderThickness="2"
                                Padding="10,0">
                            <TextBlock Text="{Binding BalanceDue, StringFormat={}{0:N2}}"
                                       Foreground="#FFD24A"
                                       FontSize="29"
                                       FontWeight="Bold"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="CASH TENDERED"
                                   Style="{StaticResource CashierFieldLabel}"/>

                        <TextBox x:Name="TenderedAmountTextBox"
                                 Grid.Column="1"
                                 Text="{Binding TenderedAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CashierMoneyInputTextBox}"
                                 GotKeyboardFocus="TenderedAmountTextBox_GotKeyboardFocus"
                                 PreviewMouseLeftButtonDown="TenderedAmountTextBox_PreviewMouseLeftButtonDown"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="APPLY TO BILL"
                                   Style="{StaticResource CashierFieldLabel}"/>

                        <Border Grid.Column="1"
                                Background="#EAF6EF"
                                BorderBrush="{StaticResource CashierSuccessBrush}"
                                BorderThickness="2"
                                Padding="10,0">
                            <TextBlock Text="{Binding AppliedAmount, StringFormat={}{0:N2}}"
                                       Foreground="{StaticResource CashierSuccessDarkBrush}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="CHANGE / BALANCE"
                                   Style="{StaticResource CashierFieldLabel}"/>

                        <Border Grid.Column="1"
                                Background="#FFF4E5"
                                BorderBrush="{StaticResource CashierWarningBrush}"
                                BorderThickness="2"
                                Padding="10,0">
                            <TextBlock Text="{Binding ChangeOrRemainingText}"
                                       Foreground="{StaticResource CashierWarningDarkBrush}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Border Grid.Row="5"
                            Style="{StaticResource CashierStatusPanel}"
                            Margin="0,12,0,0">
                        <TextBlock Text="Exact cash completes the cash portion. Higher cash calculates change. Lower cash records a partial cash payment."
                                   Style="{StaticResource CashierMutedText}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>

            <components:TenderNumpadControl x:Name="TenderNumpad"
                                            Grid.Column="1"
                                            TargetText="{Binding TenderedAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            HeaderText="CASH ENTRY"
                                            TargetLabel="CASH TENDERED"
                                            ModeText="AMOUNT"
                                            ShowDecimal="True"
                                            ShowDoubleZero="True"
                                            MaxLength="12"
                                            ClearText=""
                                            SelectAllOnFirstKey="True"
                                            EnterPressed="TenderNumpad_EnterPressed"/>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                Style="{StaticResource CashierDialogFooter}"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Use the keyboard or touch numpad."
                           Style="{StaticResource CashierMutedText}"
                           FontWeight="SemiBold"/>

                <Button Grid.Column="1"
                        Content="CANCEL"
                        Style="{StaticResource CashierButton}"
                        Margin="0,0,8,0"
                        Click="CancelBtn_Click"/>

                <Button Grid.Column="2"
                        Content="CONFIRM CASH"
                        Style="{StaticResource CashierSuccessButton}"
                        Click="ConfirmBtn_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
