<Window x:Class="POS.Cashier.UI.Dialogs.StockInquiryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stock Inquiry"
        Style="{StaticResource CashierDialogWindow}"
        Width="900"
        Height="600"
        MinWidth="700"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierDialogHeader}">
            <Grid>
                <TextBlock Text="STOCK INQUIRY" Style="{StaticResource CashierDialogTitle}"/>
                <TextBlock Text="ENTER checks · ESC closes"
                           Style="{StaticResource CashierShortcutHint}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CashierPanel}" Margin="14,14,14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="SearchTextBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource CashierTextBox}"
                         FontSize="18"
                         FontWeight="Bold"/>

                <Button Grid.Column="1"
                        Content="CHECK STOCK"
                        Command="{Binding CheckStockCommand}"
                        Style="{StaticResource CashierPrimaryButton}"
                        IsDefault="True"
                        Margin="10,0,0,0"/>

                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding StatusText}"
                           Style="{StaticResource CashierMutedText}"
                           Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <DataGrid x:Name="dgStock"
                  Grid.Row="2"
                  Style="{StaticResource CashierDataGrid}"
                  Margin="14,0,14,8"
                  ItemsSource="{Binding StockResults}"
                  RowHeight="38">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Item / Variant"
                                    Binding="{Binding DisplayName}"
                                    Width="*"/>
                <DataGridTextColumn Header="SKU / Code"
                                    Binding="{Binding LookupCode}"
                                    Width="180"/>
                <DataGridTextColumn Header="In Stock Qty"
                                    Binding="{Binding CurrentStock, StringFormat={}{0:N3}}"
                                    Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="{StaticResource CashierPrimaryDarkBrush}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource CashierDialogFooter}">
            <Button Content="CLOSE INQUIRY"
                    Style="{StaticResource CashierButton}"
                    Width="150"
                    HorizontalAlignment="Right"
                    IsCancel="True"
                    Click="CancelBtn_Click"/>
        </Border>
    </Grid>
</Window>
