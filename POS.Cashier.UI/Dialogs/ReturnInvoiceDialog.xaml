<Window x:Class="POS.Cashier.UI.Dialogs.ReturnInvoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer Return and Credit Note"
        Style="{StaticResource CashierOperationalWindow}"
        Height="720"
        Width="1120"
        MinHeight="560"
        MinWidth="840"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        KeyboardNavigation.TabNavigation="Cycle"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CashierOperationalHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CUSTOMER RETURN &amp; CREDIT NOTE"
                               Style="{StaticResource CashierOperationalHeaderTitle}"/>
                    <TextBlock Text="Load the original invoice, select eligible lines, and confirm the settlement details."
                               Style="{StaticResource CashierShortcutHint}"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="ENTER = FIND   |   ESC = CLOSE"
                           Style="{StaticResource CashierShortcutHint}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource CashierOperationalSearchPanel}"
                Margin="0,8,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Invoice No."
                           Style="{StaticResource CashierOperationalInlineLabel}"
                           Margin="0,0,10,0"/>

                <TextBox x:Name="InvoiceSearchTextBox"
                         Grid.Column="1"
                         Text="{Binding InvoiceSearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource CashierOperationalSearchTextBox}"
                         KeyDown="InvoiceSearchTextBox_KeyDown"/>

                <Button Grid.Column="2"
                        Content="FIND INVOICE"
                        Style="{StaticResource CashierOperationalPrimaryButton}"
                        Margin="8,0,0,0"
                        Click="FindInvoiceButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CashierOperationalInformationPanel}"
                Margin="0,0,0,8">
            <TextBlock Text="{Binding InvoiceSummary}"
                       FontWeight="SemiBold"
                       FontSize="13"
                       Foreground="{StaticResource CashierTextBrush}"
                       TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="3"
                Style="{StaticResource CashierOperationalContentPanel}">
            <DataGrid ItemsSource="{Binding InvoiceLines}"
                      Style="{StaticResource CashierOperationalEditableDataGrid}"
                      IsReadOnly="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Return"
                                            Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                            Width="70"/>
                    <DataGridTextColumn Header="Description"
                                        Binding="{Binding ItemDescription}"
                                        Width="*"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CashierOperationalBoldCellText}"/>
                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding ItemType}"
                                        Width="90"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CashierOperationalCenterCellText}"/>
                    <DataGridTextColumn Header="Batch"
                                        Binding="{Binding BatchNo}"
                                        Width="100"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CashierOperationalCenterCellText}"/>
                    <DataGridTextColumn Header="Sold"
                                        Binding="{Binding SoldQuantity, StringFormat={}{0:#,##0.###}}"
                                        Width="70"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CashierOperationalCenterCellText}"/>
                    <DataGridTextColumn Header="Returned"
                                        Binding="{Binding PreviouslyReturnedQuantity, StringFormat={}{0:#,##0.###}}"
                                        Width="85"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CashierOperationalCenterCellText}"/>
                    <DataGridTextColumn Header="Remaining"
                                        Binding="{Binding RemainingQuantity, StringFormat={}{0:#,##0.###}}"
                                        Width="90"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CashierOperationalCenterCellText}"/>
                    <DataGridTemplateColumn Header="Return Qty" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CashierOperationalGridQuantityTextBox}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Refund"
                                        Binding="{Binding EstimatedRefundAmount, StringFormat=N2}"
                                        Width="110"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CashierOperationalMoneyCellText}"/>
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding ValidationMessage}"
                                        Width="190"
                                        IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4"
                Style="{StaticResource CashierOperationalDetailPanel}"
                Margin="0,8,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Reason"
                           Style="{StaticResource CashierOperationalInlineLabel}"/>
                <TextBox Grid.Column="1"
                         Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource CashierOperationalTextBox}"
                         Margin="0,0,14,0"/>

                <TextBlock Grid.Column="2"
                           Text="Authorized By"
                           Style="{StaticResource CashierOperationalInlineLabel}"/>
                <TextBox Grid.Column="3"
                             Text="{Binding AuthorizedBy, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CashierOperationalTextBox}"
                             IsReadOnly="True"
                             Background="#F3F4F6"
                             Foreground="{StaticResource CashierTextBrush}"
                             AutomationProperties.Name="Authorized by"/>
            </Grid>
        </Border>

        <Border Grid.Row="5"
                Style="{StaticResource CashierOperationalFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="CANCEL"
                        IsCancel="True"
                        Style="{StaticResource CashierOperationalSecondaryButton}"
                        Click="CancelButton_Click"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="CASH REFUND:"
                               Style="{StaticResource CashierOperationalInlineLabel}"/>
                    <TextBlock Text="LKR"
                               Foreground="{StaticResource CashierMoneyTextBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="8,0,5,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalRefundAmount, StringFormat=N2}"
                               Foreground="{StaticResource CashierMoneyTextBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="COMPLETE RETURN &amp; CREDIT NOTE"
                        IsDefault="True"
                        Style="{StaticResource CashierOperationalSuccessButton}"
                        MinWidth="280"
                        Click="CompleteReturnButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
