<Window x:Class="POS.Cashier.UI.Dialogs.ReturnInvoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer Return and Credit Note"
        Style="{StaticResource CashierDialogWindow}"
        Height="720"
        Width="1120"
        MinHeight="520"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource CashierButton}">
            <Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="82"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBgBrush}">
            <TextBlock Text="CUSTOMER RETURN &amp; CREDIT NOTE"
                       Foreground="White"
                       FontSize="19"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource InfoPanelBgBrush}"
                Padding="14"
                BorderBrush="{StaticResource HeaderBgBrush}"
                BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="165"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InvoiceSearchTextBox"
                         Text="{Binding InvoiceSearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="22"
                         FontWeight="Bold"
                         Padding="10"
                         Background="#F8FAFC"
                         BorderBrush="{StaticResource ControlBorderBrush}"
                         BorderThickness="2"
                         KeyDown="InvoiceSearchTextBox_KeyDown"/>

                <Button Grid.Column="1"
                        Content="FIND INVOICE"
                        Background="{StaticResource ActionBtnBrush}"
                        Margin="10,0,0,0"
                        Click="FindInvoiceButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#E2E8F0" Padding="12,8">
            <TextBlock Text="{Binding InvoiceSummary}"
                       FontWeight="Bold"
                       FontSize="14"
                       Foreground="#1E293B"
                       TextWrapping="Wrap"/>
        </Border>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding InvoiceLines}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  Background="White"
                  RowHeight="54"
                  FontSize="14"
                  BorderThickness="0"
                  SelectionMode="Single"
                  AlternatingRowBackground="#F8FAFC"
                  Margin="12">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource HeaderBgBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="8"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Return"
                                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                        Width="70"/>
                <DataGridTextColumn Header="Description"
                                    Binding="{Binding ItemDescription}"
                                    Width="*"
                                    IsReadOnly="True"/>
                <DataGridTextColumn Header="Type"
                                    Binding="{Binding ItemType}"
                                    Width="90"
                                    IsReadOnly="True"/>
                <DataGridTextColumn Header="Batch"
                                    Binding="{Binding BatchNo}"
                                    Width="100"
                                    IsReadOnly="True"/>
                <DataGridTextColumn Header="Sold"
                                    Binding="{Binding SoldQuantity, StringFormat=0.###}"
                                    Width="70"
                                    IsReadOnly="True"/>
                <DataGridTextColumn Header="Returned"
                                    Binding="{Binding PreviouslyReturnedQuantity, StringFormat=0.###}"
                                    Width="85"
                                    IsReadOnly="True"/>
                <DataGridTextColumn Header="Remaining"
                                    Binding="{Binding RemainingQuantity, StringFormat=0.###}"
                                    Width="90"
                                    IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Return Qty" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="17"
                                     FontWeight="Bold"
                                     TextAlignment="Center"
                                     Background="#FFF7ED"
                                     BorderThickness="0"
                                     Padding="4"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Refund"
                                    Binding="{Binding EstimatedRefundAmount, StringFormat=N2}"
                                    Width="110"
                                    IsReadOnly="True"/>
                <DataGridTextColumn Header="Status"
                                    Binding="{Binding ValidationMessage}"
                                    Width="180"
                                    IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" Background="#F8FAFC" Padding="14" BorderBrush="#CBD5E1" BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Reason"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8"
                         Margin="4,0,14,0"/>

                <TextBlock Grid.Column="2"
                           Text="Authorized By"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Column="3"
                         Text="{Binding AuthorizedBy, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8"
                         Margin="4,0,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="5" Background="{StaticResource HeaderBgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="CANCEL"
                    IsCancel="True"
                    Background="{StaticResource CancelBtnBrush}"
                    Margin="14"
                    Click="CancelButton_Click"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="CASH REFUND:"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="LKR"
                           Foreground="#FFD700"
                           FontSize="25"
                           FontWeight="Black"
                           Margin="12,0,5,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalRefundAmount, StringFormat=N2}"
                           Foreground="#FFD700"
                           FontSize="25"
                           FontWeight="Black"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="2"
                    Content="COMPLETE RETURN &amp; CREDIT NOTE"
                    IsDefault="True"
                    Background="#10B981"
                    Margin="14"
                    FontSize="16"
                    Click="CompleteReturnButton_Click"/>
        </Grid>
    </Grid>
</Window>
