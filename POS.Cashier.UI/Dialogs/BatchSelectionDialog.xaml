<Window
        x:Class="POS.Cashier.UI.Dialogs.BatchSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Exact Batch"
        Style="{StaticResource CashierOperationalWindow}"
        Width="1040"
        Height="520"
        MinWidth="880"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyboardNavigation.TabNavigation="Cycle">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierOperationalHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SELECT EXACT PHYSICAL BATCH" Style="{StaticResource CashierOperationalHeaderTitle}"/>
                    <TextBlock Text="Multiple sellable batches are available; confirm the stock being issued" Foreground="{StaticResource CashierHeaderHintBrush}" FontSize="11"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="ENTER = CONFIRM   |   ESC = CANCEL" Style="{StaticResource CashierShortcutHint}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CashierOperationalContentPanel}" Padding="10,7" Margin="0,8,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Item / Variant" Style="{StaticResource CashierFieldLabel}"/>
                    <TextBlock FontWeight="SemiBold">
                        <Run Text="{Binding ItemName, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding VariantDescription, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="SKU / Barcode" Style="{StaticResource CashierFieldLabel}"/>
                    <TextBlock><Run Text="{Binding SkuCode, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Barcode, Mode=OneWay}"/></TextBlock>
                </StackPanel>
                <Border Grid.Column="3" Background="{StaticResource CashierPanelAltBrush}" BorderBrush="{StaticResource CashierBorderBrush}" BorderThickness="1" Padding="12,5" CornerRadius="2">
                    <StackPanel>
                        <TextBlock Text="SALE MODE" FontSize="10" Foreground="{StaticResource CashierMutedTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PricingModeText}" FontWeight="Bold" Foreground="{StaticResource CashierHeaderBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CashierOperationalContentPanel}" Padding="8">
            <!-- UPDATED DATAGRID: Added IsReadOnly, SelectionMode, and PreviewMouseLeftButtonUp -->
            <DataGrid x:Name="BatchDataGrid" 
                      ItemsSource="{Binding Batches}" 
                      SelectedItem="{Binding SelectedBatch, Mode=TwoWay}" 
                      Style="{StaticResource CashierOperationalDataGrid}" 
                      PreviewMouseLeftButtonUp="BatchDataGrid_PreviewMouseLeftButtonUp"
                      IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="*" ElementStyle="{StaticResource CashierOperationalBoldCellText}"/>
                    <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDisplayText}" Width="90" ElementStyle="{StaticResource CashierOperationalCenterCellText}"/>
                    <DataGridTextColumn Header="Received" Binding="{Binding ReceivedDisplayText}" Width="90" ElementStyle="{StaticResource CashierOperationalCenterCellText}"/>
                    <DataGridTextColumn Header="Available" Binding="{Binding AvailabilityText}" Width="110" ElementStyle="{StaticResource CashierOperationalCenterCellText}"/>
                    <DataGridTextColumn Header="Retail" Binding="{Binding RetailPrice, StringFormat={}{0:N2}}" Width="105" ElementStyle="{StaticResource CashierOperationalRightCellText}"/>
                    <DataGridTextColumn Header="Wholesale" Binding="{Binding WholesalePrice, StringFormat={}{0:N2}}" Width="120" ElementStyle="{StaticResource CashierOperationalRightCellText}"/>
                    <DataGridTextColumn Header="Price Source" Binding="{Binding PriceSourceText}" Width="125" ElementStyle="{StaticResource CashierOperationalRightCellText}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CashierOperationalFooter}" Margin="0,8,0,0" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="145"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="CANCEL" Command="{Binding CancelCommand}" Style="{StaticResource CashierOperationalSecondaryButton}"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource CashierHeaderBrush}" Margin="12,0"/>
                <Button Grid.Column="2" Content="CONFIRM BATCH" Command="{Binding ConfirmCommand}" Style="{StaticResource CashierOperationalSuccessButton}"/>
            </Grid>
        </Border>
    </Grid>
</Window>