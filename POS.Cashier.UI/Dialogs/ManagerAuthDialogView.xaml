<Window x:Class="POS.Cashier.UI.Dialogs.ManagerAuthDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manager Authorization"
        Style="{StaticResource CashierDialogWindow}"
        Width="430"
        Height="390"
        MinWidth="400"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierDialogHeader}">
            <Grid>
                <TextBlock Text="MANAGER AUTHORIZATION"
                           Style="{StaticResource CashierDialogTitle}"/>
                <TextBlock Text="ENTER confirms · ESC cancels"
                           Style="{StaticResource CashierShortcutHint}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource CashierPanel}"
                Margin="16">
            <StackPanel>
                <TextBlock Text="This action requires manager or administrator credentials."
                           Style="{StaticResource CashierMutedText}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,18"/>

                <TextBlock Text="Username" Style="{StaticResource CashierFieldLabel}"/>
                <TextBox x:Name="UsernameBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource CashierTextBox}"
                         Margin="0,6,0,14"
                         MaxLength="100"/>

                <TextBlock Text="Password" Style="{StaticResource CashierFieldLabel}"/>
                <PasswordBox x:Name="PwdBox"
                             Style="{StaticResource CashierPasswordBox}"
                             Margin="0,6,0,14"
                             MaxLength="256"/>

                <Border Style="{StaticResource CashierStatusPanel}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource CashierValidationText}"
                               MinHeight="18"
                               TextAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CashierDialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL"
                        Style="{StaticResource CashierButton}"
                        IsCancel="True"
                        Margin="0,0,10,0"
                        Click="CancelBtn_Click"/>
                <Button Content="AUTHORIZE"
                        Style="{StaticResource CashierPrimaryButton}"
                        MinWidth="130"
                        IsDefault="True"
                        Command="{Binding AuthenticateCommand}"
                        CommandParameter="{Binding ElementName=PwdBox}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
