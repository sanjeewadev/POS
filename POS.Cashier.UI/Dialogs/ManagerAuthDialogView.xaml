<Window x:Class="POS.Cashier.UI.Dialogs.ManagerAuthDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manager Authorization"
        Style="{StaticResource CashierDialogWindow}"
        Width="470"
        Height="490"
        MinWidth="430"
        MinHeight="485"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="66"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierTransactionDialogHeader}" Margin="10,10,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CashierTransactionHeaderIcon}">
                    <TextBlock Text="M" Foreground="White" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="MANAGER AUTH" Style="{StaticResource CashierDialogTitle}"/>
                    <TextBlock Text="is required"
                               Style="{StaticResource CashierTransactionHeaderSubtitle}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="ESC = CANCEL"
                           Style="{StaticResource CashierShortcutHint}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CashierTransactionContentPanel}" Margin="10">
            <StackPanel>
                <Border Style="{StaticResource CashierTransactionSectionPanel}" Margin="0,0,0,10">
                    <TextBlock Text="Enter the approving user's credentials. The password is cleared immediately after validation."
                               Style="{StaticResource CashierTransactionFooterHint}"/>
                </Border>

                <TextBlock Text="USERNAME" Style="{StaticResource CashierTransactionFieldLabel}"/>
                <TextBox x:Name="UsernameBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource CashierTransactionInputTextBox}"
                         Margin="0,6,0,10" MaxLength="100"/>

                <TextBlock Text="PASSWORD" Style="{StaticResource CashierTransactionFieldLabel}"/>
                <PasswordBox x:Name="PwdBox"
                             Style="{StaticResource CashierTransactionPasswordBox}"
                             Margin="0,6,0,10" MaxLength="256"/>

                <Border Style="{StaticResource CashierTransactionSectionPanel}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource CashierValidationText}"
                               MinHeight="18" TextAlignment="Center" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CashierDialogFooter}" Margin="10,0,10,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL" IsCancel="True" Click="CancelBtn_Click"
                        Style="{StaticResource CashierTransactionCancelButton}" Margin="0,0,10,0"/>
                <Button Content="AUTHORIZE" IsDefault="True"
                        Command="{Binding AuthenticateCommand}"
                        CommandParameter="{Binding ElementName=PwdBox}"
                        Style="{StaticResource CashierTransactionPrimaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
