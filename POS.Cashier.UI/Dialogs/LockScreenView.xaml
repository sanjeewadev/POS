<Window x:Class="POS.Cashier.UI.Dialogs.LockScreenView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terminal Locked"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#0F172A"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Border Width="560"
                MaxHeight="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                BorderBrush="#0F3D5E"
                BorderThickness="2"
                Padding="28">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            HorizontalAlignment="Center">
                    <TextBlock Text="TERMINAL LOCKED"
                               Foreground="#0F3D5E"
                               FontSize="30"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="The current sale and shift remain open."
                               Foreground="#64748B"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <Border Grid.Row="2"
                        Background="#F1F5F9"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Current User"
                                   Foreground="#475569"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="UsernameText"
                                   Grid.Column="1"
                                   Foreground="#111827"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2"
                                   Text="Terminal / Shift"
                                   Foreground="#475569"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="ShiftContextText"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   Foreground="#111827"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Grid.Row="4"
                        Background="#FFF7ED"
                        BorderBrush="#FDBA74"
                        BorderThickness="1"
                        Padding="12">
                    <TextBlock x:Name="ReasonText"
                               Foreground="#9A3412"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </Border>

                <StackPanel Grid.Row="6">
                    <TextBlock Text="Password"
                               Foreground="#334155"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <PasswordBox x:Name="PasswordInput"
                                 Height="42"
                                 FontSize="18"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#94A3B8"
                                 BorderThickness="1"
                                 PasswordChar="●"/>

                    <TextBlock x:Name="ErrorText"
                               Foreground="#B91C1C"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               MinHeight="22"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <Button x:Name="UnlockButton"
                        Grid.Row="8"
                        Content="UNLOCK TERMINAL"
                        Height="44"
                        Click="UnlockButton_Click"
                        Background="#0F766E"
                        BorderBrush="#0F766E"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="Bold"
                        Cursor="Hand"/>

                <Button x:Name="ManagerRecoveryButton"
                        Grid.Row="10"
                        Content="MANAGER RECOVERY"
                        Height="42"
                        Click="ManagerRecoveryButton_Click"
                        Background="#1E3A8A"
                        BorderBrush="#1E3A8A"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
