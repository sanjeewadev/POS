<Window x:Class="POS.Cashier.UI.Dialogs.GiftVoucherTenderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gift Voucher Payment"
        Style="{StaticResource CashierDialogWindow}"
        Width="900"
        Height="630"
        MinWidth="820"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyboardNavigation.TabNavigation="Cycle"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CashierTransactionDialogHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CashierTransactionHeaderIcon}">
                    <TextBlock Text="GV"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="GIFT VOUCHER PAYMENT"
                               Style="{StaticResource CashierDialogTitle}"
                               FontSize="22"/>
                    <TextBlock Text="Scan or type the voucher barcode, verify it, then confirm the payment."
                               Style="{StaticResource CashierTransactionHeaderSubtitle}"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="ENTER = VERIFY / CONFIRM   |   ESC = CANCEL"
                           Style="{StaticResource CashierShortcutHint}"
                           Foreground="White"
                           FontWeight="Bold"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Margin="0,10,0,10"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      Focusable="False">
            <Border Style="{StaticResource CashierPanel}"
                    CornerRadius="3"
                    Padding="10"
                    Margin="0,0,8,0">
                <Grid MinHeight="390">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource CashierTransactionStatusBanner}"
                            Background="{Binding StatusColorHex}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="26"
                                    Height="26"
                                    CornerRadius="13"
                                    BorderBrush="White"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CashierTransactionStatusSymbol}"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding StatusText}"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="BALANCE DUE"
                                   Style="{StaticResource CashierTransactionFieldLabel}"/>
                        <Border Grid.Column="1"
                                Style="{StaticResource CashierTransactionReadOnlyPanel}"
                                Background="{StaticResource CashierTransactionDueBrush}"
                                BorderBrush="{StaticResource CashierTransactionDueBorderBrush}">
                            <TextBlock Text="{Binding BalanceDue, StringFormat={}{0:N2}}"
                                       Style="{StaticResource CashierTransactionReadOnlyValue}"
                                       Foreground="{StaticResource CashierTransactionBalanceTextBrush}"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="VOUCHER BARCODE"
                                   Style="{StaticResource CashierTransactionFieldLabel}"/>
                        <TextBox x:Name="BarcodeTextBox"
                                 Grid.Column="1"
                                 Text="{Binding VoucherBarcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CashierTransactionInputTextBox}"
                                 FontSize="15"
                                 TabIndex="0"
                                 AutomationProperties.Name="Gift voucher barcode"/>
                        <Button Grid.Column="2"
                                Content="VERIFY"
                                Command="{Binding SearchVoucherCommand}"
                                Style="{StaticResource CashierTransactionPrimaryButton}"
                                Margin="8,0,0,0"
                                TabIndex="1"
                                AutomationProperties.Name="Verify gift voucher"/>
                    </Grid>

                    <Border Grid.Row="3"
                            Margin="0,10,0,0"
                            Style="{StaticResource CashierStatusPanel}"
                            Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,0,14,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="VOUCHER DETAILS"
                                           Style="{StaticResource CashierSectionTitle}"/>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Voucher no."
                                               Style="{StaticResource CashierTransactionDetailLabel}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding VoucherNo}"
                                               Style="{StaticResource CashierTransactionDetailValue}"/>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Status"
                                               Style="{StaticResource CashierTransactionDetailLabel}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding VoucherStatus}"
                                               Style="{StaticResource CashierTransactionDetailValue}"/>
                                </Grid>

                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Expiry"
                                               Style="{StaticResource CashierTransactionDetailLabel}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}"
                                               Style="{StaticResource CashierTransactionDetailValue}"/>
                                </Grid>

                                <Border Grid.Row="4"
                                        Margin="0,8,0,0"
                                        Background="{StaticResource CashierTransactionDueBrush}"
                                        BorderBrush="{StaticResource CashierWarningBrush}"
                                        BorderThickness="1"
                                        Padding="10">
                                    <TextBlock Text="One-time rule: a completed redemption marks this voucher as Redeemed and it cannot be used again."
                                               Foreground="{StaticResource CashierTransactionHelpTextBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </Grid>

                            <Border Grid.Column="1"
                                    Background="{StaticResource CashierBorderBrush}"/>

                            <StackPanel Grid.Column="2"
                                        Margin="14,0,0,0">
                                <TextBlock Text="VOUCHER VALUE"
                                           Style="{StaticResource CashierTransactionFieldLabel}"
                                           HorizontalAlignment="Center"/>
                                <Border Style="{StaticResource CashierTransactionReadOnlyPanel}"
                                        Background="{StaticResource CashierTransactionAppliedBrush}"
                                        BorderBrush="{StaticResource CashierTransactionAppliedBorderBrush}"
                                        Margin="0,4,0,10">
                                    <TextBlock Text="{Binding VoucherAmount, StringFormat={}{0:N2}}"
                                               Style="{StaticResource CashierTransactionReadOnlyValue}"
                                               Foreground="{StaticResource CashierTransactionAppliedTextBrush}"/>
                                </Border>

                                <TextBlock Text="AMOUNT TO APPLY"
                                           Style="{StaticResource CashierTransactionFieldLabel}"
                                           HorizontalAlignment="Center"/>
                                <Border Style="{StaticResource CashierTransactionReadOnlyPanel}"
                                        Background="{StaticResource CashierTransactionBalanceBrush}"
                                        BorderBrush="{StaticResource CashierTransactionBalanceBorderBrush}"
                                        Margin="0,4,0,10">
                                    <TextBlock Text="{Binding AmountToApply, StringFormat={}{0:N2}}"
                                               Style="{StaticResource CashierTransactionReadOnlyValue}"
                                               Foreground="{StaticResource CashierTransactionBalanceTextBrush}"/>
                                </Border>

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RequiresManagerApproval}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsManagerApproved}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="FORFEITED VALUE"
                                               Style="{StaticResource CashierTransactionFieldLabel}"
                                               HorizontalAlignment="Center"/>
                                    <Border Style="{StaticResource CashierTransactionReadOnlyPanel}"
                                            Background="{StaticResource CashierTransactionDueBrush}"
                                            BorderBrush="{StaticResource CashierDangerBrush}"
                                            Margin="0,4,0,0">
                                        <TextBlock Text="{Binding ForfeitedAmount, StringFormat={}{0:N2}}"
                                                   Style="{StaticResource CashierTransactionReadOnlyValue}"
                                                   Foreground="{StaticResource CashierDangerBrush}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2"
                Style="{StaticResource CashierDialogFooter}"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="BARCODE / KEYBOARD"
                               Foreground="{StaticResource CashierTransactionHelpBrush}"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="Enter verifies, then confirms."
                               Style="{StaticResource CashierMutedText}"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="MANAGER APPROVE"
                        Command="{Binding RequestManagerApprovalCommand}"
                        Margin="0,0,8,0"
                        TabIndex="2"
                        AutomationProperties.Name="Approve gift voucher forfeiture">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource CashierTransactionProtectedButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RequiresManagerApproval}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="2"
                        Content="CLEAR"
                        Command="{Binding ClearCommand}"
                        Style="{StaticResource CashierTransactionSecondaryButton}"
                        Margin="0,0,8,0"
                        TabIndex="3"
                        AutomationProperties.Name="Clear gift voucher"/>

                <Button Grid.Column="3"
                        Content="CANCEL"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource CashierTransactionCancelButton}"
                        Margin="0,0,8,0"
                        TabIndex="4"
                        IsCancel="True"
                        AutomationProperties.Name="Cancel gift voucher payment"/>

                <Button Grid.Column="4"
                        Content="CONFIRM VOUCHER"
                        Command="{Binding ConfirmCommand}"
                        Style="{StaticResource CashierTransactionConfirmButton}"
                        TabIndex="5"
                        IsDefault="True"
                        IsEnabled="{Binding CanConfirm}"
                        AutomationProperties.Name="Confirm gift voucher payment"/>
            </Grid>
        </Border>
    </Grid>
</Window>