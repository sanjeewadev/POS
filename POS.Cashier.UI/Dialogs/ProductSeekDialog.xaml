<Window x:Class="POS.Cashier.UI.Dialogs.ProductSeekDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product Search"
        Style="{StaticResource CashierOperationalWindow}"
        Width="1240"
        Height="720"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyboardNavigation.TabNavigation="Cycle">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierOperationalHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="PRODUCT SEARCH" Style="{StaticResource CashierOperationalHeaderTitle}"/>
                    <TextBlock Text="Find by name, code, SKU, or barcode" Foreground="{StaticResource CashierHeaderHintBrush}" FontSize="11"/>
                </StackPanel>
                <!-- Add this CheckBox to your ProductSeekDialog.xaml -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox
                    Content="Show available stock only"
                    IsChecked="{Binding ShowAvailableOnly}"
                    VerticalAlignment="Center"
                    Margin="10,0,0,0"
                    ToolTip="When checked, hides items with zero or negative stock."/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MODE: " Style="{StaticResource CashierShortcutHint}"/>
                    <TextBlock Text="{Binding PricingModeText}" Foreground="{StaticResource CashierHeaderHintBrush}" FontWeight="Bold" Margin="0,0,24,0"/>
                    <TextBlock Text="ENTER = CONFIRM   |   ESC = CLOSE" Style="{StaticResource CashierShortcutHint}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource CashierOperationalSearchPanel}" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Search" Style="{StaticResource CashierFieldLabel}" Margin="0,0,10,0"/>
                    <TextBox x:Name="SearchTxt" Grid.Column="1" Text="{Binding SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CashierOperationalSearchTextBox}" ToolTip="Item name, item code, SKU, item barcode or GRN barcode"/>
                    <TextBlock Grid.Column="2" Text="Category" Style="{StaticResource CashierFieldLabel}" Margin="12,0,10,0"/>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Style="{StaticResource CashierOperationalComboBox}" SelectionChanged="CategoryComboBox_SelectionChanged"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource CashierOperationalContentPanel}" Padding="8" Margin="0,8,0,0">
                <DataGrid x:Name="ResultsDataGrid" 
                          ItemsSource="{Binding SearchResults}" 
                          SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" 
                          Style="{StaticResource CashierOperationalDataGrid}" 
                          PreviewMouseLeftButtonUp="ResultsDataGrid_PreviewMouseLeftButtonUp"
                          IsReadOnly="True"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode}" Width="130" ElementStyle="{StaticResource CashierOperationalBoldCellText}"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding ItemName}" Width="3*" ElementStyle="{StaticResource CashierOperationalLeftCellText}"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="140" ElementStyle="{StaticResource CashierOperationalLeftCellText}"/>
                        <DataGridTextColumn Header="Expiry" Binding="{Binding EarliestExpiryDateDisplayText}" Width="100" ElementStyle="{StaticResource CashierOperationalCenterCellText}"/>
                        <DataGridTextColumn Header="Retail" Binding="{Binding RetailPrice, StringFormat={}{0:N2}}" Width="90" ElementStyle="{StaticResource CashierOperationalRightCellText}"/>
                        <DataGridTextColumn Header="Wholesale" Binding="{Binding WholesalePrice, StringFormat={}{0:N2}}" Width="95" ElementStyle="{StaticResource CashierOperationalRightCellText}"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding StockOnHand}" Width="80" ElementStyle="{StaticResource CashierOperationalCenterCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CashierOperationalFooter}" Margin="0,8,0,0" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="145"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="CLOSE" Command="{Binding CloseCommand}" Style="{StaticResource CashierOperationalSecondaryButton}"/>
                <Button Grid.Column="1" Content="CLEAR" Command="{Binding ClearCommand}" Style="{StaticResource CashierOperationalSecondaryButton}" Margin="6,0,0,0"/>
                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusColorHex}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="12,0"/>
                <Button Grid.Column="3" Content="CONFIRM" Command="{Binding ConfirmSelectionCommand}" Style="{StaticResource CashierOperationalSuccessButton}"/>
            </Grid>
        </Border>
    </Grid>
</Window>