<Window x:Class="POS.Cashier.UI.Dialogs.ProductSeekDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product Look-Up"
        Height="790"
        Width="1080"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#ECE9D8"
        FontFamily="Segoe UI, Tahoma"
        FontSize="12"
        WindowStyle="None"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#828790"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#D0D0D0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#D0D0D0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#D4D0C8"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="BorderBrush" Value="#828790"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0A246A"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="RightText">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="CenterText">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="BoldText">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="Button" x:Key="ClassicBtn">
            <Setter Property="Background" Value="#D4D0C8"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style TargetType="Border" x:Key="PanelBorder">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#828790"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#0A246A"
            BorderThickness="2">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="190"/>
                <RowDefinition Height="210"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="#0A246A"
                    Padding="9">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="PRICE LOOK-UP / ITEM SEEK"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="Tap row / Enter = Add | Esc = Close"
                               Foreground="#DEFF9A"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- SEARCH BAR -->
            <Border Grid.Row="1"
                    Background="#ECE9D8"
                    Padding="10"
                    BorderBrush="#828790"
                    BorderThickness="0,0,0,1">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Search Item / SKU / Item Barcode / GRN Barcode:"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Margin="0,0,10,0"/>

                    <TextBox x:Name="SearchTxt"
                             Grid.Column="1"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Padding="6,0"
                             BorderBrush="#828790"
                             Background="White"/>

                    <Button Grid.Column="2"
                            Content="SEARCH"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource ClassicBtn}"
                            Margin="10,0,0,0"
                            Height="30"/>
                </Grid>
            </Border>

            <!-- PARENT ITEMS -->
            <Border Grid.Row="2"
                    Style="{StaticResource PanelBorder}"
                    Margin="10,10,10,5">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="1. Select Master Item"
                               FontWeight="Bold"
                               Foreground="#003366"
                               Margin="0,0,0,6"/>

                    <DataGrid x:Name="ParentDataGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding ParentResults}"
                              SelectedItem="{Binding SelectedParent, Mode=TwoWay}"
                              PreviewMouseLeftButtonUp="ParentDataGrid_PreviewMouseLeftButtonUp"
                              TouchUp="ParentDataGrid_TouchUp">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item Code"
                                                Binding="{Binding ItemCode}"
                                                Width="120"
                                                ElementStyle="{StaticResource BoldText}"/>

                            <DataGridTextColumn Header="Master Item Name"
                                                Binding="{Binding ItemName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Category"
                                                Binding="{Binding CategoryName}"
                                                Width="170"/>

                            <DataGridTextColumn Header="Tracking"
                                                Binding="{Binding TrackingText}"
                                                Width="125"
                                                ElementStyle="{StaticResource CenterText}"/>

                            <DataGridTextColumn Header="Variants"
                                                Binding="{Binding ActiveVariantsCount}"
                                                Width="80"
                                                ElementStyle="{StaticResource CenterText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- VARIANTS -->
            <Border Grid.Row="3"
                    Style="{StaticResource PanelBorder}"
                    Margin="10,5,10,5">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="2. Select Variant"
                                   FontWeight="Bold"
                                   Foreground="#003366"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="Average-cost item: tap variant to add. Batch item: tap variant, then tap GRN batch below."
                                   Foreground="#555555"
                                   FontStyle="Italic"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <DataGrid x:Name="VariantDataGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding VariantResults}"
                              SelectedItem="{Binding SelectedVariant, Mode=TwoWay}"
                              PreviewMouseLeftButtonUp="VariantDataGrid_PreviewMouseLeftButtonUp"
                              TouchUp="VariantDataGrid_TouchUp">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU"
                                                Binding="{Binding SkuCode}"
                                                Width="145"
                                                ElementStyle="{StaticResource BoldText}"/>

                            <DataGridTextColumn Header="Item Barcode"
                                                Binding="{Binding Barcode}"
                                                Width="150"/>

                            <DataGridTextColumn Header="Variant"
                                                Binding="{Binding VariantDescription}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Tracking"
                                                Binding="{Binding TrackingText}"
                                                Width="125"
                                                ElementStyle="{StaticResource CenterText}"/>

                            <DataGridTextColumn Header="Retail"
                                                Binding="{Binding RetailPrice, StringFormat={}{0:N2}}"
                                                Width="100"
                                                ElementStyle="{StaticResource RightText}"/>

                            <DataGridTextColumn Header="Stock"
                                                Binding="{Binding StockOnHand, StringFormat={}{0:0.###}}"
                                                Width="90"
                                                ElementStyle="{StaticResource CenterText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- GRN BATCHES -->
            <Border Grid.Row="4"
                    Style="{StaticResource PanelBorder}"
                    Margin="10,5,10,10">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="3. Available GRN Batches"
                                   FontWeight="Bold"
                                   Foreground="#003366"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="Tap exact batch to add"
                                   Foreground="#555555"
                                   FontStyle="Italic"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <DataGrid x:Name="BatchDataGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding BatchResults}"
                              SelectedItem="{Binding SelectedBatch, Mode=TwoWay}"
                              PreviewMouseLeftButtonUp="BatchDataGrid_PreviewMouseLeftButtonUp"
                              TouchUp="BatchDataGrid_TouchUp">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GRN Barcode"
                                                Binding="{Binding BarcodeDisplayText}"
                                                Width="150"
                                                ElementStyle="{StaticResource BoldText}"/>

                            <DataGridTextColumn Header="Batch No"
                                                Binding="{Binding BatchDisplayText}"
                                                Width="130"/>

                            <DataGridTextColumn Header="Expiry"
                                                Binding="{Binding ExpiryDisplayText}"
                                                Width="100"
                                                ElementStyle="{StaticResource CenterText}"/>

                            <DataGridTextColumn Header="Available"
                                                Binding="{Binding AvailableQty, StringFormat={}{0:0.###}}"
                                                Width="95"
                                                ElementStyle="{StaticResource CenterText}"/>

                            <DataGridTextColumn Header="Cost"
                                                Binding="{Binding CostPrice, StringFormat={}{0:N2}}"
                                                Width="85"
                                                ElementStyle="{StaticResource RightText}"/>

                            <DataGridTextColumn Header="Retail"
                                                Binding="{Binding RetailPrice, StringFormat={}{0:N2}}"
                                                Width="85"
                                                ElementStyle="{StaticResource RightText}"/>

                            <DataGridTextColumn Header="Wholesale"
                                                Binding="{Binding WholesalePrice, StringFormat={}{0:N2}}"
                                                Width="90"
                                                ElementStyle="{StaticResource RightText}"/>

                            <DataGridTextColumn Header="Received"
                                                Binding="{Binding ReceivedDate, StringFormat={}{0:yyyy-MM-dd}}"
                                                Width="105"
                                                ElementStyle="{StaticResource CenterText}"/>

                            <DataGridTextColumn Header="Warning"
                                                Binding="{Binding WarningText}"
                                                Width="*"
                                                ElementStyle="{StaticResource BoldText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- FOOTER -->
            <Border Grid.Row="5"
                    Background="#D4D0C8"
                    BorderBrush="#828790"
                    BorderThickness="0,1,0,0"
                    Padding="10">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="CLOSE"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource ClassicBtn}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusText}"
                               Foreground="{Binding StatusColorHex}"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="15,0"/>

                    <TextBlock Grid.Column="2"
                               Text="No confirm popup"
                               Foreground="#003366"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>