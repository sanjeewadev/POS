<Window x:Class="POS.Cashier.UI.Dialogs.ProductSeekDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item Search"
        Style="{StaticResource CashierDialogWindow}"
        Width="1180"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="SeekRightText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="SeekCenterText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SeekBoldText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Style="{StaticResource CashierDialogHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="ITEM SEARCH / PRICE LOOK-UP"
                               Style="{StaticResource CashierDialogTitle}"/>
                    <TextBlock Text="Find by item name, item code, SKU, item barcode or GRN barcode"
                               Foreground="{StaticResource CashierHeaderHintBrush}"
                               FontSize="11"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="ENTER = SEARCH / ADD   |   ESC = CLOSE"
                           Style="{StaticResource CashierShortcutHint}"/>
            </Grid>
        </Border>

        <!-- SEARCH TOOLBAR -->
        <Border Grid.Row="1"
                Style="{StaticResource CashierPanel}"
                Padding="10,8"
                Margin="0,8,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="112"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Search"
                           Style="{StaticResource CashierFieldLabel}"
                           Margin="0,0,10,0"/>

                <TextBox x:Name="SearchTxt"
                         Grid.Column="1"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource CashierTextBox}"
                         ToolTip="Item name, item code, SKU, item barcode or GRN barcode"/>

                <Button Grid.Column="2"
                        Content="SEARCH"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource CashierPrimaryButton}"
                        Margin="8,0,0,0"
                        Height="34"/>
            </Grid>
        </Border>

        <!-- SEARCH RESULTS -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.05*" MinHeight="190"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="0.95*" MinHeight="170"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*" MinWidth="300"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="1.35*" MinWidth="430"/>
                </Grid.ColumnDefinitions>

                <!-- MASTER ITEMS -->
                <Border Grid.Column="0"
                        Style="{StaticResource CashierPanel}"
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="1. Master Items"
                                       Style="{StaticResource CashierSectionTitle}"/>

                            <TextBlock Grid.Column="1"
                                       Text="Select an item"
                                       Style="{StaticResource CashierMutedText}"/>
                        </Grid>

                        <DataGrid x:Name="ParentDataGrid"
                                  Grid.Row="1"
                                  ItemsSource="{Binding ParentResults}"
                                  SelectedItem="{Binding SelectedParent, Mode=TwoWay}"
                                  Style="{StaticResource CashierDataGrid}"
                                  PreviewMouseLeftButtonUp="ParentDataGrid_PreviewMouseLeftButtonUp"
                                  TouchUp="ParentDataGrid_TouchUp">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item Code"
                                                    Binding="{Binding ItemCode}"
                                                    Width="95"
                                                    ElementStyle="{StaticResource SeekBoldText}"/>
                                <DataGridTextColumn Header="Master Item"
                                                    Binding="{Binding ItemName}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Tracking"
                                                    Binding="{Binding TrackingText}"
                                                    Width="110"
                                                    ElementStyle="{StaticResource SeekCenterText}"/>
                                <DataGridTextColumn Header="Sellable"
                                                    Binding="{Binding ActiveVariantsCount}"
                                                    Width="68"
                                                    ElementStyle="{StaticResource SeekCenterText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{StaticResource CashierBorderBrush}"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"/>

                <!-- SELLABLE VARIANTS -->
                <Border Grid.Column="2"
                        Style="{StaticResource CashierPanel}"
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="2. Sellable Variants"
                                       Style="{StaticResource CashierSectionTitle}"/>

                            <TextBlock Grid.Column="1"
                                       Text="Zero-stock variants are hidden"
                                       Style="{StaticResource CashierMutedText}"
                                       FontStyle="Italic"/>
                        </Grid>

                        <DataGrid x:Name="VariantDataGrid"
                                  Grid.Row="1"
                                  ItemsSource="{Binding VariantResults}"
                                  SelectedItem="{Binding SelectedVariant, Mode=TwoWay}"
                                  Style="{StaticResource CashierDataGrid}"
                                  PreviewMouseLeftButtonUp="VariantDataGrid_PreviewMouseLeftButtonUp"
                                  TouchUp="VariantDataGrid_TouchUp">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SKU"
                                                    Binding="{Binding SkuCode}"
                                                    Width="135"
                                                    ElementStyle="{StaticResource SeekBoldText}"/>
                                <DataGridTextColumn Header="Item Barcode"
                                                    Binding="{Binding Barcode}"
                                                    Width="145"/>
                                <DataGridTextColumn Header="Variant"
                                                    Binding="{Binding VariantDescription}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Tracking"
                                                    Binding="{Binding TrackingText}"
                                                    Width="110"
                                                    ElementStyle="{StaticResource SeekCenterText}"/>
                                <DataGridTextColumn Header="Retail"
                                                    Binding="{Binding RetailPrice, StringFormat={}{0:N2}}"
                                                    Width="90"
                                                    ElementStyle="{StaticResource SeekRightText}"/>
                                <DataGridTextColumn Header="Stock"
                                                    Binding="{Binding StockOnHand, StringFormat={}{0:0.###}}"
                                                    Width="78"
                                                    ElementStyle="{StaticResource SeekCenterText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="1"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource CashierBorderBrush}"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- GRN BATCHES -->
            <Border Grid.Row="2"
                    Style="{StaticResource CashierPanel}"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="3. Available GRN Batches"
                                   Style="{StaticResource CashierSectionTitle}"/>

                        <TextBlock Grid.Column="1"
                                   Text="Required only for batch-tracked items; expired and zero-stock batches are hidden"
                                   Style="{StaticResource CashierMutedText}"
                                   FontStyle="Italic"/>
                    </Grid>

                    <DataGrid x:Name="BatchDataGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding BatchResults}"
                              SelectedItem="{Binding SelectedBatch, Mode=TwoWay}"
                              Style="{StaticResource CashierDataGrid}"
                              PreviewMouseLeftButtonUp="BatchDataGrid_PreviewMouseLeftButtonUp"
                              TouchUp="BatchDataGrid_TouchUp">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GRN Barcode"
                                                Binding="{Binding BarcodeDisplayText}"
                                                Width="150"
                                                ElementStyle="{StaticResource SeekBoldText}"/>
                            <DataGridTextColumn Header="Batch No"
                                                Binding="{Binding BatchDisplayText}"
                                                Width="145"/>
                            <DataGridTextColumn Header="Expiry"
                                                Binding="{Binding ExpiryDisplayText}"
                                                Width="100"
                                                ElementStyle="{StaticResource SeekCenterText}"/>
                            <DataGridTextColumn Header="Available"
                                                Binding="{Binding AvailableQty, StringFormat={}{0:0.###}}"
                                                Width="92"
                                                ElementStyle="{StaticResource SeekCenterText}"/>
                            <DataGridTextColumn Header="Cost"
                                                Binding="{Binding CostPrice, StringFormat={}{0:N2}}"
                                                Width="88"
                                                ElementStyle="{StaticResource SeekRightText}"/>
                            <DataGridTextColumn Header="Retail"
                                                Binding="{Binding RetailPrice, StringFormat={}{0:N2}}"
                                                Width="88"
                                                ElementStyle="{StaticResource SeekRightText}"/>
                            <DataGridTextColumn Header="Wholesale"
                                                Binding="{Binding WholesalePrice, StringFormat={}{0:N2}}"
                                                Width="96"
                                                ElementStyle="{StaticResource SeekRightText}"/>
                            <DataGridTextColumn Header="Received"
                                                Binding="{Binding ReceivedDate, StringFormat={}{0:yyyy-MM-dd}}"
                                                Width="105"
                                                ElementStyle="{StaticResource SeekCenterText}"/>
                            <DataGridTextColumn Header="Warning"
                                                Binding="{Binding WarningText}"
                                                Width="*"
                                                ElementStyle="{StaticResource SeekBoldText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="3"
                Style="{StaticResource CashierDialogFooter}"
                Margin="0,8,0,0"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="CLOSE"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource CashierButton}"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           Foreground="{Binding StatusColorHex}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="12,0"/>

                <Button Grid.Column="2"
                        Content="ADD ITEM"
                        Command="{Binding AddToCartCommand}"
                        IsEnabled="{Binding CanAddVariant}"
                        Style="{StaticResource CashierPrimaryButton}"
                        Margin="0,0,6,0"/>

                <Button Grid.Column="3"
                        Content="ADD BATCH"
                        Command="{Binding AddSelectedBatchToCartCommand}"
                        IsEnabled="{Binding CanAddBatch}"
                        Style="{StaticResource CashierSuccessButton}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
