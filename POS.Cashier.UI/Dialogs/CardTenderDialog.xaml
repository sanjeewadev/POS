<Window x:Class="POS.Cashier.UI.Dialogs.CardTenderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:POS.Cashier.UI.Components"
        Title="Card Payment"
        Style="{StaticResource CashierDialogWindow}"
        Width="900"
        Height="620"
        MinWidth="820"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyboardNavigation.TabNavigation="Cycle"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CashierTransactionDialogHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CashierTransactionHeaderIcon}">
                    <TextBlock Text="CARD"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding CardTitle}"
                               Style="{StaticResource CashierDialogTitle}"
                               FontSize="22"/>
                    <TextBlock Text="Apply a card payment to the current sale"
                               Style="{StaticResource CashierTransactionHeaderSubtitle}"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="ENTER = NEXT / CONFIRM   |   ESC = CANCEL"
                           Style="{StaticResource CashierShortcutHint}"
                           Foreground="White"
                           FontWeight="Bold"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Margin="0,10,0,10"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      Focusable="False">
            <Grid MinHeight="390">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CashierPanel}"
                        CornerRadius="3"
                        Padding="14"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="58"/>
                            <RowDefinition Height="58"/>
                            <RowDefinition Height="58"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Style="{StaticResource CashierTransactionStatusBanner}"
                                Background="{Binding StatusColorHex}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="26"
                                        Height="26"
                                        CornerRadius="13"
                                        BorderBrush="White"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CashierTransactionStatusSymbol}"/>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding StatusText}"
                                           Foreground="White"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CARD TYPE"
                                       Style="{StaticResource CashierTransactionFieldLabel}"/>
                            <Border Grid.Column="1"
                                    Style="{StaticResource CashierTransactionReadOnlyPanel}"
                                    Background="{StaticResource CashierTransactionNumpadDisplayBrush}"
                                    BorderBrush="{StaticResource CashierTransactionNumpadDisplayBorderBrush}">
                                <TextBlock Text="{Binding CardType}"
                                           Style="{StaticResource CashierTransactionReadOnlyValue}"
                                           Foreground="{StaticResource CashierTransactionNumpadDisplayValueBrush}"
                                           TextAlignment="Left"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="BALANCE DUE"
                                       Style="{StaticResource CashierTransactionFieldLabel}"/>
                            <Border Grid.Column="1"
                                    Style="{StaticResource CashierTransactionReadOnlyPanel}"
                                    Background="{StaticResource CashierTransactionDueBrush}"
                                    BorderBrush="{StaticResource CashierTransactionDueBorderBrush}">
                                <TextBlock Text="{Binding BalanceDue, StringFormat={}{0:N2}}"
                                           Style="{StaticResource CashierTransactionReadOnlyValue}"
                                           Foreground="White"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CARD AMOUNT"
                                       Style="{StaticResource CashierTransactionFieldLabel}"/>
                            <TextBox x:Name="CardAmountTextBox"
                                     Grid.Column="1"
                                     Text="{Binding CardAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CashierTransactionMoneyInputTextBox}"
                                     TextAlignment="Right"
                                     TabIndex="0"
                                     AutomationProperties.Name="Card payment amount"
                                     GotKeyboardFocus="CardAmountTextBox_GotKeyboardFocus"
                                     PreviewMouseLeftButtonDown="CardAmountTextBox_PreviewMouseLeftButtonDown"/>
                        </Grid>

                        <Grid Grid.Row="4" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LAST 6 DIGITS"
                                       Style="{StaticResource CashierTransactionFieldLabel}"/>
                            <TextBox x:Name="LastSixDigitsTextBox"
                                     Grid.Column="1"
                                     Text="{Binding LastSixDigits, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CashierTransactionInputTextBox}"
                                     TextAlignment="Center"
                                     MaxLength="6"
                                     TabIndex="1"
                                     AutomationProperties.Name="Last six card digits"
                                     GotKeyboardFocus="LastSixDigitsTextBox_GotKeyboardFocus"
                                     PreviewMouseLeftButtonDown="LastSixDigitsTextBox_PreviewMouseLeftButtonDown"/>
                        </Grid>

                        <Grid Grid.Row="5" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="REFERENCE"
                                       Style="{StaticResource CashierTransactionFieldLabel}"/>
                            <TextBox x:Name="ReferenceTextBox"
                                     Grid.Column="1"
                                     Text="{Binding ReferenceNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CashierTransactionInputTextBox}"
                                     MaxLength="30"
                                     TabIndex="2"
                                     AutomationProperties.Name="Card reference"
                                     GotKeyboardFocus="ReferenceTextBox_GotKeyboardFocus"
                                     PreviewMouseLeftButtonDown="ReferenceTextBox_PreviewMouseLeftButtonDown"/>
                        </Grid>

                        <Border Grid.Row="6"
                                Margin="0,10,0,0"
                                Style="{StaticResource CashierStatusPanel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CashierTransactionHelpIcon}">
                                    <TextBlock Text="i"
                                               Foreground="{StaticResource CashierTransactionHelpBrush}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Enter the amount, then the last 6 digits. Reference is optional. Partial card payments are supported."
                                           Foreground="{StaticResource CashierTransactionHelpTextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <components:TenderNumpadControl x:Name="TenderNumpad"
                                                Grid.Column="1"
                                                TargetText="{Binding ActiveInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                HeaderText="{Binding ActiveNumpadHeader}"
                                                TargetLabel="{Binding ActiveTargetLabel}"
                                                ModeText="{Binding ActiveModeText}"
                                                ShowDecimal="{Binding ActiveShowDecimal}"
                                                ShowDoubleZero="{Binding ActiveShowDoubleZero}"
                                                MaxLength="{Binding ActiveMaxLength}"
                                                ClearText=""
                                                SelectAllOnFirstKey="True"
                                                IsEnterEnabled="True"
                                                EnterPressed="TenderNumpad_EnterPressed"/>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Style="{StaticResource CashierDialogFooter}"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="178"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="KEYBOARD / TOUCH"
                               Foreground="{StaticResource CashierTransactionHelpBrush}"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="Enter advances fields, then confirms."
                               Style="{StaticResource CashierMutedText}"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="CANCEL"
                        Style="{StaticResource CashierTransactionCancelButton}"
                        Margin="0,0,8,0"
                        TabIndex="3"
                        IsCancel="True"
                        AutomationProperties.Name="Cancel card payment"
                        Click="CancelBtn_Click"/>

                <Button Grid.Column="2"
                        Content="CONFIRM CARD"
                        Style="{StaticResource CashierTransactionConfirmButton}"
                        TabIndex="4"
                        IsDefault="True"
                        IsEnabled="{Binding CanConfirm}"
                        AutomationProperties.Name="Confirm card payment"
                        Click="ConfirmBtn_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
