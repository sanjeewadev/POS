<Window x:Class="POS.Cashier.UI.Dialogs.CashMovementDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cash Movement"
        Style="{StaticResource CashierDialogWindow}"
        Width="560"
        Height="640"
        MinWidth="500"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="CashierTransactionReasonListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3FAFD"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <!-- selected background/foreground -->
                                <Setter TargetName="Bd" Property="Background" Value="#CDEBF6"/>
                                <Setter Property="Foreground" Value="#0B3A4B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CashierBorderBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,1"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsEnabled" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="66"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierTransactionDialogHeader}" Margin="10,10,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CashierTransactionHeaderIcon}" Background="{Binding ThemeColorHex}">
                    <TextBlock Text="Rs." Foreground="White" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource CashierDialogTitle}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="ENTER = CONFIRM   |   ESC = CANCEL"
                           Style="{StaticResource CashierShortcutHint}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="6" Padding="4"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CashierTransactionContentPanel}" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="AMOUNT" Style="{StaticResource CashierTransactionFieldLabel}"/>
                        <Border Style="{StaticResource CashierTransactionAmountPanel}"
                                Background="{StaticResource CashierTransactionDueBrush}"
                                BorderBrush="{StaticResource CashierTransactionDueBorderBrush}"
                                Margin="0,4,0,0">
                            <TextBlock Text="{Binding Amount, StringFormat='Rs. {0:N2}'}"
                                       Style="{StaticResource CashierTransactionAmountText}"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CashierTransactionContentPanel}" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="SELECT REASON" Style="{StaticResource CashierTransactionFieldLabel}"/>
                        <ListBox x:Name="ReasonListBox"
                                 ItemsSource="{Binding ReasonCategories}"
                                 SelectedItem="{Binding SelectedReason, UpdateSourceTrigger=PropertyChanged}"
                                 ItemContainerStyle="{StaticResource CashierTransactionReasonListItem}"
                                 BorderBrush="{StaticResource CashierBorderBrush}"
                                 BorderThickness="1"
                                 Background="{StaticResource CashierInputBrush}"
                                 MinHeight="150"
                                 MaxHeight="190"
                                 Margin="0,4,0,0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CashierTransactionContentPanel}">
                    <StackPanel>
                        <TextBlock Text="REMARKS (OPTIONAL; REQUIRED FOR OTHER)"
                                   Style="{StaticResource CashierTransactionFieldLabel}"/>
                        <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CashierTransactionMultilineTextBox}"
                                 Margin="0,4,0,0" MaxLength="500"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource CashierDialogFooter}" Margin="10,0,10,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CANCEL" IsCancel="True" Click="CancelBtn_Click"
                            Style="{StaticResource CashierTransactionCancelButton}" Margin="0,0,10,0"/>
                    <Button Content="{Binding ButtonText}" Command="{Binding ConfirmCommand}"
                            IsDefault="True" Style="{StaticResource CashierTransactionConfirmButton}"
                            Background="{Binding ThemeColorHex}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
