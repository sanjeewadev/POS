<Window x:Class="POS.Cashier.UI.Dialogs.LoyaltyCustomerDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        Style="{StaticResource CashierOperationalWindow}"
        Height="680"
        Width="1080"
        MinHeight="500"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyboardNavigation.TabNavigation="Cycle">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Style="{StaticResource CashierOperationalHeader}"
                Margin="0,0,0,6">

            <Grid>
                <TextBlock Text="LOYALTY CUSTOMER LOOKUP"
                           Foreground="White"
                           FontSize="19"
                           FontWeight="Heavy"
                           HorizontalAlignment="Left"/>

                <TextBlock Text="Retail customers with Loyalty enabled only"
                           Foreground="{StaticResource CashierHeaderHintBrush}"
                           FontSize="12"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT DIRECTORY -->
            <GroupBox Grid.Column="0"
                      Style="{StaticResource CashierOperationalGroupBox}"
                      Header="Retail Loyalty Customers"
                      FontSize="15"
                      FontWeight="Bold"
                      Foreground="{StaticResource CashierSuccessBrush}"
                      BorderBrush="{StaticResource CashierBorderBrush}"
                      Background="{StaticResource CashierPanelAltBrush}">

                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- SEARCH -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="115"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding SearchLabel}"
                                   FontWeight="SemiBold"
                                   Foreground="Black"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <TextBox x:Name="SearchTxt"
                                 Grid.Column="1"
                                 Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CashierOperationalSearchTextBox}"
                                 PreviewKeyDown="SearchTxt_PreviewKeyDown"/>

                        <Button Grid.Column="2"
        Content="SEARCH"
        Command="{Binding SearchCommand}"
        Style="{StaticResource CashierOperationalSecondaryButton}"
        Height="38"
        Margin="8,0,0,0"/>

                        <Button Grid.Column="3"
        Content="REFRESH"
        Click="RefreshBtn_Click"
        Style="{StaticResource CashierOperationalSecondaryButton}"
        Height="38"
        Margin="8,0,0,0"/>
                    </Grid>

                    <!-- GRID -->
                    <DataGrid Grid.Row="1"
                              x:Name="CustomerDataGrid"
                              Style="{StaticResource CashierOperationalDataGrid}"
                              ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding SelectedCustomer}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="{StaticResource CashierGridLineBrush}"
                              VerticalGridLinesBrush="{StaticResource CashierGridLineBrush}"
                              RowHeight="36"
                              FontSize="14"
                              Background="White"
                              SelectionMode="Single"
                              BorderBrush="{StaticResource CashierBorderBrush}"
                              BorderThickness="1"
                              Foreground="Black"
                              PreviewKeyDown="CustomerDataGrid_PreviewKeyDown"
                              MouseDoubleClick="CustomerDataGrid_MouseDoubleClick">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code"
                                                Binding="{Binding CustomerCode}"
                                                Width="110"
                                                FontWeight="Bold"/>

                            <DataGridTextColumn Header="Customer Name"
                                                Binding="{Binding FullName}"
                                                Width="*"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource CashierHeaderBrush}"/>

                            <DataGridTextColumn Header="Phone"
                                                Binding="{Binding Phone}"
                                                Width="130"/>

                            <DataGridTextColumn Header="Birthday"
                                                Binding="{Binding Birthday, StringFormat=MMM dd}"
                                                Width="90"/>

                            <DataGridTextColumn Header="Loyalty"
                                                Binding="{Binding DiscountLabel}"
                                                Width="120"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource CashierSuccessBrush}"/>

                            <DataGridTextColumn Header="Credit"
                                                Binding="{Binding CreditStatusText}"
                                                Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <!-- RIGHT DETAILS -->
            <GroupBox Grid.Column="2"
                      Header="Selected Loyalty Customer"
                      FontSize="15"
                      FontWeight="Bold"
                      Foreground="{StaticResource CashierSuccessBrush}"
                      BorderBrush="{StaticResource CashierBorderBrush}"
                      Background="{StaticResource CashierPanelAltBrush}">

                <Border Style="{StaticResource CashierOperationalDetailPanel}"
                        BorderBrush="{StaticResource CashierGridLineBrush}"
                        BorderThickness="1"
                        Padding="12"
                        Margin="5">

                    <Grid>
                        <TextBlock Text="Select a loyalty customer."
                                   Foreground="#777"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomerSelected}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomerSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="{Binding DisplayCompanyName}"
                                       FontSize="20"
                                       FontWeight="Heavy"
                                       Foreground="{StaticResource CashierHeaderBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="{Binding DisplayContactName}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource CashierTextBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,0,0,15"/>

                            <Border Background="White"
                                    BorderBrush="{StaticResource CashierBorderBrush}"
                                    BorderThickness="1"
                                    Padding="10"
                                    Margin="0,0,0,12">

                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Type:" Style="{StaticResource CashierOperationalInlineLabel}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayCustomerType}"
                                                   FontWeight="Heavy"
                                                   Foreground="{StaticResource CashierHeaderBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Loyalty:" Style="{StaticResource CashierOperationalInlineLabel}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayDiscountStatus}"
                                                   FontWeight="Heavy"
                                                   Foreground="{StaticResource CashierSuccessBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Credit:" Style="{StaticResource CashierOperationalInlineLabel}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayCreditStatus}"
                                                   FontWeight="Heavy"
                                                   Foreground="{StaticResource CashierDangerBrush}"
                                                   HorizontalAlignment="Right"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource CashierTransactionAppliedBrush}"
                                    BorderBrush="{StaticResource CashierSuccessBrush}"
                                    BorderThickness="1"
                                    Padding="10"
                                    Margin="0,0,0,12">

                                <TextBlock Text="This button is only a shortcut. It attaches the same CustomerMaster record to the sale. Manual discount rules will be applied later from the discount engine."
                                           Foreground="{StaticResource CashierSuccessDarkBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </Border>

                            <Border Background="{StaticResource CashierPanelBrush}"
                                    BorderBrush="{StaticResource CashierDangerBrush}"
                                    BorderThickness="2"
                                    Padding="10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAccountLocked}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <TextBlock Text="{Binding LockReasonText}"
                                           Foreground="{StaticResource CashierDangerBrush}"
                                           FontWeight="Heavy"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </GroupBox>
        </Grid>

        <!-- FOOTER -->
        <Grid Grid.Row="2" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="CLOSE"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Style="{StaticResource CashierOperationalSecondaryButton}"/>

            <TextBlock Grid.Column="1"
                       Text="Double-click a customer row or press Attach."
                       Foreground="{StaticResource CashierTextBrush}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="10,0"/>

            <Button Grid.Column="2"
                    Content="{Binding AttachButtonText}"
                    Command="{Binding AttachCommand}"
                    IsDefault="True"
                    IsEnabled="{Binding CanAttachToInvoice}"
                    Style="{StaticResource CashierOperationalSuccessButton}"/>
        </Grid>
    </Grid>
</Window>