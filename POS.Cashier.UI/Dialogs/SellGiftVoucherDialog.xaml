<Window x:Class="POS.Cashier.UI.Dialogs.SellGiftVoucherDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sell Gift Voucher"
        Style="{StaticResource CashierDialogWindow}"
        Width="760"
        Height="560"
        MinWidth="680"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="66"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierTransactionDialogHeader}" Margin="10,10,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CashierTransactionHeaderIcon}">
                    <TextBlock Text="GV" Foreground="White" FontSize="14" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SELL GIFT VOUCHER" Style="{StaticResource CashierDialogTitle}"/>
                    <TextBlock Text="Validate a created voucher and add it to the current sale"
                               Style="{StaticResource CashierTransactionHeaderSubtitle}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="ENTER = VERIFY / ADD   |   ESC = CANCEL"
                           Style="{StaticResource CashierShortcutHint}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="10" Padding="6"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CashierTransactionContentPanel}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="VOUCHER BARCODE" Style="{StaticResource CashierTransactionFieldLabel}"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BarcodeTextBox"
                                     Text="{Binding VoucherBarcode, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CashierTransactionInputTextBox}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchVoucherCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Content="VERIFY"
                                    Command="{Binding SearchVoucherCommand}"
                                    Style="{StaticResource CashierTransactionPrimaryButton}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CashierTransactionSectionPanel}" Margin="0,0,0,10">
                    <TextBlock Text="Scan or enter a physical Gift Voucher created in BackOffice. Only a voucher in Created status can be sold."
                               Style="{StaticResource CashierTransactionFooterHint}"/>
                </Border>

                <Border Style="{StaticResource CashierTransactionContentPanel}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="42"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.ColumnSpan="2" Text="VOUCHER DETAILS"
                                       Style="{StaticResource CashierSectionTitle}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Text="Voucher No" Style="{StaticResource CashierTransactionDetailLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VoucherNo}"
                                       Style="{StaticResource CashierTransactionDetailValue}"/>
                            <TextBlock Grid.Row="2" Text="Status" Style="{StaticResource CashierTransactionDetailLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VoucherStatus}"
                                       Style="{StaticResource CashierTransactionDetailValue}"
                                       Foreground="{Binding StatusColorHex}"/>
                            <TextBlock Grid.Row="3" Text="Expiry" Style="{StaticResource CashierTransactionDetailLabel}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}"
                                       Style="{StaticResource CashierTransactionDetailValue}"/>
                        </Grid>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="VOUCHER AMOUNT"
                                       Style="{StaticResource CashierTransactionFieldLabel}"
                                       HorizontalAlignment="Center"/>
                            <Border Style="{StaticResource CashierTransactionAmountPanel}"
                                    Background="{StaticResource CashierTransactionAppliedBrush}"
                                    BorderBrush="{StaticResource CashierTransactionAppliedBorderBrush}"
                                    Margin="0,6,0,10">
                                <TextBlock Text="{Binding VoucherAmount, StringFormat=Rs. {0:N2}}"
                                           Style="{StaticResource CashierTransactionAmountText}"
                                           Foreground="{StaticResource CashierTransactionAppliedTextBrush}"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding DisplayDescription}"
                                       Style="{StaticResource CashierTransactionDetailValue}"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CashierTransactionStatusBanner}"
                        Background="{Binding StatusColorHex}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CashierTransactionStatusSymbol}"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                   Foreground="White" FontWeight="Bold"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource CashierDialogFooter}" Margin="10,0,10,10">
            <Grid>
                <TextBlock Text="Verify the voucher before adding it to the sale."
                           Style="{StaticResource CashierTransactionFooterHint}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CLEAR" Command="{Binding ClearCommand}"
                            Style="{StaticResource CashierTransactionSecondaryButton}" Margin="0,0,10,0"/>
                    <Button Content="CANCEL" Command="{Binding CancelCommand}"
                            IsCancel="True" Style="{StaticResource CashierTransactionCancelButton}"
                            Margin="0,0,10,0"/>
                    <Button Content="ADD TO SALE" Command="{Binding ConfirmCommand}"
                            IsDefault="True" IsEnabled="{Binding HasValidatedVoucher}"
                            Style="{StaticResource CashierTransactionConfirmButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
