<Window x:Class="POS.Cashier.UI.Dialogs.ShiftCloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close Shift - Blind Cash Count"
        Style="{StaticResource CashierSummaryControlWindow}"
        Width="760"
        Height="680"
        MinWidth="640"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        KeyboardNavigation.TabNavigation="Cycle"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CashierSummaryDangerHeader}">
            <DockPanel LastChildFill="True">
                <TextBlock Text="ENTER submits · ESC cancels"
                           Style="{StaticResource CashierShortcutHint}"
                           DockPanel.Dock="Right"
                           Margin="16,0,0,0"/>
                <StackPanel>
                    <TextBlock Text="CLOSE SHIFT — BLIND CASH COUNT"
                               Style="{StaticResource CashierSummaryHeaderTitle}"/>
                    <TextBlock Text="Count the physical drawer before the system reveals expected cash."
                               Style="{StaticResource CashierSummaryHeaderSubtitle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CashierSummarySectionPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="DENOMINATION"
                                   Style="{StaticResource CashierSummaryMetricLabel}"/>
                        <TextBlock Grid.Column="1"
                                   Text="QUANTITY"
                                   Style="{StaticResource CashierSummaryMetricLabel}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="LINE TOTAL"
                                   Style="{StaticResource CashierSummaryMetricLabel}"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="1" Text="Rs. 5,000" VerticalAlignment="Center"/>
                        <TextBox x:Name="Qty5000" Grid.Row="1" Grid.Column="1" Style="{StaticResource CashierSummaryQuantityTextBox}" TabIndex="0" TextChanged="Count_TextChanged"/>
                        <TextBlock x:Name="Total5000" Grid.Row="1" Grid.Column="2" Style="{StaticResource CashierSummaryRowValue}"/>

                        <TextBlock Grid.Row="2" Text="Rs. 1,000" VerticalAlignment="Center"/>
                        <TextBox x:Name="Qty1000" Grid.Row="2" Grid.Column="1" Style="{StaticResource CashierSummaryQuantityTextBox}" TabIndex="1" TextChanged="Count_TextChanged"/>
                        <TextBlock x:Name="Total1000" Grid.Row="2" Grid.Column="2" Style="{StaticResource CashierSummaryRowValue}"/>

                        <TextBlock Grid.Row="3" Text="Rs. 500" VerticalAlignment="Center"/>
                        <TextBox x:Name="Qty500" Grid.Row="3" Grid.Column="1" Style="{StaticResource CashierSummaryQuantityTextBox}" TabIndex="2" TextChanged="Count_TextChanged"/>
                        <TextBlock x:Name="Total500" Grid.Row="3" Grid.Column="2" Style="{StaticResource CashierSummaryRowValue}"/>

                        <TextBlock Grid.Row="4" Text="Rs. 100" VerticalAlignment="Center"/>
                        <TextBox x:Name="Qty100" Grid.Row="4" Grid.Column="1" Style="{StaticResource CashierSummaryQuantityTextBox}" TabIndex="3" TextChanged="Count_TextChanged"/>
                        <TextBlock x:Name="Total100" Grid.Row="4" Grid.Column="2" Style="{StaticResource CashierSummaryRowValue}"/>

                        <TextBlock Grid.Row="5" Text="Rs. 50" VerticalAlignment="Center"/>
                        <TextBox x:Name="Qty50" Grid.Row="5" Grid.Column="1" Style="{StaticResource CashierSummaryQuantityTextBox}" TabIndex="4" TextChanged="Count_TextChanged"/>
                        <TextBlock x:Name="Total50" Grid.Row="5" Grid.Column="2" Style="{StaticResource CashierSummaryRowValue}"/>

                        <TextBlock Grid.Row="6" Text="Rs. 20" VerticalAlignment="Center"/>
                        <TextBox x:Name="Qty20" Grid.Row="6" Grid.Column="1" Style="{StaticResource CashierSummaryQuantityTextBox}" TabIndex="5" TextChanged="Count_TextChanged"/>
                        <TextBlock x:Name="Total20" Grid.Row="6" Grid.Column="2" Style="{StaticResource CashierSummaryRowValue}"/>

                        <TextBlock Grid.Row="7" Text="Rs. 10" VerticalAlignment="Center"/>
                        <TextBox x:Name="Qty10" Grid.Row="7" Grid.Column="1" Style="{StaticResource CashierSummaryQuantityTextBox}" TabIndex="6" TextChanged="Count_TextChanged"/>
                        <TextBlock x:Name="Total10" Grid.Row="7" Grid.Column="2" Style="{StaticResource CashierSummaryRowValue}"/>

                        <TextBlock Grid.Row="8" Text="Rs. 5" VerticalAlignment="Center"/>
                        <TextBox x:Name="Qty5" Grid.Row="8" Grid.Column="1" Style="{StaticResource CashierSummaryQuantityTextBox}" TabIndex="7" TextChanged="Count_TextChanged"/>
                        <TextBlock x:Name="Total5" Grid.Row="8" Grid.Column="2" Style="{StaticResource CashierSummaryRowValue}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CashierSummaryDangerPanel}">
                        <StackPanel>
                            <TextBlock Text="COUNTED CASH"
                                       Style="{StaticResource CashierSummaryMetricLabel}"
                                       Foreground="{StaticResource CashierDangerDarkBrush}"/>
                            <TextBlock x:Name="GrandTotalText"
                                       Text="Rs. 0.00"
                                       Style="{StaticResource CashierSummaryMetricValue}"
                                       Foreground="{StaticResource CashierDangerBrush}"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CashierSummarySectionPanel}"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="COINS / OTHER AMOUNT"
                                       Style="{StaticResource CashierFieldLabel}"/>
                            <TextBox x:Name="OtherAmount"
                                     Style="{StaticResource CashierSummaryMoneyTextBox}"
                                     TabIndex="8"
                                     Margin="0,6,0,14"
                                     TextChanged="Count_TextChanged"/>

                            <TextBlock Text="OPTIONAL VARIANCE NOTE"
                                       Style="{StaticResource CashierFieldLabel}"/>
                            <TextBox x:Name="VarianceNoteBox"
                                     Style="{StaticResource CashierSummaryNoteTextBox}"
                                     TabIndex="9"
                                     Margin="0,6,0,0"
                                     MinHeight="92"
                                     MaxLength="500"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CashierSummaryWarningPanel}"
                            Margin="0,12,0,0">
                        <TextBlock Text="Only enter the physical cash counted in the drawer. Expected cash is intentionally hidden until submission."
                                   Foreground="{StaticResource CashierWarningDarkBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Style="{StaticResource CashierSummaryFooter}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="CANCEL"
                        Style="{StaticResource CashierSummarySecondaryButton}"
                        IsCancel="True"
                        MinWidth="110"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>
                <Button Content="SUBMIT COUNT"
                        Style="{StaticResource CashierSummaryDangerButton}"
                        MinWidth="155"
                        IsDefault="True"
                        Click="Submit_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
