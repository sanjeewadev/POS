<Window x:Class="POS.Cashier.UI.Dialogs.ShiftCloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close Shift - Blind Cash Count"
        Height="620" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#7F1D1D" Padding="15">
            <StackPanel>
                <TextBlock Text="CLOSE SHIFT — BLIND CASH COUNT" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Count the physical drawer before the system reveals expected cash." Foreground="#FECACA" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Denomination" FontWeight="Bold" Foreground="#374151"/>
                <TextBlock Grid.Column="1" Text="Quantity" FontWeight="Bold" Foreground="#374151" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Line total" FontWeight="Bold" Foreground="#374151" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="1" Text="Rs. 5,000" VerticalAlignment="Center"/><TextBox x:Name="Qty5000" Grid.Row="1" Grid.Column="1" TextChanged="Count_TextChanged" HorizontalContentAlignment="Right"/><TextBlock x:Name="Total5000" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="2" Text="Rs. 1,000" VerticalAlignment="Center"/><TextBox x:Name="Qty1000" Grid.Row="2" Grid.Column="1" TextChanged="Count_TextChanged" HorizontalContentAlignment="Right"/><TextBlock x:Name="Total1000" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="3" Text="Rs. 500" VerticalAlignment="Center"/><TextBox x:Name="Qty500" Grid.Row="3" Grid.Column="1" TextChanged="Count_TextChanged" HorizontalContentAlignment="Right"/><TextBlock x:Name="Total500" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="4" Text="Rs. 100" VerticalAlignment="Center"/><TextBox x:Name="Qty100" Grid.Row="4" Grid.Column="1" TextChanged="Count_TextChanged" HorizontalContentAlignment="Right"/><TextBlock x:Name="Total100" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="5" Text="Rs. 50" VerticalAlignment="Center"/><TextBox x:Name="Qty50" Grid.Row="5" Grid.Column="1" TextChanged="Count_TextChanged" HorizontalContentAlignment="Right"/><TextBlock x:Name="Total50" Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="6" Text="Rs. 20" VerticalAlignment="Center"/><TextBox x:Name="Qty20" Grid.Row="6" Grid.Column="1" TextChanged="Count_TextChanged" HorizontalContentAlignment="Right"/><TextBlock x:Name="Total20" Grid.Row="6" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="7" Text="Rs. 10" VerticalAlignment="Center"/><TextBox x:Name="Qty10" Grid.Row="7" Grid.Column="1" TextChanged="Count_TextChanged" HorizontalContentAlignment="Right"/><TextBlock x:Name="Total10" Grid.Row="7" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="8" Text="Rs. 5" VerticalAlignment="Center"/><TextBox x:Name="Qty5" Grid.Row="8" Grid.Column="1" TextChanged="Count_TextChanged" HorizontalContentAlignment="Right"/><TextBlock x:Name="Total5" Grid.Row="8" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <StackPanel Grid.Row="9" Grid.ColumnSpan="2">
                    <TextBlock Text="Coins / other amount" FontWeight="SemiBold"/>
                    <TextBox x:Name="OtherAmount" TextChanged="Count_TextChanged" HorizontalContentAlignment="Right" Margin="0,5,10,0"/>
                    <TextBlock Text="Optional variance note" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBox x:Name="VarianceNoteBox" MaxLength="500" Margin="0,5,10,0"/>
                </StackPanel>

                <Border Grid.Row="9" Grid.Column="2" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <TextBlock Text="COUNTED CASH" FontWeight="Bold" Foreground="#7F1D1D"/>
                        <TextBlock x:Name="GrandTotalText" Text="Rs. 0.00" FontSize="22" FontWeight="Bold" Foreground="#991B1B" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Content="CANCEL" Click="Cancel_Click" Height="42" Background="#E5E7EB" FontWeight="Bold"/>
            <Button Grid.Column="2" Content="SUBMIT COUNT" Click="Submit_Click" Height="42" Background="#991B1B" Foreground="White" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
