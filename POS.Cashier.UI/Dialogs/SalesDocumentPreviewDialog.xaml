<Window x:Class="POS.Cashier.UI.Dialogs.SalesDocumentPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Document Preview"
        Style="{StaticResource CashierDialogWindow}"
        Width="620"
        Height="700"
        MinWidth="520"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Margin="10"
            Background="#F8FAFC"
            BorderBrush="#334155"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#0F3D5E">
                <DockPanel>
                    <TextBlock x:Name="HeadingText"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="17"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"/>
                    <TextBlock Text="Esc = Close"
                               Foreground="#DDEAF3"
                               FontSize="11"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,12,0"/>
                </DockPanel>
            </Border>

            <TextBox x:Name="PreviewTextBox"
                     Grid.Row="1"
                     Margin="14"
                     Padding="12"
                     FontFamily="Consolas"
                     FontSize="14"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="White"
                     BorderBrush="#94A3B8"/>

            <Border Grid.Row="2"
                    Background="#E5E7EB"
                    BorderBrush="#CBD5E1"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <Button Content="Save PDF"
                            Style="{StaticResource CashierButton}"
                            Width="105"
                            Height="32"
                            Margin="0,0,8,0"
                            Click="SavePdf_Click"/>
                    <Button Content="Print"
                            Style="{StaticResource CashierPrimaryButton}"
                            IsDefault="True"
                            Width="105"
                            Height="32"
                            Margin="0,0,8,0"
                            FontWeight="SemiBold"
                            Background="#2563EB"
                            Foreground="White"
                            Click="Print_Click"/>
                    <Button Content="Close"
                            Style="{StaticResource CashierButton}"
                            Width="95"
                            Height="32"
                            IsCancel="True"
                            Click="Close_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
