<Window x:Class="POS.Cashier.UI.Dialogs.SalesDocumentPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Document Preview"
        Style="{StaticResource CashierSummaryControlWindow}"
        Width="860"
        Height="760"
        MinWidth="620"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        KeyboardNavigation.TabNavigation="Cycle"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CashierSummaryHeader}">
            <DockPanel LastChildFill="True">
                <TextBlock Text="ESC closes"
                           Style="{StaticResource CashierShortcutHint}"
                           DockPanel.Dock="Right"
                           Margin="16,0,0,0"/>
                <StackPanel>
                    <TextBlock x:Name="HeadingText"
                               Style="{StaticResource CashierSummaryHeaderTitle}"/>
                    <TextBlock Text="Review the immutable transaction snapshot before printing or saving."
                               Style="{StaticResource CashierSummaryHeaderSubtitle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource CashierSummaryContentPanel}"
                Margin="16">
            <TextBox x:Name="PreviewTextBox"
                     Style="{StaticResource CashierSummaryPreviewTextBox}"/>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CashierSummaryFooter}">
            <Grid>
                <TextBlock Text="PDF export and printing use the displayed completed-document snapshot."
                           Style="{StaticResource CashierSummaryStatusText}"
                           Margin="0,0,12,0"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="SAVE PDF"
                            Style="{StaticResource CashierSummarySecondaryButton}"
                            MinWidth="110"
                            Margin="0,0,8,0"
                            Click="SavePdf_Click"/>
                    <Button Content="PRINT"
                            Style="{StaticResource CashierSummaryPrimaryButton}"
                            IsDefault="True"
                            MinWidth="110"
                            Margin="0,0,8,0"
                            Click="Print_Click"/>
                    <Button Content="CLOSE"
                            Style="{StaticResource CashierSummarySecondaryButton}"
                            MinWidth="100"
                            IsCancel="True"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
