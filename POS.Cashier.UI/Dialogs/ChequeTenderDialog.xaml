<Window x:Class="POS.Cashier.UI.Dialogs.ChequeTenderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:POS.Cashier.UI.Components"
        Title="Cheque Payment"
        Style="{StaticResource CashierDialogWindow}"
        Width="900"
        Height="620"
        MinWidth="820"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyboardNavigation.TabNavigation="Cycle"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CashierTransactionDialogHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CashierTransactionHeaderIcon}">
                    <TextBlock Text="CHQ"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="CHEQUE PAYMENT"
                               Style="{StaticResource CashierDialogTitle}"
                               FontSize="22"/>
                    <TextBlock Text="Record cheque details for the current sale"
                               Style="{StaticResource CashierTransactionHeaderSubtitle}"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="ENTER = NEXT / CONFIRM   |   ESC = CANCEL"
                           Style="{StaticResource CashierShortcutHint}"
                           Foreground="White"
                           FontWeight="Bold"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Margin="0,10,0,10"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      Focusable="False">
            <Grid MinHeight="420">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CashierPanel}"
                        CornerRadius="3"
                        Padding="10"
                        Margin="0,0,8,0">
                    <Grid>
                        <!-- Match Card dialog row sizing pattern -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="58"/>
                            <RowDefinition Height="58"/>
                            <RowDefinition Height="64"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Style="{StaticResource CashierTransactionStatusBanner}"
                                Background="{Binding StatusColorHex}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="26"
                                        Height="26"
                                        CornerRadius="13"
                                        BorderBrush="White"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CashierTransactionStatusSymbol}"/>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding StatusText}"
                                           Foreground="White"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="BALANCE DUE"
                                       Style="{StaticResource CashierTransactionFieldLabel}"/>
                            <Border Grid.Column="1"
                                    Style="{StaticResource CashierTransactionReadOnlyPanel}"
                                    Background="{StaticResource CashierTransactionDueBrush}"
                                    BorderBrush="{StaticResource CashierTransactionDueBorderBrush}">
                                <TextBlock Text="{Binding BalanceDue, StringFormat={}{0:N2}}"
                                           Style="{StaticResource CashierTransactionReadOnlyValue}"
                                           Foreground="White"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CHEQUE AMOUNT"
                                       Style="{StaticResource CashierTransactionFieldLabel}"/>
                            <TextBox x:Name="ChequeAmountTextBox"
                                     Grid.Column="1"
                                     Text="{Binding ChequeAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CashierTransactionMoneyInputTextBox}"
                                     TextAlignment="Right"
                                     TabIndex="0"
                                     AutomationProperties.Name="Cheque payment amount"
                                     GotKeyboardFocus="ChequeAmountTextBox_GotKeyboardFocus"
                                     PreviewMouseLeftButtonDown="ChequeAmountTextBox_PreviewMouseLeftButtonDown"/>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CHEQUE NUMBER"
                                       Style="{StaticResource CashierTransactionFieldLabel}"/>
                            <TextBox x:Name="ChequeNoTextBox"
                                     Grid.Column="1"
                                     Text="{Binding ChequeNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CashierTransactionInputTextBox}"
                                     MaxLength="20"
                                     TabIndex="1"
                                     AutomationProperties.Name="Cheque number"
                                     GotKeyboardFocus="ChequeNoTextBox_GotKeyboardFocus"
                                     PreviewMouseLeftButtonDown="ChequeNoTextBox_PreviewMouseLeftButtonDown"/>
                        </Grid>

                        <Grid Grid.Row="4" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="BANK NAME"
                                       Style="{StaticResource CashierTransactionFieldLabel}"/>
                            <TextBox x:Name="BankNameTextBox"
                                     Grid.Column="1"
                                     Text="{Binding BankName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CashierTransactionInputTextBox}"
                                     MaxLength="60"
                                     TabIndex="2"
                                     AutomationProperties.Name="Cheque bank name"
                                     GotKeyboardFocus="BankNameTextBox_GotKeyboardFocus"
                                     PreviewMouseLeftButtonDown="BankNameTextBox_PreviewMouseLeftButtonDown"/>
                        </Grid>

                        <Grid Grid.Row="5" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="BRANCH"
                                       Style="{StaticResource CashierTransactionFieldLabel}"/>
                            <TextBox x:Name="BranchNameTextBox"
                                     Grid.Column="1"
                                     Text="{Binding BranchName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CashierTransactionInputTextBox}"
                                     MaxLength="40"
                                     TabIndex="3"
                                     AutomationProperties.Name="Cheque bank branch"
                                     GotKeyboardFocus="BranchNameTextBox_GotKeyboardFocus"
                                     PreviewMouseLeftButtonDown="BranchNameTextBox_PreviewMouseLeftButtonDown"/>
                        </Grid>

                        <Grid Grid.Row="6" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CHEQUE DATE"
                                       Style="{StaticResource CashierTransactionFieldLabel}"/>
                            <DatePicker x:Name="ChequeDatePicker"
                                        Grid.Column="1"
                                        SelectedDate="{Binding ChequeDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource CashierDatePicker}"
                                        MinHeight="42"
                                        FontSize="15"
                                        TabIndex="4"
                                        AutomationProperties.Name="Cheque date"
                                        GotKeyboardFocus="ChequeDatePicker_GotKeyboardFocus"/>
                        </Grid>

                        <Border Grid.Row="7"
                                Margin="0,10,0,0"
                                Style="{StaticResource CashierStatusPanel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CashierTransactionHelpIcon}">
                                    <TextBlock Text="i"
                                               Foreground="{StaticResource CashierTransactionHelpBrush}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Cheque number and bank name are required. Cheque payments do not count as physical drawer cash."
                                           Foreground="{StaticResource CashierTransactionHelpTextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding RemainingAfterCheque, StringFormat=Remaining: Rs. {0:N2}}"
                                           Foreground="{StaticResource CashierTransactionBalanceTextBrush}"
                                           FontWeight="Bold"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <components:TenderNumpadControl x:Name="TenderNumpad"
                                                Grid.Column="1"
                                                TargetText="{Binding ActiveInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                HeaderText="{Binding ActiveNumpadHeader}"
                                                TargetLabel="{Binding ActiveTargetLabel}"
                                                ModeText="{Binding ActiveModeText}"
                                                ShowDecimal="{Binding ActiveShowDecimal}"
                                                ShowDoubleZero="{Binding ActiveShowDoubleZero}"
                                                MaxLength="{Binding ActiveMaxLength}"
                                                ClearText=""
                                                SelectAllOnFirstKey="True"
                                                IsEnterEnabled="True"
                                                EnterPressed="TenderNumpad_EnterPressed"/>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Style="{StaticResource CashierDialogFooter}"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="188"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="KEYBOARD / TOUCH"
                               Foreground="{StaticResource CashierTransactionHelpBrush}"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="Enter advances through cheque details."
                               Style="{StaticResource CashierMutedText}"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="CANCEL"
                        Style="{StaticResource CashierTransactionCancelButton}"
                        Margin="0,0,8,0"
                        TabIndex="5"
                        IsCancel="True"
                        AutomationProperties.Name="Cancel cheque payment"
                        Click="CancelBtn_Click"/>

                <Button Grid.Column="2"
                        Content="CONFIRM CHEQUE"
                        Style="{StaticResource CashierTransactionConfirmButton}"
                        TabIndex="6"
                        IsDefault="True"
                        IsEnabled="{Binding CanConfirm}"
                        AutomationProperties.Name="Confirm cheque payment"
                        Click="ConfirmBtn_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>