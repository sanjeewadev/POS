<Window x:Class="POS.Cashier.UI.Dialogs.CashierLicenseRecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced POS - Cashier Activation Required"
        Style="{StaticResource CashierSummaryControlWindow}"
        Width="820"
        Height="720"
        MinWidth="720"
        MinHeight="620"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="74"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CashierSummaryDangerHeader}"
                Margin="10,10,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CashierTransactionHeaderIcon}">
                    <TextBlock Text="L"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="CASHIER ACTIVATION REQUIRED"
                               Style="{StaticResource CashierSummaryHeaderTitle}"/>
                    <TextBlock Text="View this computer's machine code and import its signed terminal licence"
                               Style="{StaticResource CashierSummaryHeaderSubtitle}"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="ESC = EXIT"
                           Style="{StaticResource CashierShortcutHint}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource CashierSummaryContentPanel}"
                Margin="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border x:Name="StatusPanel"
                            Style="{StaticResource CashierSummaryDangerPanel}"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="StatusTitleTextBlock"
                                       Text="Checking licence status..."
                                       FontSize="16"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="StatusMessageTextBlock"
                                       Text="Please wait."
                                       Style="{StaticResource CashierSummaryStatusText}"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CashierSummarySectionPanel}"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.ColumnSpan="2"
                                       Text="TERMINAL AND LICENCE INFORMATION"
                                       Style="{StaticResource CashierSummarySectionTitle}"/>

                            <TextBlock Grid.Row="1" Text="Store ID" Style="{StaticResource CashierSummaryRowLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StoreIdTextBlock" Style="{StaticResource CashierSummaryRowValue}"/>

                            <TextBlock Grid.Row="2" Text="Terminal" Style="{StaticResource CashierSummaryRowLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TerminalTextBlock" Style="{StaticResource CashierSummaryRowValue}"/>

                            <TextBlock Grid.Row="3" Text="Computer name" Style="{StaticResource CashierSummaryRowLabel}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="MachineNameTextBlock" Style="{StaticResource CashierSummaryRowValue}"/>

                            <TextBlock Grid.Row="4" Text="Machine code" Style="{StaticResource CashierSummaryRowLabel}"/>
                            <TextBox Grid.Row="4"
                                     Grid.Column="1"
                                     x:Name="MachineCodeTextBox"
                                     Style="{StaticResource CashierSummaryReadOnlyTextBox}"
                                     Margin="12,3,0,3"
                                     HorizontalContentAlignment="Right"/>

                            <TextBlock Grid.Row="5" Text="Store licence" Style="{StaticResource CashierSummaryRowLabel}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="StoreStatusTextBlock" Style="{StaticResource CashierSummaryRowValue}"/>

                            <TextBlock Grid.Row="6" Text="Terminal licence" Style="{StaticResource CashierSummaryRowLabel}"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TerminalStatusTextBlock" Style="{StaticResource CashierSummaryRowValue}"/>

                            <TextBlock Grid.Row="7" Text="Terminal expiry" Style="{StaticResource CashierSummaryRowLabel}"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="ExpiryTextBlock" Style="{StaticResource CashierSummaryRowValue}"/>

                            <TextBlock Grid.Row="8" Text="Application version" Style="{StaticResource CashierSummaryRowLabel}"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" x:Name="VersionTextBlock" Style="{StaticResource CashierSummaryRowValue}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CashierSummarySectionPanel}">
                        <StackPanel>
                            <TextBlock Text="OFFLINE ACTIVATION ACTIONS"
                                       Style="{StaticResource CashierSummarySectionTitle}"/>

                            <UniformGrid Columns="3" Rows="2">
                                <Button Content="COPY MACHINE CODE"
                                        Style="{StaticResource CashierSummarySecondaryButton}"
                                        Margin="0,0,8,8"
                                        Click="CopyMachineCode_Click"/>
                                <Button Content="COPY LICENCE REQUEST"
                                        Style="{StaticResource CashierSummarySecondaryButton}"
                                        Margin="0,0,8,8"
                                        Click="CopyLicenseRequest_Click"/>
                                <Button Content="SAVE LICENCE REQUEST"
                                        Style="{StaticResource CashierSummarySecondaryButton}"
                                        Margin="0,0,0,8"
                                        Click="SaveLicenseRequest_Click"/>
                                <Button x:Name="ImportLicenseButton"
                                        Content="IMPORT TERMINAL LICENCE"
                                        Style="{StaticResource CashierSummaryPrimaryButton}"
                                        Margin="0,0,8,0"
                                        Click="ImportLicense_Click"/>
                                <Button Content="CHECK AGAIN"
                                        Style="{StaticResource CashierSummarySecondaryButton}"
                                        Margin="0,0,8,0"
                                        Click="CheckAgain_Click"/>
                                <Button Content="CONFIGURE CONNECTION"
                                        Style="{StaticResource CashierSummarySecondaryButton}"
                                        Click="ConfigureConnection_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CashierSummaryFooter}"
                Margin="10,0,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ActionStatusTextBlock"
                           Text="Activation is required before Cashier login."
                           Style="{StaticResource CashierSummaryStatusText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="EXIT"
                        Style="{StaticResource CashierSummarySecondaryButton}"
                        Margin="12,0,8,0"
                        Click="Exit_Click"/>

                <Button Grid.Column="2"
                        x:Name="ContinueButton"
                        Content="CONTINUE TO CASHIER"
                        Style="{StaticResource CashierSummarySuccessButton}"
                        IsEnabled="False"
                        IsDefault="True"
                        Click="Continue_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
