<Window x:Class="POS.Cashier.UI.Dialogs.HoldRecallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suspended Sales"
        Style="{StaticResource CashierOperationalWindow}"
        Width="820"
        Height="520"
        MinWidth="680"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyboardNavigation.TabNavigation="Cycle">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierOperationalHeader}">
            <Grid>
                <TextBlock Text="SUSPENDED TRANSACTIONS"
                           Style="{StaticResource CashierOperationalHeaderTitle}"/>
                <TextBlock Text="ENTER recalls | ESC closes"
                           Style="{StaticResource CashierShortcutHint}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <DataGrid x:Name="dgSuspended"
                  Grid.Row="1"
                  Style="{StaticResource CashierOperationalDataGrid}"
                  Margin="14"
                  ItemsSource="{Binding SuspendedCarts}"
                  SelectedItem="{Binding SelectedCart, Mode=TwoWay}"
                  RowHeight="38">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time"
                                    Binding="{Binding SuspendTime, StringFormat=t}"
                                    Width="110"/>
                <DataGridTextColumn Header="Reference / Name"
                                    Binding="{Binding ReferenceName}"
                                    Width="*"/>
                <DataGridTextColumn Header="Items"
                                    Binding="{Binding ItemCount}"
                                    Width="90"/>
                <DataGridTextColumn Header="Total Value"
                                    Binding="{Binding TotalValue, StringFormat=N2}"
                                    Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{StaticResource CashierOperationalFooter}">
            <Grid>
                <TextBlock Text="Select one held cart before recalling or cancelling it."
                           Style="{StaticResource CashierMutedText}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CLOSE"
                            Style="{StaticResource CashierOperationalSecondaryButton}"
                            IsCancel="True"
                            Margin="0,0,10,0"
                            Click="CancelBtn_Click"/>
                    <Button Content="CANCEL CART"
                            Style="{StaticResource CashierOperationalDangerButton}"
                            MinWidth="130"
                            Margin="0,0,10,0"
                            Click="DeleteBtn_Click"/>
                    <Button Content="RECALL TO POS"
                            Style="{StaticResource CashierOperationalSuccessButton}"
                            MinWidth="145"
                            IsDefault="True"
                            Click="ConfirmBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
