<Window x:Class="POS.Cashier.UI.Dialogs.B2BCustomerDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        Style="{StaticResource CashierOperationalWindow}"
        Height="720"
        Width="1160"
        MinHeight="500"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        KeyboardNavigation.TabNavigation="Cycle">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Style="{StaticResource CashierOperationalHeader}"
                Margin="0,0,0,6">

            <Grid>
                <TextBlock Text="{Binding DialogTitle}"
                           Foreground="White"
                           FontSize="19"
                           FontWeight="Heavy"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Esc = Close"
                           Foreground="{StaticResource CashierHeaderHintBrush}"
                           FontSize="12"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT DIRECTORY -->
            <GroupBox Grid.Column="0"
                      Style="{StaticResource CashierOperationalGroupBox}"
                      Header="{Binding DirectoryTitle}"
                      FontSize="15"
                      FontWeight="Bold"
                      Foreground="{StaticResource CashierHeaderBrush}"
                      BorderBrush="{StaticResource CashierBorderBrush}"
                      Background="{StaticResource CashierPanelAltBrush}">

                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- SEARCH BAR -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="115"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding SearchLabel}"
                                   FontWeight="SemiBold"
                                   Foreground="Black"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <TextBox x:Name="SearchTxt"
                                 Grid.Column="1"
                                 Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CashierOperationalSearchTextBox}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="2"
        Content="SEARCH"
        Command="{Binding SearchCommand}"
        Style="{StaticResource CashierOperationalSecondaryButton}"
        Height="38"
        Margin="8,0,0,0"/>

                        <Button Grid.Column="3"
        Content="REFRESH"
        Click="RefreshBtn_Click"
        Style="{StaticResource CashierOperationalSecondaryButton}"
        Height="38"
        Margin="8,0,0,0"/>
                    </Grid>

                    <!-- CUSTOMER GRID -->
                    <DataGrid Grid.Row="1"
                              x:Name="CustomerDataGrid"
                              Style="{StaticResource CashierOperationalDataGrid}"
                              ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding SelectedCustomer}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="{StaticResource CashierGridLineBrush}"
                              VerticalGridLinesBrush="{StaticResource CashierGridLineBrush}"
                              RowHeight="36"
                              FontSize="14"
                              Background="White"
                              SelectionMode="Single"
                              BorderBrush="{StaticResource CashierBorderBrush}"
                              BorderThickness="1"
                              FontWeight="Normal"
                              Foreground="Black"
                              MouseDoubleClick="CustomerDataGrid_MouseDoubleClick">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code"
                                                Binding="{Binding CustomerCode}"
                                                Width="105"
                                                FontWeight="Bold"/>

                            <DataGridTextColumn Header="Customer / Company"
                                                Binding="{Binding DisplayName}"
                                                Width="*"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource CashierHeaderBrush}"/>

                            <DataGridTextColumn Header="Contact / Phone"
                                                Binding="{Binding DisplaySubName}"
                                                Width="140"/>

                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding DisplayCustomerType}"
                                                Width="85"/>

                            <DataGridTextColumn Header="Loyalty / Discount"
                                                Binding="{Binding DiscountLabel}"
                                                Width="125"/>

                            <DataGridTextColumn Header="Credit"
                                                Binding="{Binding CreditStatusText}"
                                                Width="145"/>

                            <DataGridTextColumn Header="Balance"
                                                Binding="{Binding CurrentBalance, StringFormat={}{0:N2}}"
                                                Width="95"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource CashierDangerBrush}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="0,0,5,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <!-- RIGHT DASHBOARD -->
            <GroupBox Grid.Column="2"
                      Header="Selected Customer Status"
                      FontSize="15"
                      FontWeight="Bold"
                      Foreground="{StaticResource CashierHeaderBrush}"
                      BorderBrush="{StaticResource CashierBorderBrush}"
                      Background="{StaticResource CashierPanelAltBrush}">

                <Border Style="{StaticResource CashierOperationalDetailPanel}"
                        BorderBrush="{StaticResource CashierGridLineBrush}"
                        BorderThickness="1"
                        Padding="12"
                        Margin="5">

                    <Grid>
                        <!-- NO CUSTOMER SELECTED -->
                        <TextBlock Text="Select a customer to view account status."
                                   Foreground="#777"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomerSelected}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- CUSTOMER SELECTED -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomerSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="{Binding DisplayCompanyName}"
                                       FontSize="20"
                                       FontWeight="Heavy"
                                       Foreground="{StaticResource CashierHeaderBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="{Binding DisplayContactName}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource CashierTextBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,0,0,15"/>

                            <Border Style="{StaticResource CashierOperationalMetricPanel}"
                                    BorderBrush="{StaticResource CashierBorderBrush}"
                                    BorderThickness="1"
                                    Padding="8"
                                    Margin="0,0,0,10">

                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Customer Type:" Style="{StaticResource CashierOperationalInlineLabel}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayCustomerType}"
                                                   FontWeight="Heavy"
                                                   Foreground="{StaticResource CashierHeaderBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Discount Status:" Style="{StaticResource CashierOperationalInlineLabel}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayDiscountStatus}"
                                                   FontWeight="Heavy"
                                                   Foreground="{StaticResource CashierSuccessBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Credit Status:" Style="{StaticResource CashierOperationalInlineLabel}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayCreditStatus}"
                                                   FontWeight="Heavy"
                                                   Foreground="{StaticResource CashierDangerBrush}"
                                                   HorizontalAlignment="Right"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CashierOperationalMetricPanel}"
                                    BorderBrush="{StaticResource CashierBorderBrush}"
                                    BorderThickness="1"
                                    Padding="10"
                                    Margin="0,0,0,12">

                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Credit Limit:" Style="{StaticResource CashierOperationalInlineLabel}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CreditLimit, StringFormat=Rs. {0:N2}}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Current Debt:" Style="{StaticResource CashierOperationalInlineLabel}" Foreground="{StaticResource CashierDangerBrush}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CurrentDebt, StringFormat=Rs. {0:N2}}"
                                                   FontSize="17"
                                                   FontWeight="Heavy"
                                                   Foreground="{StaticResource CashierDangerBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Rectangle Height="2" Fill="{StaticResource CashierBorderBrush}" Margin="0,5,0,10"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Available Credit:"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource CashierSuccessBrush}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AvailableCredit, StringFormat=Rs. {0:N2}}"
                                                   FontSize="20"
                                                   FontWeight="Heavy"
                                                   HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource CashierSuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAccountLocked}" Value="True">
                                                            <Setter Property="Foreground" Value="DarkRed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource CashierPanelBrush}"
                                    BorderBrush="{StaticResource CashierDangerBrush}"
                                    BorderThickness="2"
                                    Padding="10"
                                    Margin="0,0,0,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAccountLocked}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <TextBlock Text="{Binding LockReasonText}"
                                           Foreground="{StaticResource CashierDangerBrush}"
                                           FontWeight="Heavy"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Border Style="{StaticResource CashierOperationalInformationPanel}"
                                    BorderThickness="1"
                                    Padding="8">

                                <TextBlock Text="Normal customer attach does not require credit approval. Credit approval is checked only when using Customer Credit payment."
                                           Foreground="{StaticResource CashierTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </GroupBox>
        </Grid>

        <!-- FOOTER -->
        <Grid Grid.Row="2" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="CLOSE"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Style="{StaticResource CashierOperationalSecondaryButton}"
                    Background="{StaticResource CashierNeutralButtonBrush}"/>

            <TextBlock Grid.Column="1"
                       Text="Double-click a customer row or press Attach."
                       Foreground="{StaticResource CashierTextBrush}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="10,0"/>

            <Button Grid.Column="2"
                    Content="{Binding AttachButtonText}"
                    Command="{Binding AttachCommand}"
                    IsDefault="True"
                    IsEnabled="{Binding CanAttachToInvoice}"
                    Style="{StaticResource CashierOperationalSuccessButton}"/>
        </Grid>
    </Grid>
</Window>