<Window x:Class="POS.Cashier.UI.Dialogs.ActiveCartRecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recover Cashier Cart"
        Style="{StaticResource CashierDialogWindow}"
        Width="680"
        Height="430"
        MinWidth="620"
        MinHeight="390"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="76"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CashierTransactionDialogHeader}"
                Margin="10,10,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CashierTransactionHeaderIcon}"
                        Background="#D97706">
                    <TextBlock Text="↻"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="UNFINISHED CART FOUND"
                               Style="{StaticResource CashierDialogTitle}"/>
                    <TextBlock Text="Choose how this terminal should continue"
                               Style="{StaticResource CashierTransactionHeaderSubtitle}"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="ENTER = SELECT   |   ESC = LOG OFF"
                           Style="{StaticResource CashierShortcutHint}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource CashierTransactionContentPanel}"
                Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="An unfinished Cashier cart was recovered. Payment details must be entered again before checkout."
                           TextWrapping="Wrap"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           Margin="0,0,0,14"/>

                <Border Grid.Row="1"
                        Background="#F8FAFC"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Reference"
                                   Style="{StaticResource CashierTransactionFieldLabel}"
                                   Margin="0,0,12,8"/>
                        <TextBlock x:Name="ReferenceTextBlock"
                                   Grid.Row="0" Grid.Column="1"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#0F3B66"
                                   Margin="0,0,24,8"/>

                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="Items"
                                   Style="{StaticResource CashierTransactionFieldLabel}"
                                   Margin="0,0,12,8"/>
                        <TextBlock x:Name="ItemCountTextBlock"
                                   Grid.Row="0" Grid.Column="3"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Cart Value"
                                   Style="{StaticResource CashierTransactionFieldLabel}"
                                   Margin="0,0,12,0"/>
                        <TextBlock x:Name="NetTotalTextBlock"
                                   Grid.Row="1" Grid.Column="1"
                                   Grid.ColumnSpan="3"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#0F3B66"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2"
                           Text="Resume is the normal choice. Cancel Cart opens the existing audited cancellation-reason flow."
                           TextWrapping="Wrap"
                           Foreground="#475569"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,14,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CashierDialogFooter}"
                Margin="10,0,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="LEFT / RIGHT = CHOOSE"
                           Style="{StaticResource CashierTransactionFooterHint}"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="LogOffButton"
                            Content="LOG OFF"
                            Click="LogOffButton_Click"
                            Style="{StaticResource CashierTransactionCancelButton}"
                            Margin="0,0,10,0"/>
                    <Button x:Name="CancelCartButton"
                            Content="CANCEL CART"
                            Click="CancelCartButton_Click"
                            Style="{StaticResource CashierTransactionDangerButton}"
                            Margin="0,0,10,0"/>
                    <Button x:Name="ResumeButton"
                            Content="RESUME CART"
                            IsDefault="True"
                            Click="ResumeButton_Click"
                            Style="{StaticResource CashierTransactionPrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
