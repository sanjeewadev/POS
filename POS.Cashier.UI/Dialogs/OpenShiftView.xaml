<Window x:Class="POS.Cashier.UI.Dialogs.OpenShiftView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start Cashier Shift"
        Height="410"
        Width="520"
        MinHeight="410"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#EEF2F7"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0F3D5E"
                BorderBrush="#0B2D45"
                BorderThickness="1"
                Padding="16">
            <StackPanel>
                <TextBlock Text="START CASHIER SHIFT"
                           Foreground="White"
                           FontSize="21"
                           FontWeight="Bold"/>

                <TextBlock Text="Confirm the terminal and operator before sales begin."
                           Foreground="#DCEAF4"
                           FontSize="12"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                Padding="18">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Terminal"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           VerticalAlignment="Center"/>

                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Text="{Binding TerminalNo}"
                         IsReadOnly="True"
                         Height="32"
                         Padding="8,0"
                         VerticalContentAlignment="Center"
                         Background="#F1F5F9"
                         BorderBrush="#CBD5E1"/>

                <TextBlock Grid.Row="1"
                           Text="Operator"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           VerticalAlignment="Center"/>

                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Text="{Binding CashierName}"
                         IsReadOnly="True"
                         Height="32"
                         Padding="8,0"
                         VerticalContentAlignment="Center"
                         Background="#F1F5F9"
                         BorderBrush="#CBD5E1"/>

                <TextBlock Grid.Row="2"
                           Text="Opening cash"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           VerticalAlignment="Center"/>

                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Text="{Binding OpeningCash, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                         Height="32"
                         Padding="8,0"
                         HorizontalContentAlignment="Right"
                         VerticalContentAlignment="Center"
                         BorderBrush="#CBD5E1"/>

                <Border Grid.Row="3"
                        Grid.ColumnSpan="2"
                        Background="#EFF6FF"
                        BorderBrush="#93C5FD"
                        BorderThickness="1"
                        Padding="10"
                        Margin="0,8,0,0">
                    <TextBlock Text="Enter the physical opening cash already placed in this drawer. Later Float In and Float Out actions are recorded separately."
                               Foreground="#1E3A8A"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </Border>

                <TextBlock Grid.Row="4"
                           Grid.ColumnSpan="2"
                           Text="{Binding ErrorMessage}"
                           Foreground="#B91C1C"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Sales opens only after the shift is confirmed."
                       Foreground="#64748B"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="CANCEL"
                    Click="Cancel_Click"
                    Height="38"
                    MinWidth="105"
                    FontWeight="SemiBold"
                    Background="#E2E8F0"
                    BorderBrush="#94A3B8"/>

            <Button Grid.Column="3"
                    Content="START SHIFT"
                    Click="OpenShift_Click"
                    Height="38"
                    MinWidth="145"
                    FontWeight="Bold"
                    Foreground="White"
                    Background="#0F766E"
                    BorderBrush="#0F766E"/>
        </Grid>
    </Grid>
</Window>
