<Window x:Class="POS.Cashier.UI.Dialogs.OpenShiftView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start Cashier Shift"
        Style="{StaticResource CashierSummaryControlWindow}"
        Width="640"
        Height="430"
        MinWidth="560"
        MinHeight="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        KeyboardNavigation.TabNavigation="Cycle">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CashierSummaryHeader}">
            <DockPanel LastChildFill="True">
                <TextBlock Text="ENTER starts · ESC cancels"
                           Style="{StaticResource CashierShortcutHint}"
                           DockPanel.Dock="Right"
                           Margin="16,0,0,0"/>
                <StackPanel>
                    <TextBlock Text="START CASHIER SHIFT"
                               Style="{StaticResource CashierSummaryHeaderTitle}"/>
                    <TextBlock Text="Confirm the terminal and operator before sales begin."
                               Style="{StaticResource CashierSummaryHeaderSubtitle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16">
            <StackPanel>
                <Border Style="{StaticResource CashierSummarySectionPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="145"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Terminal"
                                   Style="{StaticResource CashierFieldLabel}"/>
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding TerminalNo}"
                                 Style="{StaticResource CashierSummaryReadOnlyTextBox}"/>

                        <TextBlock Grid.Row="2"
                                   Text="Operator"
                                   Style="{StaticResource CashierFieldLabel}"/>
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding CashierName}"
                                 Style="{StaticResource CashierSummaryReadOnlyTextBox}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CashierSummaryInformationPanel}"
                        Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="i"
                                   Foreground="{StaticResource CashierPrimaryDarkBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1"
                                   Text="The shift starts with Rs. 0.00 opening cash. Use FLOAT CASH after opening when cash is added to the drawer."
                                   Foreground="{StaticResource CashierPrimaryDarkBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource CashierValidationText}"
                           Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Style="{StaticResource CashierSummaryFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Sales opens only after the shift is confirmed."
                           Style="{StaticResource CashierSummaryStatusText}"
                           Margin="0,0,12,0"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Content="CANCEL"
                            IsCancel="True"
                            Click="Cancel_Click"
                            Style="{StaticResource CashierSummarySecondaryButton}"
                            MinWidth="110"
                            Margin="0,0,10,0"/>
                    <Button x:Name="StartShiftButton"
                            Content="START SHIFT"
                            IsDefault="True"
                            Click="OpenShift_Click"
                            Style="{StaticResource CashierSummarySuccessButton}"
                            MinWidth="150"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
