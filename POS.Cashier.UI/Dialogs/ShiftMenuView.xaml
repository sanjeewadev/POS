<Window x:Class="POS.Cashier.UI.Dialogs.ShiftMenuView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shift and Security"
        Style="{StaticResource CashierDialogWindow}"
        Width="460"
        Height="680"
        MinWidth="420"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierDialogHeader}">
            <Grid>
                <TextBlock Text="SHIFT AND SECURITY"
                           Style="{StaticResource CashierDialogTitle}"/>
                <TextBlock Text="ESC closes"
                           Style="{StaticResource CashierShortcutHint}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16">
            <StackPanel x:Name="MenuActionsPanel">
                <Border Style="{StaticResource CashierPanel}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="TERMINAL STATUS"
                                   Style="{StaticResource CashierSectionTitle}"
                                   Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,7">
                            <TextBlock Text="Cashier" Style="{StaticResource CashierFieldLabel}"/>
                            <TextBlock x:Name="CashierNameTxt"
                                       Text="Pending..."
                                       Style="{StaticResource CashierReadOnlyValue}"
                                       Foreground="{StaticResource CashierPrimaryBrush}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,7">
                            <TextBlock Text="Shift ID" Style="{StaticResource CashierFieldLabel}"/>
                            <TextBlock x:Name="ShiftIdTxt"
                                       Text="#0000"
                                       Style="{StaticResource CashierReadOnlyValue}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Security level" Style="{StaticResource CashierFieldLabel}"/>
                            <TextBlock x:Name="SecurityStatusTxt"
                                       Text="CASHIER MODE"
                                       Style="{StaticResource CashierReadOnlyValue}"
                                       Foreground="{StaticResource CashierSuccessBrush}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Button x:Name="XReportBtn"
                        Content="X REPORT — LIVE SUMMARY"
                        Style="{StaticResource CashierSuccessButton}"
                        Height="48"
                        Margin="0,0,0,10"
                        Click="XReportBtn_Click"/>

                <Button x:Name="CloseShiftBtn"
                        Content="CLOSE SHIFT / Z REPORT"
                        Style="{StaticResource CashierDangerButton}"
                        Height="48"
                        Margin="0,0,0,10"
                        Click="CloseShiftBtn_Click"/>

                <Button x:Name="CustomerPaymentBtn"
                        Content="CUSTOMER ACCOUNT PAYMENT"
                        Style="{StaticResource CashierPrimaryButton}"
                        Height="48"
                        Margin="0,0,0,10"
                        Click="CustomerPaymentBtn_Click"/>

                <Button x:Name="LockTerminalBtn"
                        Content="LOCK TERMINAL  (F12)"
                        Style="{StaticResource CashierButton}"
                        Height="48"
                        Margin="0,0,0,10"
                        Click="LockTerminalBtn_Click"/>

                <Button x:Name="ToggleManagerBtn"
                        Style="{StaticResource CashierDangerButton}"
                        Height="48"
                        Margin="0,0,0,10"
                        Click="ToggleManagerBtn_Click">
                    <TextBlock x:Name="ToggleManagerTxt" Text="ELEVATE TO MANAGER"/>
                </Button>

                <Button x:Name="LogOffBtn"
                        Content="LOG OFF USER"
                        Style="{StaticResource CashierProtectedButton}"
                        Height="48"
                        Click="LogOffBtn_Click"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource CashierDialogFooter}">
            <Grid>
                <TextBlock x:Name="OperationText"
                           Text="Processing..."
                           Style="{StaticResource CashierMutedText}"
                           Visibility="Collapsed"
                           VerticalAlignment="Center"/>
                <Button x:Name="CloseMenuButton"
                        Content="CLOSE MENU"
                        Style="{StaticResource CashierButton}"
                        Width="130"
                        HorizontalAlignment="Right"
                        IsCancel="True"
                        Click="CloseBtn_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
