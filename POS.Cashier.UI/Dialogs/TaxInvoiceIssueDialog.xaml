<Window x:Class="POS.Cashier.UI.Dialogs.TaxInvoiceIssueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tax Invoice Details"
        Width="560"
        Height="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#D9E2EC"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Margin="10"
            Background="#F8FAFC"
            BorderBrush="#334155"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0F3D5E">
                <TextBlock Text="TAX INVOICE CUSTOMER DETAILS"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="17"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"/>
            </Border>

            <Grid Grid.Row="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                           Text="Confirm the customer details that will be saved permanently with this Tax Invoice."
                           TextWrapping="Wrap"
                           Foreground="#475569"
                           Margin="0,0,0,16"/>

                <TextBlock Grid.Row="1" Text="Customer name *" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox x:Name="CustomerNameTextBox" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,0,0,10" MaxLength="150"/>

                <TextBlock Grid.Row="2" Text="Customer TIN" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox x:Name="CustomerTinTextBox" Grid.Row="2" Grid.Column="1" Height="30" Margin="0,0,0,10" MaxLength="30"/>

                <TextBlock Grid.Row="3" Text="Customer VAT No" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox x:Name="CustomerVatTextBox" Grid.Row="3" Grid.Column="1" Height="30" Margin="0,0,0,10" MaxLength="30"/>

                <TextBlock Grid.Row="4" Text="Address *" VerticalAlignment="Top" Margin="0,6,10,0"/>
                <TextBox x:Name="CustomerAddressTextBox"
                         Grid.Row="4"
                         Grid.Column="1"
                         Height="95"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MaxLength="500"/>

                <TextBlock x:Name="ValidationText"
                           Grid.Row="5"
                           Grid.ColumnSpan="2"
                           Foreground="#DC2626"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0"/>
            </Grid>

            <Border Grid.Row="2"
                    Background="#E5E7EB"
                    BorderBrush="#CBD5E1"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <Button Content="Continue"
                            Width="110"
                            Height="32"
                            Margin="0,0,8,0"
                            FontWeight="SemiBold"
                            Background="#2563EB"
                            Foreground="White"
                            Click="Continue_Click"/>
                    <Button Content="Cancel"
                            Width="95"
                            Height="32"
                            IsCancel="True"
                            Click="Cancel_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
