<Window x:Class="POS.Cashier.UI.Dialogs.TaxInvoiceIssueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tax Invoice Details"
        Style="{StaticResource CashierDialogWindow}"
        Width="580"
        Height="500"
        MinWidth="540"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierDialogHeader}">
            <Grid>
                <TextBlock Text="TAX INVOICE CUSTOMER DETAILS"
                           Style="{StaticResource CashierDialogTitle}"/>
                <TextBlock Text="ENTER continues · ESC cancels"
                           Style="{StaticResource CashierShortcutHint}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CashierPanel}" Margin="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.ColumnSpan="2"
                           Text="Confirm the customer details that will be saved permanently with this Tax Invoice."
                           Style="{StaticResource CashierMutedText}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"/>

                <TextBlock Grid.Row="1" Text="Customer name *" Style="{StaticResource CashierFieldLabel}" Margin="0,0,10,10"/>
                <TextBox x:Name="CustomerNameTextBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource CashierTextBox}" Margin="0,0,0,10" MaxLength="150"/>

                <TextBlock Grid.Row="2" Text="Customer TIN" Style="{StaticResource CashierFieldLabel}" Margin="0,0,10,10"/>
                <TextBox x:Name="CustomerTinTextBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource CashierTextBox}" Margin="0,0,0,10" MaxLength="30"/>

                <TextBlock Grid.Row="3" Text="Customer VAT No" Style="{StaticResource CashierFieldLabel}" Margin="0,0,10,10"/>
                <TextBox x:Name="CustomerVatTextBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource CashierTextBox}" Margin="0,0,0,10" MaxLength="30"/>

                <TextBlock Grid.Row="4" Text="Address *" Style="{StaticResource CashierFieldLabel}" VerticalAlignment="Top" Margin="0,6,10,0"/>
                <TextBox x:Name="CustomerAddressTextBox"
                         Grid.Row="4"
                         Grid.Column="1"
                         Style="{StaticResource CashierTextBox}"
                         Height="100"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MaxLength="500"/>

                <TextBlock x:Name="ValidationText"
                           Grid.Row="5"
                           Grid.ColumnSpan="2"
                           Style="{StaticResource CashierValidationText}"
                           MinHeight="18"
                           Margin="0,14,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CashierDialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL"
                        Style="{StaticResource CashierButton}"
                        IsCancel="True"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>
                <Button Content="CONTINUE"
                        Style="{StaticResource CashierPrimaryButton}"
                        MinWidth="120"
                        IsDefault="True"
                        Click="Continue_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
