<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="CashierDialogWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource CashierWindowBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource CashierTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="ShowInTaskbar" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="CashierDialogHeader" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CashierHeaderBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CashierHeaderDarkBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="MinHeight" Value="50"/>
    </Style>

    <Style x:Key="CashierDialogTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="CashierPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CashierPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CashierBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style x:Key="CashierDialogFooter" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CashierPanelAltBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CashierBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <Style x:Key="CashierStatusPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CashierPanelAltBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CashierBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="9,7"/>
    </Style>

</ResourceDictionary>
