<UserControl x:Class="POS.Cashier.UI.Components.TenderNumpadControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="250"
             MinHeight="390"
             Focusable="False">

    <Border Background="{StaticResource CashierPanelAltBrush}"
            BorderBrush="{StaticResource CashierBorderDarkBrush}"
            BorderThickness="1"
            Padding="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource CashierHeaderBrush}"
                    BorderBrush="{StaticResource CashierHeaderDarkBrush}"
                    BorderThickness="1"
                    Padding="8,0">
                <Grid>
                    <TextBlock Text="{Binding HeaderText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>

                    <TextBlock Text="{Binding ModeText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="{StaticResource CashierHeaderHintBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="#151B26"
                    BorderBrush="#080B10"
                    BorderThickness="2"
                    Margin="0,6,0,6"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding TargetLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="#AEB6C0"
                               FontSize="10"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="1"
                               Text="{Binding TargetText, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=0}"
                               Foreground="#FFD24A"
                               FontSize="27"
                               FontWeight="Bold"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.08*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0"
                        Content="7" Tag="7"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="0" Grid.Column="1"
                        Content="8" Tag="8"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="0" Grid.Column="2"
                        Content="9" Tag="9"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="0" Grid.Column="3"
                        Content="⌫" Tag="BACK"
                        Style="{StaticResource CashierNumpadActionButton}"
                        Background="{StaticResource CashierDangerBrush}"
                        BorderBrush="{StaticResource CashierDangerDarkBrush}"
                        FontSize="23"
                        Click="Key_Click"/>

                <Button Grid.Row="1" Grid.Column="0"
                        Content="4" Tag="4"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="1" Grid.Column="1"
                        Content="5" Tag="5"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="1" Grid.Column="2"
                        Content="6" Tag="6"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="1" Grid.Column="3"
                        Content="CLEAR" Tag="CLR"
                        Style="{StaticResource CashierNumpadActionButton}"
                        Background="{StaticResource CashierWarningBrush}"
                        BorderBrush="{StaticResource CashierWarningDarkBrush}"
                        FontSize="14"
                        Click="Key_Click"/>

                <Button Grid.Row="2" Grid.Column="0"
                        Content="1" Tag="1"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="2" Grid.Column="1"
                        Content="2" Tag="2"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="2" Grid.Column="2"
                        Content="3" Tag="3"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="2" Grid.Column="3"
                        Grid.RowSpan="2"
                        Content="ENTER" Tag="ENTER"
                        Style="{StaticResource CashierNumpadActionButton}"
                        Background="{StaticResource CashierSuccessBrush}"
                        BorderBrush="{StaticResource CashierSuccessDarkBrush}"
                        FontSize="17"
                        Click="Key_Click"/>

                <Button x:Name="DoubleZeroButton"
                        Grid.Row="3" Grid.Column="0"
                        Content="00" Tag="00"
                        Style="{StaticResource CashierNumpadButton}"
                        FontSize="21"
                        Click="Key_Click"/>
                <Button Grid.Row="3" Grid.Column="1"
                        Content="0" Tag="0"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button x:Name="DecimalButton"
                        Grid.Row="3" Grid.Column="2"
                        Content="." Tag="."
                        Style="{StaticResource CashierNumpadButton}"
                        FontSize="28"
                        Click="Key_Click"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
