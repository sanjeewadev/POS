<UserControl x:Class="POS.Cashier.UI.Components.TenderNumpadControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="280"
             MinHeight="360"
             Focusable="False">

    <Border Style="{StaticResource CashierTransactionNumpadPanel}">
        <Grid>
            <!-- Single row: buttons only -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="-2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.08*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0"
                        Content="7" Tag="7"
                        AutomationProperties.Name="Numpad 7"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="0" Grid.Column="1"
                        Content="8" Tag="8"
                        AutomationProperties.Name="Numpad 8"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="0" Grid.Column="2"
                        Content="9" Tag="9"
                        AutomationProperties.Name="Numpad 9"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="0" Grid.Column="3"
                        Content="BACK" Tag="BACK"
                        AutomationProperties.Name="Numpad backspace"
                        Style="{StaticResource CashierNumpadActionButton}"
                        Background="{StaticResource CashierTransactionBackBrush}"
                        BorderBrush="{StaticResource CashierTransactionBackBorderBrush}"
                        FontSize="12"
                        Click="Key_Click"/>

                <Button Grid.Row="1" Grid.Column="0"
                        Content="4" Tag="4"
                        AutomationProperties.Name="Numpad 4"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="1" Grid.Column="1"
                        Content="5" Tag="5"
                        AutomationProperties.Name="Numpad 5"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="1" Grid.Column="2"
                        Content="6" Tag="6"
                        AutomationProperties.Name="Numpad 6"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="1" Grid.Column="3"
                        Content="CLEAR" Tag="CLR"
                        AutomationProperties.Name="Clear cash amount"
                        Style="{StaticResource CashierNumpadActionButton}"
                        Background="{StaticResource CashierTransactionClearBrush}"
                        BorderBrush="{StaticResource CashierTransactionClearBorderBrush}"
                        FontSize="12"
                        Click="Key_Click"/>

                <Button Grid.Row="2" Grid.Column="0"
                        Content="1" Tag="1"
                        AutomationProperties.Name="Numpad 1"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="2" Grid.Column="1"
                        Content="2" Tag="2"
                        AutomationProperties.Name="Numpad 2"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="2" Grid.Column="2"
                        Content="3" Tag="3"
                        AutomationProperties.Name="Numpad 3"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button x:Name="EnterButton"
                        Grid.Row="2" Grid.Column="3"
                        Grid.RowSpan="2"
                        Content="ENTER" Tag="ENTER"
                        AutomationProperties.Name="Confirm entered cash amount"
                        Style="{StaticResource CashierNumpadActionButton}"
                        Background="{StaticResource CashierTransactionEnterBrush}"
                        BorderBrush="{StaticResource CashierTransactionEnterBorderBrush}"
                        FontSize="16"
                        IsEnabled="{Binding IsEnterEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Click="Key_Click"/>

                <Button x:Name="DoubleZeroButton"
                        Grid.Row="3" Grid.Column="0"
                        Content="00" Tag="00"
                        AutomationProperties.Name="Numpad double zero"
                        Style="{StaticResource CashierNumpadButton}"
                        FontSize="21"
                        Click="Key_Click"/>
                <Button Grid.Row="3" Grid.Column="1"
                        Content="0" Tag="0"
                        AutomationProperties.Name="Numpad zero"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button x:Name="DecimalButton"
                        Grid.Row="3" Grid.Column="2"
                        Content="." Tag="."
                        AutomationProperties.Name="Numpad decimal point"
                        Style="{StaticResource CashierNumpadButton}"
                        FontSize="27"
                        Click="Key_Click"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>