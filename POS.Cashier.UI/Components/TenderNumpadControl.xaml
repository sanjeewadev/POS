<UserControl x:Class="POS.Cashier.UI.Components.TenderNumpadControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="270"
             MinHeight="400"
             Focusable="False">

    <Border Background="#F6F8FB"
            BorderBrush="#AEBAC8"
            BorderThickness="1"
            CornerRadius="3"
            Padding="8"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#0A335D"
                    BorderBrush="#062341"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="10,0">
                <Grid>
                    <TextBlock Text="{Binding HeaderText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>

                    <TextBlock Text="{Binding ModeText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="#D4E2F0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="#0D2746"
                    BorderBrush="#061A30"
                    BorderThickness="1"
                    CornerRadius="2"
                    Margin="0,7,0,7"
                    Padding="10,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="17"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding TargetLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="#D4E2F0"
                               FontSize="10"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="1"
                               Text="{Binding TargetText, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=0}"
                               Foreground="#FFD34D"
                               FontSize="29"
                               FontWeight="Bold"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="-2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.08*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0"
                        Content="7" Tag="7"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="0" Grid.Column="1"
                        Content="8" Tag="8"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="0" Grid.Column="2"
                        Content="9" Tag="9"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="0" Grid.Column="3"
                        Content="⌫" Tag="BACK"
                        Style="{StaticResource CashierNumpadActionButton}"
                        Background="#C62D32"
                        BorderBrush="#9F1F24"
                        FontSize="24"
                        Click="Key_Click"/>

                <Button Grid.Row="1" Grid.Column="0"
                        Content="4" Tag="4"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="1" Grid.Column="1"
                        Content="5" Tag="5"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="1" Grid.Column="2"
                        Content="6" Tag="6"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="1" Grid.Column="3"
                        Content="CLEAR" Tag="CLR"
                        Style="{StaticResource CashierNumpadActionButton}"
                        Background="#C67A00"
                        BorderBrush="#9D6100"
                        FontSize="13"
                        Click="Key_Click"/>

                <Button Grid.Row="2" Grid.Column="0"
                        Content="1" Tag="1"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="2" Grid.Column="1"
                        Content="2" Tag="2"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="2" Grid.Column="2"
                        Content="3" Tag="3"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button Grid.Row="2" Grid.Column="3"
                        Grid.RowSpan="2"
                        Content="ENTER" Tag="ENTER"
                        Style="{StaticResource CashierNumpadActionButton}"
                        Background="#16875C"
                        BorderBrush="#0E6846"
                        FontSize="16"
                        Click="Key_Click"/>

                <Button x:Name="DoubleZeroButton"
                        Grid.Row="3" Grid.Column="0"
                        Content="00" Tag="00"
                        Style="{StaticResource CashierNumpadButton}"
                        FontSize="21"
                        Click="Key_Click"/>
                <Button Grid.Row="3" Grid.Column="1"
                        Content="0" Tag="0"
                        Style="{StaticResource CashierNumpadButton}"
                        Click="Key_Click"/>
                <Button x:Name="DecimalButton"
                        Grid.Row="3" Grid.Column="2"
                        Content="." Tag="."
                        Style="{StaticResource CashierNumpadButton}"
                        FontSize="27"
                        Click="Key_Click"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
