<Window x:Class="POS.Cashier.UI.Views.SalesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sales Checkout"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Background="{StaticResource MainBgBrush}"
        FontFamily="Segoe UI, Arial"
        FontSize="13"
        PreviewTextInput="Window_PreviewTextInput"
        PreviewKeyDown="Window_PreviewKeyDown"
        Activated="SalesView_Activated">

    <Window.Resources>
        <ContextMenu x:Key="MoreContextMenu">
            <MenuItem Header="Lock Terminal (F12)" Click="LockTerminalMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="Shift Menu (F11)" Click="ShiftMenuMenuItem_Click"/>
        </ContextMenu>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Native readable selection colors -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#123A66"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#123A66"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>

        <!-- =========================================================
             PROFESSIONAL TERMINAL TYPOGRAPHY
             ========================================================= -->

        <Style TargetType="TextBlock" x:Key="TopBarTitleText">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="TopBarSmallText">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="HeaderLabel">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBox" x:Key="LockedInput">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,2,10,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- =========================================================
             BUTTON STYLE
             ========================================================= -->

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FeatureIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <StackPanel Margin="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="28"
                                           FontWeight="Black"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,3"/>

                                <ContentPresenter HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrintFeatureIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="24"
                                           FontWeight="Black"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,3"/>

                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactTextButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="2"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardLogoButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="#F8FAFC"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <StackPanel Margin="8,5,8,4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="82"
                                        Height="32"
                                        Background="{TemplateBinding Background}"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>

                                <ContentPresenter HorizontalAlignment="Center"
                                                  Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MasterCardLogoButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="#F8FAFC"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <StackPanel Margin="8,5,8,4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="94"
                                        Height="37"
                                        Background="{TemplateBinding Background}"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>

                                <ContentPresenter HorizontalAlignment="Center"
                                                  Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VisaLogoButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="#F8FAFC"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <StackPanel Margin="8,5,8,4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="75"
                                        Height="29"
                                        Background="{TemplateBinding Background}"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>

                                <ContentPresenter HorizontalAlignment="Center"
                                                  Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AmexLogoButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="#F8FAFC"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <StackPanel Margin="8,5,8,4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="103"
                                        Height="40"
                                        Background="{TemplateBinding Background}"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>

                                <ContentPresenter HorizontalAlignment="Center"
                                                  Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryFeatureIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <StackPanel Margin="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="34"
                                           FontWeight="Black"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,2"/>

                                <ContentPresenter HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryTextButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="2"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RightActionIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="24"
                                           FontWeight="Black"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =========================================================
             NATIVE CART TABLE STYLE
             ========================================================= -->

        <Style TargetType="DataGridColumnHeader" x:Key="NativeCartHeaderStyle">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridRow" x:Key="NativeCartRowStyle">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAF4FF"/>
                </Trigger>

                <!-- Remove the left BorderThickness on the row (this was causing the layout shift) -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1d3b7d"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#60A5FA"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell" x:Key="NativeCartCellStyle">
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="NativeCartItemText">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGridRow}}}"
                             Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="NativeCartCenterText">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGridRow}}}"
                             Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="NativeCartRightText">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,6,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGridRow}}}"
                             Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="NativeCartAmountText" BasedOn="{StaticResource NativeCartRightText}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="NativeCartDiscountText" BasedOn="{StaticResource NativeCartCenterText}">
            <Setter Property="Foreground" Value="#B91C1C"/>
        </Style>

        <!-- =========================================================
             TOTALS / STATUS TEXT
             ========================================================= -->

        <Style TargetType="TextBlock" x:Key="SmallStatusText">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="TotalSmallValueText">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="43"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- =========================================================
             PROFESSIONAL TOP BAR
             ========================================================= -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBgBrush}"
                Margin="0,0,0,2"
                BorderBrush="#0F172A"
                BorderThickness="1">

            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Store / terminal identity -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding StoreDisplayName}"
                               Style="{StaticResource TopBarTitleText}"
                               MaxWidth="320"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,14,0"/>

                    <Border Background="#334155"
                            BorderBrush="#475569"
                            BorderThickness="1"
                            Padding="8,3"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding TerminalDisplayName}"
                                   Style="{StaticResource TopBarSmallText}"/>
                    </Border>
                </StackPanel>

                <!-- Compact notification / operational message -->
                <Border Grid.Column="1"
                        Visibility="{Binding IsNotificationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="#F8FAFC"
                        BorderBrush="{Binding NotificationColor}"
                        BorderThickness="4,1,1,1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MinWidth="360"
                        MaxWidth="680"
                        Padding="10,4"
                        Margin="12,0">

                    <TextBlock Text="{Binding NotificationMessage}"
                               Foreground="#0F172A"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <!-- Operator / mode / date -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Border x:Name="NumLockWarningBorder"
                            Visibility="Collapsed"
                            Background="#7F1D1D"
                            BorderBrush="#FCA5A5"
                            BorderThickness="1"
                            Padding="8,3"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="NUM LOCK OFF"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="Bold"/>
                    </Border>

                    <Button Content="LOCK  F12"
                            Click="LockTerminalBtn_Click"
                            Height="28"
                            MinWidth="96"
                            Padding="10,0"
                            Margin="0,0,12,0"
                            Background="#F59E0B"
                            BorderBrush="#D97706"
                            Foreground="#111827"
                            FontSize="12"
                            FontWeight="Bold"
                            Cursor="Hand"/>

                    <TextBlock Text="{Binding SecurityStatusMode}"
                               Foreground="#BFDBFE"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding CashierName}"
                               Foreground="#E2E8F0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding CurrentDate, StringFormat=yyyy-MM-dd HH:mm:ss}"
                               Foreground="#FDBA74"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =========================================================
             MAIN
             ========================================================= -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="8*"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>

            <!-- TOP PANEL -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: CART -->
                <Grid Grid.Column="0"
                      Margin="0,0,2,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- INFO PANEL -->
                    <Border Grid.Row="0"
                            Background="{StaticResource InfoPanelBgBrush}"
                            Padding="8"
                            Margin="0,0,0,2"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Terminal" Style="{StaticResource HeaderLabel}" Grid.Row="0" Grid.Column="0"/>
                            <TextBox Text="{Binding TerminalDisplayName}" Style="{StaticResource LockedInput}" Grid.Row="0" Grid.Column="1"/>

                            <TextBlock Text="Shift" Style="{StaticResource HeaderLabel}" Grid.Row="1" Grid.Column="0"/>
                            <TextBox Text="{Binding ShiftDisplayText}" Style="{StaticResource LockedInput}" Grid.Row="1" Grid.Column="1"/>

                            <TextBlock Text="Date" Style="{StaticResource HeaderLabel}" Grid.Row="0" Grid.Column="2"/>
                            <TextBox Text="{Binding CurrentDate, StringFormat=yyyy-MM-dd}" Style="{StaticResource LockedInput}" Grid.Row="0" Grid.Column="3"/>

                            <TextBlock Text="Cashier" Style="{StaticResource HeaderLabel}" Grid.Row="1" Grid.Column="2"/>
                            <TextBox Text="{Binding CashierName}" Style="{StaticResource LockedInput}" Grid.Row="1" Grid.Column="3"/>

                            <TextBlock Text="Customer" Style="{StaticResource HeaderLabel}" Grid.Row="0" Grid.Column="4"/>
                            <TextBox Text="{Binding CustomerName}" Style="{StaticResource LockedInput}" Background="White" Grid.Row="0" Grid.Column="5"/>

                            <TextBlock Text="Mode" Style="{StaticResource HeaderLabel}" Grid.Row="1" Grid.Column="4"/>
                            <TextBox Text="{Binding TerminalInputMode}" Style="{StaticResource LockedInput}" Grid.Row="1" Grid.Column="5"/>

                            <TextBlock Text="Invoice" Style="{StaticResource HeaderLabel}" Grid.Row="0" Grid.Column="6"/>
                            <TextBox Text="{Binding InvoiceNo}" Style="{StaticResource LockedInput}" Foreground="#7F1D1D" Grid.Row="0" Grid.Column="7"/>

                            <TextBlock Text="Input" Style="{StaticResource HeaderLabel}" Grid.Row="1" Grid.Column="6"/>
                            <TextBox Text="{Binding TerminalInput}"
                                     Style="{StaticResource LockedInput}"
                                     Background="#FEF9C3"
                                     Foreground="#7F1D1D"
                                     FontSize="13"
                                     Grid.Row="1"
                                     Grid.Column="7"/>
                        </Grid>
                    </Border>

                    <!-- CART TABLE - NATIVE COMPACT CASHIER STYLE -->
                    <DataGrid x:Name="CartDataGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding Cart}"
                              SelectedItem="{Binding SelectedCartItem, Mode=TwoWay}"
                              SelectionChanged="CartDataGrid_SelectionChanged"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeColumns="True"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeight="38"
                              FontSize="14"
                              Background="White"
                              BorderBrush="#1E293B"
                              BorderThickness="1"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#CBD5E1"
                              VerticalGridLinesBrush="#E2E8F0"
                              AlternationCount="2"
                              RowStyle="{StaticResource NativeCartRowStyle}"
                              ColumnHeaderStyle="{StaticResource NativeCartHeaderStyle}"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Focusable="True"
                              KeyboardNavigation.TabNavigation="None"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ITEM"
                                                Binding="{Binding CashierItemDisplay}"
                                                Width="*"
                                                MinWidth="320"
                                                IsReadOnly="True"
                                                CellStyle="{StaticResource NativeCartCellStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NativeCartItemText}">
                                        <Setter Property="Margin" Value="6,0,0,0"/>
                                    </Style>

                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="QTY"
                                                Binding="{Binding SmartQuantityText}"
                                                Width="85"
                                                IsReadOnly="True"
                                                CellStyle="{StaticResource NativeCartCellStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NativeCartCenterText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="PRICE"
                                                Binding="{Binding UnitPrice, StringFormat={}{0:N2}}"
                                                Width="110"
                                                IsReadOnly="True"
                                                CellStyle="{StaticResource NativeCartCellStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NativeCartRightText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="DISC"
                                                Binding="{Binding DiscountDisplayText}"
                                                Width="95"
                                                IsReadOnly="True"
                                                CellStyle="{StaticResource NativeCartCellStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NativeCartDiscountText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="AMOUNT"
                                                Binding="{Binding FinalLineAmount, StringFormat={}{0:N2}}"
                                                Width="125"
                                                IsReadOnly="True"
                                                CellStyle="{StaticResource NativeCartCellStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NativeCartAmountText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- TOTALS -->
                    <Border Grid.Row="2"
                            Background="{StaticResource TotalsPanelBgBrush}"
                            Padding="8"
                            BorderBrush="#0F172A"
                            BorderThickness="1"
                            Margin="0,2,0,0">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,6">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>

                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding PaymentStatusText}"
                                               
                                               VerticalAlignment="Center"
                                               Background="{Binding PaymentStatusColor}"
                                               Foreground="White"
                                               Padding="8,2"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="2,0"
                                               MaxWidth="250"
                                               TextTrimming="CharacterEllipsis"/>

                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                           Text="NET VALUE"
                                               TextAlignment="Right"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           Margin="0,0,18,0"/>


                                </Grid>

                                <Border Grid.Column="1"
                                        Background="White"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        Padding="2">

                                    <TextBlock Text="{Binding NetValue, StringFormat=N2}"
                                               FontSize="38"
                                               FontWeight="Bold"
                                               Foreground="#0F3B66"
                                               TextAlignment="Right"/>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1.05*"/>
                                    <ColumnDefinition Width="1.05*"/>
                                    <ColumnDefinition Width="0.75*"/>
                                    <ColumnDefinition Width="1.05*"/>
                                    <ColumnDefinition Width="1.05*"/>
                                    <ColumnDefinition Width="1.05*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Gross / Discount / Items"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <Border Grid.Column="1"
                                        Background="White"
                                        Margin="0,0,6,0"
                                        Padding="1"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1">

                                    <TextBlock Text="{Binding GrossValue, StringFormat={}{0:N2}}"
                                               TextAlignment="Right"
                                               Style="{StaticResource TotalSmallValueText}"/>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="White"
                                        Margin="0,0,6,0"
                                        Padding="1"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1">

                                    <TextBlock Text="{Binding TotalDiscount, StringFormat={}{0:N2}}"
                                               TextAlignment="Right"
                                               Foreground="#7F1D1D"
                                               Style="{StaticResource TotalSmallValueText}"/>
                                </Border>

                                <Border Grid.Column="3"
                                        Background="White"
                                        Margin="0,0,8,0"
                                        Padding="1"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1">

                                    <TextBlock Text="{Binding TotalItems}"
                                               TextAlignment="Center"
                                               Style="{StaticResource TotalSmallValueText}"/>
                                </Border>

                                <Border Grid.Column="4"
                                        Background="#ECFDF5"
                                        Margin="0,0,6,0"
                                        Padding="2"
                                        BorderBrush="#10B981"
                                        BorderThickness="1">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="PAID"
                                                   Foreground="#065F46"
                                                   Margin="0,0,5,0"
                                                   Style="{StaticResource SmallStatusText}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding PaidTotal, StringFormat={}{0:N2}}"
                                                   Foreground="#065F46"
                                                   TextAlignment="Right"
                                                   Style="{StaticResource SmallStatusText}"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="5"
                                        Background="#FFF7ED"
                                        Margin="0,0,6,0"
                                        Padding="2"
                                        BorderBrush="#D97706"
                                        BorderThickness="1">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="BAL"
                                                   Foreground="#9A3412"
                                                   Margin="0,0,5,0"
                                                   Style="{StaticResource SmallStatusText}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding BalanceDue, StringFormat={}{0:N2}}"
                                                   Foreground="#9A3412"
                                                   TextAlignment="Right"
                                                   Style="{StaticResource SmallStatusText}"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="6"
                                        Background="#ECFDF5"
                                        Margin="0,0,8,0"
                                        Padding="2"
                                        BorderBrush="#047857"
                                        BorderThickness="1">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="CHG"
                                                   Foreground="#047857"
                                                   Margin="0,0,5,0"
                                                   Style="{StaticResource SmallStatusText}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding BalanceReturned, StringFormat={}{0:N2}}"
                                                   Foreground="#047857"
                                                   TextAlignment="Right"
                                                   Style="{StaticResource SmallStatusText}"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#EFF6FF" BorderBrush="#60A5FA" BorderThickness="1" Padding="4" Margin="0,0,5,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="TAXABLE" Foreground="#1E3A8A" FontSize="11" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding TaxableAmountTotal, StringFormat={}{0:N2}}" Foreground="#1E3A8A" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1" Padding="4" Margin="0,0,5,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="VAT" Foreground="#991B1B" FontSize="11" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding TotalVatAmount, StringFormat={}{0:N2}}" Foreground="#991B1B" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#F0FDF4" BorderBrush="#4ADE80" BorderThickness="1" Padding="4" Margin="0,0,5,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ZERO" Foreground="#166534" FontSize="11" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding ZeroRatedAmount, StringFormat={}{0:N2}}" Foreground="#166534" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Background="#FFFBEB" BorderBrush="#FBBF24" BorderThickness="1" Padding="4" Margin="0,0,5,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="EXEMPT" Foreground="#92400E" FontSize="11" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding ExemptAmount, StringFormat={}{0:N2}}" Foreground="#92400E" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="1" Padding="4" Margin="0,0,5,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="O/S" Foreground="#334155" FontSize="11" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding OutOfScopeAmount, StringFormat={}{0:N2}}" Foreground="#334155" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="5" Background="#FAF5FF" BorderBrush="#C084FC" BorderThickness="1" Padding="4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="INV DISC" Foreground="#6B21A8" FontSize="12" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding InvoiceDiscountAmount, StringFormat={}{0:N2}}" Foreground="#6B21A8" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Column="6"
                                           Text="{Binding TaxSummaryStatusText}"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           MaxWidth="250"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- RIGHT: ACTIONS AND NUMPAD -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4*"/>
                        <RowDefinition Height="6*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="3" Rows="4" Margin="0,0,0,1">
                        <Button Background="{StaticResource ActionBtnBrush}" Content="Suspend (F6)" Click="SuspendBtn_Click"/>
                        <Button Background="{StaticResource ActionBtnBrush}" Content="Recall (F7)" Click="RecallBtn_Click"/>
                        <Button Background="{StaticResource ActionBtnBrush}" Content="Return" Click="ReturnBtn_Click"/>

                        <Button Background="{StaticResource ActionBtnBrush}" Content="Line Disc (F3)" Click="FixedDiscountBtn_Click"/>
                        <Button Background="{StaticResource ActionBtnBrush}" Content="% Disc (Shift+F3)" Click="PercentDiscountBtn_Click"/>
                        <Button Background="{StaticResource ActionBtnBrush}" Content="Float Cash" Click="FloatCashBtn_Click"/>

                        <Button Background="{StaticResource ActionBtnBrush}" Content="Qty (F2 / *)" Click="QtyBtn_Click"/>
                        <Button Background="{StaticResource ActionBtnBrush}" Content="Inv Disc (F4)" Click="InvoiceDiscountBtn_Click"/>
                        <Button Background="{StaticResource ActionBtnBrush}" Content="Drawer" Click="DrawerBtn_Click"/>


                        <Button Background="{StaticResource ActionBtnBrush}"
                                Style="{StaticResource RightActionIconButtonStyle}"
                                
                                Content="Search (F1)"
                                Click="SeekBtn_Click"/>
                        <Button Background="{StaticResource ActionBtnBrush}" Content="Remove (Del / -)" Click="RemoveBtn_Click"/>
                        <Button Background="{StaticResource CancelBtnBrush}"
                                Style="{StaticResource RightActionIconButtonStyle}"
                                Tag="&#xE711;"
                                Content="Cancel"
                                Click="CancelSaleBtn_Click"/>
                    </UniformGrid>

                    <UniformGrid Grid.Row="1"
                                 Columns="3"
                                 Rows="5"
                                 Background="#0E3A47">

                        <Button Background="#292727"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Style="{StaticResource RightActionIconButtonStyle}"
                                Tag="&#xE751;"
                                Content="Enter"
                                FontSize="13"
                                Click="EnterBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content=":)"
                                FontSize="18"
                                IsEnabled="False"
                                ToolTip="Reserved"/>


                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="&lt;&lt;"
                                FontSize="16"
                                Click="BackspaceBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="7"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="8"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="9"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="4"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="5"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="6"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="1"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="2"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="3"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="Clear"
                                FontSize="13"
                                Click="ClearBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="0"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="."
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>
                    </UniformGrid>
                </Grid>
            </Grid>

            <!-- BOTTOM PANEL -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <UniformGrid Grid.Column="0" Columns="5" Rows="3" Margin="0,0,1,0">

                    <Button Background="#2563EB"
                            Foreground="White"
                            Style="{StaticResource PrintFeatureIconButtonStyle}"
                            Tag="&#xE749;"
                            Content="Print"
                            Click="PrintBtn_Click"/>

                    <Button Background="{StaticResource SystemBtnBrush}"
                            Style="{StaticResource CompactTextButtonStyle}"
                            Content="Paid In"
                            Click="PaidInBtn_Click"/>

                    <Button Background="{StaticResource SystemBtnBrush}"
                            Style="{StaticResource CompactTextButtonStyle}"
                            Content="Paid Out"
                            Click="PaidOutBtn_Click"/>

                    <Button Background="{StaticResource ActionBtnBrush}"
                            Style="{StaticResource CompactTextButtonStyle}"
                            Content="{Binding PricingModeButtonText}"
                            Click="PricingModeBtn_Click"/>

                    <Button Background="{StaticResource ExpressBtnBrush}"
                            Foreground="White"
                            Style="{StaticResource CompactTextButtonStyle}"
                            Content="Express Items"
                            FontSize="13"
                            Click="ExpressItemsBtn_Click"/>

                    <Button Background="{StaticResource ActionBtnBrush}"
                            Style="{StaticResource CompactTextButtonStyle}"
                            Content="Stock Inq."
                            Click="StockInquiryBtn_Click"/>
                   

                    <Button Background="{StaticResource ActionBtnBrush}"
                            Style="{StaticResource CompactTextButtonStyle}"
                            Content="Sell Voucher"
                            Click="SellVoucherBtn_Click"/>
                    
                    <Button Background="{StaticResource ActionBtnBrush}"
                            Style="{StaticResource CompactTextButtonStyle}"
                            Content="No Sale"
                            Click="NoSaleBtn_Click"/>

                    <Button Background="{StaticResource ActionBtnBrush}"
                            Style="{StaticResource CompactTextButtonStyle}"
                            Content="New Price"
                            Click="NewPriceBtn_Click"/>

                    <Button Background="{StaticResource ActionBtnBrush}"
                            Style="{StaticResource CompactTextButtonStyle}"
                            Content="Free"
                            Click="FreeBtn_Click"/>

                    <Button x:Name="MoreBtn"
                            Background="{StaticResource SystemBtnBrush}"
                            Style="{StaticResource FeatureIconButtonStyle}"
                            Tag="&#xE712;"
                            Content="More"
                            Click="MoreBtn_Click"/>

                    <Button Background="{StaticResource ActionBtnBrush}"
                            Style="{StaticResource CompactTextButtonStyle}"
                            Content="Refresh =)"
                            Click="ReloadBtn_Click"/>

                    <Button Background="{StaticResource ActionBtnBrush}"
                            Style="{StaticResource CompactTextButtonStyle}"
                            Content="Customer R."
                            Click="CustomerRegisterBtn_Click"/>

                    <Button Background="{StaticResource ActionBtnBrush}"
                            Style="{StaticResource CompactTextButtonStyle}"
                            Content="Customer  F5"
                            Click="CustomerBtn_Click"/>

                    <Button Background="{StaticResource LoyaltyBgBrush}"
                            Foreground="#FACC15"
                            Style="{StaticResource FeatureIconButtonStyle}"
                            Tag="&#xE735;"
                            Content="LOYALTY"
                            FontSize="14"
                            />

                </UniformGrid>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.8*"/>
                    </Grid.ColumnDefinitions>

                    <UniformGrid Grid.Column="0" Columns="3" Rows="2" Margin="0,0,1,0">
                        <Button Style="{StaticResource MasterCardLogoButtonStyle}"
                                Content="MasterCard"
                                ToolTip="MasterCard"
                                Click="PayBtn_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="/POS.Cashier.UI;component/Resources/PaymentLogos/mastercard.png"
                                            Stretch="Uniform"/>
                            </Button.Background>
                        </Button>

                        <Button Style="{StaticResource VisaLogoButtonStyle}"
                                Content="VISA"
                                ToolTip="VISA"
                                Click="PayBtn_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="/POS.Cashier.UI;component/Resources/PaymentLogos/visa.png"
                                            Stretch="Uniform"/>
                            </Button.Background>
                        </Button>

                        <Button Style="{StaticResource AmexLogoButtonStyle}"
                                Content="AMEX"
                                ToolTip="American Express"
                                Click="PayBtn_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="/POS.Cashier.UI;component/Resources/PaymentLogos/amex.png"
                                            Stretch="Uniform"/>
                            </Button.Background>
                        </Button>

                        <Button Background="{StaticResource PaymentDarkOrangeBrush}"
                                Foreground="Black"
                                Style="{StaticResource FeatureIconButtonStyle}"
                                Tag="&#xE77B;"
                                Content="Cust Credit"
                                Click="PayBtn_Click"/>

                        <Button Background="{StaticResource PaymentOrangeBrush}"
                                Foreground="Black"
                                Style="{StaticResource FeatureIconButtonStyle}"
                                Tag="&#xE7C3;"
                                Content="Cheque"
                                Click="AlternatePaymentBtn_Click"/>

                        <Button Background="{StaticResource PaymentOrangeBrush}"
                                Foreground="Black"
                                Style="{StaticResource FeatureIconButtonStyle}"
                                Tag="&#xE7B8;"
                                Content="Gift Voucher"
                                FontSize="13"
                                />
                    </UniformGrid>

                    <Button Grid.Column="1"
                        Background="{StaticResource SubTotalBtnBrush}"
                        Style="{StaticResource PrimaryFeatureIconButtonStyle}"
                        Tag="&#xE8EF;"
                        FontSize="18"
                        Margin="0,1,1,1"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="SubTotalBtn_Click">
                        <Button.Content>
                            <TextBlock TextAlignment="Center">
                                <Run Text="Sub Total" FontSize="20"/>
                                <LineBreak/>
                                <Run Text="(F10)" FontSize="18"/>
                            </TextBlock>
                        </Button.Content>
                    </Button>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0"
                                Background="{StaticResource PluBtnBrush}"
                                Style="{StaticResource PrimaryFeatureIconButtonStyle}"
                                Tag="&#xEC5A;"
                                Content="Search (F1)"
                                FontSize="20"
                                Margin="0,1,1,1"
                                Click="SeekBtn_Click"/>

                        <Button Grid.Row="1"
                                Background="{StaticResource CashBtnBrush}"
                                Style="{StaticResource PrimaryFeatureIconButtonStyle}"
                                Tag="&#xEC59;"
                                Content="Cash (F8 / +)"
                                FontSize="20"
                                Margin="0,1,1,1"
                                Click="PayBtn_Click"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Border Background="#D90F2742"
                Grid.RowSpan="10"
                Grid.ColumnSpan="10"
                Panel.ZIndex="1000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCheckoutInProgress}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="PROCESSING SALE"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Please wait. Scanner and payment keys are temporarily locked."
                           Foreground="#DBEAFE"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border x:Name="DimmingCurtain"
                Background="#90000000"
                Visibility="Collapsed"
                Grid.RowSpan="10"
                Grid.ColumnSpan="10"
                Panel.ZIndex="999"/>
    </Grid>
</Window>
