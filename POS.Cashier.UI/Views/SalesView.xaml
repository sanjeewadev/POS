<Window x:Class="POS.Cashier.UI.Views.SalesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sales Checkout"
        WindowState="Maximized"
        WindowStyle="None"
        Background="{StaticResource MainBgBrush}"
        FontFamily="Segoe UI, Arial"
        FontSize="13"
        PreviewTextInput="Window_PreviewTextInput"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Native readable selection colors -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D7EBFF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#D7EBFF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>

        <!-- =========================================================
             PROFESSIONAL TERMINAL TYPOGRAPHY
             ========================================================= -->

        <Style TargetType="TextBlock" x:Key="TopBarTitleText">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="TopBarSmallText">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="HeaderLabel">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBox" x:Key="LockedInput">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,2,10,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- =========================================================
             BUTTON STYLE
             ========================================================= -->

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =========================================================
             NATIVE CART TABLE STYLE
             ========================================================= -->

        <Style TargetType="DataGridColumnHeader" x:Key="NativeCartHeaderStyle">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridRow" x:Key="NativeCartRowStyle">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAF4FF"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D7EBFF"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell" x:Key="NativeCartCellStyle">
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D7EBFF"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="NativeCartItemText">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="NativeCartCenterText">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="NativeCartRightText">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,6,0"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="NativeCartAmountText" BasedOn="{StaticResource NativeCartRightText}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="NativeCartDiscountText" BasedOn="{StaticResource NativeCartCenterText}">
            <Setter Property="Foreground" Value="#B91C1C"/>
        </Style>

        <!-- =========================================================
             TOTALS / STATUS TEXT
             ========================================================= -->

        <Style TargetType="TextBlock" x:Key="SmallStatusText">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="TotalSmallValueText">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="43"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- =========================================================
             PROFESSIONAL TOP BAR
             ========================================================= -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBgBrush}"
                Margin="0,0,0,2"
                BorderBrush="#0F172A"
                BorderThickness="1">

            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Store / terminal identity -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding StoreDisplayName}"
                               Style="{StaticResource TopBarTitleText}"
                               MaxWidth="320"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,14,0"/>

                    <Border Background="#334155"
                            BorderBrush="#475569"
                            BorderThickness="1"
                            Padding="8,3"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding TerminalDisplayName}"
                                   Style="{StaticResource TopBarSmallText}"/>
                    </Border>
                </StackPanel>

                <!-- Compact notification / operational message -->
                <Border Grid.Column="1"
                        Visibility="{Binding IsNotificationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="#F8FAFC"
                        BorderBrush="{Binding NotificationColor}"
                        BorderThickness="4,1,1,1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MinWidth="360"
                        MaxWidth="620"
                        Padding="10,4"
                        Margin="12,0">

                    <TextBlock Text="{Binding NotificationMessage}"
                               Foreground="#0F172A"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <!-- Operator / mode / date -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button Content="LOCK  F12"
                            Click="LockTerminalBtn_Click"
                            Height="28"
                            MinWidth="96"
                            Padding="10,0"
                            Margin="0,0,12,0"
                            Background="#F59E0B"
                            BorderBrush="#D97706"
                            Foreground="#111827"
                            FontSize="12"
                            FontWeight="Bold"
                            Cursor="Hand"/>

                    <TextBlock Text="{Binding SecurityStatusMode}"
                               Foreground="#BFDBFE"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding CashierName}"
                               Foreground="#E2E8F0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding CurrentDate, StringFormat=yyyy-MM-dd HH:mm:ss}"
                               Foreground="#FDBA74"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =========================================================
             MAIN
             ========================================================= -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="8*"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>

            <!-- TOP PANEL -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: CART -->
                <Grid Grid.Column="0"
                      Margin="0,0,2,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- INFO PANEL -->
                    <Border Grid.Row="0"
                            Background="{StaticResource InfoPanelBgBrush}"
                            Padding="8"
                            Margin="0,0,0,2"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Terminal" Style="{StaticResource HeaderLabel}" Grid.Row="0" Grid.Column="0"/>
                            <TextBox Text="{Binding TerminalDisplayName}" Style="{StaticResource LockedInput}" Grid.Row="0" Grid.Column="1"/>

                            <TextBlock Text="Shift" Style="{StaticResource HeaderLabel}" Grid.Row="1" Grid.Column="0"/>
                            <TextBox Text="{Binding ShiftDisplayText}" Style="{StaticResource LockedInput}" Grid.Row="1" Grid.Column="1"/>

                            <TextBlock Text="Date" Style="{StaticResource HeaderLabel}" Grid.Row="0" Grid.Column="2"/>
                            <TextBox Text="{Binding CurrentDate, StringFormat=yyyy-MM-dd}" Style="{StaticResource LockedInput}" Grid.Row="0" Grid.Column="3"/>

                            <TextBlock Text="Cashier" Style="{StaticResource HeaderLabel}" Grid.Row="1" Grid.Column="2"/>
                            <TextBox Text="{Binding CashierName}" Style="{StaticResource LockedInput}" Grid.Row="1" Grid.Column="3"/>

                            <TextBlock Text="Customer" Style="{StaticResource HeaderLabel}" Grid.Row="0" Grid.Column="4"/>
                            <TextBox Text="{Binding CustomerName}" Style="{StaticResource LockedInput}" Background="White" Grid.Row="0" Grid.Column="5"/>

                            <TextBlock Text="Mode" Style="{StaticResource HeaderLabel}" Grid.Row="1" Grid.Column="4"/>
                            <TextBox Text="{Binding TerminalInputMode}" Style="{StaticResource LockedInput}" Grid.Row="1" Grid.Column="5"/>

                            <TextBlock Text="Invoice" Style="{StaticResource HeaderLabel}" Grid.Row="0" Grid.Column="6"/>
                            <TextBox Text="{Binding InvoiceNo}" Style="{StaticResource LockedInput}" Foreground="#7F1D1D" Grid.Row="0" Grid.Column="7"/>

                            <TextBlock Text="Input" Style="{StaticResource HeaderLabel}" Grid.Row="1" Grid.Column="6"/>
                            <TextBox Text="{Binding TerminalInput}"
                                     Style="{StaticResource LockedInput}"
                                     Background="#FEF9C3"
                                     Foreground="#7F1D1D"
                                     FontSize="13"
                                     Grid.Row="1"
                                     Grid.Column="7"/>
                        </Grid>
                    </Border>

                    <!-- CART TABLE - NATIVE COMPACT CASHIER STYLE -->
                    <DataGrid x:Name="CartDataGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding Cart}"
                              SelectedItem="{Binding SelectedCartItem, Mode=TwoWay}"
                              SelectionChanged="CartDataGrid_SelectionChanged"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeColumns="True"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeight="38"
                              FontSize="14"
                              Background="White"
                              BorderBrush="#1E293B"
                              BorderThickness="1"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#CBD5E1"
                              VerticalGridLinesBrush="#E2E8F0"
                              AlternationCount="2"
                              RowStyle="{StaticResource NativeCartRowStyle}"
                              ColumnHeaderStyle="{StaticResource NativeCartHeaderStyle}"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Focusable="True"
                              KeyboardNavigation.TabNavigation="None"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ITEM"
                                                Binding="{Binding CashierItemDisplay}"
                                                Width="*"
                                                MinWidth="320"
                                                IsReadOnly="True"
                                                CellStyle="{StaticResource NativeCartCellStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NativeCartItemText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="QTY"
                                                Binding="{Binding SmartQuantityText}"
                                                Width="85"
                                                IsReadOnly="True"
                                                CellStyle="{StaticResource NativeCartCellStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NativeCartCenterText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="PRICE"
                                                Binding="{Binding UnitPrice, StringFormat={}{0:N2}}"
                                                Width="110"
                                                IsReadOnly="True"
                                                CellStyle="{StaticResource NativeCartCellStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NativeCartRightText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="DISC"
                                                Binding="{Binding DiscountDisplayText}"
                                                Width="95"
                                                IsReadOnly="True"
                                                CellStyle="{StaticResource NativeCartCellStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NativeCartDiscountText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="AMOUNT"
                                                Binding="{Binding FinalLineAmount, StringFormat={}{0:N2}}"
                                                Width="125"
                                                IsReadOnly="True"
                                                CellStyle="{StaticResource NativeCartCellStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NativeCartAmountText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- TOTALS -->
                    <Border Grid.Row="2"
                            Background="{StaticResource TotalsPanelBgBrush}"
                            Padding="12"
                            BorderBrush="#0F172A"
                            BorderThickness="1"
                            Margin="0,2,0,0">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,8">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="NET VALUE"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           Margin="0,0,18,0"/>

                                <Border Grid.Column="1"
                                        Background="White"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        Padding="5">

                                    <TextBlock Text="{Binding NetValue, StringFormat=N2}"
                                               FontSize="38"
                                               FontWeight="Bold"
                                               Foreground="#7F1D1D"
                                               TextAlignment="Right"/>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1.05*"/>
                                    <ColumnDefinition Width="1.05*"/>
                                    <ColumnDefinition Width="0.75*"/>
                                    <ColumnDefinition Width="1.05*"/>
                                    <ColumnDefinition Width="1.05*"/>
                                    <ColumnDefinition Width="1.05*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Gross / Discount / Items"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <Border Grid.Column="1"
                                        Background="White"
                                        Margin="0,0,6,0"
                                        Padding="2"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1">

                                    <TextBlock Text="{Binding GrossValue, StringFormat={}{0:N2}}"
                                               TextAlignment="Right"
                                               Style="{StaticResource TotalSmallValueText}"/>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="White"
                                        Margin="0,0,6,0"
                                        Padding="2"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1">

                                    <TextBlock Text="{Binding TotalDiscount, StringFormat={}{0:N2}}"
                                               TextAlignment="Right"
                                               Foreground="#7F1D1D"
                                               Style="{StaticResource TotalSmallValueText}"/>
                                </Border>

                                <Border Grid.Column="3"
                                        Background="White"
                                        Margin="0,0,8,0"
                                        Padding="2"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1">

                                    <TextBlock Text="{Binding TotalItems}"
                                               TextAlignment="Center"
                                               Style="{StaticResource TotalSmallValueText}"/>
                                </Border>

                                <Border Grid.Column="4"
                                        Background="#ECFDF5"
                                        Margin="0,0,6,0"
                                        Padding="3"
                                        BorderBrush="#10B981"
                                        BorderThickness="1">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="PAID"
                                                   Foreground="#065F46"
                                                   Margin="0,0,5,0"
                                                   Style="{StaticResource SmallStatusText}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding PaidTotal, StringFormat={}{0:N2}}"
                                                   Foreground="#065F46"
                                                   TextAlignment="Right"
                                                   Style="{StaticResource SmallStatusText}"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="5"
                                        Background="#FFF7ED"
                                        Margin="0,0,6,0"
                                        Padding="3"
                                        BorderBrush="#D97706"
                                        BorderThickness="1">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="BAL"
                                                   Foreground="#9A3412"
                                                   Margin="0,0,5,0"
                                                   Style="{StaticResource SmallStatusText}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding BalanceDue, StringFormat={}{0:N2}}"
                                                   Foreground="#9A3412"
                                                   TextAlignment="Right"
                                                   Style="{StaticResource SmallStatusText}"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="6"
                                        Background="#ECFDF5"
                                        Margin="0,0,8,0"
                                        Padding="3"
                                        BorderBrush="#047857"
                                        BorderThickness="1">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="CHG"
                                                   Foreground="#047857"
                                                   Margin="0,0,5,0"
                                                   Style="{StaticResource SmallStatusText}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding BalanceReturned, StringFormat={}{0:N2}}"
                                                   Foreground="#047857"
                                                   TextAlignment="Right"
                                                   Style="{StaticResource SmallStatusText}"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="7" Orientation="Horizontal">
                                    <TextBlock Text="{Binding PaymentStatusText}"
                                               Background="#020617"
                                               Foreground="White"
                                               Padding="8,2"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="2,0"
                                               MaxWidth="250"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="Printer ON"
                                               Background="#DCFCE7"
                                               Foreground="#166534"
                                               Padding="8,2"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="2,0"/>

                                    <TextBlock Text="LAN"
                                               Background="#DCFCE7"
                                               Foreground="#166534"
                                               Padding="8,2"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="2,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#EFF6FF" BorderBrush="#60A5FA" BorderThickness="1" Padding="4" Margin="0,0,5,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="TAXABLE" Foreground="#1E3A8A" FontSize="10" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding TaxableAmountTotal, StringFormat={}{0:N2}}" Foreground="#1E3A8A" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1" Padding="4" Margin="0,0,5,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="VAT" Foreground="#991B1B" FontSize="10" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding TotalVatAmount, StringFormat={}{0:N2}}" Foreground="#991B1B" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#F0FDF4" BorderBrush="#4ADE80" BorderThickness="1" Padding="4" Margin="0,0,5,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ZERO" Foreground="#166534" FontSize="10" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding ZeroRatedAmount, StringFormat={}{0:N2}}" Foreground="#166534" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Background="#FFFBEB" BorderBrush="#FBBF24" BorderThickness="1" Padding="4" Margin="0,0,5,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="EXEMPT" Foreground="#92400E" FontSize="10" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding ExemptAmount, StringFormat={}{0:N2}}" Foreground="#92400E" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="1" Padding="4" Margin="0,0,5,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="O/S" Foreground="#334155" FontSize="10" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding OutOfScopeAmount, StringFormat={}{0:N2}}" Foreground="#334155" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="5" Background="#FAF5FF" BorderBrush="#C084FC" BorderThickness="1" Padding="4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="INV DISC" Foreground="#6B21A8" FontSize="10" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding InvoiceDiscountAmount, StringFormat={}{0:N2}}" Foreground="#6B21A8" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Column="6"
                                           Text="{Binding TaxSummaryStatusText}"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           MaxWidth="250"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- RIGHT: ACTIONS AND NUMPAD -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="5*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="3" Rows="4" Margin="0,0,0,1">
                        <Button Background="{StaticResource ActionBtnBrush}" Content="Return" Click="ReturnBtn_Click"/>
                        <Button Background="{StaticResource ActionBtnBrush}" Content="Inv Disc" Click="InvoiceDiscountBtn_Click"/>
                        <Button Background="{StaticResource ActionBtnBrush}" Content="Rs Disc" Click="FixedDiscountBtn_Click"/>

                        <Button Background="{StaticResource ActionBtnBrush}" Content="Suspend" Click="SuspendRecallBtn_Click"/>
                        <Button Background="{StaticResource ActionBtnBrush}" Content="Recall" Click="SuspendRecallBtn_Click"/>
                        <Button Background="{StaticResource ActionBtnBrush}" Content="Qty" Click="QtyBtn_Click"/>

                        <Button Background="{StaticResource ActionBtnBrush}" Content="Float Cash" Click="FloatCashBtn_Click"/>
                        <Button Background="{StaticResource ActionBtnBrush}" Content="% Disc" Click="PercentDiscountBtn_Click"/>
                        <Button Background="{StaticResource ActionBtnBrush}" Content="Drawer" Click="DrawerBtn_Click"/>

                        <Button Background="{StaticResource ActionBtnBrush}" Content="Seek" Click="SeekBtn_Click"/>
                        <Button Background="{StaticResource ActionBtnBrush}" Content="Remove" Click="RemoveBtn_Click"/>
                        <Button Background="{StaticResource CancelBtnBrush}" Content="Cancel" Click="CancelSaleBtn_Click"/>
                    </UniformGrid>

                    <UniformGrid Grid.Row="1"
                                 Columns="3"
                                 Rows="6"
                                 Background="#0E3A47">

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="(-)"
                                FontSize="15"
                                Click="QtyBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="+"
                                FontSize="18"
                                Click="PlusBtn_Click"/>

                        <Button Background="#991B1B"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="Enter"
                                FontSize="14"
                                Click="EnterBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="/"
                                FontSize="18"
                                Click="PercentDiscountBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="-"
                                FontSize="18"
                                Click="MinusBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="&lt;&lt;"
                                FontSize="16"
                                Click="BackspaceBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="7"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="8"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="9"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="4"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="5"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="6"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="1"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="2"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="3"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="Clear"
                                FontSize="13"
                                Click="ClearBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="0"
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>

                        <Button Background="#0E3A47"
                                BorderBrush="#B9CDD4"
                                Foreground="White"
                                Content="."
                                FontSize="25"
                                FontWeight="SemiBold"
                                Click="NumpadBtn_Click"/>
                    </UniformGrid>
                </Grid>
            </Grid>

            <!-- BOTTOM PANEL -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <UniformGrid Grid.Column="0" Columns="5" Rows="3" Margin="0,0,2,0">

                    <Button Background="#2563EB"
                            Foreground="White"
                            Content="Print"
                            Click="PrintBtn_Click"/>

                    <Button Background="{StaticResource SystemBtnBrush}"
                            Content="Paid In"
                            Click="PaidInBtn_Click"/>

                    <Button Background="{StaticResource SystemBtnBrush}"
                            Content="Paid Out"
                            Click="PaidOutBtn_Click"/>

                    <Button Background="{StaticResource ActionBtnBrush}"
                            Content="Reload"/>

                    <Button Background="{StaticResource ExpressBtnBrush}"
                            Foreground="White"
                            Content="Express Items"
                            FontSize="12"
                            Click="ExpressItemsBtn_Click"/>

                    <Button Background="{StaticResource ActionBtnBrush}"
                            Content="Stock Inq."
                            Click="StockInquiryBtn_Click"/>

                    <Button Background="{StaticResource ActionBtnBrush}"
                            Content="Sell Voucher"
                            Click="SellVoucherBtn_Click"/>

                    <Button Background="{StaticResource ActionBtnBrush}"
                            Content="Customer R."
                            Click="CustomerRegisterBtn_Click"/>

                    <Button Background="{StaticResource ActionBtnBrush}"
                            Content="Customer"
                            Click="CustomerBtn_Click"/>

                    <Button Background="{StaticResource ActionBtnBrush}"
                            Content="Retail"/>

                    <Button x:Name="MoreBtn"
                            Background="{StaticResource SystemBtnBrush}"
                            Content="More"
                            Click="MoreBtn_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Lock Terminal (F12)" Click="LockTerminalBtn_Click"/>
                                <Separator/>
                                <MenuItem Header="Reports" Click="ReportsBtn_Click"/>
                                <MenuItem Header="Shift Menu (F11)" Click="ShiftMenuBtn_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Background="{StaticResource ActionBtnBrush}"
                            Content="No Sale"
                            Click="NoSaleBtn_Click"/>

                    <Button Background="{StaticResource ActionBtnBrush}"
                            Content="New Price"
                            Click="NewPriceBtn_Click"/>

                    <Button Background="{StaticResource ActionBtnBrush}"
                            Content="Free"
                            Click="FreeBtn_Click"/>

                    <Button Background="{StaticResource ActionBtnBrush}"
                            Content="Disc Rule"
                            FontSize="12"
                            Click="DiscountRuleBtn_Click"/>
                </UniformGrid>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4.5*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.6*"/>
                    </Grid.ColumnDefinitions>

                    <UniformGrid Grid.Column="0" Columns="4" Rows="2" Margin="0,0,2,0">
                        <Button Background="{StaticResource PaymentDarkOrangeBrush}"
                                Foreground="Black"
                                Content="Cust Credit"
                                Click="PayBtn_Click"/>

                        <Button Background="#F8FAFC"
                                Foreground="#B91C1C"
                                Content="MasterCard"
                                FontWeight="SemiBold"
                                Click="PayBtn_Click"/>

                        <Button Background="#F8FAFC"
                                Foreground="#1E3A8A"
                                Content="VISA"
                                FontSize="16"
                                FontWeight="Bold"
                                Click="PayBtn_Click"/>

                        <Button Background="#F8FAFC"
                                Foreground="#2563EB"
                                Content="AMEX"
                                FontSize="15"
                                FontWeight="Bold"
                                Click="PayBtn_Click"/>

                        <Button Background="{StaticResource PaymentDarkOrangeBrush}"
                                Foreground="Black"
                                Content="Credit Note"
                                Click="UnsupportedPaymentBtn_Click"/>

                        <Button Background="{StaticResource PaymentOrangeBrush}"
                                Foreground="Black"
                                Content="Cheque"
                                Click="UnsupportedPaymentBtn_Click"/>

                        <Button Background="{StaticResource LoyaltyBgBrush}"
                                Foreground="#FACC15"
                                Content="LOYALTY"
                                FontSize="14"
                                Click="LoyaltyBtn_Click"/>

                        <Button Background="{StaticResource PaymentOrangeBrush}"
                                Foreground="Black"
                                Content="Gift Voucher"
                                FontSize="12"
                                Click="UnsupportedPaymentBtn_Click"/>
                    </UniformGrid>

                    <Button Grid.Column="1"
                            Background="{StaticResource SubTotalBtnBrush}"
                            Content="Sub&#x0a;Total"
                            FontSize="18"
                            Margin="0,0,1,0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="SubTotalBtn_Click"/>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0"
                                Background="{StaticResource PluBtnBrush}"
                                Content="PLU"
                                FontSize="18"
                                Margin="0,0,0,1"
                                Click="SeekBtn_Click"/>

                        <Button Grid.Row="1"
                                Background="{StaticResource CashBtnBrush}"
                                Content="Cash"
                                FontSize="26"
                                FontWeight="Bold"
                                Click="PayBtn_Click"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Border x:Name="DimmingCurtain"
                Background="#90000000"
                Visibility="Collapsed"
                Grid.RowSpan="10"
                Grid.ColumnSpan="10"
                Panel.ZIndex="999"/>
    </Grid>
</Window>
