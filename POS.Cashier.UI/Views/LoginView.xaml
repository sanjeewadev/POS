<Window x:Class="POS.Cashier.UI.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cashier Login"
        Style="{StaticResource CashierDialogWindow}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        Height="480"
        Width="520"
        FocusManager.FocusedElement="{Binding ElementName=UsernameTextBox}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CashierDialogHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="CASHIER LOGIN"
                               Style="{StaticResource CashierDialogTitle}"/>
                    <TextBlock Text="Secure terminal access"
                               Foreground="{StaticResource CashierHeaderHintBrush}"
                               FontSize="11"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="ENTER = LOGIN"
                           Style="{StaticResource CashierShortcutHint}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource CashierPanel}"
                Margin="0,10,0,10"
                Padding="24,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource CashierStatusPanel}"
                        Margin="0,0,0,16">
                    <TextBlock Text="{Binding LockoutMessage}"
                               Foreground="{StaticResource CashierHeaderBrush}"
                               FontSize="13"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </Border>

                <TextBlock Grid.Row="1"
                           Text="Username"
                           Style="{StaticResource CashierFieldLabel}"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="UsernameTextBox"
                         Grid.Row="2"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource CashierTextBox}"
                         Margin="0,0,0,12"/>

                <TextBlock Grid.Row="3"
                           Text="Password"
                           Style="{StaticResource CashierFieldLabel}"
                           Margin="0,0,0,5"/>

                <PasswordBox x:Name="txtPassword"
                             Grid.Row="4"
                             PasswordChanged="txtPassword_PasswordChanged"
                             Style="{StaticResource CashierPasswordBox}"/>

                <Border Grid.Row="5"
                        Style="{StaticResource CashierStatusPanel}"
                        Margin="0,14,0,0"
                        MinHeight="46">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource CashierDangerBrush}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CashierDialogFooter}"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Use the cashier assigned to the open shift."
                           Style="{StaticResource CashierMutedText}"
                           TextWrapping="Wrap"/>

                <Button Grid.Column="1"
                        Content="LOGIN"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=txtPassword}"
                        Style="{StaticResource CashierPrimaryButton}"
                        IsDefault="True"
                        Height="38"/>
            </Grid>
        </Border>
    </Grid>
</Window>
