<Window x:Class="POS.BackOffice.UI.Views.FirstRunAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Initial Administrator Setup"
        Height="590"
        Width="520"
        MinHeight="500"
        MinWidth="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="ToolWindow"
        Background="#F3F4F6">

    <Grid Margin="24">
        <Border Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="6"
                Padding="24">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="INITIAL ADMINISTRATOR SETUP"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           HorizontalAlignment="Center"/>

                <TextBlock Grid.Row="1"
                           Margin="0,8,0,18"
                           Text="No system users were found. Create the store's first administrator account."
                           Foreground="#475569"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="First name"
                                   FontWeight="SemiBold"/>

                        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34"
                                 Margin="0,5,0,12"
                                 MaxLength="50"/>

                        <TextBlock Text="Last name"
                                   FontWeight="SemiBold"/>

                        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34"
                                 Margin="0,5,0,12"
                                 MaxLength="50"/>

                        <TextBlock Text="Username"
                                   FontWeight="SemiBold"/>

                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34"
                                 Margin="0,5,0,12"
                                 MaxLength="50"/>

                        <TextBlock Text="Password"
                                   FontWeight="SemiBold"/>

                        <PasswordBox x:Name="PasswordInput"
                                     Height="34"
                                     Margin="0,5,0,12"
                                     MaxLength="128"/>

                        <TextBlock Text="Confirm password"
                                   FontWeight="SemiBold"/>

                        <PasswordBox x:Name="ConfirmPasswordInput"
                                     Height="34"
                                     Margin="0,5,0,8"
                                     MaxLength="128"/>

                        <TextBlock Text="Use at least 6 characters with at least one letter and one number."
                                   Foreground="#64748B"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,8,4"/>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="3"
                           Text="{Binding ErrorMessage}"
                           Foreground="#B91C1C"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           MinHeight="28"
                           MaxHeight="60"
                           Margin="0,0,0,10"/>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="EXIT SETUP"
                            Height="42"
                            Click="ExitButton_Click"/>

                    <Button x:Name="CreateButton"
                            Grid.Column="2"
                            Content="CREATE ADMINISTRATOR"
                            Height="42"
                            FontWeight="Bold"
                            IsDefault="True"
                            Click="CreateButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
