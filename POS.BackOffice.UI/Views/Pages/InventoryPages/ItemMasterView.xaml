<UserControl x:Class="POS.BackOffice.UI.Views.Pages.InventoryPages.ItemMasterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1400"
             Loaded="UserControl_Loaded"
             Background="{DynamicResource WindowBackgroundBrush}"
             FontFamily="Segoe UI"
             FontSize="12">

    <UserControl.Resources>

        <Style TargetType="TextBlock" x:Key="HeaderLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="InlineLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <Style TargetType="TextBox" x:Key="ClassicInput">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource WhiteBackgroundBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonDefaultBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource ButtonDefaultBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox" x:Key="ClassicCombo">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource WhiteBackgroundBrush}"/>
        </Style>

        <Style TargetType="Button" x:Key="ClassicBtn">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="{DynamicResource ButtonDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="ActionBtn" BasedOn="{StaticResource ClassicBtn}">
            <Setter Property="Background" Value="{DynamicResource ActionBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WhiteBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBoxBorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ActionHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Border" x:Key="ClassicGroupBox">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="TabItem" x:Key="ClassicTab">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource WhiteBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource DataGridHeaderBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <Style TargetType="DataGridCell" x:Key="BaseCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource LightSelectionBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell" x:Key="FrozenCell" BasedOn="{StaticResource BaseCell}">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
        </Style>

        <Style TargetType="DataGridCell" x:Key="RetailCell" BasedOn="{StaticResource BaseCell}">
            <Setter Property="Background" Value="{DynamicResource HighlightBackgroundBrush}"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="410"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource HeaderTextBrush}"
                Padding="8"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="ITEM DATABASE"
                               Foreground="{DynamicResource WhiteBackgroundBrush}"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding MasterSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}"
                                 Margin="0,0,5,0"
                                 ToolTip="Search item code, name, category, SKU, barcode, or variant. Press Enter or click Search.">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchItemsCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="1"
                                Content="SEARCH"
                                Command="{Binding SearchItemsCommand}"
                                Style="{StaticResource ClassicBtn}"
                                Padding="10,0"
                                Margin="0,0,5,0"/>

                        <Button Grid.Column="2"
                                Content="REFRESH"
                                Command="{Binding RefreshDatabaseCommand}"
                                Style="{StaticResource ClassicBtn}"
                                Padding="10,0"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="145"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Type:"
                                   Foreground="{DynamicResource WhiteBackgroundBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="2,0,6,0"/>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ItemTypeFilters}"
                                  SelectedItem="{Binding SelectedItemTypeFilter, Mode=TwoWay}"
                                  Style="{StaticResource ClassicCombo}"
                                  ToolTip="Filter the Item Database without changing the selected item's type."/>

                        <CheckBox Grid.Column="3"
                                  Content="Include Deactivated Items"
                                  IsChecked="{Binding IncludeDeactivatedItems, Mode=TwoWay}"
                                  Foreground="{DynamicResource WhiteBackgroundBrush}"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Margin="2,0,0,0"/>
                    </Grid>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedDatabaseItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="{DynamicResource LightBorderBrush}"
                          VerticalGridLinesBrush="{DynamicResource LightBorderBrush}"
                          RowHeight="26"
                          HeadersVisibility="Column"
                          Background="{DynamicResource WhiteBackgroundBrush}"
                          BorderThickness="0"
                          SelectionMode="Single"
                          AlternatingRowBackground="{DynamicResource DataGridAlternatingRow}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource BaseCell}"/>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code"
                                            Binding="{Binding ItemCode, Mode=OneWay}"
                                            Width="95"
                                            FontWeight="Bold"/>

                        <DataGridTextColumn Header="Name"
                                            Binding="{Binding ItemName, Mode=OneWay}"
                                            Width="*"
                                            MinWidth="120"
                                            FontWeight="SemiBold"/>

                        <DataGridTextColumn Header="Type"
                                            Binding="{Binding ItemTypeText, Mode=OneWay}"
                                            Width="78"/>

                        <DataGridTextColumn Header="Vars"
                                            Binding="{Binding VariantCount, Mode=OneWay}"
                                            Width="45">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding StatusText, Mode=OneWay}"
                                            Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Padding="8"
                    Margin="0,0,0,5">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="DELETE UNUSED ITEM"
                            Command="{Binding DeleteUnusedItemCommand}"
                            Style="{StaticResource ClassicBtn}"
                            Foreground="{DynamicResource WarningTextBrush}"
                            BorderBrush="{DynamicResource WarningTextBrush}"
                            Margin="0,0,6,0"
                            ToolTip="Permanently deletes only unused items. Blocked if stock, transactions, batches, or supplier links exist."/>

                    <Button Grid.Column="1"
                            Content="DEACTIVATE ITEM"
                            Command="{Binding DeactivateItemCommand}"
                            Style="{StaticResource ClassicBtn}"
                            Foreground="{DynamicResource WarningTextBrush}"
                            BorderBrush="{DynamicResource WarningTextBrush}"
                            Margin="0,0,6,0"
                            ToolTip="Safe for used items. Keeps sales, GRN, stock, and report history."/>

                    <Button Grid.Column="2"
                            Content="REACTIVATE ITEM"
                            Command="{Binding ReactivateItemCommand}"
                            Style="{StaticResource ClassicBtn}"
                            Foreground="{DynamicResource SuccessBorderBrush}"
                            BorderBrush="{DynamicResource SuccessBorderBrush}"
                            Margin="0,0,8,0"/>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="8,0">
                        <Border Background="{DynamicResource WhiteBackgroundBrush}"
                                BorderBrush="{DynamicResource LightBorderBrush}"
                                BorderThickness="1"
                                Padding="8,3"
                                Margin="0,0,10,0">
                            <TextBlock>
                                <Run Text="Status: "/>
                                <Run Text="{Binding ItemStatusText, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button Grid.Column="4"
                            Content="CLEAR"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource ClassicBtn}"
                            Margin="0,0,10,0"/>

                    <Button Grid.Column="5"
                            Content="SAVE FULL ITEM"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource ActionBtn}"
                            Padding="20,0"
                            FontSize="13"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource ClassicGroupBox}">
                <StackPanel>
                    <TextBlock Text="1. CLASSIFICATION &amp; IDENTITY"
                               Style="{StaticResource HeaderLabel}"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Category *"
                                   Style="{StaticResource InlineLabel}"
                                   Foreground="{DynamicResource HeaderTextBrush}"/>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                  DisplayMemberPath="CategoryName"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="CategoryName"
                                  IsEnabled="{Binding IsSetupEditable}"
                                  Style="{StaticResource ClassicCombo}"/>

                        <TextBlock Grid.Column="3"
                                   Text="Sub-Cat"
                                   Style="{StaticResource InlineLabel}"
                                   Foreground="{DynamicResource HeaderTextBrush}"/>

                        <ComboBox Grid.Column="4"
                                  ItemsSource="{Binding SubCategories}"
                                  SelectedItem="{Binding SelectedSubCategory, Mode=TwoWay}"
                                  DisplayMemberPath="SubCategoryName"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="SubCategoryName"
                                  IsEnabled="{Binding IsSetupEditable}"
                                  Style="{StaticResource ClassicCombo}"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Item Type *"
                                   Style="{StaticResource InlineLabel}"
                                   Foreground="{DynamicResource HeaderTextBrush}"/>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ItemTypes}"
                                  SelectedItem="{Binding SelectedItemType, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  IsEditable="False"
                                  IsEnabled="{Binding IsSetupEditable}"
                                  Style="{StaticResource ClassicCombo}"/>

                        <TextBlock Grid.Column="3"
                                   Text="Setup Safety"
                                   Style="{StaticResource InlineLabel}"/>

                        <TextBlock Grid.Column="4"
                                   Text="{Binding StructureSafetyText, Mode=OneWay}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Border Background="{DynamicResource HighlightBackgroundBrush}"
                            BorderBrush="{DynamicResource LightBorderBrush}"
                            BorderThickness="1"
                            Padding="6"
                            Margin="0,0,0,6">
                        <TextBlock Text="{Binding SelectedItemTypeDescription, Mode=OneWay}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Item Code *"
                                   Style="{StaticResource InlineLabel}"
                                   Foreground="{DynamicResource WarningTextBrush}"/>

                        <Border Grid.Column="1"
                                BorderBrush="{DynamicResource InputBoxBorderBrush}"
                                BorderThickness="1"
                                Height="24">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource WhiteBackgroundBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCodeReadOnly}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ButtonDefaultBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{DynamicResource ButtonDefaultBrush}"
                                        BorderBrush="{DynamicResource LightBorderBrush}"
                                        BorderThickness="0,0,1,0">

                                    <TextBlock Text="{Binding ItemPrefix}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Padding="6,0"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"/>
                                </Border>

                                <TextBox Grid.Column="1"
                                         Text="{Binding ItemSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding IsCodeReadOnly}"
                                         IsEnabled="{Binding IsSetupEditable}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         Padding="4,0"
                                         CharacterCasing="Upper"
                                         FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Column="3"
                                   Text="Item Name *"
                                   Style="{StaticResource InlineLabel}"
                                   Foreground="{DynamicResource WarningTextBrush}"/>

                        <TextBox Grid.Column="4"
                                 Text="{Binding CurrentItem.ItemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}"
                                 FontWeight="Bold"
                                 MaxLength="150"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Print Name"
                                   Style="{StaticResource InlineLabel}"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding CurrentItem.PrintName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}"
                                 MaxLength="50"/>

                        <TextBlock Grid.Column="3"
                                   Text="Base UOM *"
                                   Style="{StaticResource InlineLabel}"
                                   Foreground="{DynamicResource HeaderTextBrush}"/>

                        <ComboBox Grid.Column="4"
                                  ItemsSource="{Binding Uoms}"
                                  SelectedItem="{Binding SelectedUom, Mode=TwoWay}"
                                  IsEditable="False"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="UomCode"
                                  IsEnabled="{Binding IsSetupEditable}"
                                  Style="{StaticResource ClassicCombo}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding UomCode}" FontWeight="Bold"/>
                                        <TextBlock Text=" - "/>
                                        <TextBlock Text="{Binding UomDescription}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Column="6"
                                   Text="Tax Category *"
                                   Style="{StaticResource InlineLabel}"
                                   Foreground="{DynamicResource HeaderTextBrush}"/>

                        <ComboBox Grid.Column="7"
                                  ItemsSource="{Binding TaxCategories}"
                                  SelectedItem="{Binding SelectedTaxCategory, Mode=TwoWay}"
                                  IsEditable="False"
                                  IsEnabled="{Binding IsTaxCategoryEditable}"
                                  Style="{StaticResource ClassicCombo}"
                                  ToolTip="Authoritative tax treatment for this item.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CategoryName}"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="  "/>
                                        <TextBlock Text="{Binding CategoryCode}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="10"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Border Background="#FFF8D8"
                            BorderBrush="#C9A227"
                            BorderThickness="1"
                            Padding="6"
                            Margin="0,5,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Selling Price Rule:"
                                       Style="{StaticResource InlineLabel}"
                                       Foreground="{DynamicResource HeaderTextBrush}"
                                       FontWeight="Bold"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedTaxCategoryText, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="3"
                                       Text="Retail, wholesale, minimum, and maximum prices are stored VAT inclusive."
                                       Foreground="{DynamicResource HeaderTextBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="4"
                                       Text="{Binding TaxCategoryHelpText, Mode=OneWay}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="10"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource WhiteBackgroundBrush}"
                            BorderBrush="{DynamicResource LightBorderBrush}"
                            BorderThickness="1"
                            Padding="7"
                            Margin="0,5,0,0">

                        <StackPanel>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStockItem}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <WrapPanel Orientation="Horizontal"
                                           VerticalAlignment="Center">
                                    <TextBlock Text="Stock Controls:"
                                               Style="{StaticResource InlineLabel}"
                                               Margin="0,0,10,0"
                                               Foreground="{DynamicResource HeaderTextBrush}"/>

                                    <CheckBox Content="Batch Tracking"
                                              IsChecked="{Binding BulkHasBatchTracking, Mode=TwoWay}"
                                              IsEnabled="{Binding IsSetupEditable}"
                                              Margin="0,0,15,0"
                                              FontWeight="Bold"/>

                                    <CheckBox Content="Expiry Tracking"
                                              IsChecked="{Binding BulkHasExpiryTracking, Mode=TwoWay}"
                                              Margin="0,0,15,0"
                                              FontWeight="SemiBold">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="IsEnabled" Value="True"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSetupEditable}" Value="False">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BulkHasBatchTracking}" Value="False">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>

                                    <CheckBox Content="Scale Item"
                                              IsChecked="{Binding BulkIsScaleItem, Mode=TwoWay}"
                                              IsEnabled="{Binding IsSetupEditable}"
                                              Margin="0,0,15,0"
                                              FontWeight="SemiBold"/>

                                    <CheckBox Content="Allow Cashier Discount"
                                              IsChecked="{Binding CurrentItem.AllowCashierDiscount, Mode=TwoWay}"
                                              Margin="0,0,15,0"
                                              FontWeight="SemiBold"/>

                                    <CheckBox Content="Lock Purchase"
                                              IsChecked="{Binding CurrentItem.IsPurchaseLocked, Mode=TwoWay}"
                                              Margin="0,0,15,0"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource WarningTextBrush}"/>

                                    <CheckBox Content="Lock Sale"
                                              IsChecked="{Binding CurrentItem.IsSaleLocked, Mode=TwoWay}"
                                              Margin="0,0,15,0"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource WarningTextBrush}"/>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServiceItem}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Service: no stock, batch, expiry, GRN, stock count, stock adjustment, or inventory movement. Standard cost remains optional for profit reporting."
                                               Foreground="{DynamicResource HeaderTextBrush}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>

                                    <CheckBox Grid.Column="1"
                                              Content="Allow Cashier Discount"
                                              IsChecked="{Binding CurrentItem.AllowCashierDiscount, Mode=TwoWay}"
                                              Margin="15,0,15,0"
                                              FontWeight="SemiBold"/>

                                    <CheckBox Grid.Column="2"
                                              Content="Lock Sale"
                                              IsChecked="{Binding CurrentItem.IsSaleLocked, Mode=TwoWay}"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource WarningTextBrush}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TabControl Grid.Row="2"
                        Background="{DynamicResource WhiteBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}">

                <TabItem Header="Matrix Builder &amp; Defaults" Style="{StaticResource ClassicTab}">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="430"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource ClassicGroupBox}"
                                VerticalAlignment="Stretch">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="2. MATRIX VARIANT BUILDER"
                                               Style="{StaticResource HeaderLabel}"/>

                                    <TextBlock Text="{Binding VariantBuilderHelpText, Mode=OneWay}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Group"
                                               Style="{StaticResource InlineLabel}"/>

                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding PropertyKeys}"
                                              SelectedItem="{Binding SelectedPropertyKey, Mode=TwoWay}"
                                              DisplayMemberPath="GroupName"
                                              IsEnabled="{Binding IsSetupEditable}"
                                              Style="{StaticResource ClassicCombo}"/>

                                    <TextBlock Grid.Column="3"
                                               Text="Value"
                                               Style="{StaticResource InlineLabel}"/>

                                    <ComboBox Grid.Column="4"
                                              ItemsSource="{Binding PropertyValues}"
                                              SelectedItem="{Binding PropertyValueInput, Mode=TwoWay}"
                                              DisplayMemberPath="ValueName"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              TextSearch.TextPath="ValueName"
                                              IsEnabled="{Binding IsSetupEditable}"
                                              Style="{StaticResource ClassicCombo}"/>

                                    <Button Grid.Column="5"
                                            Content="ADD VALUE"
                                            Command="{Binding AddPropertyCommand}"
                                            IsEnabled="{Binding IsSetupEditable}"
                                            Style="{StaticResource ClassicBtn}"
                                            Height="24"
                                            Padding="10,0"
                                            Margin="8,0,0,0"/>
                                </Grid>

                                <Border Grid.Row="2"
                                        Background="{DynamicResource WhiteBackgroundBrush}"
                                        BorderBrush="{DynamicResource LightBorderBrush}"
                                        BorderThickness="1"
                                        Padding="8">

                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="Selected Matrix Values"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource HeaderTextBrush}"
                                                       Margin="0,0,0,8"/>

                                            <ItemsControl ItemsSource="{Binding SelectedPropertyGroups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource LightBorderBrush}"
                                                                BorderThickness="1"
                                                                Background="{DynamicResource PanelBackgroundBrush}"
                                                                Padding="6"
                                                                Margin="0,0,0,8">

                                                            <StackPanel>
                                                                <TextBlock Text="{Binding GroupName}"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource HeaderTextBrush}"
                                                                           Margin="0,0,0,5"/>

                                                                <ItemsControl ItemsSource="{Binding Values}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel Orientation="Horizontal"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>

                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="{DynamicResource HighlightBackgroundBrush}"
                                                                                    BorderBrush="{DynamicResource InputBoxBorderBrush}"
                                                                                    BorderThickness="1"
                                                                                    Padding="8,3"
                                                                                    Margin="0,0,6,6">

                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="{Binding Value.ValueName}"
                                                                                               FontSize="11"
                                                                                               FontWeight="SemiBold"
                                                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                                                               Margin="0,0,6,0"
                                                                                               VerticalAlignment="Center"/>

                                                                                    <Button Content="X"
                                                                                            Command="{Binding DataContext.RemovePropertyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                            CommandParameter="{Binding}"
                                                                                            IsEnabled="{Binding DataContext.IsSetupEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                            Background="Transparent"
                                                                                            BorderThickness="0"
                                                                                            Foreground="{DynamicResource WarningTextBrush}"
                                                                                            FontWeight="Bold"
                                                                                            FontSize="10"
                                                                                            Cursor="Hand"
                                                                                            Padding="2,0"
                                                                                            VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>

                                <Button Grid.Row="3"
                                        Content="GENERATE VARIANTS"
                                        Command="{Binding GenerateVariantsCommand}"
                                        IsEnabled="{Binding IsSetupEditable}"
                                        Style="{StaticResource ActionBtn}"
                                        Height="30"
                                        Margin="0,8,0,0"
                                        FontSize="13"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource ClassicGroupBox}"
                                VerticalAlignment="Stretch">

                            <StackPanel>
                                <TextBlock Text="3. BULK PRICING DEFAULTS"
                                           Style="{StaticResource HeaderLabel}"/>

                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding BulkCostLabel, Mode=OneWay, FallbackValue='Cost Price'}"
                                               Style="{StaticResource InlineLabel}"/>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding BulkCost, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource ClassicInput}"
                                             HorizontalContentAlignment="Right"
                                             FontWeight="Bold"/>
                                </Grid>

                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Retail Mkp %"
                                               Style="{StaticResource InlineLabel}"/>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding BulkRetailMarkupPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource ClassicInput}"
                                             HorizontalContentAlignment="Right"/>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding BulkRetailPriceLabel, Mode=OneWay, FallbackValue='Retail Rs.'}"
                                               Style="{StaticResource InlineLabel}"
                                               Foreground="{DynamicResource SuccessBorderBrush}"/>

                                    <TextBox Grid.Column="4"
                                             Text="{Binding BulkRetailPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource ClassicInput}"
                                             HorizontalContentAlignment="Right"
                                             FontWeight="Bold"
                                             Background="{DynamicResource HighlightBackgroundBrush}"/>
                                </Grid>

                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="W/S Mkp %"
                                               Style="{StaticResource InlineLabel}"/>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding BulkWholesaleMarkupPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource ClassicInput}"
                                             HorizontalContentAlignment="Right"/>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding BulkWholesalePriceLabel, Mode=OneWay, FallbackValue='W/S Rs.'}"
                                               Style="{StaticResource InlineLabel}"/>

                                    <TextBox Grid.Column="4"
                                             Text="{Binding BulkWholesalePrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource ClassicInput}"
                                             HorizontalContentAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding BulkMinimumPriceLabel, Mode=OneWay, FallbackValue='Min Price'}"
                                               Style="{StaticResource InlineLabel}"/>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding BulkMinimumPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource ClassicInput}"
                                             HorizontalContentAlignment="Right"/>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding BulkMaximumPriceLabel, Mode=OneWay, FallbackValue='Max Price'}"
                                               Style="{StaticResource InlineLabel}"/>

                                    <TextBox Grid.Column="4"
                                             Text="{Binding BulkMaximumPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource ClassicInput}"
                                             HorizontalContentAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStockItem}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Reorder Level"
                                               Style="{StaticResource InlineLabel}"/>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding BulkReorderLevel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource ClassicInput}"
                                             HorizontalContentAlignment="Right"/>

                                    <TextBlock Grid.Column="2"
                                               Text="Applied to generated variants"
                                               FontSize="10"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>
                                </Grid>

                                <Button Content="APPLY TO ALL VARIANTS"
                                        Command="{Binding ApplyBulkDefaultsCommand}"
                                        Style="{StaticResource ClassicBtn}"
                                        Height="28"
                                        Margin="0,0,0,10"/>

                                <Border Background="{DynamicResource WhiteBackgroundBrush}"
                                        BorderBrush="{DynamicResource LightBorderBrush}"
                                        BorderThickness="1"
                                        Padding="8">

                                    <TextBlock Text="{Binding StructureSafetyText, Mode=OneWay}"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Variant Pricing &amp; SKUs" Style="{StaticResource ClassicTab}">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- SUPPLIER ASSIGN TOOLBAR -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource HighlightBackgroundBrush}"
                                BorderBrush="{DynamicResource LightBorderBrush}"
                                BorderThickness="1"
                                Padding="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStockItem}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                          Content="Select All Variants"
                          IsChecked="{Binding SelectAllVariantsForSupplierAssignment, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          FontWeight="Bold"
                          Foreground="{DynamicResource HeaderTextBrush}"/>

                                <TextBlock Grid.Column="2"
                           Text="{Binding SelectedSupplierAssignmentCount, StringFormat={}Selected: {0}}"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{DynamicResource WarningTextBrush}"/>

                                <Button Grid.Column="4"
                        Content="ASSIGN SUPPLIER"
                        Command="{Binding AssignSupplierToSelectedVariantsCommand}"
                        Style="{StaticResource ActionBtn}"
                        Height="26"
                        Padding="16,0"/>

                                <TextBlock Grid.Column="6"
                           Text="Tick variants, assign supplier, then click SAVE FULL ITEM."
                           FontSize="11"
                           FontStyle="Italic"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- VARIANT GRID -->
                        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding GeneratedVariants}"
                  SelectedItem="{Binding SelectedVariantForSupplierEdit, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="{DynamicResource LightBorderBrush}"
                  VerticalGridLinesBrush="{DynamicResource LightBorderBrush}"
                  RowHeight="26"
                  HeadersVisibility="Column"
                  Background="{DynamicResource WhiteBackgroundBrush}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource BorderBrush}"
                  SelectionMode="Single"
                  AlternatingRowBackground="{DynamicResource DataGridAlternatingRow}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource BaseCell}"/>
                            </DataGrid.Resources>

                            <DataGrid.Columns>

                                <DataGridTemplateColumn Header="Select" Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelectedForSupplierAssignment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Command="{Binding DataContext.RefreshSupplierAssignmentSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      IsEnabled="{Binding DataContext.IsSupplierManagementEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Full Product Name"
                                    Binding="{Binding FullDisplayName, Mode=OneWay}"
                                    Width="230"
                                    FontWeight="Bold"
                                    IsReadOnly="True"
                                    CellStyle="{StaticResource FrozenCell}"/>

                                <DataGridTextColumn Header="Receipt Name"
                                    Binding="{Binding ReceiptDisplayName, Mode=OneWay}"
                                    Width="200"
                                    IsReadOnly="True"
                                    CellStyle="{StaticResource FrozenCell}"/>

                                <DataGridTextColumn Header="SKU"
                                    Binding="{Binding SkuCode, Mode=OneWay}"
                                    Width="150"
                                    IsReadOnly="True"/>

                                <DataGridTextColumn Header="Variant"
                                    Binding="{Binding VariantDisplayName, Mode=OneWay}"
                                    Width="130"
                                    IsReadOnly="True"/>

                                <DataGridTextColumn Header="Barcode"
                                    Binding="{Binding Barcode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                    Width="135"/>

                                <DataGridTextColumn Header="Cost / Std Cost"
                                    Binding="{Binding CostPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                    Width="80"/>

                                <DataGridTextColumn Header="Retail Inc VAT"
                                    Binding="{Binding RetailPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                    Width="90"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource SuccessBorderBrush}"
                                    CellStyle="{StaticResource RetailCell}"/>

                                <DataGridTextColumn Header="W/S Inc VAT"
                                    Binding="{Binding WholesalePrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                    Width="90"/>

                                <DataGridTextColumn Header="Min Inc VAT"
                                    Binding="{Binding MinimumPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                    Width="70"/>

                                <DataGridTextColumn Header="Max Inc VAT"
                                    Binding="{Binding MaximumPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                    Width="70"/>

                                <DataGridTemplateColumn Header="Reorder"
                                                        Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ReorderLevel, Mode=OneWay}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding ReorderLevel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     IsEnabled="{Binding DataContext.IsStockItem, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     HorizontalContentAlignment="Right"
                                                     Style="{StaticResource ClassicInput}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridCheckBoxColumn Header="Inactive"
                                        Binding="{Binding IsDeactivated, Mode=TwoWay}"
                                        Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Approved Suppliers">
                    <TabItem.Style>
                        <Style TargetType="TabItem" BasedOn="{StaticResource ClassicTab}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStockItem}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TabItem.Style>

                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- SELECT VARIANT -->
                        <Border Grid.Row="0"
                Background="{DynamicResource WhiteBackgroundBrush}"
                BorderBrush="{DynamicResource LightBorderBrush}"
                BorderThickness="1"
                Padding="10">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                           Text="Manage Suppliers For Selected Variant:"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"/>

                                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding GeneratedVariants}"
                          SelectedItem="{Binding SelectedVariantForSupplierEdit, Mode=TwoWay}"
                          DisplayMemberPath="FullDisplayName"
                          Style="{StaticResource ClassicCombo}"
                          ToolTip="You can also select a variant from the Pricing tab."/>
                            </Grid>
                        </Border>

                        <!-- ADD / EDIT SUPPLIER LINK -->
                        <Border Grid.Row="2"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource LightBorderBrush}"
                BorderThickness="1"
                Padding="10">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                           Text="ADD / EDIT SUPPLIER LINK"
                           FontWeight="Bold"
                           Foreground="{DynamicResource HeaderTextBrush}"/>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                               Text="Supplier"
                               Style="{StaticResource InlineLabel}"/>

                                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableSuppliers}"
                              SelectedItem="{Binding SupplierToAdd, Mode=TwoWay}"
                              DisplayMemberPath="SupplierName"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              TextSearch.TextPath="SupplierName"
                              Style="{StaticResource ClassicCombo}"/>

                                    <TextBlock Grid.Column="3"
                               Text="Cost Rs."
                               Style="{StaticResource InlineLabel}"/>

                                    <TextBox Grid.Column="4"
                             Text="{Binding SupplierCostInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ClassicInput}"
                             HorizontalContentAlignment="Right"
                             FontWeight="Bold"/>

                                    <TextBlock Grid.Column="6"
                               Text="MOQ"
                               Style="{StaticResource InlineLabel}"/>

                                    <TextBox Grid.Column="7"
                             Text="{Binding SupplierMinimumOrderQuantityInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ClassicInput}"
                             HorizontalContentAlignment="Right"/>

                                    <Button Grid.Column="9"
                            Content="SAVE SUPPLIER LINK"
                            Command="{Binding AddSupplierToVariantCommand}"
                            Style="{StaticResource ActionBtn}"
                            Padding="15,0"/>

                                    <Button Grid.Column="11"
                            Content="CLEAR EDIT"
                            Command="{Binding ClearSupplierEditCommand}"
                            Style="{StaticResource ClassicBtn}"
                            Padding="12,0"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- SUPPLIER LINKS GRID -->
                        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding SelectedVariantSuppliers}"
                  SelectedItem="{Binding SelectedSupplierLinkForEdit, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="{DynamicResource LightBorderBrush}"
                  VerticalGridLinesBrush="{DynamicResource LightBorderBrush}"
                  RowHeight="28"
                  HeadersVisibility="Column"
                  Background="{DynamicResource WhiteBackgroundBrush}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource BorderBrush}"
                  SelectionMode="Single"
                  AlternatingRowBackground="{DynamicResource DataGridAlternatingRow}">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource BaseCell}"/>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Supplier Code"
                                    Binding="{Binding Supplier.SupplierCode, Mode=OneWay}"
                                    Width="130"
                                    FontWeight="Bold"/>

                                <DataGridTextColumn Header="Supplier Name"
                                    Binding="{Binding Supplier.SupplierName, Mode=OneWay}"
                                    Width="*"
                                    FontWeight="SemiBold"/>

                                <DataGridTextColumn Header="Cost Rs."
                                    Binding="{Binding LastCostPrice, Mode=OneWay, StringFormat=N2}"
                                    Width="120"
                                    FontWeight="Bold">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="MOQ"
                                    Binding="{Binding MinimumOrderQuantity, Mode=OneWay}"
                                    Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Action" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove"
                                    Command="{Binding DataContext.RemoveSupplierFromVariantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource WarningTextBrush}"
                                    Cursor="Hand"
                                    FontWeight="Bold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>