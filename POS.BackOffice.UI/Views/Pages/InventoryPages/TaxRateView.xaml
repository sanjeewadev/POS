<UserControl x:Class="POS.BackOffice.UI.Views.Pages.InventoryPages.TaxRateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200"
             Background="{DynamicResource WindowBackgroundBrush}"
             FontFamily="Segoe UI"
             FontSize="12">

    <UserControl.Resources>

        <Style TargetType="TextBlock" x:Key="HeaderLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="InlineLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <Style TargetType="TextBox" x:Key="ClassicInput">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource WhiteBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonDefaultBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource ButtonDefaultBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="ClassicBtn">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="{DynamicResource ButtonDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="ActionBtn" BasedOn="{StaticResource ClassicBtn}">
            <Setter Property="Background" Value="{DynamicResource ActionBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WhiteBackgroundBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ActionHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Border" x:Key="ClassicGroupBox">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource DataGridHeaderBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <Style TargetType="DataGridCell" x:Key="BaseCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource LightSelectionBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="RightText">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,6,0"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="CenterText">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: TAX RATE FORM -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource ClassicGroupBox}">
                <StackPanel>
                    <TextBlock Text="1. TAX MASTER SETUP"
                               Style="{StaticResource HeaderLabel}"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Tax Code *"
                                   Style="{StaticResource InlineLabel}"
                                   Foreground="{DynamicResource WarningTextBrush}"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding TaxCodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsTaxCodeReadOnly}"
                                 Style="{StaticResource ClassicInput}"
                                 FontWeight="Bold"
                                 CharacterCasing="Upper"
                                 MaxLength="20"
                                 ToolTip="Examples: TAX-FREE, VAT-STD, VAT-RED"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Tax Name *"
                                   Style="{StaticResource InlineLabel}"
                                   Foreground="{DynamicResource WarningTextBrush}"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding TaxNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}"
                                 MaxLength="100"
                                 ToolTip="Example: Standard VAT"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Rate %"
                                   Style="{StaticResource InlineLabel}"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding RatePercentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}"
                                 HorizontalContentAlignment="Right"
                                 MaxLength="6"/>

                        <TextBlock Grid.Column="2"
                                   Text=""
                                   Style="{StaticResource InlineLabel}"/>

                        <TextBlock Grid.Column="3"
                                   Text="Order"
                                   Style="{StaticResource InlineLabel}"/>

                        <TextBox Grid.Column="4"
                                 Text="{Binding DisplayOrderText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}"
                                 HorizontalContentAlignment="Right"
                                 MaxLength="4"/>
                    </Grid>

                    <CheckBox Content="Active"
                              IsChecked="{Binding IsActiveInput, Mode=TwoWay}"
                              FontWeight="Bold"
                              Margin="110,2,0,10"/>

                    <TextBlock Text="Tax rates are used by Item Master, PO, GRN, cashier sales, and future VAT reports. Do not delete real tax records after they are used. Deactivate them instead."
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               Margin="110,0,0,10"/>

                    <Border Background="{DynamicResource WindowBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="DELETE"
                                    Command="{Binding DeleteCommand}"
                                    Style="{StaticResource ClassicBtn}"
                                    Foreground="{DynamicResource WarningTextBrush}"
                                    BorderBrush="{DynamicResource WarningTextBrush}"
                                    Padding="10,0"
                                    ToolTip="Deletes only if this tax rate is unused."/>

                            <Button Grid.Column="1"
                                    Content="{Binding DeactivateReactivateButtonText}"
                                    Command="{Binding DeactivateReactivateCommand}"
                                    Style="{StaticResource ClassicBtn}"
                                    Margin="5,0,0,0"
                                    Padding="10,0"/>

                            <Button Grid.Column="3"
                                    Content="CLEAR"
                                    Command="{Binding ClearCommand}"
                                    Style="{StaticResource ClassicBtn}"
                                    Margin="0,0,5,0"
                                    Padding="10,0"/>

                            <Button Grid.Column="4"
                                    Content="SAVE"
                                    Command="{Binding SaveCommand}"
                                    Style="{StaticResource ActionBtn}"
                                    Padding="18,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Padding="8"
                    Margin="0,5,0,0">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>

        <!-- RIGHT: TAX RATE DATABASE -->
        <Border Grid.Column="2"
                Background="{DynamicResource HeaderTextBrush}"
                Padding="5"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="5,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="TAX RATE DATABASE"
                               Foreground="{DynamicResource WhiteBackgroundBrush}"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ClassicInput}"
                             Height="25"
                             Margin="0,0,8,0"
                             ToolTip="Search by tax code or tax name. Press Enter or click Search / Refresh.">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter"
                                        Command="{Binding SearchRefreshCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <CheckBox Grid.Column="2"
                              Content="Include Deactivated"
                              IsChecked="{Binding IncludeDeactivated, Mode=TwoWay}"
                              Foreground="{DynamicResource WhiteBackgroundBrush}"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>

                    <Button Grid.Column="3"
                            Content="SEARCH / REFRESH"
                            Command="{Binding SearchRefreshCommand}"
                            Style="{StaticResource ClassicBtn}"
                            Height="25"
                            Padding="10,0"
                            Margin="0,0,5,0"/>

                    <Button Grid.Column="4"
                            Content="CLEAR SEARCH"
                            Command="{Binding ClearSearchCommand}"
                            Style="{StaticResource ClassicBtn}"
                            Height="25"
                            Padding="10,0"/>
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding TaxRates}"
                          SelectedItem="{Binding SelectedTaxRate, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="{DynamicResource LightBorderBrush}"
                          VerticalGridLinesBrush="{DynamicResource LightBorderBrush}"
                          RowHeight="28"
                          HeadersVisibility="Column"
                          Background="{DynamicResource WhiteBackgroundBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1"
                          SelectionMode="Single"
                          AlternatingRowBackground="{DynamicResource DataGridAlternatingRow}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource BaseCell}"/>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order"
                                            Binding="{Binding DisplayOrder}"
                                            Width="65"
                                            ElementStyle="{StaticResource CenterText}"/>

                        <DataGridTextColumn Header="Tax Code"
                                            Binding="{Binding TaxCode}"
                                            Width="110"
                                            FontWeight="Bold"/>

                        <DataGridTextColumn Header="Tax Name"
                                            Binding="{Binding TaxName}"
                                            Width="*"
                                            MinWidth="190"/>

                        <DataGridTextColumn Header="Rate %"
                                            Binding="{Binding RatePercent, StringFormat=N2}"
                                            Width="80"
                                            ElementStyle="{StaticResource RightText}"/>

                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding StatusText}"
                                            Width="100"
                                            ElementStyle="{StaticResource CenterText}"/>

                        <DataGridTextColumn Header="Updated"
                                            Binding="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                            Width="135"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
