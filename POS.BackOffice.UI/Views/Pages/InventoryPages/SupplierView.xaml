<UserControl x:Class="POS.BackOffice.UI.Views.Pages.InventoryPages.SupplierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1200"
             Loaded="UserControl_Loaded"
             Background="{DynamicResource WindowBackgroundBrush}"
             FontFamily="Segoe UI"
             FontSize="12">

    <UserControl.Resources>
        <Style x:Key="RightText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="CenterText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440" MinWidth="360" MaxWidth="520"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="520"/>
        </Grid.ColumnDefinitions>

        <!-- EDITOR -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
                <StackPanel>
                    <Border Style="{DynamicResource BoPanel}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="1. SUPPLIER MASTER"
                                           Style="{DynamicResource BoSectionHeader}"
                                           Margin="0"/>
                                <Border Grid.Column="1"
                                        Background="#DEFF9A"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="10,2">
                                    <TextBlock Text="{Binding SupplierStatusText}"
                                               FontWeight="Bold"
                                               Foreground="Black"/>
                                </Border>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Supplier Code" Style="{DynamicResource BoInlineLabel}"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding SupplierCode, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding IsSupplierCodeReadOnly}"
                                         Style="{DynamicResource BoInputTextBox}"
                                         FontWeight="Bold" MaxLength="20" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="1" Text="Supplier Name *" Style="{DynamicResource BoInlineLabel}" Foreground="DarkRed"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource BoInputTextBox}"
                                         FontWeight="Bold" MaxLength="150" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="2" Text="Company Name" Style="{DynamicResource BoInlineLabel}"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource BoInputTextBox}" MaxLength="150" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="3" Text="Contact Person" Style="{DynamicResource BoInlineLabel}"/>
                                <TextBox Grid.Row="3" Grid.Column="1"
                                         Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource BoInputTextBox}" MaxLength="100" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="4" Text="Primary Phone *" Style="{DynamicResource BoInlineLabel}" Foreground="DarkRed"/>
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         Text="{Binding Phone1, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource BoInputTextBox}" MaxLength="20" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="5" Text="Second Phone" Style="{DynamicResource BoInlineLabel}"/>
                                <TextBox Grid.Row="5" Grid.Column="1"
                                         Text="{Binding Phone2, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource BoInputTextBox}" MaxLength="20" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="6" Text="Email" Style="{DynamicResource BoInlineLabel}"/>
                                <TextBox Grid.Row="6" Grid.Column="1"
                                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource BoInputTextBox}" MaxLength="100" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="7" Text="Address" Style="{DynamicResource BoInlineLabel}" VerticalAlignment="Top" Margin="0,5,6,0"/>
                                <TextBox Grid.Row="7" Grid.Column="1"
                                         Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource BoInputTextBox}"
                                         Height="52" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" MaxLength="250"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource BoPanel}">
                        <StackPanel>
                            <TextBlock Text="2. FINANCE / VAT SETUP" Style="{DynamicResource BoSectionHeader}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="VAT Status" Style="{DynamicResource BoInlineLabel}"/>
                                <CheckBox Grid.Row="0" Grid.Column="1"
                                          Content="VAT Registered Supplier"
                                          IsChecked="{Binding HasVat}"
                                          FontWeight="Bold" Foreground="{DynamicResource HeaderTextBrush}"
                                          VerticalAlignment="Center" Margin="0,0,0,7"/>

                                <TextBlock Grid.Row="1" Text="VAT Reg. No" Style="{DynamicResource BoInlineLabel}" Foreground="DarkRed"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding VatNumber, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsVatNumberInputEnabled}"
                                         Style="{DynamicResource BoInputTextBox}"
                                         FontWeight="Bold" MaxLength="50" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="VAT number is required only for VAT-registered suppliers."
                                           Style="{DynamicResource BoHelpText}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Text="Credit Days" Style="{DynamicResource BoInlineLabel}"/>
                                <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding DefaultCreditDays, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource BoInputTextBox}"
                                             HorizontalContentAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="Used for PO/GRN due dates."
                                               Style="{DynamicResource BoHelpText}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <TextBlock Grid.Row="4" Text="Current Balance" Style="{DynamicResource BoInlineLabel}"/>
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         Text="{Binding CurrentBalance, StringFormat=N2}"
                                         IsReadOnly="True"
                                         Style="{DynamicResource BoInputTextBox}"
                                         HorizontalContentAlignment="Right" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1" Style="{DynamicResource BoActionFooter}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" HorizontalAlignment="Left">
                        <Button Content="DELETE UNUSED"
                                Command="{Binding DeleteSupplierCommand}"
                                Style="{DynamicResource BoDangerButton}"
                                Margin="0,0,6,0"
                                ToolTip="Permanent delete is allowed only when no linked records or balance exist."/>

                        <Button Content="DEACTIVATE"
                                Command="{Binding DeactivateSupplierCommand}"
                                Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BoDangerButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSupplier}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDeactivated}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="REACTIVATE"
                                Command="{Binding ReactivateSupplierCommand}"
                                Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BoSuccessButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSupplier}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDeactivated}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
                        <Button Content="CLEAR" Command="{Binding ClearCommand}"
                                Style="{DynamicResource BoButton}" Width="82" Margin="0,0,6,0"/>
                        <Button Content="SAVE SUPPLIER" Command="{Binding SaveCommand}"
                                Style="{DynamicResource BoPrimaryButton}" Width="132"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      ShowsPreview="True"/>

        <!-- DATABASE -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource HeaderTextBrush}"
                    BorderBrush="#002244" BorderThickness="1" Padding="7" Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="SUPPLIER DATABASE" Foreground="White" FontWeight="Bold" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource BoInputTextBox}" Height="25" Margin="0,0,8,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <CheckBox Grid.Column="2" Content="Include Suspended" IsChecked="{Binding IncludeDeactivated}"
                              Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Grid.Column="3" Content="REFRESH" Command="{Binding RefreshCommand}"
                            Style="{DynamicResource BoButton}" Height="25" MinWidth="78" Margin="0,0,5,0"/>
                    <Button Grid.Column="4" Content="CLEAR" Command="{Binding ClearSearchCommand}"
                            Style="{DynamicResource BoButton}" Height="25" MinWidth="70"/>
                </Grid>
            </Border>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Suppliers}"
                      SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                      Style="{DynamicResource BoDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding SupplierCode}" Width="82"/>
                    <DataGridTextColumn Header="Supplier Name" Binding="{Binding SupplierName}" Width="2*" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="1.6*"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone1}" Width="105"/>
                    <DataGridTextColumn Header="VAT Status" Binding="{Binding VatStatusText}" Width="105"/>
                    <DataGridTextColumn Header="VAT No" Binding="{Binding VatNumber}" Width="120"/>
                    <DataGridTextColumn Header="Credit Days" Binding="{Binding DefaultCreditDays}" Width="82" ElementStyle="{StaticResource CenterText}"/>
                    <DataGridTextColumn Header="Balance" Binding="{Binding CurrentBalance, StringFormat=N2}" Width="95" ElementStyle="{StaticResource RightText}"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="82" ElementStyle="{StaticResource CenterText}"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2" Style="{DynamicResource BoActionFooter}" Margin="0,6,0,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource HeaderTextBrush}"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
