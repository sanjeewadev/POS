<UserControl x:Class="POS.BackOffice.UI.Views.Pages.InventoryPages.SupplierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1200"
             Loaded="UserControl_Loaded"
             Background="#D4D0C8"
             FontFamily="Segoe UI"
             FontSize="12">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#CFE8FF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E5F3FF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>

        <Style TargetType="TextBlock" x:Key="HeaderLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="InlineLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style TargetType="TextBox" x:Key="ClassicInput">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="Foreground" Value="#555555"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="Foreground" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="ClassicBtn">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CCCCCC"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="ActionBtn" BasedOn="{StaticResource ClassicBtn}">
            <Setter Property="Background" Value="#005555"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#003333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007777"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Border" x:Key="ClassicGroupBox">
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
        </Style>

        <Style TargetType="DataGridCell" x:Key="BaseCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CFE8FF"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="RightText">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,6,0"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="CenterText">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: SUPPLIER FORM -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource ClassicGroupBox}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="1. SUPPLIER MASTER"
                                   Style="{StaticResource HeaderLabel}"/>

                        <Border Grid.Column="1"
                                Background="#DEFF9A"
                                BorderBrush="#A0A0A0"
                                BorderThickness="1"
                                Padding="10,2">
                            <TextBlock Text="{Binding SupplierStatusText, Mode=OneWay}"
                                       FontWeight="Bold"
                                       Foreground="Black"/>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Supplier Code *"
                                   Style="{StaticResource InlineLabel}"
                                   Foreground="DarkRed"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding SupplierCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsSupplierCodeReadOnly}"
                                 Style="{StaticResource ClassicInput}"
                                 FontWeight="Bold"
                                 MaxLength="20"
                                 ToolTip="Supplier code is locked after save."/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Supplier Name *"
                                   Style="{StaticResource InlineLabel}"
                                   Foreground="DarkRed"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding SupplierName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}"
                                 FontWeight="Bold"
                                 MaxLength="150"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Company Name"
                                   Style="{StaticResource InlineLabel}"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding CompanyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}"
                                 MaxLength="150"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Contact Person"
                                   Style="{StaticResource InlineLabel}"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding ContactPerson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}"
                                 MaxLength="50"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Primary Phone *"
                                   Style="{StaticResource InlineLabel}"
                                   Foreground="DarkRed"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding Phone1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}"
                                 MaxLength="20"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Second Phone"
                                   Style="{StaticResource InlineLabel}"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding Phone2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}"
                                 MaxLength="20"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Email"
                                   Style="{StaticResource InlineLabel}"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}"
                                 MaxLength="100"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Address"
                                   Style="{StaticResource InlineLabel}"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}"
                                 Height="50"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 MaxLength="250"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource ClassicGroupBox}">
                <StackPanel>
                    <TextBlock Text="2. FINANCE / VAT SETUP"
                               Style="{StaticResource HeaderLabel}"/>

                    <CheckBox Content="VAT Registered Supplier"
                              IsChecked="{Binding HasVat, Mode=TwoWay}"
                              FontWeight="Bold"
                              Foreground="#003366"
                              Margin="120,0,0,8"
                              ToolTip="If unticked, PO and GRN must force VAT to zero for this supplier."/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="VAT Reg. No"
                                   Style="{StaticResource InlineLabel}"
                                   Foreground="DarkRed"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding VatNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsVatNumberInputEnabled}"
                                 Style="{StaticResource ClassicInput}"
                                 FontWeight="Bold"
                                 MaxLength="50"
                                 ToolTip="Required only for VAT registered suppliers."/>
                    </Grid>

                    <TextBlock Text="VAT number is mandatory when VAT Registered Supplier is ticked. If supplier is not VAT registered, PO/GRN VAT must be zero."
                               Foreground="#666666"
                               FontSize="10.5"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               Margin="120,0,0,8"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Credit Days"
                                   Style="{StaticResource InlineLabel}"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding DefaultCreditDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}"
                                 HorizontalContentAlignment="Center"
                                 FontWeight="Bold"/>

                        <TextBlock Grid.Column="2"
                                   Text="Used to calculate PO/GRN due date."
                                   Foreground="#666666"
                                   FontSize="10.5"
                                   FontStyle="Italic"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Current Balance"
                                   Style="{StaticResource InlineLabel}"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding CurrentBalance, Mode=OneWay, StringFormat=N2}"
                                 IsReadOnly="True"
                                 Style="{StaticResource ClassicInput}"
                                 HorizontalContentAlignment="Right"
                                 FontWeight="Bold"/>
                    </Grid>

                    <CheckBox Content="Deactivate / Suspend Supplier"
                              IsChecked="{Binding IsDeactivated, Mode=TwoWay}"
                              FontWeight="Bold"
                              Foreground="DarkRed"
                              Margin="120,3,0,0"
                              ToolTip="Suspended suppliers are hidden from new PO/GRN selections but old history remains."/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Background="#F0F0F0"
                    BorderBrush="#A0A0A0"
                    BorderThickness="1"
                    Padding="8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="DELETE UNUSED"
                                Command="{Binding DeleteSupplierCommand}"
                                Style="{StaticResource ClassicBtn}"
                                Foreground="DarkRed"
                                BorderBrush="DarkRed"
                                Margin="0,0,6,0"
                                ToolTip="Permanent delete only if supplier has no linked records and zero balance."/>

                        <Button Content="DEACTIVATE"
                                Command="{Binding DeactivateSupplierCommand}"
                                Style="{StaticResource ClassicBtn}"
                                Foreground="DarkRed"
                                BorderBrush="DarkRed"
                                Margin="0,0,6,0"/>

                        <Button Content="REACTIVATE"
                                Command="{Binding ReactivateSupplierCommand}"
                                Style="{StaticResource ClassicBtn}"
                                Foreground="#005500"
                                BorderBrush="#005500"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="CLEAR"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource ClassicBtn}"
                                Width="80"
                                Margin="0,0,6,0"/>

                        <Button Content="SAVE SUPPLIER"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource ActionBtn}"
                                Width="125"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- RIGHT: DATABASE GRID -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#003366"
                    BorderBrush="#002244"
                    BorderThickness="1"
                    Padding="8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="SUPPLIER DATABASE"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ClassicInput}"
                             Height="25"
                             Margin="0,0,8,0"
                             ToolTip="Search supplier code, name, company, phone, email, or VAT number.">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <CheckBox Grid.Column="2"
                              Content="Include Suspended"
                              IsChecked="{Binding IncludeDeactivated, Mode=TwoWay}"
                              Foreground="White"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>

                    <Button Grid.Column="3"
                            Content="SEARCH / REFRESH"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource ClassicBtn}"
                            Height="25"
                            Padding="10,0"
                            Margin="0,0,6,0"/>

                    <Button Grid.Column="4"
                            Content="CLEAR SEARCH"
                            Command="{Binding ClearSearchCommand}"
                            Style="{StaticResource ClassicBtn}"
                            Height="25"
                            Padding="10,0"/>
                </Grid>
            </Border>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Suppliers}"
                      SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E0E0E0"
                      VerticalGridLinesBrush="#E0E0E0"
                      RowHeight="28"
                      Background="White"
                      BorderBrush="#A0A0A0"
                      BorderThickness="1"
                      SelectionMode="Single"
                      AlternatingRowBackground="#F9F9F9"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                <DataGrid.Resources>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource BaseCell}"/>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code"
                                        Binding="{Binding SupplierCode, Mode=OneWay}"
                                        Width="85"
                                        IsReadOnly="True"/>

                    <DataGridTextColumn Header="Supplier Name"
                                        Binding="{Binding SupplierName, Mode=OneWay}"
                                        Width="190"
                                        IsReadOnly="True"
                                        FontWeight="Bold"/>

                    <DataGridTextColumn Header="Company"
                                        Binding="{Binding CompanyName, Mode=OneWay}"
                                        Width="175"
                                        IsReadOnly="True"/>

                    <DataGridTextColumn Header="Phone"
                                        Binding="{Binding Phone1, Mode=OneWay}"
                                        Width="110"
                                        IsReadOnly="True"/>

                    <DataGridTextColumn Header="VAT Status"
                                        Binding="{Binding VatStatusText, Mode=OneWay}"
                                        Width="120"
                                        IsReadOnly="True"/>

                    <DataGridTextColumn Header="VAT No"
                                        Binding="{Binding VatNumber, Mode=OneWay}"
                                        Width="130"
                                        IsReadOnly="True"/>

                    <DataGridTextColumn Header="Credit Days"
                                        Binding="{Binding DefaultCreditDays, Mode=OneWay}"
                                        Width="85"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CenterText}"/>

                    <DataGridTextColumn Header="Balance"
                                        Binding="{Binding CurrentBalance, Mode=OneWay, StringFormat=N2}"
                                        Width="95"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource RightText}"/>

                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding StatusText, Mode=OneWay}"
                                        Width="85"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CenterText}"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2"
                    Background="#F0F0F0"
                    BorderBrush="#A0A0A0"
                    BorderThickness="1"
                    Padding="8"
                    Margin="0,6,0,0">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#003366"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
