<UserControl x:Class="POS.BackOffice.UI.Views.Pages.Admin.StoreSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1280"
             Background="{DynamicResource WindowBackgroundBrush}"
             FontFamily="Segoe UI"
             FontSize="12">

    <UserControl.Resources>

        <Style x:Key="SectionBorder"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="10"/>
        </Style>

        <Style x:Key="SectionHeading"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource HeaderTextBrush}"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Margin"
                    Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FieldLabel"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="Margin"
                    Value="0,0,8,0"/>
        </Style>

        <Style x:Key="HelpText"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize"
                    Value="11"/>
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
        </Style>

        <Style x:Key="ClassicTextBox"
               TargetType="TextBox">
            <Setter Property="Height"
                    Value="27"/>
            <Setter Property="Padding"
                    Value="6,0"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Background"
                    Value="{DynamicResource WhiteBackgroundBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

        <Style x:Key="MultilineTextBox"
               TargetType="TextBox">
            <Setter Property="MinHeight"
                    Value="82"/>
            <Setter Property="Padding"
                    Value="6"/>
            <Setter Property="AcceptsReturn"
                    Value="True"/>
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility"
                    Value="Auto"/>
            <Setter Property="Background"
                    Value="{DynamicResource WhiteBackgroundBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

        <Style x:Key="ClassicButton"
               TargetType="Button">
            <Setter Property="Height"
                    Value="29"/>
            <Setter Property="MinWidth"
                    Value="105"/>
            <Setter Property="Padding"
                    Value="12,0"/>
            <Setter Property="Background"
                    Value="{DynamicResource ButtonDefaultBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource ButtonHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource ClassicButton}">
            <Setter Property="Background"
                    Value="{DynamicResource ActionBackgroundBrush}"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ActionBackgroundBrush}"/>
            <Setter Property="MinWidth"
                    Value="145"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource ActionHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. STORE IDENTITY -->
                <Border Grid.Row="0"
                        Style="{StaticResource SectionBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="31"/>
                            <RowDefinition Height="31"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="175"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.ColumnSpan="2"
                                   Text="1. STORE IDENTITY"
                                   Style="{StaticResource SectionHeading}"/>

                        <TextBlock Grid.Row="1"
                                   Text="Business / Legal Name *"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding LegalName, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="200"
                                 Style="{StaticResource ClassicTextBox}"/>

                        <TextBlock Grid.Row="2"
                                   Text="Store / Trading Name *"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="150"
                                 Style="{StaticResource ClassicTextBox}"/>

                        <TextBlock Grid.Row="3"
                                   Grid.ColumnSpan="2"
                                   Text="This page is the authoritative store identity. The store / trading name is used on Cashier, receipts, reports, backups, barcode labels and new licence requests. The legal name is printed only when it is different."
                                   Style="{StaticResource HelpText}"
                                   Margin="0,5,0,0"/>
                    </Grid>
                </Border>

                <!-- 2 + 3 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 2. ADDRESS & CONTACT -->
                    <Border Grid.Column="0"
                            Style="{StaticResource SectionBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="31"/>
                                <RowDefinition Height="31"/>
                                <RowDefinition Height="31"/>
                                <RowDefinition Height="31"/>
                                <RowDefinition Height="31"/>
                                <RowDefinition Height="31"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.ColumnSpan="2"
                                       Text="2. ADDRESS &amp; CONTACT"
                                       Style="{StaticResource SectionHeading}"/>

                            <TextBlock Grid.Row="1"
                                       Text="Address Line 1"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="250"
                                     Style="{StaticResource ClassicTextBox}"/>

                            <TextBlock Grid.Row="2"
                                       Text="Address Line 2"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="250"
                                     Style="{StaticResource ClassicTextBox}"/>

                            <TextBlock Grid.Row="3"
                                       Text="City"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="3"
                                     Grid.Column="1"
                                     Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="100"
                                     Style="{StaticResource ClassicTextBox}"/>

                            <TextBlock Grid.Row="4"
                                       Text="Postal Code"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="4"
                                     Grid.Column="1"
                                     Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="50"
                                     Style="{StaticResource ClassicTextBox}"/>

                            <TextBlock Grid.Row="5"
                                       Text="Country"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="5"
                                     Grid.Column="1"
                                     Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="100"
                                     Style="{StaticResource ClassicTextBox}"/>

                            <TextBlock Grid.Row="6"
                                       Text="Telephone"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="6"
                                     Grid.Column="1"
                                     Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="100"
                                     Style="{StaticResource ClassicTextBox}"/>

                            <TextBlock Grid.Row="7"
                                       Text="Email"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="7"
                                     Grid.Column="1"
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="150"
                                     Style="{StaticResource ClassicTextBox}"/>
                        </Grid>
                    </Border>

                    <!-- 3. BUSINESS / VAT DETAILS -->
                    <Border Grid.Column="2"
                            Style="{StaticResource SectionBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="31"/>
                                <RowDefinition Height="31"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="165"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.ColumnSpan="2"
                                       Text="3. BUSINESS / VAT DETAILS"
                                       Style="{StaticResource SectionHeading}"/>

                            <TextBlock Grid.Row="1"
                                       Text="Business Registration No"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding Brn, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="100"
                                     Style="{StaticResource ClassicTextBox}"/>

                            <TextBlock Grid.Row="2"
                                       Text="VAT Registration No"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Text="{Binding TaxNo, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="100"
                                     Style="{StaticResource ClassicTextBox}"/>

                            <Border Grid.Row="3"
                                    Grid.ColumnSpan="2"
                                    Background="{DynamicResource HighlightBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Padding="8"
                                    Margin="0,8,0,0">
                                <TextBlock Text="Leave the VAT registration number blank when the business is not VAT registered. VAT percentages are maintained in Tax Rates and assigned to items; this page does not set a global VAT rate."
                                           Style="{StaticResource HelpText}"/>
                            </Border>

                            <TextBlock Grid.Row="4"
                                       Grid.ColumnSpan="2"
                                       Text="Currency remains LKR for this POS version. Document numbering is managed by the related transaction workflows and is not configured here."
                                       Style="{StaticResource HelpText}"
                                       VerticalAlignment="Bottom"
                                       Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 4. RECEIPT INFORMATION -->
                <Border Grid.Row="4"
                        Style="{StaticResource SectionBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.ColumnSpan="3"
                                   Text="4. RECEIPT INFORMATION"
                                   Style="{StaticResource SectionHeading}"/>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0">
                            <TextBlock Text="Additional Receipt Header (Optional)"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,4"/>

                            <TextBox Text="{Binding ReceiptHeader, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="1000"
                                     Style="{StaticResource MultilineTextBox}"/>

                            <TextBlock Text="Store name, legal name, address, telephone, BRN, and VAT number are printed automatically when available."
                                       Style="{StaticResource HelpText}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="2">
                            <TextBlock Text="Receipt Footer"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,4"/>

                            <TextBox Text="{Binding ReceiptFooter, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="1000"
                                     Style="{StaticResource MultilineTextBox}"/>

                            <TextBlock Text="Use short plain-text lines for reliable printing on 58 mm and 80 mm receipt printers."
                                       Style="{StaticResource HelpText}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2"
                                   Grid.ColumnSpan="3"
                                   Text="Receipt information applies to both sales receipts and printed price quotations."
                                   Style="{StaticResource HelpText}"
                                   Margin="0,8,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 5. SAVE & STATUS -->
        <Border Grid.Row="2"
                Style="{StaticResource SectionBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="5. SAVE &amp; STATUS"
                               Style="{StaticResource SectionHeading}"
                               Margin="0,0,0,3"/>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{Binding StatusColor}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding LastUpdatedText, StringFormat='Last saved: {0}'}"
                               Style="{StaticResource HelpText}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="RELOAD"
                        Command="{Binding DiscardChangesCommand}"
                        Style="{StaticResource ClassicButton}"/>

                <Button Grid.Column="4"
                        Content="SAVE SETTINGS"
                        Command="{Binding SaveSettingsCommand}"
                        Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
