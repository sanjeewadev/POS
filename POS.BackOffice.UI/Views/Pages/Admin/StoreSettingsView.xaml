<UserControl x:Class="POS.BackOffice.UI.Views.Pages.Admin.StoreSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1250"
             Background="#EEF2F7"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <Style x:Key="PageTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PageSubTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="SectionTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F3D5E"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="FieldLabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="MultiLineTextBox" TargetType="TextBox" BasedOn="{StaticResource InputTextBox}">
            <Setter Property="Height" Value="96"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="InputComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0F766E"/>
            <Setter Property="MinWidth" Value="190"/>
        </Style>

        <Style x:Key="TabStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#0F3D5E"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- PAGE HEADER -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="4"
                Padding="18"
                Margin="0,0,0,14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Store Settings"
                               Style="{StaticResource PageTitleText}"/>

                    <TextBlock Text="Business identity, tax, document prefixes, receipt text, and regional settings."
                               Style="{StaticResource PageSubTitleText}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#F1F5F9"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,8"
                        VerticalAlignment="Center">

                    <StackPanel>
                        <TextBlock Text="Status"
                                   Foreground="#64748B"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{Binding StatusColor}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   MaxWidth="360"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- BODY -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="4">

            <TabControl BorderThickness="0"
                        Background="Transparent"
                        Padding="12"
                        ItemContainerStyle="{StaticResource TabStyle}">

                <!-- TAB 1 -->
                <TabItem Header="Company &amp; Tax">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6,14,6,6">

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Business Identity"
                                               Style="{StaticResource SectionTitleText}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Company Legal Name *"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding LegalName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBox}"/>

                                            <TextBlock Text="Trading / Store Name *"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBox}"/>

                                            <TextBlock Text="Business Registration Number"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding Brn, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBox}"/>

                                            <TextBlock Text="VAT / Tax Registration Number"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding TaxNo, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Phone"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBox}"/>

                                            <TextBlock Text="Email"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBox}"/>

                                            <TextBlock Text="Global VAT Rate %"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding GlobalVatRate, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBox}"
                                                     Width="150"
                                                     HorizontalAlignment="Left"
                                                     FontWeight="Bold"/>

                                            <TextBlock Text="This is the default VAT rate used by the system where item-specific tax rules are not configured."
                                                       Foreground="#64748B"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Address"
                                               Style="{StaticResource SectionTitleText}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Address Line 1"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBox}"/>

                                            <TextBlock Text="Address Line 2"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="City"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBox}"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Postal Code"
                                                               Style="{StaticResource FieldLabelText}"/>

                                                    <TextBox Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource InputTextBox}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Country"
                                                               Style="{StaticResource FieldLabelText}"/>

                                                    <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource InputTextBox}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2 -->
                <TabItem Header="Documents &amp; Receipt">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6,14,6,6">

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Document Prefixes"
                                               Style="{StaticResource SectionTitleText}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Invoice Prefix *"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding InvoicePrefix, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Purchase Order Prefix *"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding PurchaseOrderPrefix, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Quotation Print Prefix *"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding QuotationPrefix, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBox}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Quotation prefix is only used for cashier-side printed quotations. It does not create a saved quotation document."
                                               Foreground="#64748B"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Receipt Text"
                                               Style="{StaticResource SectionTitleText}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Receipt Header"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding ReceiptHeader, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource MultiLineTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Receipt Footer"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding ReceiptFooter, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource MultiLineTextBox}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Invoice Terms"
                                               Style="{StaticResource SectionTitleText}"/>

                                    <TextBlock Text="A4 invoice terms and conditions"
                                               Style="{StaticResource FieldLabelText}"/>

                                    <TextBox Text="{Binding InvoiceTerms, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MultiLineTextBox}"
                                             Height="150"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 3 -->
                <TabItem Header="Regional &amp; Financial">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6,14,6,6">

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Currency"
                                               Style="{StaticResource SectionTitleText}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Currency Code *"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding CurrencyCode, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Currency Symbol *"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding CurrencySymbol, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBox}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Regional Settings"
                                               Style="{StaticResource SectionTitleText}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Time Zone"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <ComboBox Text="{Binding TimeZoneId, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding TimeZones}"
                                                      IsEditable="True"
                                                      Style="{StaticResource InputComboBox}"/>

                                            <TextBlock Text="Date Format"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <ComboBox Text="{Binding DateFormat, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding DateFormats}"
                                                      IsEditable="True"
                                                      Style="{StaticResource InputComboBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Financial Year Start Month"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <ComboBox SelectedItem="{Binding FinancialYearStartMonth, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding FinancialYearStartMonths}"
                                                      Style="{StaticResource InputComboBox}"/>

                                            <TextBlock Text="Example: 1 = January, 4 = April."
                                                       Foreground="#64748B"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14"
                Margin="0,14,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="{Binding StatusColor}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Discard Changes"
                            Command="{Binding DiscardChangesCommand}"
                            Style="{StaticResource ActionButton}"
                            Margin="0,0,10,0"/>

                    <Button Content="Save Store Settings"
                            Command="{Binding SaveSettingsCommand}"
                            Style="{StaticResource SaveButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>