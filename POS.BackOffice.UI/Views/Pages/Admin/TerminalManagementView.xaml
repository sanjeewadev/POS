<UserControl x:Class="POS.BackOffice.UI.Views.Pages.Admin.TerminalManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="1250"
             Background="#F3F4F6"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <Style x:Key="PageTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PageSubTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="SectionTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2B5B84"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="MultiLineTextBox" TargetType="TextBox" BasedOn="{StaticResource InputTextBox}">
            <Setter Property="Height" Value="78"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="InputComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="InputCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C7C7C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ClassicButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="125"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D1D5DB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C7CBD1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ClassicButton}">
            <Setter Property="Background" Value="#2B5B84"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1E405E"/>
            <Setter Property="MinWidth" Value="145"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#244D70"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E405E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ClassicButton}">
            <Setter Property="Background" Value="#B91C1C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#7F1D1D"/>
        </Style>

        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E0E0E0"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#C7C7C7"
                BorderThickness="1"
                Padding="16"
                Margin="0,0,0,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="390"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Terminal Management"
                               Style="{StaticResource PageTitleText}"/>

                    <TextBlock Text="Register cashier terminals, view machine codes, check license status, and enable or disable terminals."
                               Style="{StaticResource PageSubTitleText}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#F8F8F8"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        Padding="10"
                        VerticalAlignment="Center">

                    <StackPanel>
                        <TextBlock Text="STATUS"
                                   Foreground="#666666"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{Binding StatusColor}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- TERMINAL LIST -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#C7C7C7"
                    BorderThickness="1"
                    Padding="12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Registered Terminals"
                                   Style="{StaticResource SectionTitleText}"
                                   Margin="0"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <Button Content="Refresh"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource ClassicButton}"
                                    Margin="0,0,8,0"/>

                            <Button Content="Register Current Machine"
                                    Command="{Binding RegisterCurrentMachineCommand}"
                                    Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Terminals}"
                              SelectedItem="{Binding SelectedTerminal, Mode=TwoWay}"
                              Style="{StaticResource GridStyle}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Terminal No"
                                                Binding="{Binding TerminalNo}"
                                                Width="85"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="Terminal Name"
                                                Binding="{Binding TerminalName}"
                                                Width="150"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="Machine Name"
                                                Binding="{Binding MachineName}"
                                                Width="140"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="Location"
                                                Binding="{Binding Location}"
                                                Width="120"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding TerminalTypeText}"
                                                Width="125"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="Active"
                                                Binding="{Binding ActiveStatusText}"
                                                Width="80"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="License ID"
                                                Binding="{Binding LicenseIdDisplay}"
                                                Width="130"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="License Status"
                                                Binding="{Binding LicenseStatusText}"
                                                Width="120"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="Expiry"
                                                Binding="{Binding LicenseExpiryDateText}"
                                                Width="95"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="Last Login"
                                                Binding="{Binding LastLoginText}"
                                                Width="125"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="Last Sale"
                                                Binding="{Binding LastSaleText}"
                                                Width="125"
                                                ElementStyle="{StaticResource GridCellText}"/>

                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2"
                            Background="#F8F8F8"
                            BorderBrush="#D0D0D0"
                            BorderThickness="1"
                            Padding="10"
                            Margin="0,10,0,0">

                        <TextBlock Text="BackOffice-only machines do not need terminal licenses. Cashier/selling terminals need a valid terminal license."
                                   Style="{StaticResource HelpText}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- EDIT PANEL -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#C7C7C7"
                    BorderThickness="1"
                    Padding="12">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Terminal Details"
                                   Style="{StaticResource SectionTitleText}"/>

                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="Use Register Current Machine when setting up this PC."
                                           Foreground="#2B5B84"
                                           FontWeight="Bold"
                                           FontSize="13"/>

                                <TextBlock Text="For another PC, copy its machine code from License Management or Terminal Management on that PC."
                                           Style="{StaticResource HelpText}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Terminal No *" Style="{StaticResource FieldLabelText}"/>
                        <TextBox Text="{Binding TerminalNo, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}"/>

                        <TextBlock Text="Terminal Name *" Style="{StaticResource FieldLabelText}"/>
                        <TextBox Text="{Binding TerminalName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}"/>

                        <TextBlock Text="Machine Name" Style="{StaticResource FieldLabelText}"/>
                        <TextBox Text="{Binding MachineName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}"/>

                        <TextBlock Text="Machine Code" Style="{StaticResource FieldLabelText}"/>
                        <TextBox Text="{Binding MachineCode, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}"/>

                        <Button Content="Copy Machine Code"
                                Command="{Binding CopyMachineCodeCommand}"
                                Style="{StaticResource ClassicButton}"
                                Width="165"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,10"/>

                        <TextBlock Text="Location *" Style="{StaticResource FieldLabelText}"/>
                        <ComboBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding Locations}"
                                  IsEditable="True"
                                  Style="{StaticResource InputComboBox}"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <CheckBox Content="Cashier Terminal"
                                          IsChecked="{Binding IsCashierTerminal, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource InputCheckBox}"/>

                                <CheckBox Content="BackOffice Allowed"
                                          IsChecked="{Binding IsBackOfficeAllowed, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource InputCheckBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <CheckBox Content="Active"
                                          IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource InputCheckBox}"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource SectionCard}" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="License Snapshot"
                                           Style="{StaticResource SectionTitleText}"
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="License ID" Style="{StaticResource FieldLabelText}"/>
                                <TextBlock Text="{Binding LicenseId}" Style="{StaticResource ValueText}"/>

                                <TextBlock Text="License Status" Style="{StaticResource FieldLabelText}"/>
                                <TextBlock Text="{Binding LicenseStatusText}" Style="{StaticResource ValueText}"/>

                                <TextBlock Text="License Expiry" Style="{StaticResource FieldLabelText}"/>
                                <TextBlock Text="{Binding LicenseExpiryDateText}" Style="{StaticResource ValueText}"/>

                                <TextBlock Text="Last Login" Style="{StaticResource FieldLabelText}"/>
                                <TextBlock Text="{Binding LastLoginText}" Style="{StaticResource ValueText}"/>

                                <TextBlock Text="Last Sale" Style="{StaticResource FieldLabelText}"/>
                                <TextBlock Text="{Binding LastSaleText}" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Remarks" Style="{StaticResource FieldLabelText}"/>
                        <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MultiLineTextBox}"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,4,0,10">

                            <Button Content="New"
                                    Command="{Binding NewTerminalCommand}"
                                    Style="{StaticResource ClassicButton}"
                                    Margin="0,0,8,0"/>

                            <Button Content="Save"
                                    Command="{Binding SaveTerminalCommand}"
                                    Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">

                            <Button Content="Activate"
                                    Command="{Binding ActivateTerminalCommand}"
                                    Style="{StaticResource ClassicButton}"
                                    Margin="0,0,8,0"/>

                            <Button Content="Deactivate"
                                    Command="{Binding DeactivateTerminalCommand}"
                                    Style="{StaticResource DangerButton}"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#C7C7C7"
                BorderThickness="1"
                Padding="12"
                Margin="0,12,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="{Binding StatusColor}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource ClassicButton}"
                            Margin="0,0,8,0"/>

                    <Button Content="Register Current Machine"
                            Command="{Binding RegisterCurrentMachineCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"/>

                    <Button Content="Save Terminal"
                            Command="{Binding SaveTerminalCommand}"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>