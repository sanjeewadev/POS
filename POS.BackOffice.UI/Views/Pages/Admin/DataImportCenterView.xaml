<UserControl x:Class="POS.BackOffice.UI.Views.Pages.Admin.DataImportCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{DynamicResource WindowBackgroundBrush}"
             FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <!-- Converters could go here (e.g. for step visibility) -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Styles matching ItemMasterView -->
        <Style TargetType="Button" x:Key="ClassicBtn">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="{DynamicResource ButtonDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="ActionBtn" BasedOn="{StaticResource ClassicBtn}">
            <Setter Property="Background" Value="{DynamicResource ActionBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WhiteBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBoxBorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ActionHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="DataGridCell" x:Key="BaseCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsValid}" Value="False">
                    <Setter Property="Background" Value="#FFE6E6"/>
                    <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsValid}" Value="True">
                    <Setter Property="Background" Value="#E6FFE6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderTextBrush}" Padding="15" Margin="0,0,0,10">
            <TextBlock Text="DATA TRANSFER CENTER" Foreground="{DynamicResource WhiteBackgroundBrush}" FontSize="16" FontWeight="Bold"/>
        </Border>

        <TabControl Grid.Row="1" SelectedIndex="0" Background="Transparent" BorderThickness="0">
            <TabItem Header="IMPORT DATA" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <!-- Step 1: Upload (Visible when CurrentStep == 1) -->
                    <Grid Visibility="{Binding IsStep1Visible, Converter={StaticResource BoolToVis}, FallbackValue=Visible}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Step 1: Download Template or Upload Data" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="{DynamicResource PrimaryTextBrush}"/>
                
                <ComboBox ItemsSource="{Binding ImportTypes}" SelectedItem="{Binding SelectedImportType}" Width="200" Height="28" Margin="0,0,0,15"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="DOWNLOAD TEMPLATE" Command="{Binding DownloadTemplateCommand}" Style="{StaticResource ClassicBtn}" Margin="0,0,15,0" Height="35" Padding="20,0"/>
                    <Button Content="BROWSE &amp; UPLOAD CSV" Command="{Binding UploadFileCommand}" Style="{StaticResource ActionBtn}" Height="35" Padding="20,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Step 2: Validation Grid (Visible when CurrentStep == 2) -->
        <Grid Grid.Row="1" Visibility="{Binding IsStep2Visible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,0,20,0" Foreground="{DynamicResource PrimaryTextBrush}">
                        <Run Text="Total Rows: "/> <Run Text="{Binding TotalRows}"/>
                    </TextBlock>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,0,20,0" Foreground="#28A745">
                        <Run Text="Valid: "/> <Run Text="{Binding ValidRows}"/>
                    </TextBlock>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#DC3545">
                        <Run Text="Errors: "/> <Run Text="{Binding ErrorRows}"/>
                    </TextBlock>
                    <Button Content="Clear All Errors" Command="{Binding ClearErrorsCommand}" 
                            Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource ClassicBtn}" Margin="20,0,0,0" Padding="15,2" Background="#FFF5F5" Foreground="#DC3545" BorderBrush="#DC3545"/>
                </WrapPanel>
            </Border>

            <DataGrid Grid.Row="1" ItemsSource="{Binding PreviewData}" 
                      Visibility="{Binding IsItemsImport, Converter={StaticResource BoolToVis}}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" AlternatingRowBackground="{DynamicResource DataGridAlternatingRow}">
                <DataGrid.Columns>
                      <DataGridTextColumn Header="Row" Binding="{Binding RowNumber}" Width="50"/>
                      <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="60" FontWeight="Bold"/>
                      <DataGridTextColumn Header="Item Code" Binding="{Binding Data.ItemCode}" Width="90"/>
                      <DataGridTextColumn Header="Item Name" Binding="{Binding Data.ItemName}" Width="150"/>
                      <DataGridTextColumn Header="Category" Binding="{Binding Data.CategoryName}" Width="120"/>
                      <DataGridTextColumn Header="SubCat" Binding="{Binding Data.SubCategoryName}" Width="100"/>
                      <DataGridTextColumn Header="Barcode" Binding="{Binding Data.Barcode}" Width="100"/>
                      <DataGridTextColumn Header="Retail" Binding="{Binding Data.RetailPrice, StringFormat=N2}" Width="80"/>
                      <DataGridTextColumn Header="Error Message" Binding="{Binding ErrorMessage}" Width="*"/>
                      <DataGridTemplateColumn Width="70">
                          <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                  <Button Content="Remove" 
                                          Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                          CommandParameter="{Binding}" 
                                          Style="{StaticResource ClassicBtn}" Background="#FFF5F5" Foreground="#DC3545" BorderBrush="#DC3545" Padding="5,2" Margin="2"/>
                              </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid Grid.Row="1" ItemsSource="{Binding CategoriesPreviewData}" 
                      Visibility="{Binding IsCategoriesImport, Converter={StaticResource BoolToVis}}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" AlternatingRowBackground="{DynamicResource DataGridAlternatingRow}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Row" Binding="{Binding RowNumber}" Width="50"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="60" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Code" Binding="{Binding Data.CategoryCode}" Width="100"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Data.CategoryName}" Width="150"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Data.Description}" Width="*"/>
                    <DataGridTextColumn Header="Display Order" Binding="{Binding Data.DisplayOrder}" Width="100"/>
                    <DataGridTextColumn Header="Error Message" Binding="{Binding ErrorMessage}" Width="*"/>
                    <DataGridTemplateColumn Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove" 
                                        Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" 
                                        Style="{StaticResource ClassicBtn}" Background="#FFF5F5" Foreground="#DC3545" BorderBrush="#DC3545" Padding="5,2" Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid Grid.Row="1" ItemsSource="{Binding SubCategoriesPreviewData}" 
                      Visibility="{Binding IsSubCategoriesImport, Converter={StaticResource BoolToVis}}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" AlternatingRowBackground="{DynamicResource DataGridAlternatingRow}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Row" Binding="{Binding RowNumber}" Width="50"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="60" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Parent Category" Binding="{Binding Data.ParentCategoryName}" Width="150"/>
                    <DataGridTextColumn Header="Code" Binding="{Binding Data.SubCategoryCode}" Width="100"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Data.SubCategoryName}" Width="150"/>
                    <DataGridTextColumn Header="Display Order" Binding="{Binding Data.DisplayOrder}" Width="100"/>
                    <DataGridTextColumn Header="Error Message" Binding="{Binding ErrorMessage}" Width="*"/>
                    <DataGridTemplateColumn Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove" 
                                        Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" 
                                        Style="{StaticResource ClassicBtn}" Background="#FFF5F5" Foreground="#DC3545" BorderBrush="#DC3545" Padding="5,2" Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid Grid.Row="1" ItemsSource="{Binding SuppliersPreviewData}" 
                      Visibility="{Binding IsSuppliersImport, Converter={StaticResource BoolToVis}}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" AlternatingRowBackground="{DynamicResource DataGridAlternatingRow}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Row" Binding="{Binding RowNumber}" Width="50"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="60" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Code" Binding="{Binding Data.SupplierCode}" Width="100"/>
                    <DataGridTextColumn Header="Supplier Name" Binding="{Binding Data.SupplierName}" Width="150"/>
                    <DataGridTextColumn Header="Company Name" Binding="{Binding Data.CompanyName}" Width="150"/>
                    <DataGridTextColumn Header="Phone 1" Binding="{Binding Data.Phone1}" Width="120"/>
                    <DataGridTextColumn Header="Error Message" Binding="{Binding ErrorMessage}" Width="*"/>
                    <DataGridTemplateColumn Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove" 
                                        Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" 
                                        Style="{StaticResource ClassicBtn}" Background="#FFF5F5" Foreground="#DC3545" BorderBrush="#DC3545" Padding="5,2" Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="CANCEL" Command="{Binding CancelImportCommand}" Style="{StaticResource ClassicBtn}" Margin="0,0,10,0"/>
                <Button Content="IMPORT TO DATABASE" Command="{Binding ExecuteImportCommand}" Style="{StaticResource ActionBtn}"/>
            </StackPanel>
        </Grid>
        
        <!-- Step 3: Success -->
        <Grid Visibility="{Binding IsStep3Visible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Processing Import..." FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>
        </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="EXPORT DATA" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,20,0,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0">
                        <TextBlock Text="Export Master Data to CSV" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,30" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                        
                        <Button Content="EXPORT CATEGORIES" Command="{Binding ExportCategoriesCommand}" Style="{StaticResource ActionBtn}" Height="45" Width="250" Margin="0,0,0,15" FontSize="14"/>
                        <Button Content="EXPORT SUB-CATEGORIES" Command="{Binding ExportSubCategoriesCommand}" Style="{StaticResource ActionBtn}" Height="45" Width="250" Margin="0,0,0,15" FontSize="14"/>
                        <Button Content="EXPORT ITEMS" Command="{Binding ExportItemsCommand}" Style="{StaticResource ActionBtn}" Height="45" Width="250" FontSize="14"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
