<UserControl x:Class="POS.BackOffice.UI.Views.Pages.Admin.BackupRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1280"
             Background="{DynamicResource WindowBackgroundBrush}"
             FontFamily="Segoe UI"
             FontSize="12">

    <UserControl.Resources>

        <Style TargetType="TextBlock" x:Key="HeaderLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="InlineLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="HelpText">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ValueText">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="Border" x:Key="ClassicGroupBox">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="Border" x:Key="ReadOnlyValueBox">
            <Setter Property="Background" Value="{DynamicResource WhiteBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="25"/>
        </Style>

        <Style TargetType="TextBox" x:Key="ClassicInput">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource ButtonDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="Button" x:Key="ClassicBtn">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="Background" Value="{DynamicResource ButtonDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button"
               x:Key="ActionBtn"
               BasedOn="{StaticResource ClassicBtn}">
            <Setter Property="Background" Value="{DynamicResource ActionBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WhiteBackgroundBrush}"/>
            <Setter Property="MinWidth" Value="140"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ActionHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button"
               x:Key="DangerBtn"
               BasedOn="{StaticResource ClassicBtn}">
            <Setter Property="Background" Value="#B91C1C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#7F1D1D"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>

        <Style TargetType="DataGrid" x:Key="ClassicGrid">
            <Setter Property="Background" Value="{DynamicResource WhiteBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#D0D0D0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#D0D0D0"/>
            <Setter Property="RowHeight" Value="27"/>
            <Setter Property="ColumnHeaderHeight" Value="28"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <Border Grid.Row="0"
                Style="{StaticResource ClassicGroupBox}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,20,0">
                    <TextBlock Text="1. DATABASE BACKUP &amp; RESTORE"
                               Style="{StaticResource HeaderLabel}"/>
                    <TextBlock Text="{Binding BackupModeDescription}"
                               Style="{StaticResource HelpText}"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Foreground="{Binding StatusColor}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="10,0,15,0"/>

                <Border Grid.Column="2"
                        Style="{StaticResource ReadOnlyValueBox}"
                        MinWidth="185">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Text="ACCESS: "
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text"
                                            Value="Administrator Only"/>
                                    <Setter Property="Foreground"
                                            Value="#B91C1C"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdministrator}"
                                                     Value="True">
                                            <Setter Property="Text"
                                                    Value="Administrator"/>
                                            <Setter Property="Foreground"
                                                    Value="#008000"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2 + 3 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CURRENT DATABASE -->
            <Border Grid.Column="0"
                    Style="{StaticResource ClassicGroupBox}">
                <StackPanel>
                    <TextBlock Text="2. CURRENT DATABASE"
                               Style="{StaticResource HeaderLabel}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="29"/>
                            <RowDefinition Height="29"/>
                            <RowDefinition Height="29"/>
                            <RowDefinition Height="29"/>
                            <RowDefinition Height="29"/>
                            <RowDefinition Height="29"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Store"
                                   Style="{StaticResource InlineLabel}"/>
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding CurrentStoreText}"
                                 Style="{StaticResource ClassicInput}"/>

                        <TextBlock Grid.Row="1"
                                   Text="Database Mode"
                                   Style="{StaticResource InlineLabel}"/>
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding CurrentDatabaseModeText}"
                                 Style="{StaticResource ClassicInput}"/>

                        <TextBlock Grid.Row="2"
                                   Text="{Binding CurrentDatabaseLocationLabel}"
                                   Style="{StaticResource InlineLabel}"/>
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding CurrentDatabasePath}"
                                 ToolTip="{Binding CurrentDatabasePath}"
                                 Style="{StaticResource ClassicInput}"/>

                        <TextBlock Grid.Row="3"
                                   Text="{Binding CurrentDatabaseDetailLabel}"
                                   Style="{StaticResource InlineLabel}"/>
                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Text="{Binding CurrentDatabaseSizeText}"
                                 Style="{StaticResource ClassicInput}"/>

                        <TextBlock Grid.Row="4"
                                   Text="Schema / Migration"
                                   Style="{StaticResource InlineLabel}"/>
                        <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 Text="{Binding CurrentMigrationText}"
                                 ToolTip="{Binding CurrentMigrationText}"
                                 Style="{StaticResource ClassicInput}"/>

                        <TextBlock Grid.Row="5"
                                   Text="Last Backup"
                                   Style="{StaticResource InlineLabel}"/>
                        <TextBox Grid.Row="5"
                                 Grid.Column="1"
                                 Text="{Binding LastBackupText}"
                                 ToolTip="{Binding LastBackupText}"
                                 Style="{StaticResource ClassicInput}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- CREATE MANUAL BACKUP -->
            <Border Grid.Column="2"
                    Style="{StaticResource ClassicGroupBox}">
                <StackPanel>
                    <TextBlock Text="3. CREATE MANUAL BACKUP"
                               Style="{StaticResource HeaderLabel}"/>

                    <Border Background="#FFF7E6"
                            BorderBrush="#D97706"
                            BorderThickness="1"
                            Padding="8"
                            Margin="0,0,0,8"
                            Visibility="{Binding IsCentralSqlServer, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Central SQL Server is active. Create and verify .bak backups on the BackOffice server computer by using Start menu > Advanced POS > Backup POS Database."
                                   Foreground="#9A3412"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Choose a USB drive or another secure folder. The backup is created as one verified .posbackup file."
                               Style="{StaticResource HelpText}"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Default Backup Folder"
                               Style="{StaticResource InlineLabel}"/>

                    <TextBox Text="{Binding BackupFolder}"
                             ToolTip="{Binding BackupFolder}"
                             Style="{StaticResource ClassicInput}"
                             Margin="0,3,0,8"/>

                    <TextBlock Text="Backup files contain store data. Keep them in a secure location."
                               Foreground="#C05A00"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="CREATE BACKUP"
                                Command="{Binding CreateBackupCommand}"
                                IsEnabled="{Binding CanUseLocalBackup}"
                                Style="{StaticResource ActionBtn}"
                                Margin="0,0,8,0"/>

                        <Button Content="OPEN BACKUP FOLDER"
                                Command="{Binding OpenBackupFolderCommand}"
                                IsEnabled="{Binding CanUseLocalBackup}"
                                Style="{StaticResource ClassicBtn}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. RESTORE -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ClassicGroupBox}">
                <StackPanel>
                    <TextBlock Text="4. VERIFY AND RESTORE BACKUP"
                               Style="{StaticResource HeaderLabel}"/>

                    <Border Background="#FFF7E6"
                            BorderBrush="#D97706"
                            BorderThickness="1"
                            Padding="8"
                            Margin="0,0,0,8"
                            Visibility="{Binding IsCentralSqlServer, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="SQLite .posbackup files do not apply to the active central SQL Server database. Use the approved SQL Server backup and restore tools on the BackOffice server computer."
                                   Foreground="#9A3412"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="29"/>
                            <RowDefinition Height="29"/>
                            <RowDefinition Height="29"/>
                            <RowDefinition Height="29"/>
                            <RowDefinition Height="29"/>
                            <RowDefinition Height="29"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Selected File"
                                   Style="{StaticResource InlineLabel}"/>
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding SelectedBackupFile}"
                                 ToolTip="{Binding SelectedBackupFile}"
                                 Style="{StaticResource ClassicInput}"/>

                        <Button Grid.Row="0"
                                Grid.Column="3"
                                Content="SELECT FILE"
                                Command="{Binding SelectBackupFileCommand}"
                                IsEnabled="{Binding CanUseLocalBackup}"
                                Style="{StaticResource ClassicBtn}"/>

                        <Button Grid.Row="0"
                                Grid.Column="5"
                                Content="CLEAR"
                                Command="{Binding ClearSelectedBackupFileCommand}"
                                Style="{StaticResource ClassicBtn}"/>

                        <TextBlock Grid.Row="1"
                                   Text="Store"
                                   Style="{StaticResource InlineLabel}"/>
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="5"
                                 Text="{Binding SelectedBackupStore}"
                                 Style="{StaticResource ClassicInput}"/>

                        <TextBlock Grid.Row="2"
                                   Text="Created"
                                   Style="{StaticResource InlineLabel}"/>
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding SelectedBackupCreatedAt}"
                                 Style="{StaticResource ClassicInput}"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="3"
                                   Text="App Version"
                                   Style="{StaticResource InlineLabel}"/>
                        <TextBox Grid.Row="2"
                                 Grid.Column="5"
                                 Width="160"
                                 Text="{Binding SelectedBackupVersion}"
                                 Style="{StaticResource ClassicInput}"/>

                        <TextBlock Grid.Row="3"
                                   Text="Migration"
                                   Style="{StaticResource InlineLabel}"/>
                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="5"
                                 Text="{Binding SelectedBackupMigration}"
                                 ToolTip="{Binding SelectedBackupMigration}"
                                 Style="{StaticResource ClassicInput}"/>

                        <TextBlock Grid.Row="4"
                                   Text="Database Size"
                                   Style="{StaticResource InlineLabel}"/>
                        <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 Text="{Binding SelectedBackupSize}"
                                 Style="{StaticResource ClassicInput}"/>

                        <TextBlock Grid.Row="4"
                                   Grid.Column="3"
                                   Text="Last Restore"
                                   Style="{StaticResource InlineLabel}"/>
                        <TextBox Grid.Row="4"
                                 Grid.Column="5"
                                 Width="260"
                                 Text="{Binding LastRestoreText}"
                                 ToolTip="{Binding LastRestoreText}"
                                 Style="{StaticResource ClassicInput}"/>

                        <TextBlock Grid.Row="5"
                                   Text="Verification"
                                   Style="{StaticResource InlineLabel}"/>
                        <Border Grid.Row="5"
                                Grid.Column="1"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource ReadOnlyValueBox}">
                            <TextBlock Text="{Binding VerifyResultText}"
                                       Style="{StaticResource ValueText}"/>
                        </Border>

                        <StackPanel Grid.Row="5"
                                    Grid.Column="5"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="VERIFY"
                                    Command="{Binding VerifyBackupCommand}"
                                    IsEnabled="{Binding CanUseLocalBackup}"
                                    Style="{StaticResource ClassicBtn}"
                                    Margin="0,0,8,0"/>

                            <Button Content="RESTORE BACKUP"
                                    Command="{Binding RestoreBackupCommand}"
                                    IsEnabled="{Binding CanUseLocalBackup}"
                                    Style="{StaticResource DangerBtn}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Standalone SQLite restore replaces the current local database only after checksum, integrity, required-table, and migration checks pass. A restore-safety copy is created first."
                               Foreground="#C05A00"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- HISTORY -->
            <Border Grid.Row="2"
                    Style="{StaticResource ClassicGroupBox}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="5. RECENT MANUAL OPERATIONS"
                                   Style="{StaticResource HeaderLabel}"
                                   Margin="0"/>

                        <Button Grid.Column="1"
                                Content="REFRESH"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource ClassicBtn}"/>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding RecentHistory}"
                              SelectedItem="{Binding SelectedHistory, Mode=TwoWay}"
                              Style="{StaticResource ClassicGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date / Time"
                                                Binding="{Binding CreatedAtText}"
                                                Width="140"/>
                            <DataGridTextColumn Header="Action"
                                                Binding="{Binding ActionType}"
                                                Width="125"/>
                            <DataGridTextColumn Header="Result"
                                                Binding="{Binding StatusText}"
                                                Width="75"/>
                            <DataGridTextColumn Header="Backup File"
                                                Binding="{Binding BackupFileNameDisplay}"
                                                Width="230"/>
                            <DataGridTextColumn Header="Size"
                                                Binding="{Binding DisplayFileSize}"
                                                Width="90"/>
                            <DataGridTextColumn Header="User"
                                                Binding="{Binding CreatedBy}"
                                                Width="110"/>
                            <DataGridTextColumn Header="Terminal"
                                                Binding="{Binding TerminalNo}"
                                                Width="75"/>
                            <DataGridTextColumn Header="Message"
                                                Binding="{Binding Message}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="6"
                Style="{StaticResource ClassicGroupBox}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{Binding StatusColor}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <TextBlock Grid.Column="1"
                           Text="Manual operations only — no automatic backup schedule"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontStyle="Italic"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
