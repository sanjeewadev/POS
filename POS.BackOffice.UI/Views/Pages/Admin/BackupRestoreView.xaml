<UserControl x:Class="POS.BackOffice.UI.Views.Pages.Admin.BackupRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="1250"
             Background="#F3F4F6"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <Style x:Key="PageTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PageSubTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="SectionTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2B5B84"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ReadOnlyTextBox" TargetType="TextBox" BasedOn="{StaticResource InputTextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F8F8F8"/>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C7C7C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="WarningCard" TargetType="Border">
            <Setter Property="Background" Value="#FFF7ED"/>
            <Setter Property="BorderBrush" Value="#FDBA74"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ClassicButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="125"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D1D5DB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C7CBD1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ClassicButton}">
            <Setter Property="Background" Value="#2B5B84"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1E405E"/>
            <Setter Property="MinWidth" Value="145"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#244D70"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E405E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ClassicButton}">
            <Setter Property="Background" Value="#B91C1C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#7F1D1D"/>
        </Style>

        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E0E0E0"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#C7C7C7"
                BorderThickness="1"
                Padding="16"
                Margin="0,0,0,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="390"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Backup &amp; Restore"
                               Style="{StaticResource PageTitleText}"/>

                    <TextBlock Text="Create manual backups, restore from backup files, open backup folder, and verify backup packages."
                               Style="{StaticResource PageSubTitleText}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#F8F8F8"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        Padding="10"
                        VerticalAlignment="Center">

                    <StackPanel>
                        <TextBlock Text="STATUS"
                                   Foreground="#666666"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{Binding StatusColor}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT ACTION PANEL -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- BACKUP ACTIONS -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Manual Backup"
                                       Style="{StaticResource SectionTitleText}"/>

                            <TextBlock Text="Create a backup file from the current local SQLite database."
                                       Style="{StaticResource HelpText}"
                                       Margin="0,0,0,10"/>

                            <Button Content="Create Backup"
                                    Command="{Binding CreateBackupCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12"/>

                            <TextBlock Text="Last Backup" Style="{StaticResource FieldLabelText}"/>
                            <TextBlock Text="{Binding LastBackupText}" Style="{StaticResource ValueText}"/>

                            <TextBlock Text="Last Created Backup File" Style="{StaticResource FieldLabelText}"/>
                            <TextBox Text="{Binding LastCreatedBackupFile}"
                                     Style="{StaticResource ReadOnlyTextBox}"/>

                            <TextBlock Text="Last Created Checksum" Style="{StaticResource FieldLabelText}"/>
                            <TextBox Text="{Binding LastCreatedBackupChecksum}"
                                     Style="{StaticResource ReadOnlyTextBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- BACKUP FOLDER -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Backup Folder"
                                       Style="{StaticResource SectionTitleText}"/>

                            <TextBlock Text="Backup files are saved in this folder by default."
                                       Style="{StaticResource HelpText}"
                                       Margin="0,0,0,10"/>

                            <TextBox Text="{Binding BackupFolder}"
                                     Style="{StaticResource ReadOnlyTextBox}"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Open Backup Folder"
                                        Command="{Binding OpenBackupFolderCommand}"
                                        Style="{StaticResource ClassicButton}"
                                        Margin="0,0,8,0"/>

                                <Button Content="Copy Folder Path"
                                        Command="{Binding CopyBackupFolderCommand}"
                                        Style="{StaticResource ClassicButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CUSTOMER INSTRUCTIONS -->
                    <Border Style="{StaticResource WarningCard}">
                        <StackPanel>
                            <TextBlock Text="Customer Backup Instruction"
                                       Foreground="#9A3412"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Create a backup daily and copy/upload the backup file to Google Drive, USB drive, or external hard disk."
                                       Foreground="#7C2D12"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"/>

                            <TextBlock Text="Do not keep the only backup inside the same computer. If the computer hard disk fails, the local backup can also be lost."
                                       Foreground="#7C2D12"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT PANEL -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- RESTORE / VERIFY -->
                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="#C7C7C7"
                        BorderThickness="1"
                        Padding="14"
                        Margin="0,0,0,12">

                    <StackPanel>
                        <TextBlock Text="Restore / Verify Backup File"
                                   Style="{StaticResource SectionTitleText}"/>

                        <TextBlock Text="Selected Backup File" Style="{StaticResource FieldLabelText}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding SelectedBackupFile}"
                                     Style="{StaticResource ReadOnlyTextBox}"
                                     Margin="0"/>

                            <Button Grid.Column="2"
                                    Content="Select File"
                                    Command="{Binding SelectBackupFileForActionCommand}"
                                    Style="{StaticResource ClassicButton}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Verify Backup"
                                    Command="{Binding VerifyBackupCommand}"
                                    Style="{StaticResource ClassicButton}"
                                    Margin="0,0,8,0"/>

                            <Button Content="Restore Backup"
                                    Command="{Binding RestoreBackupCommand}"
                                    Style="{StaticResource DangerButton}"
                                    Margin="0,0,8,0"/>

                            <Button Content="Clear Selection"
                                    Command="{Binding ClearSelectedBackupFileCommand}"
                                    Style="{StaticResource ClassicButton}"/>
                        </StackPanel>

                        <Border Background="#F8F8F8"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                Padding="10">

                            <StackPanel>
                                <TextBlock Text="Verify Result"
                                           Style="{StaticResource FieldLabelText}"/>

                                <TextBlock Text="{Binding VerifyResultText}"
                                           Foreground="#111827"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFF7ED"
                                BorderBrush="#FDBA74"
                                BorderThickness="1"
                                Padding="10"
                                Margin="0,10,0,0">

                            <TextBlock Text="Restore will replace the current database. Close cashier windows before restore. After restore, restart the application before continuing work."
                                       Foreground="#7C2D12"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Last Restore" Style="{StaticResource FieldLabelText}" Margin="0,10,0,4"/>
                        <TextBlock Text="{Binding LastRestoreText}" Style="{StaticResource ValueText}"/>
                    </StackPanel>
                </Border>

                <!-- HISTORY -->
                <Border Grid.Row="1"
                        Background="White"
                        BorderBrush="#C7C7C7"
                        BorderThickness="1"
                        Padding="12">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Recent Backup / Restore History"
                                       Style="{StaticResource SectionTitleText}"
                                       Margin="0"/>

                            <Button Grid.Column="1"
                                    Content="Refresh"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource ClassicButton}"/>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding RecentHistory}"
                                  SelectedItem="{Binding SelectedHistory, Mode=TwoWay}"
                                  Style="{StaticResource GridStyle}"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Date / Time"
                                                    Binding="{Binding CreatedAtText}"
                                                    Width="140"
                                                    ElementStyle="{StaticResource GridCellText}"/>

                                <DataGridTextColumn Header="Action"
                                                    Binding="{Binding ActionType}"
                                                    Width="120"
                                                    ElementStyle="{StaticResource GridCellText}"/>

                                <DataGridTextColumn Header="Status"
                                                    Binding="{Binding StatusText}"
                                                    Width="80"
                                                    ElementStyle="{StaticResource GridCellText}"/>

                                <DataGridTextColumn Header="Backup File"
                                                    Binding="{Binding BackupFileNameDisplay}"
                                                    Width="220"
                                                    ElementStyle="{StaticResource GridCellText}"/>

                                <DataGridTextColumn Header="Size"
                                                    Binding="{Binding DisplayFileSize}"
                                                    Width="90"
                                                    ElementStyle="{StaticResource GridCellText}"/>

                                <DataGridTextColumn Header="Machine"
                                                    Binding="{Binding MachineName}"
                                                    Width="130"
                                                    ElementStyle="{StaticResource GridCellText}"/>

                                <DataGridTextColumn Header="Terminal"
                                                    Binding="{Binding TerminalNo}"
                                                    Width="80"
                                                    ElementStyle="{StaticResource GridCellText}"/>

                                <DataGridTextColumn Header="Message"
                                                    Binding="{Binding Message}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource GridCellText}"/>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#C7C7C7"
                BorderThickness="1"
                Padding="12"
                Margin="0,12,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="{Binding StatusColor}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Create Backup"
                            Command="{Binding CreateBackupCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"/>

                    <Button Content="Restore Backup"
                            Command="{Binding RestoreBackupCommand}"
                            Style="{StaticResource DangerButton}"
                            Margin="0,0,8,0"/>

                    <Button Content="Open Backup Folder"
                            Command="{Binding OpenBackupFolderCommand}"
                            Style="{StaticResource ClassicButton}"
                            Margin="0,0,8,0"/>

                    <Button Content="Verify Backup"
                            Command="{Binding VerifyBackupCommand}"
                            Style="{StaticResource ClassicButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>