<UserControl x:Class="POS.BackOffice.UI.Views.Pages.Admin.LicenseManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1280"
             Background="{DynamicResource WindowBackgroundBrush}"
             FontFamily="Segoe UI"
             FontSize="12">

    <UserControl.Resources>

        <Style TargetType="TextBlock" x:Key="HeaderLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="InlineLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style TargetType="TextBox" x:Key="ClassicInput">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource WhiteBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonDefaultBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="ClassicBtn">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="Background" Value="{DynamicResource ButtonDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="ActionBtn" BasedOn="{StaticResource ClassicBtn}">
            <Setter Property="Background" Value="{DynamicResource ActionBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WhiteBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="MinWidth" Value="135"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ActionHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Border" x:Key="ClassicGroupBox">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="Border" x:Key="ReadOnlyValueBox">
            <Setter Property="Background" Value="{DynamicResource WhiteBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="25"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ValueText">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="HelpText">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Style="{StaticResource ClassicGroupBox}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="1. LICENSE MANAGEMENT"
                               Style="{StaticResource HeaderLabel}"/>
                    <TextBlock Text="Offline annual store and terminal licensing"
                               Style="{StaticResource HelpText}"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Foreground="{Binding StatusColor}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="10,0,15,0"/>

                <Border Grid.Column="2"
                        Background="{DynamicResource WhiteBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Padding="12,5"
                        MinWidth="175">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Text="OVERALL: "
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding OverallStatus}"
                                   Foreground="{Binding OverallStatusColor}"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- BODY -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- OPERATING STATUS -->
                <Border Style="{StaticResource ClassicGroupBox}"
                        Margin="0,0,0,5">
                    <StackPanel>
                        <TextBlock Text="2. OPERATING STATUS"
                                   Style="{StaticResource HeaderLabel}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource ReadOnlyValueBox}">
                                <StackPanel>
                                    <TextBlock Text="Overall License" Style="{StaticResource InlineLabel}"/>
                                    <TextBlock Text="{Binding OverallStatus}"
                                               Foreground="{Binding OverallStatusColor}"
                                               FontSize="14"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource ReadOnlyValueBox}">
                                <StackPanel>
                                    <TextBlock Text="Operating Mode" Style="{StaticResource InlineLabel}"/>
                                    <TextBlock FontSize="14" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Operational"/>
                                                <Setter Property="Foreground" Value="#008000"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReadOnlyMode}" Value="True">
                                                        <Setter Property="Text" Value="Cashier Locked"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource ReadOnlyValueBox}">
                                <StackPanel>
                                    <TextBlock Text="BackOffice" Style="{StaticResource InlineLabel}"/>
                                    <TextBlock FontSize="14" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Blocked"/>
                                                <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanRunBackOffice}" Value="True">
                                                        <Setter Property="Text" Value="Allowed"/>
                                                        <Setter Property="Foreground" Value="#008000"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="6" Style="{StaticResource ReadOnlyValueBox}">
                                <StackPanel>
                                    <TextBlock Text="Cashier Terminal" Style="{StaticResource InlineLabel}"/>
                                    <TextBlock FontSize="14" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Blocked"/>
                                                <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanRunCashier}" Value="True">
                                                        <Setter Property="Text" Value="Allowed"/>
                                                        <Setter Property="Foreground" Value="#008000"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- STORE AND TERMINAL LICENSES -->
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource ClassicGroupBox}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="3. STORE LICENSE"
                                           Style="{StaticResource HeaderLabel}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding LicenseStatus}"
                                           Foreground="{Binding StoreLicenseStatusColor}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Top"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Store ID" Style="{StaticResource InlineLabel}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding StoreId}"
                                         IsReadOnly="True"
                                         Style="{StaticResource ClassicInput}"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Current Store Name" Style="{StaticResource InlineLabel}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding CurrentStoreName}"
                                         IsReadOnly="True"
                                         Style="{StaticResource ClassicInput}"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Licensed Store Name" Style="{StaticResource InlineLabel}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding LicensedStoreName}"
                                         IsReadOnly="True"
                                         Style="{StaticResource ClassicInput}"/>
                            </Grid>

                            <Border Background="{DynamicResource HighlightBackgroundBrush}"
                                    BorderBrush="{DynamicResource LightBorderBrush}"
                                    BorderThickness="1"
                                    Padding="7"
                                    Margin="0,0,0,5">
                                <TextBlock Text="{Binding StoreNameIdentityMessage}"
                                           Foreground="{Binding StoreNameIdentityColor}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="License ID" Style="{StaticResource InlineLabel}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding LicenseId}"
                                         IsReadOnly="True"
                                         Style="{StaticResource ClassicInput}"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Expiry Date" Style="{StaticResource InlineLabel}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding ExpiryDate}"
                                         IsReadOnly="True"
                                         Style="{StaticResource ClassicInput}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Days Remaining" Style="{StaticResource InlineLabel}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding DaysRemaining}"
                                         IsReadOnly="True"
                                         Style="{StaticResource ClassicInput}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource ClassicGroupBox}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="4. TERMINAL LICENSE"
                                           Style="{StaticResource HeaderLabel}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TerminalLicenseStatus}"
                                           Foreground="{Binding TerminalLicenseStatusColor}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Top"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Terminal No" Style="{StaticResource InlineLabel}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding CurrentTerminalNo}"
                                         IsReadOnly="True"
                                         Style="{StaticResource ClassicInput}"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="License ID" Style="{StaticResource InlineLabel}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding TerminalLicenseId}"
                                         IsReadOnly="True"
                                         Style="{StaticResource ClassicInput}"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Expiry Date" Style="{StaticResource InlineLabel}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding TerminalExpiryDate}"
                                         IsReadOnly="True"
                                         Style="{StaticResource ClassicInput}"/>
                            </Grid>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Days Remaining" Style="{StaticResource InlineLabel}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding TerminalDaysRemaining}"
                                         IsReadOnly="True"
                                         Style="{StaticResource ClassicInput}"/>
                            </Grid>

                            <Border Background="{DynamicResource HighlightBackgroundBrush}"
                                    BorderBrush="{DynamicResource LightBorderBrush}"
                                    BorderThickness="1"
                                    Padding="7">
                                <TextBlock Text="Only cashier or selling computers require an active terminal license. BackOffice remains available for administration and renewal."
                                           Style="{StaticResource HelpText}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- CURRENT MACHINE AND REQUEST -->
                <Border Style="{StaticResource ClassicGroupBox}">
                    <StackPanel>
                        <TextBlock Text="5. CURRENT MACHINE AND LICENSE REQUEST"
                                   Style="{StaticResource HeaderLabel}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="125"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Machine Name" Style="{StaticResource InlineLabel}"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding CurrentMachineName}"
                                             IsReadOnly="True"
                                             Style="{StaticResource ClassicInput}"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="125"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Machine Code" Style="{StaticResource InlineLabel}"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding CurrentMachineCode}"
                                             IsReadOnly="True"
                                             FontWeight="Bold"
                                             Style="{StaticResource ClassicInput}"/>
                                </Grid>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Background="{DynamicResource WhiteBackgroundBrush}"
                                    BorderBrush="{DynamicResource LightBorderBrush}"
                                    BorderThickness="1"
                                    Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Create licence requests here. Store Settings supplies the operational store name automatically; do not type it again in the License Generator."
                                               Style="{StaticResource HelpText}"
                                               Margin="0,0,0,8"/>
                                    <WrapPanel Grid.Row="1">
                                        <Button Content="COPY STORE LICENCE REQUEST"
                                                Command="{Binding CopyStoreLicenseRequestCommand}"
                                                Style="{StaticResource ClassicBtn}"
                                                Margin="0,0,8,6"/>
                                        <Button Content="COPY TERMINAL LICENCE REQUEST"
                                                Command="{Binding CopyTerminalLicenseRequestCommand}"
                                                Style="{StaticResource ClassicBtn}"
                                                Margin="0,0,8,6"/>
                                        <Button Content="COPY MACHINE CODE"
                                                Command="{Binding CopyMachineCodeCommand}"
                                                Style="{StaticResource ClassicBtn}"
                                                Margin="0,0,0,6"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ACTION BAR -->
        <Border Grid.Row="4"
                Style="{StaticResource ClassicGroupBox}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="LICENSE ACTIONS"
                               Style="{StaticResource HeaderLabel}"
                               Margin="0,0,0,2"/>
                    <TextBlock Text="Import a signed .poslic store or terminal license. Import the store license first, then the matching terminal license."
                               Style="{StaticResource HelpText}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="REFRESH"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource ClassicBtn}"
                            Margin="0,0,8,0"/>
                    <Button Content="IMPORT LICENSE"
                            Command="{Binding ImportLicenseCommand}"
                            Style="{StaticResource ActionBtn}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
