<UserControl x:Class="POS.BackOffice.UI.Views.Pages.File.TerminalSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1250"
             Background="#EEF2F7"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <Style x:Key="PageTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PageSubTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="SectionTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F3D5E"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="FieldLabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="InputComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="InputCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0F766E"/>
            <Setter Property="MinWidth" Value="205"/>
        </Style>

        <Style x:Key="DiagnosticButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F3D5E"/>
            <Setter Property="BorderBrush" Value="#0F3D5E"/>
            <Setter Property="MinWidth" Value="130"/>
        </Style>

        <Style x:Key="TabStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#0F3D5E"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- PAGE HEADER -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="4"
                Padding="18"
                Margin="0,0,0,14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Terminal Settings"
                               Style="{StaticResource PageTitleText}"/>

                    <TextBlock Text="Local register setup for security, printer, cash drawer, scanner, scale, pole display, and EFTPOS."
                               Style="{StaticResource PageSubTitleText}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#F1F5F9"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,8"
                        VerticalAlignment="Center">

                    <StackPanel>
                        <TextBlock Text="Status"
                                   Foreground="#64748B"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{Binding StatusColor}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   MaxWidth="390"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- BODY -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="4">

            <TabControl BorderThickness="0"
                        Background="Transparent"
                        Padding="12"
                        ItemContainerStyle="{StaticResource TabStyle}">

                <!-- TAB 1 -->
                <TabItem Header="Terminal Identity">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6,14,6,6">

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Register Identity"
                                               Style="{StaticResource SectionTitleText}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Terminal No *"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding TerminalNo, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBox}"/>

                                            <TextBlock Text="Terminal Name *"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding TerminalName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBox}"/>

                                            <TextBlock Text="Location *"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <ComboBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding Locations}"
                                                      IsEditable="True"
                                                      Style="{StaticResource InputComboBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Machine Name *"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding MachineName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBox}"/>

                                            <CheckBox Content="Terminal Active"
                                                      IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource InputCheckBox}"
                                                      Margin="0,4,0,12"/>

                                            <Border Background="#F8FAFC"
                                                    BorderBrush="#CBD5E1"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="12">

                                                <StackPanel>
                                                    <TextBlock Text="Terminal settings are saved per register."
                                                               Foreground="#0F3D5E"
                                                               FontWeight="Bold"
                                                               FontSize="13"/>

                                                    <TextBlock Text="Do not share one terminal number between two cashier computers."
                                                               Style="{StaticResource HelpText}"
                                                               Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Cashier Screen Security"
                                               Style="{StaticResource SectionTitleText}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Auto-Lock Timeout (Minutes)"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding AutoLockTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBox}"
                                                     Width="120"
                                                     HorizontalAlignment="Left"/>

                                            <TextBlock Text="Allowed range: 0 to 120 minutes."
                                                       Style="{StaticResource HelpText}"/>
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="#F8FAFC"
                                                BorderBrush="#CBD5E1"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="0 disables automatic locking."
                                                           Foreground="#0F3D5E"
                                                           FontWeight="Bold"
                                                           FontSize="13"/>

                                                <TextBlock Text="The manual Lock Terminal button and F12 shortcut remain available even when automatic locking is disabled."
                                                           Style="{StaticResource HelpText}"
                                                           Margin="0,6,0,0"/>

                                                <TextBlock Text="Cashier must be restarted after changing this setting."
                                                           Foreground="#B45309"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2 -->
                <TabItem Header="Printer &amp; Drawer">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6,14,6,6">

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Receipt Printer"
                                               Style="{StaticResource SectionTitleText}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Printer Mode *"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <ComboBox Text="{Binding PrinterMode, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding PrinterModes}"
                                                      IsEditable="True"
                                                      Style="{StaticResource InputComboBox}"/>

                                            <TextBlock Text="Receipt Printer Name *"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <ComboBox Text="{Binding ReceiptPrinterName, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding AvailablePrinters}"
                                                      IsEditable="True"
                                                      Style="{StaticResource InputComboBox}"/>

                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,0,0,12">

                                                <Button Content="Refresh Printers"
                                                        Command="{Binding RefreshPrintersCommand}"
                                                        Style="{StaticResource DiagnosticButton}"
                                                        Margin="0,0,10,0"/>

                                                <Button Content="Test Print"
                                                        Command="{Binding TestPrintCommand}"
                                                        Style="{StaticResource DiagnosticButton}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Receipt Paper Width"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <ComboBox SelectedItem="{Binding ReceiptPaperWidth, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding ReceiptPaperWidths}"
                                                      Style="{StaticResource InputComboBox}"/>

                                            <TextBlock Text="Receipt Copies"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding ReceiptCopies, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBox}"
                                                     Width="120"
                                                     HorizontalAlignment="Left"/>

                                            <CheckBox Content="Auto print receipt after sale"
                                                      IsChecked="{Binding AutoPrintReceipt, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource InputCheckBox}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Cash Drawer"
                                               Style="{StaticResource SectionTitleText}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <CheckBox Content="Enable Cash Drawer"
                                                      IsChecked="{Binding EnableCashDrawer, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource InputCheckBox}"/>

                                            <CheckBox Content="Open drawer after cash sale"
                                                      IsChecked="{Binding OpenDrawerAfterCashSale, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource InputCheckBox}"/>

                                            <Button Content="Kick Drawer"
                                                    Command="{Binding KickDrawerCommand}"
                                                    Style="{StaticResource DiagnosticButton}"
                                                    Width="140"
                                                    HorizontalAlignment="Left"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Drawer Kick Code"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding DrawerKickCode, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputTextBox}"/>

                                            <TextBlock Text="Default ESC/POS drawer code: 27,112,0,25,250"
                                                       Style="{StaticResource HelpText}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 3 -->
                <TabItem Header="Scanner / Scale / Display">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6,14,6,6">

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Barcode Scanner"
                                               Style="{StaticResource SectionTitleText}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Scanner Suffix Action"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <ComboBox Text="{Binding ScannerSuffixAction, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding ScannerSuffixActions}"
                                                      IsEditable="True"
                                                      Style="{StaticResource InputComboBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Most USB barcode scanners work as keyboard input."
                                                       Foreground="#0F3D5E"
                                                       FontWeight="Bold"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="Use Enter suffix for fastest scan-and-add behavior."
                                                       Style="{StaticResource HelpText}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Weighing Scale"
                                               Style="{StaticResource SectionTitleText}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <CheckBox Content="Enable Weighing Scale"
                                                      IsChecked="{Binding EnableScale, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource InputCheckBox}"/>

                                            <TextBlock Text="Scale COM Port"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <ComboBox Text="{Binding ScaleComPort, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding ComPorts}"
                                                      IsEditable="True"
                                                      IsEnabled="{Binding EnableScale}"
                                                      Style="{StaticResource InputComboBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Scale Baud Rate"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <ComboBox SelectedItem="{Binding ScaleBaudRate, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding ScaleBaudRates}"
                                                      IsEnabled="{Binding EnableScale}"
                                                      Style="{StaticResource InputComboBox}"/>

                                            <TextBlock Text="Scale integration will be connected after normal item sale flow is stable."
                                                       Style="{StaticResource HelpText}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Customer Pole Display"
                                               Style="{StaticResource SectionTitleText}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <CheckBox Content="Enable Customer Pole Display"
                                                      IsChecked="{Binding EnablePoleDisplay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource InputCheckBox}"/>

                                            <TextBlock Text="Pole Display COM Port"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <ComboBox Text="{Binding PoleDisplayComPort, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding ComPorts}"
                                                      IsEditable="True"
                                                      IsEnabled="{Binding EnablePoleDisplay}"
                                                      Style="{StaticResource InputComboBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Idle Welcome Message"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding PoleWelcomeMessage, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding EnablePoleDisplay}"
                                                     MaxLength="40"
                                                     Style="{StaticResource InputTextBox}"/>

                                            <TextBlock Text="Keep message short for 2-line VFD displays."
                                                       Style="{StaticResource HelpText}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="EFTPOS / Card Terminal"
                                               Style="{StaticResource SectionTitleText}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <CheckBox Content="Enable Integrated EFTPOS"
                                                      IsChecked="{Binding EnableEftpos, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource InputCheckBox}"/>

                                            <TextBlock Text="EFTPOS Provider"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding EftposProvider, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding EnableEftpos}"
                                                     Style="{StaticResource InputTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="EFTPOS Port / IP"
                                                       Style="{StaticResource FieldLabelText}"/>

                                            <TextBox Text="{Binding EftposPortOrIp, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding EnableEftpos}"
                                                     Style="{StaticResource InputTextBox}"/>

                                            <TextBlock Text="Keep disabled until a real payment terminal integration is selected."
                                                       Style="{StaticResource HelpText}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14"
                Margin="0,14,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="{Binding StatusColor}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Discard Changes"
                            Command="{Binding DiscardChangesCommand}"
                            Style="{StaticResource ActionButton}"
                            Margin="0,0,10,0"/>

                    <Button Content="Save Terminal Settings"
                            Command="{Binding SaveSettingsCommand}"
                            Style="{StaticResource SaveButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>