<UserControl x:Class="POS.BackOffice.UI.Views.Pages.File.TerminalSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1280"
             Background="{DynamicResource WindowBackgroundBrush}"
             FontFamily="Segoe UI"
             FontSize="12">

    <UserControl.Resources>

        <Style x:Key="SectionBorder"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="10"/>
        </Style>

        <Style x:Key="SectionHeading"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource HeaderTextBrush}"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Margin"
                    Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FieldLabel"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="Margin"
                    Value="0,0,8,0"/>
        </Style>

        <Style x:Key="HelpText"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize"
                    Value="11"/>
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
        </Style>

        <Style x:Key="ClassicTextBox"
               TargetType="TextBox">
            <Setter Property="Height"
                    Value="27"/>
            <Setter Property="Padding"
                    Value="6,0"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Background"
                    Value="{DynamicResource WhiteBackgroundBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

        <Style x:Key="ReadOnlyTextBox"
               TargetType="TextBox"
               BasedOn="{StaticResource ClassicTextBox}">
            <Setter Property="IsReadOnly"
                    Value="True"/>
            <Setter Property="Background"
                    Value="{DynamicResource ButtonDefaultBrush}"/>
        </Style>

        <Style x:Key="ClassicComboBox"
               TargetType="ComboBox">
            <Setter Property="Height"
                    Value="27"/>
            <Setter Property="Padding"
                    Value="5,0"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Background"
                    Value="{DynamicResource WhiteBackgroundBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

        <Style x:Key="ClassicCheckBox"
               TargetType="CheckBox">
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="ClassicButton"
               TargetType="Button">
            <Setter Property="Height"
                    Value="29"/>
            <Setter Property="MinWidth"
                    Value="105"/>
            <Setter Property="Padding"
                    Value="12,0"/>
            <Setter Property="Background"
                    Value="{DynamicResource ButtonDefaultBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource ButtonHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource ClassicButton}">
            <Setter Property="Background"
                    Value="{DynamicResource ActionBackgroundBrush}"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ActionBackgroundBrush}"/>
            <Setter Property="MinWidth"
                    Value="145"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource ActionHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. CURRENT TERMINAL -->
        <Border Grid.Row="0"
                Style="{StaticResource SectionBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="29"/>
                    <RowDefinition Height="29"/>
                    <RowDefinition Height="29"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="210"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.ColumnSpan="8"
                           Text="1. CURRENT TERMINAL"
                           Style="{StaticResource SectionHeading}"/>

                <TextBlock Grid.Row="1"
                           Text="Terminal No"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Text="{Binding TerminalNo}"
                         Style="{StaticResource ReadOnlyTextBox}"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="3"
                           Text="Terminal Name"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="1"
                         Grid.Column="4"
                         Text="{Binding TerminalName, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="80"
                         Style="{StaticResource ClassicTextBox}"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="6"
                           Text="Status"
                           Style="{StaticResource FieldLabel}"/>
                <Border Grid.Row="1"
                        Grid.Column="7"
                        Background="{DynamicResource WhiteBackgroundBrush}"
                        BorderBrush="{DynamicResource InputBoxBorderBrush}"
                        BorderThickness="1"
                        Padding="6,4">
                    <TextBlock Text="{Binding TerminalStatusText}"
                               Foreground="{Binding TerminalStatusColor}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Row="2"
                           Text="Machine Name"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Grid.ColumnSpan="4"
                         Text="{Binding MachineName}"
                         Style="{StaticResource ReadOnlyTextBox}"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="6"
                           Text="License Status"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="2"
                         Grid.Column="7"
                         Text="{Binding TerminalLicenseStatusText}"
                         Style="{StaticResource ReadOnlyTextBox}"/>

                <TextBlock Grid.Row="3"
                           Text="Machine Code"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="3"
                         Grid.Column="1"
                         Grid.ColumnSpan="4"
                         Text="{Binding MachineCode}"
                         Style="{StaticResource ReadOnlyTextBox}"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="6"
                           Text="License Expiry"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="3"
                         Grid.Column="7"
                         Text="{Binding TerminalLicenseExpiryText}"
                         ToolTip="{Binding TerminalLicenseExpiryText}"
                         Style="{StaticResource ReadOnlyTextBox}"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 2. RECEIPT PRINTER -->
                <Border Grid.Row="0"
                        Style="{StaticResource SectionBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="31"/>
                            <RowDefinition Height="31"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="145"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.ColumnSpan="10"
                                   Text="2. RECEIPT PRINTER"
                                   Style="{StaticResource SectionHeading}"/>

                        <TextBlock Grid.Row="1"
                                   Text="Windows Printer"
                                   Style="{StaticResource FieldLabel}"/>

                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  ItemsSource="{Binding AvailablePrinters}"
                                  Text="{Binding ReceiptPrinterName, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  Style="{StaticResource ClassicComboBox}"/>

                        <Button Grid.Row="1"
                                Grid.Column="3"
                                Content="REFRESH PRINTERS"
                                Command="{Binding RefreshPrintersCommand}"
                                Style="{StaticResource ClassicButton}"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="5"
                                   Text="Paper Width"
                                   Style="{StaticResource FieldLabel}"/>

                        <ComboBox Grid.Row="1"
                                  Grid.Column="6"
                                  ItemsSource="{Binding ReceiptPaperWidths}"
                                  SelectedItem="{Binding ReceiptPaperWidth}"
                                  Style="{StaticResource ClassicComboBox}"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="8"
                                   Text="Copies"
                                   Style="{StaticResource FieldLabel}"/>

                        <ComboBox Grid.Row="1"
                                  Grid.Column="9"
                                  ItemsSource="{Binding ReceiptCopyOptions}"
                                  SelectedItem="{Binding ReceiptCopies}"
                                  Style="{StaticResource ClassicComboBox}"/>

                        <CheckBox Grid.Row="2"
                                  Grid.Column="1"
                                  Grid.ColumnSpan="3"
                                  Content="Automatically print receipt after a completed sale"
                                  IsChecked="{Binding AutoPrintReceipt}"
                                  Style="{StaticResource ClassicCheckBox}"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="5"
                                   Grid.ColumnSpan="5"
                                   Text="{Binding PrinterListStatus}"
                                   Style="{StaticResource HelpText}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="3"
                                   Grid.ColumnSpan="10"
                                   Text="Select the exact Windows printer installed on this computer. Receipt copies are limited to 1–3."
                                   Style="{StaticResource HelpText}"
                                   Margin="0,5,0,0"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 3. CASH DRAWER -->
                    <Border Grid.Column="0"
                            Style="{StaticResource SectionBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="3. CASH DRAWER"
                                       Style="{StaticResource SectionHeading}"/>

                            <CheckBox Grid.Row="1"
                                      Content="Enable cash drawer through the receipt printer"
                                      IsChecked="{Binding EnableCashDrawer}"
                                      Style="{StaticResource ClassicCheckBox}"/>

                            <CheckBox Grid.Row="2"
                                      Content="Open drawer automatically after a cash sale"
                                      IsChecked="{Binding OpenDrawerAfterCashSale}"
                                      IsEnabled="{Binding EnableCashDrawer}"
                                      Style="{StaticResource ClassicCheckBox}"/>

                            <TextBlock Grid.Row="3"
                                       Text="The drawer uses the standard ESC/POS printer kick command. No technical command field is required."
                                       Style="{StaticResource HelpText}"
                                       Margin="0,5,0,0"/>
                        </Grid>
                    </Border>

                    <!-- 4. CASHIER SECURITY -->
                    <Border Grid.Column="2"
                            Style="{StaticResource SectionBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="31"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="215"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.ColumnSpan="3"
                                       Text="4. CASHIER SECURITY"
                                       Style="{StaticResource SectionHeading}"/>

                            <TextBlock Grid.Row="1"
                                       Text="Auto-Lock Timeout (Minutes)"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding AutoLockTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="3"
                                     Style="{StaticResource ClassicTextBox}"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Text="Allowed: 0–120"
                                       Style="{StaticResource HelpText}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>

                            <TextBlock Grid.Row="2"
                                       Grid.ColumnSpan="3"
                                       Text="0 disables automatic locking. Manual Lock Terminal and F12 remain available."
                                       Style="{StaticResource HelpText}"
                                       Margin="0,5,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- 5. TEST & SAVE -->
        <Border Grid.Row="4"
                Style="{StaticResource SectionBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal">
                    <Button Content="TEST PRINT"
                            Command="{Binding TestPrintCommand}"
                            Style="{StaticResource ClassicButton}"
                            Margin="0,0,8,0"/>

                    <Button Content="TEST DRAWER"
                            Command="{Binding TestDrawerCommand}"
                            Style="{StaticResource ClassicButton}"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="5. TEST &amp; SAVE"
                               Style="{StaticResource SectionHeading}"
                               Margin="0,0,0,3"/>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{Binding StatusColor}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="6"
                        Content="RELOAD"
                        Command="{Binding DiscardChangesCommand}"
                        Style="{StaticResource ClassicButton}"/>

                <Button Grid.Column="8"
                        Content="SAVE SETTINGS"
                        Command="{Binding SaveSettingsCommand}"
                        Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
