<UserControl x:Class="POS.BackOffice.UI.Views.Pages.Crm.FreeIssueRuleSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             FontFamily="Segoe UI"
             FontSize="12">

    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460" MinWidth="360" MaxWidth="560"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="520"/>
        </Grid.ColumnDefinitions>

        <!-- RULE EDITOR -->
        <Border Grid.Column="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource DataGridHeaderBackground}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="9,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="FREE ISSUE RULE SETUP" Style="{DynamicResource BoSectionHeader}" Margin="0"/>
                        <CheckBox Grid.Column="1" Content="Active" IsChecked="{Binding IsActive}"
                                  FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="9,8,5,8">
                    <StackPanel>
                        <Border Style="{DynamicResource BoPanel}">
                            <StackPanel>
                                <TextBlock Text="1. IDENTITY &amp; FUNDING" Style="{DynamicResource BoSectionHeader}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Rule Name *" Style="{DynamicResource BoInlineLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding RuleName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource BoInputTextBox}" MaxLength="150" Margin="0,0,0,7"/>

                                    <TextBlock Grid.Row="1" Text="Funding" Style="{DynamicResource BoInlineLabel}"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding FreeIssueTypes}"
                                              SelectedItem="{Binding FreeIssueType}"
                                              Style="{DynamicResource BoInputComboBox}" Margin="0,0,0,7"/>

                                    <TextBlock Grid.Row="2" Text="Reason *" Style="{DynamicResource BoInlineLabel}"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Reasons}"
                                              SelectedItem="{Binding SelectedReason}" DisplayMemberPath="ReasonName"
                                              Style="{DynamicResource BoInputComboBox}" Margin="0,0,0,7"/>

                                    <TextBlock Grid.Row="3" Text="Funding Supplier" Style="{DynamicResource BoInlineLabel}"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Suppliers}"
                                              SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="DisplayText"
                                              IsEnabled="{Binding IsSupplierFunded}"
                                              Style="{DynamicResource BoInputComboBox}" Margin="0,0,0,7"/>

                                    <TextBlock Grid.Row="4" Text="Promotion Ref." Style="{DynamicResource BoInlineLabel}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SupplierPromotionReference}"
                                             IsEnabled="{Binding IsSupplierFunded}"
                                             Style="{DynamicResource BoInputTextBox}" MaxLength="100"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource BoPanel}">
                            <StackPanel>
                                <TextBlock Text="2. ELIGIBILITY &amp; VALIDITY" Style="{DynamicResource BoSectionHeader}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Target Type" Style="{DynamicResource BoInlineLabel}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AppliesToTypes}"
                                              SelectedItem="{Binding AppliesToType}"
                                              Style="{DynamicResource BoInputComboBox}" Margin="0,0,0,7"/>

                                    <TextBlock Grid.Row="1" Text="{Binding TargetLabel}" Style="{DynamicResource BoInlineLabel}"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding TargetOptions}"
                                              SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="DisplayText"
                                              IsEnabled="{Binding HasTargetSelector}"
                                              Style="{DynamicResource BoInputComboBox}" Margin="0,0,0,7"/>

                                    <TextBlock Grid.Row="2" Text="Valid From" Style="{DynamicResource BoInlineLabel}"/>
                                    <DatePicker Grid.Row="2" Grid.Column="1" SelectedDate="{Binding ValidFrom}"
                                                Style="{DynamicResource BoInputDatePicker}" Margin="0,0,0,7"/>

                                    <TextBlock Grid.Row="3" Text="Valid To" Style="{DynamicResource BoInlineLabel}"/>
                                    <DatePicker Grid.Row="3" Grid.Column="1" SelectedDate="{Binding ValidTo}"
                                                Style="{DynamicResource BoInputDatePicker}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Expander Header="3. ADVANCED CONTROLS" IsExpanded="False" Margin="0,0,0,8">
                            <Border Style="{DynamicResource BoPanel}" Margin="0,5,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="155"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Claim Value Mode" Style="{DynamicResource BoInlineLabel}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ClaimValueModes}"
                                              SelectedItem="{Binding ClaimValueMode}" IsEnabled="{Binding IsSupplierFunded}"
                                              Style="{DynamicResource BoInputComboBox}" Margin="0,0,0,7"/>

                                    <TextBlock Grid.Row="1" Text="Fixed Claim / Unit" Style="{DynamicResource BoInlineLabel}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FixedClaimValue, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsSupplierFunded}" Style="{DynamicResource BoInputTextBox}" Margin="0,0,0,7"/>

                                    <TextBlock Grid.Row="2" Text="Max Qty / Invoice" Style="{DynamicResource BoInlineLabel}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaxQtyPerInvoice}"
                                             Style="{DynamicResource BoInputTextBox}" Margin="0,0,0,7"/>

                                    <TextBlock Grid.Row="3" Text="Max Qty / Day" Style="{DynamicResource BoInlineLabel}"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaxQtyPerDay}"
                                             Style="{DynamicResource BoInputTextBox}" Margin="0,0,0,7"/>

                                    <TextBlock Grid.Row="4" Text="Max Value / Invoice" Style="{DynamicResource BoInlineLabel}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MaxValuePerInvoice}"
                                             Style="{DynamicResource BoInputTextBox}" Margin="0,0,0,7"/>

                                    <TextBlock Grid.Row="5" Text="Max Value / Day" Style="{DynamicResource BoInlineLabel}"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MaxValuePerDay}"
                                             Style="{DynamicResource BoInputTextBox}" Margin="0,0,0,7"/>

                                    <CheckBox Grid.Row="6" Grid.ColumnSpan="2" Content="Manager approval required"
                                              IsChecked="{Binding RequiresManagerApproval}" Margin="0,3"/>
                                    <CheckBox Grid.Row="7" Grid.ColumnSpan="2" Content="Administrator approval required"
                                              IsChecked="{Binding RequiresAdminApproval}" Margin="0,3"/>
                                    <CheckBox Grid.Row="8" Grid.ColumnSpan="2" Content="Allow cashier without approval"
                                              IsChecked="{Binding AllowCashierWithoutApproval}" Margin="0,3"/>

                                    <TextBlock Grid.Row="9" Text="Approval Threshold" Style="{DynamicResource BoInlineLabel}"/>
                                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding ManagerApprovalThreshold}"
                                             Style="{DynamicResource BoInputTextBox}" Margin="0,0,0,7"/>

                                    <TextBlock Grid.Row="10" Text="Remarks" Style="{DynamicResource BoInlineLabel}" VerticalAlignment="Top" Margin="0,5,6,0"/>
                                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Remarks}"
                                             Style="{DynamicResource BoInputTextBox}" Height="55"
                                             AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500"/>
                                </Grid>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Style="{DynamicResource BoActionFooter}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColorHex}"
                                   TextWrapping="Wrap" Margin="0,0,0,7"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="ACTIVATE / DEACTIVATE" Command="{Binding ToggleActiveCommand}"
                                    Style="{DynamicResource BoButton}" Margin="0,0,6,0"/>
                            <Button Grid.Column="2" Content="NEW RULE" Command="{Binding NewRuleCommand}"
                                    Style="{DynamicResource BoButton}" Margin="0,0,6,0"/>
                            <Button Grid.Column="3" Content="SAVE RULE" Command="{Binding SaveCommand}"
                                    Style="{DynamicResource BoPrimaryButton}" Width="112"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}" ShowsPreview="True"/>

        <!-- RULE DATABASE -->
        <Border Grid.Column="2"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource HeaderTextBrush}" Padding="7" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="82"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="FREE ISSUE RULE DATABASE" Foreground="White" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}"
                                  Style="{DynamicResource BoInputComboBox}" Height="25" Margin="0,0,5,0"/>
                        <TextBox Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource BoInputTextBox}" Height="25" Margin="0,0,5,0"/>
                        <Button Grid.Column="3" Content="SEARCH" Command="{Binding SearchCommand}"
                                Style="{DynamicResource BoButton}" Height="25" Margin="0,0,5,0"/>
                        <Button Grid.Column="4" Content="REFRESH" Command="{Binding RefreshCommand}"
                                Style="{DynamicResource BoButton}" Height="25"/>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                          Style="{DynamicResource BoDataGrid}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rule" Binding="{Binding RuleName}" Width="1.6*" MinWidth="160"/>
                        <DataGridTextColumn Header="Funding" Binding="{Binding DisplayFreeIssueType}" Width="115"/>
                        <DataGridTextColumn Header="Target" Binding="{Binding DisplayAppliesTo}" Width="1.3*" MinWidth="145"/>
                        <DataGridTextColumn Header="From" Binding="{Binding ValidFrom, StringFormat=yyyy-MM-dd}" Width="88"/>
                        <DataGridTextColumn Header="To" Binding="{Binding ValidTo, StringFormat=yyyy-MM-dd}" Width="88"/>
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55"/>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="130"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding ReasonName}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
