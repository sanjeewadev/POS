<UserControl x:Class="POS.BackOffice.UI.Views.Pages.Crm.FreeIssueRuleSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             FontFamily="Segoe UI"
             FontSize="12">
    <UserControl.Resources>
        <Style x:Key="Input" TargetType="Control">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="0,2,0,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,3,8,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ClassicButton" TargetType="Button">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource ButtonDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBoxBorderBrush}"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource LightSelectionBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="410"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="FREE ISSUE RULE" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource HeaderTextBrush}" Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Rule name *" Style="{StaticResource Label}"/>
                        <TextBox Grid.Column="1" Text="{Binding RuleName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" MaxLength="150"/>
                        <TextBlock Grid.Row="1" Text="Funding" Style="{StaticResource Label}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding FreeIssueTypes}" SelectedItem="{Binding FreeIssueType}" Style="{StaticResource Input}"/>
                        <TextBlock Grid.Row="2" Text="Reason *" Style="{StaticResource Label}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Reasons}" SelectedItem="{Binding SelectedReason}" DisplayMemberPath="ReasonName" Style="{StaticResource Input}"/>
                        <TextBlock Grid.Row="3" Text="Target type" Style="{StaticResource Label}"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AppliesToTypes}" SelectedItem="{Binding AppliesToType}" Style="{StaticResource Input}"/>
                        <TextBlock Grid.Row="4" Text="{Binding TargetLabel}" Style="{StaticResource Label}"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding TargetOptions}" SelectedItem="{Binding SelectedTarget}"
                                  DisplayMemberPath="DisplayText" IsEnabled="{Binding HasTargetSelector}" Style="{StaticResource Input}"/>
                        <TextBlock Grid.Row="5" Text="Valid from" Style="{StaticResource Label}"/>
                        <DatePicker Grid.Row="5" Grid.Column="1" SelectedDate="{Binding ValidFrom}" Height="25" Margin="0,2,0,5"/>
                        <TextBlock Grid.Row="6" Text="Valid to" Style="{StaticResource Label}"/>
                        <DatePicker Grid.Row="6" Grid.Column="1" SelectedDate="{Binding ValidTo}" Height="25" Margin="0,2,0,5"/>
                        <TextBlock Grid.Row="7" Text="Funding supplier" Style="{StaticResource Label}"/>
                        <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                                  DisplayMemberPath="DisplayText" IsEnabled="{Binding IsSupplierFunded}" Style="{StaticResource Input}"/>
                        <TextBlock Grid.Row="8" Text="Promotion ref." Style="{StaticResource Label}"/>
                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding SupplierPromotionReference}" IsEnabled="{Binding IsSupplierFunded}" Style="{StaticResource Input}" MaxLength="100"/>
                    </Grid>

                    <Expander Header="Advanced controls" IsExpanded="False" Margin="0,5,0,5">
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Claim value mode" Style="{StaticResource Label}"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ClaimValueModes}" SelectedItem="{Binding ClaimValueMode}" IsEnabled="{Binding IsSupplierFunded}" Style="{StaticResource Input}"/>
                                <TextBlock Grid.Row="1" Text="Fixed claim / unit" Style="{StaticResource Label}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FixedClaimValue, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSupplierFunded}" Style="{StaticResource Input}"/>
                                <TextBlock Grid.Row="2" Text="Max qty / invoice" Style="{StaticResource Label}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaxQtyPerInvoice}" Style="{StaticResource Input}"/>
                                <TextBlock Grid.Row="3" Text="Max qty / day" Style="{StaticResource Label}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaxQtyPerDay}" Style="{StaticResource Input}"/>
                                <TextBlock Grid.Row="4" Text="Max value / invoice" Style="{StaticResource Label}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MaxValuePerInvoice}" Style="{StaticResource Input}"/>
                                <TextBlock Grid.Row="5" Text="Max value / day" Style="{StaticResource Label}"/>
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MaxValuePerDay}" Style="{StaticResource Input}"/>
                                <CheckBox Grid.Row="6" Grid.ColumnSpan="2" Content="Manager approval required" IsChecked="{Binding RequiresManagerApproval}" Margin="0,4"/>
                                <CheckBox Grid.Row="7" Grid.ColumnSpan="2" Content="Administrator approval required" IsChecked="{Binding RequiresAdminApproval}" Margin="0,4"/>
                                <CheckBox Grid.Row="8" Grid.ColumnSpan="2" Content="Allow cashier without approval" IsChecked="{Binding AllowCashierWithoutApproval}" Margin="0,4"/>
                                <TextBlock Grid.Row="9" Text="Approval threshold" Style="{StaticResource Label}"/>
                                <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding ManagerApprovalThreshold}" Style="{StaticResource Input}"/>
                                <TextBlock Grid.Row="10" Text="Remarks" Style="{StaticResource Label}" VerticalAlignment="Top"/>
                                <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Remarks}" Height="52" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500"/>
                            </Grid>
                        </Border>
                    </Expander>

                    <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,5"/>
                    <WrapPanel Margin="0,7,0,0">
                        <Button Content="New" Command="{Binding NewRuleCommand}" Style="{StaticResource ClassicButton}"/>
                        <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource ClassicButton}"/>
                        <Button Content="Activate / Deactivate" Command="{Binding ToggleActiveCommand}" Style="{StaticResource ClassicButton}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColorHex}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}" Height="26" Margin="0,0,5,6"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,0,5,6" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource ClassicButton}" Margin="0,0,5,6"/>
                    <Button Grid.Column="3" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource ClassicButton}" Margin="0,0,0,6"/>
                </Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                          RowHeight="26" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="{DynamicResource WhiteBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rule" Binding="{Binding RuleName}" Width="180"/>
                        <DataGridTextColumn Header="Funding" Binding="{Binding DisplayFreeIssueType}" Width="125"/>
                        <DataGridTextColumn Header="Target" Binding="{Binding DisplayAppliesTo}" Width="170"/>
                        <DataGridTextColumn Header="From" Binding="{Binding ValidFrom, StringFormat=yyyy-MM-dd}" Width="90"/>
                        <DataGridTextColumn Header="To" Binding="{Binding ValidTo, StringFormat=yyyy-MM-dd}" Width="90"/>
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55"/>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="150"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding ReasonName}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
