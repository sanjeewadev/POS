<UserControl x:Class="POS.BackOffice.UI.Views.Pages.Crm.GiftVoucherAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:POS.BackOffice.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="1250"
             Background="{DynamicResource WindowBackgroundBrush}"
             FontFamily="Segoe UI"
             FontSize="12">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <Style x:Key="VoucherActionButton"
               TargetType="Button"
               BasedOn="{StaticResource BoButton}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="54"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="VoucherBlockButton"
               TargetType="Button"
               BasedOn="{StaticResource VoucherActionButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Foreground" Value="#8A5300"/>
            <Setter Property="BorderBrush" Value="#B7791F"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Active">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VoucherUnblockButton"
               TargetType="Button"
               BasedOn="{StaticResource VoucherActionButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Foreground" Value="#005500"/>
            <Setter Property="BorderBrush" Value="#3D8B40"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Blocked">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VoucherVoidButton"
               TargetType="Button"
               BasedOn="{StaticResource VoucherActionButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Foreground" Value="#8B0000"/>
            <Setter Property="BorderBrush" Value="#8B0000"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Created">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VoucherStatusBadge" TargetType="Border">
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Created">
                    <Setter Property="Background" Value="#FFF8D8"/>
                    <Setter Property="BorderBrush" Value="#C89B24"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Active">
                    <Setter Property="Background" Value="#EDF8EF"/>
                    <Setter Property="BorderBrush" Value="#3D8B40"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Redeemed">
                    <Setter Property="Background" Value="#E8F1FA"/>
                    <Setter Property="BorderBrush" Value="#4A78A8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Expired">
                    <Setter Property="Background" Value="#FFF0DD"/>
                    <Setter Property="BorderBrush" Value="#C36B22"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Blocked">
                    <Setter Property="Background" Value="#FCE9E9"/>
                    <Setter Property="BorderBrush" Value="#A94044"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Voided">
                    <Setter Property="Background" Value="#ECECEC"/>
                    <Setter Property="BorderBrush" Value="#777777"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VoucherSummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="VoucherSummaryValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page title -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Gift Voucher Management"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource HeaderTextBrush}"/>
                <TextBlock Text="Create, print and control one-time paper vouchers"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
            <Border DockPanel.Dock="Right"
                    Background="{DynamicResource HighlightBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Padding="9,5"
                    VerticalAlignment="Center">
                <TextBlock Text="One-time redemption model"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource HeaderTextBrush}"/>
            </Border>
        </DockPanel>

        <!-- Create voucher batch -->
        <Border Grid.Row="1" Style="{StaticResource BoPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="New Voucher Batch"
                           Style="{StaticResource BoSectionHeader}"/>

                <Grid Grid.Row="1" Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Quantity" Style="{StaticResource BoInlineLabel}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding GenerateCount, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource BoInputTextBox}"
                             HorizontalContentAlignment="Center"/>

                    <TextBlock Grid.Column="3" Text="Value" Style="{StaticResource BoInlineLabel}"/>
                    <TextBox Grid.Column="4"
                             Text="{Binding GenerateAmount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                             Style="{StaticResource BoInputTextBox}"
                             HorizontalContentAlignment="Right"
                             FontWeight="SemiBold"/>

                    <TextBlock Grid.Column="6" Text="Expiry" Style="{StaticResource BoInlineLabel}"/>
                    <DatePicker Grid.Column="7"
                                SelectedDate="{Binding GenerateExpiryDate, Mode=TwoWay}"
                                Style="{StaticResource BoInputDatePicker}"/>

                    <TextBlock Grid.Column="9" Text="Batch No." Style="{StaticResource BoInlineLabel}"/>
                    <TextBox Grid.Column="10"
                             Text="{Binding GenerateBatchNo, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource BoInputTextBox}"
                             ToolTip="Optional. Leave empty to auto-generate."/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Description" Style="{StaticResource BoInlineLabel}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding GenerateDescription, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource BoInputTextBox}"
                             ToolTip="Optional. Example: Gift Voucher Rs. 5,000"/>

                    <Button Grid.Column="3"
                            Content="Clear"
                            Command="{Binding ClearGenerateFormCommand}"
                            Style="{StaticResource BoButton}"
                            Margin="0,0,7,0"/>
                    <Button Grid.Column="4"
                            Content="Generate Batch"
                            Command="{Binding GenerateBatchCommand}"
                            Style="{StaticResource BoPrimaryButton}"
                            MinWidth="125"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Filter bar -->
        <Border Grid.Row="2" Style="{StaticResource BoFilterBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Status" Style="{StaticResource BoInlineLabel}"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                          Style="{StaticResource BoInputComboBox}"/>

                <TextBlock Grid.Column="3" Text="Search" Style="{StaticResource BoInlineLabel}"/>
                <TextBox Grid.Column="4"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource BoInputTextBox}"
                         ToolTip="Search voucher number, barcode, batch or invoice">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="6"
                        Content="Search"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource BoPrimaryButton}"
                        Margin="0,0,6,0"/>
                <Button Grid.Column="7"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource BoButton}"
                        Margin="0,0,6,0"/>
                <Button Grid.Column="8"
                        Content="Export CSV"
                        Command="{Binding ExportCsvCommand}"
                        Style="{StaticResource BoButton}"
                        MinWidth="96"/>
            </Grid>
        </Border>

        <!-- Voucher register and selected history -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.65*" MinHeight="220"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*" MinHeight="180"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource WhiteBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,6">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Voucher Register"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource HeaderTextBrush}"/>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Vouchers.Count, StringFormat={}{0} record(s)}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </DockPanel>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Vouchers}"
                              SelectedItem="{Binding SelectedVoucher, Mode=TwoWay}"
                              Style="{StaticResource BoDataGrid}"
                              BorderThickness="0"
                              RowHeight="31"
                              FrozenColumnCount="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Voucher No." Binding="{Binding VoucherNo}" Width="130" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding VoucherAmount, StringFormat=Rs. {0:N2}}" Width="105" FontWeight="SemiBold"/>
                            <DataGridTemplateColumn Header="Status" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource VoucherStatusBadge}">
                                            <TextBlock Text="{Binding DisplayStatus}" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="120"/>
                            <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}" Width="95"/>
                            <DataGridTextColumn Header="Sold Invoice" Binding="{Binding SoldInvoiceNo}" Width="125"/>
                            <DataGridTextColumn Header="Redeemed Invoice" Binding="{Binding RedeemedInvoiceNo}" Width="135"/>
                            <DataGridTextColumn Header="Prints" Binding="{Binding PrintCount}" Width="55"/>
                            <DataGridTemplateColumn Header="Actions" Width="175">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Print"
                                                    Command="{Binding DataContext.PrintVoucherCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding Id}"
                                                    Style="{StaticResource VoucherActionButton}"/>
                                            <Button Content="Block"
                                                    Command="{Binding DataContext.BlockVoucherCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding Id}"
                                                    Style="{StaticResource VoucherBlockButton}"/>
                                            <Button Content="Unblock"
                                                    Command="{Binding DataContext.UnblockVoucherCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding Id}"
                                                    Style="{StaticResource VoucherUnblockButton}"/>
                                            <Button Content="Void"
                                                    Command="{Binding DataContext.VoidVoucherCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding Id}"
                                                    Style="{StaticResource VoucherVoidButton}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="1"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Background="{DynamicResource BorderBrush}"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Row="2"
                    Background="{DynamicResource WhiteBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Margin="0,5,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,6">
                        <TextBlock Text="Selected Voucher"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource HeaderTextBrush}"/>
                    </Border>

                    <Grid Grid.Row="1"
                          Margin="8"
                          Visibility="{Binding SelectedVoucher, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.15*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Voucher / Barcode" Style="{StaticResource VoucherSummaryLabel}"/>
                            <TextBlock Text="{Binding SelectedVoucher.VoucherNo}" Style="{StaticResource VoucherSummaryValue}"/>
                            <TextBlock Text="{Binding SelectedVoucher.Barcode}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Value" Style="{StaticResource VoucherSummaryLabel}"/>
                            <TextBlock Text="{Binding SelectedVoucher.VoucherAmount, StringFormat=Rs. {0:N2}}" Style="{StaticResource VoucherSummaryValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="Redeemed" Style="{StaticResource VoucherSummaryLabel}"/>
                            <TextBlock Text="{Binding SelectedVoucher.RedeemedAmount, StringFormat=Rs. {0:N2}}" Style="{StaticResource VoucherSummaryValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,12,0">
                            <TextBlock Text="Forfeited" Style="{StaticResource VoucherSummaryLabel}"/>
                            <TextBlock Text="{Binding SelectedVoucher.ForfeitedAmount, StringFormat=Rs. {0:N2}}" Style="{StaticResource VoucherSummaryValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="0,0,12,0">
                            <TextBlock Text="Batch / Expiry" Style="{StaticResource VoucherSummaryLabel}"/>
                            <TextBlock Text="{Binding SelectedVoucher.BatchNo}" Style="{StaticResource VoucherSummaryValue}"/>
                            <TextBlock Text="{Binding SelectedVoucher.ExpiryDate, StringFormat=yyyy-MM-dd}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="5">
                            <TextBlock Text="Status" Style="{StaticResource VoucherSummaryLabel}"/>
                            <Border Style="{StaticResource VoucherStatusBadge}" DataContext="{Binding SelectedVoucher}">
                                <TextBlock Text="{Binding DisplayStatus}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="Select a voucher to view its financial summary and immutable movement history."
                               Style="{StaticResource BoEmptyStateText}"
                               Visibility="{Binding SelectedVoucher, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding VoucherHistory}"
                              Style="{StaticResource BoDataGrid}"
                              BorderThickness="0,1,0,0"
                              RowHeight="27">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding TransactionDate, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="145"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TransactionType}" Width="105" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Applied" Binding="{Binding AppliedAmount, StringFormat=Rs. {0:N2}}" Width="95"/>
                            <DataGridTextColumn Header="Forfeited" Binding="{Binding ForfeitedAmount, StringFormat=Rs. {0:N2}}" Width="95"/>
                            <DataGridTextColumn Header="Status After" Binding="{Binding StatusAfter}" Width="100"/>
                            <DataGridTextColumn Header="Invoice" Binding="{Binding ReferenceInvoiceNo}" Width="115"/>
                            <DataGridTextColumn Header="Return" Binding="{Binding ReferenceReturnNo}" Width="115"/>
                            <DataGridTextColumn Header="Created By" Binding="{Binding CreatedBy}" Width="95"/>
                            <DataGridTextColumn Header="Authorized By" Binding="{Binding AuthorizedBy}" Width="105"/>
                            <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*" MinWidth="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Compact status footer -->
        <Border Grid.Row="4" Style="{StaticResource BoActionFooter}" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0"
                             Height="3"
                             IsIndeterminate="True"
                             Margin="0,0,0,6"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <DockPanel Grid.Row="1" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Border Width="8" Height="8" Background="{Binding StatusColorHex}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding Vouchers.Count, StringFormat=Records: {0}}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
