<UserControl x:Class="POS.BackOffice.UI.Views.Pages.Crm.CustomerMasterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             FontFamily="Segoe UI"
             FontSize="12">

    <UserControl.Resources>
        <Style x:Key="CenterCheckBox" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="RightGridText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,5,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*" MinHeight="220"/>
            <RowDefinition Height="2.3*" MinHeight="260"/>
        </Grid.RowDefinitions>

        <!-- SEARCH AND PAGE ACTIONS -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderTextBrush}"
                BorderBrush="#002244"
                BorderThickness="1"
                Padding="8"
                Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="CUSTOMER MASTER (CRM)"
                           Foreground="White" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,18,0"/>

                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Filter" Foreground="#C8D9E8" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox ItemsSource="{Binding TypeFilters}"
                              SelectedItem="{Binding SelectedTypeFilter}"
                              Style="{DynamicResource BoInputComboBox}"
                              Width="135" Margin="0,0,12,0"/>
                    <TextBlock Text="Search" Foreground="#C8D9E8" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource BoInputTextBox}"
                             Width="225" Margin="0,0,7,0"/>
                    <Button Content="REFRESH" Command="{Binding RefreshDataCommand}"
                            Style="{DynamicResource BoButton}" Height="25"/>
                </WrapPanel>

                <Button Grid.Column="2" Content="CLEAR FORM" Command="{Binding ClearFormCommand}"
                        Style="{DynamicResource BoButton}" Margin="8,0,6,0"/>
                <Button Grid.Column="3" Content="NEW CUSTOMER" Command="{Binding AddNewCustomerCommand}"
                        Style="{DynamicResource BoPrimaryButton}"/>
            </Grid>
        </Border>

        <!-- COMPACT CUSTOMER DATABASE -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding CustomersList}"
                  SelectedItem="{Binding SelectedCustomer}"
                  Style="{DynamicResource BoDataGrid}"
                  Margin="0,0,0,6">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding CustomerCode}" Width="95" FontWeight="Bold"/>
                <DataGridTextColumn Header="Customer / Company Name" Binding="{Binding FullName}" Width="2*" MinWidth="210" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="105"/>
                <DataGridTextColumn Header="Type" Binding="{Binding CustomerType}" Width="85"/>
                <DataGridCheckBoxColumn Header="Loyalty / Discount" Binding="{Binding IsDiscountEligible}" Width="105" ElementStyle="{StaticResource CenterCheckBox}"/>
                <DataGridTextColumn Header="Credit Status" Binding="{Binding CreditStatus}" Width="100"/>
                <DataGridTextColumn Header="Credit Limit" Binding="{Binding CreditLimit, StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource RightGridText}"/>
                <DataGridTextColumn Header="Balance" Binding="{Binding CurrentBalance, StringFormat={}{0:N2}}" Width="100" FontWeight="Bold" ElementStyle="{StaticResource RightGridText}"/>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" ElementStyle="{StaticResource CenterCheckBox}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- EDITOR -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid IsEnabled="{Binding IsCustomerSelected}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource DataGridHeaderBackground}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="8,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SELECTED CUSTOMER PROFILE" Style="{DynamicResource BoSectionHeader}" Margin="0"/>
                        <TextBlock Grid.Column="1" Text="{Binding CustomerTypeHelpText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <TabControl Grid.Row="1" Margin="8,5,8,6" Background="{DynamicResource PanelBackgroundBrush}">
                    <TabControl.Resources>
                        <Style TargetType="TabItem" BasedOn="{StaticResource BoTabItem}"/>
                    </TabControl.Resources>

                    <TabItem Header="1. Basic Details">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="10" MaxWidth="920" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="300" MinWidth="220"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="300" MinWidth="200"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Account Code" Style="{DynamicResource BoInlineLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding InputCustomerCode}" IsReadOnly="True"
                                         Style="{DynamicResource BoInputTextBox}" FontWeight="Bold" Margin="0,0,0,8"/>

                                <TextBlock Grid.Column="3" Text="Customer Type" Style="{DynamicResource BoInlineLabel}"/>
                                <TextBox Grid.Column="4" Text="{Binding InputCustomerType}" IsReadOnly="True"
                                         Style="{DynamicResource BoInputTextBox}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Text="Full Name *" Style="{DynamicResource BoInlineLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"
                                         Text="{Binding InputFullName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource BoInputTextBox}" FontWeight="Bold"
                                         Background="{DynamicResource HighlightBackgroundBrush}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Text="Phone *" Style="{DynamicResource BoInlineLabel}"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding InputPhone, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource BoInputTextBox}"
                                         Background="{DynamicResource HighlightBackgroundBrush}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="Email" Style="{DynamicResource BoInlineLabel}"/>
                                <TextBox Grid.Row="2" Grid.Column="4"
                                         Text="{Binding InputEmail, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource BoInputTextBox}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Text="Birthday" Style="{DynamicResource BoInlineLabel}"/>
                                <DatePicker Grid.Row="3" Grid.Column="1"
                                            SelectedDate="{Binding InputBirthday, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{DynamicResource BoInputDatePicker}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="3" Grid.Column="3" Text="NIC" Style="{DynamicResource BoInlineLabel}"/>
                                <TextBox Grid.Row="3" Grid.Column="4"
                                         Text="{Binding InputNicNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource BoInputTextBox}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="4" Text="Address" Style="{DynamicResource BoInlineLabel}" VerticalAlignment="Top" Margin="0,5,6,0"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4"
                                         Text="{Binding InputAddress, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource BoInputTextBox}" Height="48"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="2. Business Details">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="10" MaxWidth="920" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="340" MinWidth="230"/>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="250" MinWidth="180"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Customer Type *" Style="{DynamicResource BoInlineLabel}"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding CustomerTypes}"
                                          SelectedItem="{Binding InputCustomerType}"
                                          Style="{DynamicResource BoInputComboBox}"
                                          FontWeight="Bold" Background="{DynamicResource HighlightBackgroundBrush}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Column="3" Text="Account Status" Style="{DynamicResource BoInlineLabel}"/>
                                <CheckBox Grid.Column="4" Content="Account is Active" IsChecked="{Binding InputIsActive}"
                                          FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Text="Company" Style="{DynamicResource BoInlineLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding InputCompanyName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource BoInputTextBox}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="BR No." Style="{DynamicResource BoInlineLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="4"
                                         Text="{Binding InputBusinessRegistrationNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource BoInputTextBox}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Text="VAT No." Style="{DynamicResource BoInlineLabel}"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding InputVatNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource BoInputTextBox}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Text="{Binding DiscountEligibilityLabel}" Style="{DynamicResource BoInlineLabel}"/>
                                <CheckBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4"
                                          IsChecked="{Binding InputIsDiscountEligible}"
                                          Content="Allow approved manual discounts for this customer"
                                          FontWeight="Bold" Foreground="#005500" VerticalAlignment="Center" Margin="0,0,0,8"/>

                                <Border Grid.Row="4" Grid.ColumnSpan="5"
                                        Background="#F8F8F8" BorderBrush="{DynamicResource LightBorderBrush}"
                                        BorderThickness="1" Padding="8">
                                    <TextBlock Text="Retail customers display this setting as Loyalty; wholesale customers display it as Discount."
                                               Style="{DynamicResource BoHelpText}"/>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="3. Credit Settings">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="10" MaxWidth="920" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="430" MinWidth="320"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="360" MinWidth="260"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{DynamicResource BoPanel}" Margin="0">
                                    <StackPanel>
                                        <CheckBox Content="Credit Enabled"
                                                  IsChecked="{Binding InputIsCreditEnabled}"
                                                  FontWeight="Bold" Foreground="{DynamicResource HeaderTextBrush}"
                                                  Margin="0,0,0,10"/>
                                        <Grid IsEnabled="{Binding InputIsCreditEnabled}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="115"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="Credit Status" Style="{DynamicResource BoInlineLabel}"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding CreditStatuses}"
                                                      SelectedItem="{Binding InputCreditStatus}"
                                                      Style="{DynamicResource BoInputComboBox}" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="1" Text="Credit Limit Rs." Style="{DynamicResource BoInlineLabel}"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding InputCreditLimit}"
                                                     Style="{DynamicResource BoInputTextBox}"
                                                     HorizontalContentAlignment="Right" FontWeight="Bold"
                                                     Background="{DynamicResource HighlightBackgroundBrush}" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="2" Text="Credit Days" Style="{DynamicResource BoInlineLabel}"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding InputCreditDays}"
                                                     Style="{DynamicResource BoInputTextBox}"
                                                     HorizontalContentAlignment="Center"
                                                     Background="{DynamicResource HighlightBackgroundBrush}" Margin="0,0,0,8"/>

                                            <CheckBox Grid.Row="3" Grid.Column="1" Content="Lock Credit Account"
                                                      IsChecked="{Binding InputIsCreditLocked}"
                                                      FontWeight="Bold" Foreground="DarkRed"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{DynamicResource BoPanel}" Margin="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="CURRENT BALANCE" Style="{DynamicResource BoKpiLabel}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedCurrentBalance, StringFormat=Rs. \{0:N2\}}"
                                                           Style="{DynamicResource BoKpiValue}" Foreground="DarkRed" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="AVAILABLE CREDIT" Style="{DynamicResource BoKpiLabel}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedAvailableCredit, StringFormat=Rs. \{0:N2\}}"
                                                           Style="{DynamicResource BoKpiValue}" Foreground="#005500" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <Border Grid.Row="1"
                                                Background="#FFF5F5" BorderBrush="#D0A0A0" BorderThickness="1" Padding="8">
                                            <TextBlock Text="Credit must be explicitly approved in BackOffice. Cashier-created customers do not receive credit automatically."
                                                       Foreground="DarkRed" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <Border Grid.Row="2" Style="{DynamicResource BoActionFooter}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Required: Full Name, Phone and Customer Type"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="CLEAR" Command="{Binding ClearFormCommand}"
                                Style="{DynamicResource BoButton}" Width="90" Margin="0,0,7,0"/>
                        <Button Grid.Column="2" Content="SAVE CUSTOMER PROFILE" Command="{Binding SaveCustomerCommand}"
                                Style="{DynamicResource BoPrimaryButton}" Width="185"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
