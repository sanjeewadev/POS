<UserControl x:Class="POS.BackOffice.UI.Views.Pages.InventoryOperations.PriceManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:POS.BackOffice.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="1400"
             Background="#D4D0C8"
             FontFamily="Segoe UI"
             FontSize="12">

    <UserControl.Resources>

        <conv:SmartQuantityConverter x:Key="SmartQuantityConverter"/>

        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D0E8E8"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E4F0F0"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>

        <Style TargetType="{x:Type TextBlock}" x:Key="HeaderLabel">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="InlineLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="ClassicInput">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="{x:Type ComboBox}" x:Key="ClassicCombo">
            <Setter Property="Height" Value="27"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="ClassicBtn">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CCCCCC"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="ActionBtn" BasedOn="{StaticResource ClassicBtn}">
            <Setter Property="Background" Value="#005555"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#003333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007777"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="SaveBtn" BasedOn="{StaticResource ClassicBtn}">
            <Setter Property="Background" Value="#005500"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#003300"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007700"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Border}" x:Key="ClassicGroupBox">
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#003366"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}" x:Key="BaseCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D0E8E8"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type DataGridCell}" x:Key="FrozenCell" BasedOn="{StaticResource BaseCell}">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}" x:Key="EditableCell" BasedOn="{StaticResource BaseCell}">
            <Setter Property="Background" Value="#FFFFE0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}" x:Key="WarningCell" BasedOn="{StaticResource BaseCell}">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#991B1B"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}" x:Key="TrackingCell" BasedOn="{StaticResource BaseCell}">
            <Setter Property="Background" Value="#EEF6FF"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="RightText">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,5,0"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="CenterText">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="GridEditBox">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFE0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="CopyableGridTextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="Focusable" Value="True"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- COMMAND CENTER -->
        <Border Grid.Row="0"
                Style="{StaticResource ClassicGroupBox}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="PRICE MANAGEMENT"
                           Style="{StaticResource HeaderLabel}"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="225"/>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="Search Item / SKU / Barcode / Batch:"
                                   Style="{StaticResource InlineLabel}"/>

                        <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter"
                                            Command="{Binding LoadDataCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,15,0">
                        <TextBlock Text="Item Type:"
                                   Style="{StaticResource InlineLabel}"/>

                        <ComboBox ItemsSource="{Binding ItemTypeFilters}"
                                  SelectedItem="{Binding SelectedItemTypeFilter, Mode=TwoWay}"
                                  Style="{StaticResource ClassicCombo}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,15,0">
                        <TextBlock Text="Tracking:"
                                   Style="{StaticResource InlineLabel}"/>

                        <ComboBox ItemsSource="{Binding TrackingFilters}"
                                  SelectedItem="{Binding SelectedTrackingFilter, Mode=TwoWay}"
                                  Style="{StaticResource ClassicCombo}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,15,0">
                        <TextBlock Text="Margin:"
                                   Style="{StaticResource InlineLabel}"/>

                        <ComboBox ItemsSource="{Binding MarginFilters}"
                                  SelectedItem="{Binding SelectedMarginFilter, Mode=TwoWay}"
                                  Style="{StaticResource ClassicCombo}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Margin="0,0,10,0">

                        <Button Content="Refresh"
                                Command="{Binding LoadDataCommand}"
                                Style="{StaticResource ActionBtn}"
                                Width="85"
                                Margin="0,0,6,0"/>

                        <Button Content="Clear Filters"
                                Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource ClassicBtn}"
                                Width="105"/>
                    </StackPanel>

                    <Border Grid.Column="5"
                            Background="#E0FFFF"
                            BorderBrush="#005555"
                            BorderThickness="1"
                            Padding="8,4"
                            VerticalAlignment="Bottom">

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#003366"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Price Change Reason *"
                                   Style="{StaticResource InlineLabel}"
                                   Foreground="#003366"/>

                        <TextBox Text="{Binding ChangeReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}"
                                 Height="32"
                                 ToolTip="Required before saving. Example: Supplier cost increase, market price change, manager approved correction."/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom">

                        <CheckBox Content="Apply selling prices to current active stock rows (Stock Items only)"
                                  IsChecked="{Binding ApplySellingPriceToCurrentStock, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  FontWeight="Bold"
                                  Foreground="#003366"
                                  Margin="0,0,15,0"
                                  ToolTip="Recommended for Stock Items. Services never create stock rows and always update master prices only."/>

                        <Button Content="SAVE CHANGED PRICES"
                                Command="{Binding SaveAllDirtyCommand}"
                                Style="{StaticResource SaveBtn}"
                                Width="175"
                                Height="34"
                                FontSize="13"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- PRICING GRID -->
        <Border Grid.Row="2"
                Style="{StaticResource ClassicGroupBox}"
                Padding="0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#F0F0F0"
                        Padding="10"
                        BorderBrush="#A0A0A0"
                        BorderThickness="0,0,0,1">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="MASTER SELLING PRICES"
                                   Style="{StaticResource HeaderLabel}"
                                   Foreground="#005555"
                                   VerticalAlignment="Center"
                                   Margin="0"/>

                        <TextBlock Text="Edit yellow cells only. Cost is read-only. Save writes price history."
                                   FontStyle="Italic"
                                   Foreground="#666666"
                                   Margin="15,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding PricingItems}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="False"
                          HeadersVisibility="Column"
                          Background="White"
                          BorderBrush="#A0A0A0"
                          BorderThickness="0"
                          RowHeight="32"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#E0E0E0"
                          VerticalGridLinesBrush="#E0E0E0"
                          SelectionMode="Single"
                          FrozenColumnCount="4"
                          AlternatingRowBackground="#F9F9F9"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <DataGrid.Resources>
                        <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource BaseCell}"/>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type"
                                            Binding="{Binding ItemTypeText, Mode=OneWay}"
                                            Width="85"
                                            IsReadOnly="True"
                                            CellStyle="{StaticResource TrackingCell}"/>

                        <DataGridTextColumn Header="Tracking"
                                            Binding="{Binding TrackingText, Mode=OneWay}"
                                            Width="115"
                                            IsReadOnly="True"
                                            CellStyle="{StaticResource TrackingCell}"/>

                        <DataGridTemplateColumn Header="Item Code"
                                                Width="95"
                                                IsReadOnly="True"
                                                CellStyle="{StaticResource FrozenCell}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding ItemCode, Mode=OneWay}"
                                             Style="{StaticResource CopyableGridTextBox}"
                                             Foreground="#666666"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="SKU"
                                                Width="125"
                                                IsReadOnly="True"
                                                CellStyle="{StaticResource FrozenCell}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding SkuCode, Mode=OneWay}"
                                             Style="{StaticResource CopyableGridTextBox}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Description"
                                            Binding="{Binding DisplayDescription, Mode=OneWay}"
                                            Width="260"
                                            IsReadOnly="True"
                                            CellStyle="{StaticResource FrozenCell}"/>

                        <DataGridTemplateColumn Header="Barcode"
                                                Width="130"
                                                IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Barcode, Mode=OneWay}"
                                             Style="{StaticResource CopyableGridTextBox}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="UOM"
                                            Binding="{Binding Uom, Mode=OneWay}"
                                            Width="55"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource CenterText}"/>

                        <DataGridTextColumn Header="Category"
                                            Binding="{Binding CategoryName, Mode=OneWay}"
                                            Width="120"
                                            IsReadOnly="True"/>

                        <DataGridTextColumn Header="SOH"
                                            Binding="{Binding InventoryStockOnHand, Mode=OneWay, Converter={StaticResource SmartQuantityConverter}, ConverterParameter=Display, TargetNullValue=—}"
                                            Width="80"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource CenterText}"/>

                        <DataGridTextColumn Header="Stock Rows"
                                            Binding="{Binding ActiveStockRowsText, Mode=OneWay}"
                                            Width="90"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource CenterText}"/>

                        <DataGridTextColumn Header="Cost Method"
                                            Binding="{Binding CostMethodText, Mode=OneWay}"
                                            Width="135"
                                            IsReadOnly="True"/>

                        <DataGridTextColumn Header="Effective Cost"
                                            Binding="{Binding EffectiveCost, Mode=OneWay, StringFormat=N2}"
                                            Width="105"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource RightText}"/>

                        <DataGridTextColumn Header="Avg / Std Cost"
                                            Binding="{Binding MovingAverageCost, Mode=OneWay, StringFormat=N2}"
                                            Width="85"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource RightText}"/>

                        <DataGridTextColumn Header="Last / Base Cost"
                                            Binding="{Binding LastLandedCost, Mode=OneWay, StringFormat=N2}"
                                            Width="85"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource RightText}"/>

                        <DataGridTextColumn Header="Minimum"
                                            Binding="{Binding MinimumPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            Width="90"
                                            CellStyle="{StaticResource EditableCell}"
                                            ElementStyle="{StaticResource RightText}"
                                            EditingElementStyle="{StaticResource GridEditBox}"/>

                        <DataGridTextColumn Header="Retail"
                                            Binding="{Binding RetailPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            Width="90"
                                            CellStyle="{StaticResource EditableCell}"
                                            ElementStyle="{StaticResource RightText}"
                                            EditingElementStyle="{StaticResource GridEditBox}"/>

                        <DataGridTextColumn Header="Wholesale"
                                            Binding="{Binding WholesalePrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            Width="95"
                                            CellStyle="{StaticResource EditableCell}"
                                            ElementStyle="{StaticResource RightText}"
                                            EditingElementStyle="{StaticResource GridEditBox}"/>

                        <DataGridTextColumn Header="Maximum"
                                            Binding="{Binding MaximumPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            Width="90"
                                            CellStyle="{StaticResource EditableCell}"
                                            ElementStyle="{StaticResource RightText}"
                                            EditingElementStyle="{StaticResource GridEditBox}"/>

                        <DataGridTextColumn Header="Retail Margin"
                                            Binding="{Binding GrossMarginPercentage, Mode=OneWay, StringFormat={}{0:N2}%}"
                                            Width="100"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource CenterText}"/>

                        <DataGridTextColumn Header="W/S Margin"
                                            Binding="{Binding WholesaleMarginPercentage, Mode=OneWay, StringFormat={}{0:N2}%}"
                                            Width="100"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource CenterText}"/>

                        <DataGridTextColumn Header="Health"
                                            Binding="{Binding MarginHealth, Mode=OneWay}"
                                            Width="135"
                                            IsReadOnly="True"
                                            CellStyle="{StaticResource WarningCell}"/>

                        <DataGridTextColumn Header="Current Stock Value"
                                            Binding="{Binding InventoryStockValue, Mode=OneWay, StringFormat=N2, TargetNullValue=—}"
                                            Width="125"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource RightText}"/>

                        <DataGridTextColumn Header="New Retail Value"
                                            Binding="{Binding InventoryRetailValue, Mode=OneWay, StringFormat=N2, TargetNullValue=—}"
                                            Width="120"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource RightText}"/>

                        <DataGridCheckBoxColumn Header="Changed"
                                                Binding="{Binding IsDirty, Mode=OneWay}"
                                                Width="75"
                                                IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- FOOTER SUMMARY -->
        <Border Grid.Row="4"
                Style="{StaticResource ClassicGroupBox}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Items: " FontWeight="Bold" Foreground="#555555"/>
                    <TextBlock Text="{Binding TotalItems}" FontWeight="Bold" Foreground="#000000"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Stock Items: " FontWeight="Bold" Foreground="#003366"/>
                    <TextBlock Text="{Binding StockItemCount}" FontWeight="Bold" Foreground="#003366"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <TextBlock Text="Services: " FontWeight="Bold" Foreground="#005555"/>
                    <TextBlock Text="{Binding ServiceItemCount}" FontWeight="Bold" Foreground="#005555"/>
                </StackPanel>

                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <TextBlock Text="Changed: " FontWeight="Bold" Foreground="#B45309"/>
                    <TextBlock Text="{Binding DirtyItemCount}" FontWeight="Bold" Foreground="#B45309"/>
                </StackPanel>

                <StackPanel Grid.Column="8"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <TextBlock Text="Rule: "
                               FontWeight="Bold"
                               Foreground="#555555"/>

                    <TextBlock Text="Stock Items can sync active stock rows. Services use Standard Cost and master selling prices only."
                               Foreground="#003366"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
