<UserControl x:Class="POS.BackOffice.UI.Views.Pages.InventoryOperations.PriceManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:POS.BackOffice.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="1400"
             Background="#D4D0C8"
             FontFamily="Segoe UI"
             FontSize="12">
    <UserControl.Resources>
        <conv:SmartQuantityConverter x:Key="SmartQuantityConverter"/>
        <Style x:Key="GroupBox" TargetType="Border">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#9A9A9A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="#B00020"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="ToolTip" Value="Enter a valid numeric price."/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GridInput" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Background" Value="#FFFFE0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Height" Value="27"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="Button" TargetType="Button">
            <Setter Property="Height" Value="29"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#777777"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource Button}">
            <Setter Property="Background" Value="#005555"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#003333"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#003366"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D0E8E8"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RightText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D0E8E8"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/> <!-- Master Grid -->
            <RowDefinition Height="6"/>
            <RowDefinition Height="250" MinHeight="150"/> <!-- Detail Grid -->
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource GroupBox}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,7" LastChildFill="False">
                    <Button DockPanel.Dock="Right" Width="150" Content="SAVE ALL CHANGES" Command="{Binding SaveAllChangesCommand}" Style="{StaticResource PrimaryButton}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PRICE MANAGEMENT" FontSize="14" FontWeight="Bold" Foreground="#003366"/>
                        <TextBlock Text="Quick master price changes and exact batch overrides" Margin="14,1,0,0" Foreground="#666666"/>
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Search" Foreground="#555555" Margin="0,0,0,3"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Category" Foreground="#555555" Margin="0,0,0,3"/>
                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" ToolTip="Item, SKU, barcode, batch number or internal batch barcode"/>
                    <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategoryFilter}" Style="{StaticResource Combo}"/>
                    <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="REFRESH" Command="{Binding LoadDataCommand}" Style="{StaticResource Button}"/>
                        <Button Content="CLEAR FILTERS" Command="{Binding ClearFiltersCommand}" Style="{StaticResource Button}" Margin="5,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource GroupBox}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding PricingItems}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          RowHeight="28"
                          AlternatingRowBackground="#F8F8F8"
                          GridLinesVisibility="All"
                          FrozenColumnCount="3"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item / Variant" Binding="{Binding DisplayName, Mode=OneWay}" Width="*"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding SkuCode, Mode=OneWay}" Width="150"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryName, Mode=OneWay}" Width="180"/>
                        <DataGridTextColumn Header="Total Stock" Binding="{Binding TotalStock, Mode=OneWay, Converter={StaticResource SmartQuantityConverter}, ConverterParameter=Display, TargetNullValue=—}" Width="100" ElementStyle="{StaticResource RightText}"/>
                        <DataGridTextColumn Header="Batches" Binding="{Binding BatchCount, Mode=OneWay}" Width="80" ElementStyle="{StaticResource RightText}"/>
                        <DataGridTextColumn Header="Overrides" Binding="{Binding OverrideCount, Mode=OneWay}" Width="80" ElementStyle="{StaticResource RightText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No pricing items match the selected filters."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#666666"
                           FontStyle="Italic"
                           Visibility="{Binding IsPricingListEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <Border Grid.Row="4" Style="{StaticResource GroupBox}" Padding="0">
            <Grid IsEnabled="{Binding HasSelectedItem}">
                <DataGrid ItemsSource="{Binding ActiveBatches}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          RowHeight="28"
                          AlternatingRowBackground="#F8F8F8"
                          GridLinesVisibility="All"
                          FrozenColumnCount="1"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Batch No" Binding="{Binding Dto.BatchNo, Mode=OneWay}" Width="125"/>
                        <DataGridTextColumn Header="Expiry" Binding="{Binding Dto.ExpiryDate, Mode=OneWay, StringFormat=yyyy-MM-dd}" Width="90"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding Dto.CurrentStock, Mode=OneWay, Converter={StaticResource SmartQuantityConverter}, ConverterParameter=Display, TargetNullValue=—}" Width="75" ElementStyle="{StaticResource RightText}"/>
                        <DataGridTextColumn Header="Cost" Binding="{Binding Dto.CostPrice, Mode=OneWay, StringFormat=N2}" Width="85" ElementStyle="{StaticResource RightText}"/>
                        <DataGridTextColumn Header="Current Retail" Binding="{Binding Dto.EffectiveRetailPrice, Mode=OneWay, StringFormat=N2}" Width="100" ElementStyle="{StaticResource RightText}"/>
                        <DataGridTextColumn Header="Current W/S" Binding="{Binding Dto.EffectiveWholesalePrice, Mode=OneWay, StringFormat=N2}" Width="100" ElementStyle="{StaticResource RightText}"/>
                        <DataGridTemplateColumn Header="New Retail Price" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding NewRetailPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Style="{StaticResource GridInput}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="New Wholesale Price" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding NewWholesalePrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Style="{StaticResource GridInput}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Price Source" Binding="{Binding Dto.PriceSource, Mode=OneWay}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Select an item above to view its stock batches."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#666666"
                           FontStyle="Italic"
                           Visibility="{Binding ShowBatchEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource GroupBox}" Padding="7,5">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#444444"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Items: " FontWeight="Bold"/><TextBlock Text="{Binding TotalItems}" Margin="0,0,14,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
