<UserControl x:Class="POS.BackOffice.UI.Views.Pages.InventoryOperations.BarcodePrinterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="1400"
             Background="#D4D0C8"
             FontFamily="Segoe UI"
             FontSize="12">

    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="HeaderLabel">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="InlineLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TextBox" x:Key="ClassicInput">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="ComboBox" x:Key="ClassicCombo">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="Button" x:Key="ClassicBtn">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionBtn" BasedOn="{StaticResource ClassicBtn}">
            <Setter Property="Background" Value="#005555"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#003333"/>
        </Style>

        <Style TargetType="Button" x:Key="PrintBtn" BasedOn="{StaticResource ClassicBtn}">
            <Setter Property="Background" Value="#D97706"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#B45309"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="Border" x:Key="ClassicGroupBox">
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#003366"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
        </Style>

        <Style TargetType="DataGridCell" x:Key="BaseCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource LightSelectionBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox" x:Key="GridQtyBox">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFE0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="RightText">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="CenterText">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="BoldText">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="#003366"
                    BorderBrush="#002244"
                    BorderThickness="1"
                    Padding="10">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="GRN BARCODE PRINT / REPRINT"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <Border Grid.Column="1"
                            Background="#E0FFFF"
                            BorderBrush="#005555"
                            BorderThickness="1"
                            Padding="8,4">

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#003366"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Width="420"/>
                    </Border>
                </Grid>
            </Border>

            <!-- INTAKE -->
            <Border Grid.Row="2"
                    Style="{StaticResource ClassicGroupBox}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="1. LOAD LABELS"
                               Style="{StaticResource HeaderLabel}"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Recent Posted GRN:" Style="{StaticResource InlineLabel}"/>
                            <ComboBox ItemsSource="{Binding RecentGrns}"
                                      SelectedItem="{Binding SelectedGrn, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayText"
                                      Style="{StaticResource ClassicCombo}"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Refresh"
                                Command="{Binding LoadRecentGrnsCommand}"
                                Style="{StaticResource ClassicBtn}"
                                VerticalAlignment="Bottom"/>

                        <Button Grid.Column="4"
                                Content="Load GRN"
                                Command="{Binding LoadGrnItemsCommand}"
                                Style="{StaticResource ActionBtn}"
                                VerticalAlignment="Bottom"/>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Manual Barcode / SKU / GRN Batch Barcode:" Style="{StaticResource InlineLabel}"/>
                            <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ClassicInput}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AddManualItemCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Grid.Column="8">
                            <TextBlock Text="Qty:" Style="{StaticResource InlineLabel}"/>
                            <TextBox Text="{Binding ManualQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ClassicInput}"
                                     HorizontalContentAlignment="Center"
                                     FontWeight="Bold"/>
                        </StackPanel>

                        <Button Grid.Column="10"
                                Content="Add Manual"
                                Command="{Binding AddManualItemCommand}"
                                Style="{StaticResource ActionBtn}"
                                VerticalAlignment="Bottom"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ACTION BAND -->
            <Border Grid.Row="4"
                    Style="{StaticResource ClassicGroupBox}"
                    Padding="0">

                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="#E5E5E5"
                            BorderBrush="#A0A0A0"
                            BorderThickness="0,0,0,1"
                            Padding="10">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="White"
                                    BorderBrush="#A0A0A0"
                                    BorderThickness="1"
                                    Padding="8,4"
                                    Margin="0,0,6,0">
                                <TextBlock>
                                    <Run Text="Rows: "/>
                                    <Run Text="{Binding QueueItemCount}" FontWeight="Bold"/>
                                </TextBlock>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="White"
                                    BorderBrush="#A0A0A0"
                                    BorderThickness="1"
                                    Padding="8,4"
                                    Margin="0,0,6,0">
                                <TextBlock>
                                    <Run Text="Selected Rows: "/>
                                    <Run Text="{Binding SelectedQueueItemCount}" FontWeight="Bold"/>
                                </TextBlock>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="#FFFFE0"
                                    BorderBrush="#A0A0A0"
                                    BorderThickness="1"
                                    Padding="8,4">
                                <TextBlock>
                                    <Run Text="Selected Labels: "/>
                                    <Run Text="{Binding SelectedLabelsToGenerate}" FontWeight="Bold"/>
                                </TextBlock>
                            </Border>

                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <Button Content="Select All"
                                        Command="{Binding SelectAllQueueCommand}"
                                        Style="{StaticResource ClassicBtn}"
                                        Width="92"
                                        Margin="0,0,6,0"/>

                                <Button Content="Unselect"
                                        Command="{Binding UnselectAllQueueCommand}"
                                        Style="{StaticResource ClassicBtn}"
                                        Width="85"
                                        Margin="0,0,6,0"/>

                                <Button Content="Qty = Received"
                                        Command="{Binding SetPrintQtyToReceivedCommand}"
                                        Style="{StaticResource ClassicBtn}"
                                        Width="120"
                                        Margin="0,0,6,0"/>
                            </StackPanel>

                            <Button Grid.Column="5"
                                    Content="Clear Queue"
                                    Command="{Binding ClearQueueCommand}"
                                    Style="{StaticResource ClassicBtn}"
                                    Background="#FEF2F2"
                                    Foreground="#991B1B"
                                    BorderBrush="#FCA5A5"
                                    Width="105"
                                    Margin="0,0,6,0"/>

                            <Button Grid.Column="6"
                                    Content="PRINT SELECTED"
                                    Command="{Binding PrintSelectedLabelsCommand}"
                                    Style="{StaticResource PrintBtn}"
                                    Width="145"/>
                        </Grid>
                    </Border>

                    <DataGrid ItemsSource="{Binding PrintQueue}"
                              SelectedItem="{Binding SelectedQueueItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#E0E0E0"
                              VerticalGridLinesBrush="#E0E0E0"
                              BorderThickness="0"
                              RowHeight="34"
                              Background="White"
                              AlternatingRowBackground="#F9F9F9"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource BaseCell}"/>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="45">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox IsChecked="{Binding DataContext.IsSelectAllChecked,
                                                              RelativeSource={RelativeSource AncestorType=UserControl},
                                                              Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Print Qty" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding PrintQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource GridQtyBox}"
                                                 Margin="3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding LabelTypeText}"
                                                Width="85"
                                                IsReadOnly="True"
                                                ElementStyle="{StaticResource CenterText}"/>

                            <DataGridTextColumn Header="GRN / Source"
                                                Binding="{Binding SourceDocument}"
                                                Width="105"
                                                IsReadOnly="True"
                                                ElementStyle="{StaticResource BoldText}"/>

                            <DataGridTextColumn Header="Item Code"
                                                Binding="{Binding ItemCode}"
                                                Width="95"
                                                IsReadOnly="True"/>

                            <DataGridTextColumn Header="SKU"
                                                Binding="{Binding SkuCode}"
                                                Width="115"
                                                IsReadOnly="True"/>

                            <DataGridTextColumn Header="Item / Variant"
                                                Binding="{Binding DisplayName}"
                                                Width="230"
                                                IsReadOnly="True"/>

                            <DataGridTextColumn Header="Batch No"
                                                Binding="{Binding BatchDisplayText}"
                                                Width="115"
                                                IsReadOnly="True"
                                                ElementStyle="{StaticResource BoldText}"/>

                            <DataGridTextColumn Header="Expiry"
                                                Binding="{Binding ExpiryDisplayText}"
                                                Width="95"
                                                IsReadOnly="True"
                                                ElementStyle="{StaticResource CenterText}"/>

                            <DataGridTextColumn Header="GRN Barcode"
                                                Binding="{Binding EffectiveBarcode}"
                                                Width="140"
                                                IsReadOnly="True"
                                                ElementStyle="{StaticResource BoldText}"/>

                            <DataGridTextColumn Header="Received"
                                                Binding="{Binding ReceivedQtyDisplayText}"
                                                Width="80"
                                                IsReadOnly="True"
                                                ElementStyle="{StaticResource CenterText}"/>

                            <DataGridTextColumn Header="Available"
                                                Binding="{Binding AvailableQtyDisplayText}"
                                                Width="80"
                                                IsReadOnly="True"
                                                ElementStyle="{StaticResource CenterText}"/>

                            <DataGridTextColumn Header="Price"
                                                Binding="{Binding Price, StringFormat={}{0:N2}}"
                                                Width="85"
                                                IsReadOnly="True"
                                                ElementStyle="{StaticResource RightText}"/>

                            <DataGridTextColumn Header="Printed Status"
                                                Binding="{Binding PrintedStatusText}"
                                                Width="190"
                                                IsReadOnly="True"/>

                            <DataGridTemplateColumn Header="Drop" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="X"
                                                Command="{Binding DataContext.RemoveQueueItemCommand,
                                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="#A94044"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Width="28"
                                                Height="24"
                                                FontWeight="Bold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- RIGHT SIDE -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- SETTINGS -->
            <Border Grid.Row="0" Style="{StaticResource ClassicGroupBox}">
                <StackPanel>
                    <TextBlock Text="2. PRINTER SETTINGS"
                               Style="{StaticResource HeaderLabel}"
                               Foreground="#6F42C1"/>

                    <TextBlock Text="Target Windows Printer:" Style="{StaticResource InlineLabel}"/>
                    <ComboBox ItemsSource="{Binding AvailablePrinters}"
                              SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}"
                              Style="{StaticResource ClassicCombo}"
                              FontWeight="Bold"
                              Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Width mm:" Style="{StaticResource InlineLabel}"/>
                            <TextBox Text="{Binding PrintConfig.WidthMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ClassicInput}"
                                     HorizontalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Height mm:" Style="{StaticResource InlineLabel}"/>
                            <TextBox Text="{Binding PrintConfig.HeightMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ClassicInput}"
                                     HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="#F9F5FF"
                            BorderBrush="#E5D6FA"
                            BorderThickness="1"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="Label Content"
                                       FontWeight="Bold"
                                       Foreground="#6F42C1"
                                       Margin="0,0,0,8"/>

                            <CheckBox Content="Print Store Name"
                                      IsChecked="{Binding PrintConfig.PrintStoreName, Mode=TwoWay}"
                                      Margin="0,0,0,5"/>

                            <TextBox Text="{Binding PrintConfig.StoreName, Mode=OneWay}"
                                     IsReadOnly="True"
                                     IsEnabled="{Binding PrintConfig.PrintStoreName}"
                                     ToolTip="Configured in Store Settings. The barcode page does not maintain a separate store name."
                                     Style="{StaticResource ClassicInput}"
                                     Margin="20,0,0,8"/>

                            <CheckBox Content="Print Item Name / Variant"
                                      IsChecked="{Binding PrintConfig.PrintItemName, Mode=TwoWay}"
                                      Margin="0,0,0,5"/>

                            <CheckBox Content="Print Retail Price"
                                      IsChecked="{Binding PrintConfig.PrintPrice, Mode=TwoWay}"
                                      Margin="0,0,0,5"/>

                            <CheckBox Content="Print Item Code / Batch No"
                                      IsChecked="{Binding PrintConfig.PrintItemCode, Mode=TwoWay}"
                                      Margin="0,0,0,5"/>

                            <CheckBox Content="Print Batch No"
                                      IsChecked="{Binding PrintConfig.PrintBatchNo, Mode=TwoWay}"
                                      Margin="0,0,0,5"/>

                            <CheckBox Content="Print Expiry Date"
                                      IsChecked="{Binding PrintConfig.PrintExpiryDate, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- SIMPLE PREVIEW -->
            <Border Grid.Row="2"
                    Style="{StaticResource ClassicGroupBox}"
                    Background="#E2EDF8"
                    BorderBrush="#B6D4FE">

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Simple Label Preview"
                               FontWeight="Bold"
                               Foreground="#2B5B84"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>

                    <Border Background="White"
                            BorderBrush="#A0A0A0"
                            BorderThickness="1"
                            Width="245"
                            Height="145"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="6">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding PrintConfig.StoreName}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Grid.Row="1"
                                       Text="Sample Retail Item - Standard"
                                       FontSize="9"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Row="2"
                                       Text="Batch: A125 | Exp: 2027-05-31"
                                       FontSize="8"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0"/>

                            <StackPanel Grid.Row="3"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="||| ||||||| | ||||| || ||| ||||"
                                           FontFamily="Consolas"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="B0000000025"
                                           FontSize="9"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <Grid Grid.Row="4">
                                <TextBlock Text="A125"
                                           FontSize="8"
                                           VerticalAlignment="Bottom"
                                           HorizontalAlignment="Left"/>

                                <TextBlock Text="Rs. 1,500.00"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           VerticalAlignment="Bottom"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <!-- FOOTER -->
            <Border Grid.Row="4"
                    Background="White"
                    BorderBrush="#A0A0A0"
                    BorderThickness="1"
                    Padding="12">

                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Selected Labels:"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="#555555"
                                   FontSize="14"/>

                        <TextBlock Text="{Binding SelectedLabelsToGenerate}"
                                   FontWeight="Bold"
                                   FontSize="24"
                                   Foreground="#1E7E34"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Total Queue Labels:"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="#555555"/>

                        <TextBlock Text="{Binding TotalLabelsToGenerate}"
                                   FontWeight="Bold"
                                   Foreground="#003366"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <Button Content="PRINT SELECTED LABELS"
                            Command="{Binding PrintSelectedLabelsCommand}"
                            Style="{StaticResource PrintBtn}"
                            Height="48"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
