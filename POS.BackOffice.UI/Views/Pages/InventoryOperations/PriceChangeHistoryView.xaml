<UserControl x:Class="POS.BackOffice.UI.Views.Pages.InventoryOperations.PriceChangeHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="1400"
             Background="#D4D0C8"
             FontFamily="Segoe UI"
             FontSize="12"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>

        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D0E8E8"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E4F0F0"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>

        <Style TargetType="{x:Type TextBlock}" x:Key="HeaderLabel">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="InlineLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="ClassicInput">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="{x:Type ComboBox}" x:Key="ClassicCombo">
            <Setter Property="Height" Value="27"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="{x:Type DatePicker}" x:Key="ClassicDate">
            <Setter Property="Height" Value="27"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="ClassicBtn">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CCCCCC"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="ActionBtn" BasedOn="{StaticResource ClassicBtn}">
            <Setter Property="Background" Value="#005555"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#003333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007777"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Border}" x:Key="ClassicGroupBox">
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#003366"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}" x:Key="BaseCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D0E8E8"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type DataGridCell}" x:Key="FrozenCell" BasedOn="{StaticResource BaseCell}">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="RightText">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,5,0"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="CenterText">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="CopyableGridTextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="Focusable" Value="True"/>
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="ReadOnlyDetailTextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderBrush" Value="#C0C0C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- FILTER BAR -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="3"
                Style="{StaticResource ClassicGroupBox}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="PRICE CHANGE HISTORY / AUDIT LOG"
                               Style="{StaticResource HeaderLabel}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               Margin="15,0"
                               VerticalAlignment="Center"
                               Foreground="#666666"
                               FontSize="11"/>

                    <Border Grid.Column="2"
                            Background="#E0FFFF"
                            BorderBrush="#005555"
                            BorderThickness="1"
                            Padding="10,4"
                            VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Busy: "
                                       Foreground="#003366"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding IsBusy}"
                                       Foreground="#003366"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <WrapPanel Grid.Row="1"
                           Orientation="Horizontal"
                           Margin="0,8,0,0">

                    <StackPanel Margin="0,0,12,5">
                        <TextBlock Text="Search Item / SKU / Barcode / Batch:"
                                   Style="{StaticResource InlineLabel}"/>

                        <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="260"
                                 Style="{StaticResource ClassicInput}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter"
                                            Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,5">
                        <TextBlock Text="Price Level:"
                                   Style="{StaticResource InlineLabel}"/>

                        <ComboBox ItemsSource="{Binding PriceLevelFilters}"
                                  SelectedItem="{Binding SelectedPriceLevelFilter, Mode=TwoWay}"
                                  Width="105"
                                  Style="{StaticResource ClassicCombo}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,5">
                        <TextBlock Text="Source:"
                                   Style="{StaticResource InlineLabel}"/>

                        <ComboBox ItemsSource="{Binding ChangeSourceFilters}"
                                  SelectedItem="{Binding SelectedChangeSourceFilter, Mode=TwoWay}"
                                  Width="150"
                                  Style="{StaticResource ClassicCombo}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,5">
                        <TextBlock Text="Changed By:"
                                   Style="{StaticResource InlineLabel}"/>

                        <ComboBox ItemsSource="{Binding ChangedByFilters}"
                                  SelectedItem="{Binding SelectedChangedByFilter, Mode=TwoWay}"
                                  Width="135"
                                  Style="{StaticResource ClassicCombo}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,5">
                        <TextBlock Text="Date From:"
                                   Style="{StaticResource InlineLabel}"/>

                        <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay}"
                                    Width="125"
                                    Style="{StaticResource ClassicDate}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,5">
                        <TextBlock Text="Date To:"
                                   Style="{StaticResource InlineLabel}"/>

                        <DatePicker SelectedDate="{Binding DateTo, Mode=TwoWay}"
                                    Width="125"
                                    Style="{StaticResource ClassicDate}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,5">
                        <TextBlock Text="Rows:"
                                   Style="{StaticResource InlineLabel}"/>

                        <ComboBox ItemsSource="{Binding RowLimitOptions}"
                                  SelectedItem="{Binding SelectedRowLimit, Mode=TwoWay}"
                                  Width="85"
                                  Style="{StaticResource ClassicCombo}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,5">

                        <Button Content="Search"
                                Command="{Binding SearchCommand}"
                                Style="{StaticResource ActionBtn}"
                                Width="85"
                                Margin="0,0,6,0"/>

                        <Button Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource ClassicBtn}"
                                Width="85"
                                Margin="0,0,6,0"/>

                        <Button Content="Clear"
                                Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource ClassicBtn}"
                                Width="75"/>
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- MAIN HISTORY GRID -->
        <Border Grid.Row="2"
                Grid.Column="0"
                Style="{StaticResource ClassicGroupBox}"
                Padding="0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#F0F0F0"
                        Padding="10"
                        BorderBrush="#A0A0A0"
                        BorderThickness="0,0,0,1">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PRICE CHANGE RECORDS"
                                   Style="{StaticResource HeaderLabel}"
                                   Foreground="#005555"
                                   Margin="0"/>

                        <TextBlock Text="Read-only audit trail. Select a row to view full details."
                                   FontStyle="Italic"
                                   Foreground="#666666"
                                   Margin="15,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding PriceChanges}"
                          SelectedItem="{Binding SelectedPriceChange, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          Background="White"
                          BorderThickness="0"
                          RowHeight="30"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#E0E0E0"
                          VerticalGridLinesBrush="#E0E0E0"
                          SelectionMode="Single"
                          FrozenColumnCount="4"
                          AlternatingRowBackground="#F9F9F9"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <DataGrid.Resources>
                        <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource BaseCell}"/>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Changed At"
                                            Binding="{Binding ChangedAt, StringFormat=yyyy-MM-dd HH:mm}"
                                            Width="130"
                                            CellStyle="{StaticResource FrozenCell}"/>

                        <DataGridTemplateColumn Header="Change No"
                                                Width="100"
                                                CellStyle="{StaticResource FrozenCell}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding PriceChangeNo}"
                                             Style="{StaticResource CopyableGridTextBox}"
                                             Foreground="#003366"
                                             FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Level"
                                            Binding="{Binding PriceLevel}"
                                            Width="75"
                                            CellStyle="{StaticResource FrozenCell}"/>

                        <DataGridTemplateColumn Header="Item Code"
                                                Width="90"
                                                CellStyle="{StaticResource FrozenCell}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding ItemCode}"
                                             Style="{StaticResource CopyableGridTextBox}"
                                             Foreground="#666666"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="SKU"
                                                Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding SkuCode}"
                                             Style="{StaticResource CopyableGridTextBox}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Barcode"
                                                Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Barcode}"
                                             Style="{StaticResource CopyableGridTextBox}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Description"
                                            Binding="{Binding ItemDescription}"
                                            Width="210"/>

                        <DataGridTextColumn Header="Variant"
                                            Binding="{Binding VariantDescription}"
                                            Width="130"/>

                        <DataGridTemplateColumn Header="Batch No"
                                                Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding BatchNo}"
                                             Style="{StaticResource CopyableGridTextBox}"
                                             Foreground="#003366"
                                             FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Old Min"
                                            Binding="{Binding OldMinimumPrice, StringFormat=N2}"
                                            Width="85"
                                            ElementStyle="{StaticResource RightText}"/>

                        <DataGridTextColumn Header="New Min"
                                            Binding="{Binding NewMinimumPrice, StringFormat=N2}"
                                            Width="85"
                                            ElementStyle="{StaticResource RightText}"/>

                        <DataGridTextColumn Header="Old Retail"
                                            Binding="{Binding OldRetailPrice, StringFormat=N2}"
                                            Width="90"
                                            ElementStyle="{StaticResource RightText}"/>

                        <DataGridTextColumn Header="New Retail"
                                            Binding="{Binding NewRetailPrice, StringFormat=N2}"
                                            Width="90"
                                            ElementStyle="{StaticResource RightText}"/>

                        <DataGridTextColumn Header="Old W/S"
                                            Binding="{Binding OldWholesalePrice, StringFormat=N2}"
                                            Width="90"
                                            ElementStyle="{StaticResource RightText}"/>

                        <DataGridTextColumn Header="New W/S"
                                            Binding="{Binding NewWholesalePrice, StringFormat=N2}"
                                            Width="90"
                                            ElementStyle="{StaticResource RightText}"/>

                        <DataGridTextColumn Header="Old Max"
                                            Binding="{Binding OldMaximumPrice, StringFormat=N2}"
                                            Width="85"
                                            ElementStyle="{StaticResource RightText}"/>

                        <DataGridTextColumn Header="New Max"
                                            Binding="{Binding NewMaximumPrice, StringFormat=N2}"
                                            Width="85"
                                            ElementStyle="{StaticResource RightText}"/>

                        <DataGridTextColumn Header="Cost"
                                            Binding="{Binding EffectiveCost, StringFormat=N2}"
                                            Width="80"
                                            ElementStyle="{StaticResource RightText}"/>

                        <DataGridTextColumn Header="Changed By"
                                            Binding="{Binding ChangedBy}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Reason"
                                            Binding="{Binding ChangeReason}"
                                            Width="220"/>

                        <DataGridTextColumn Header="Source"
                                            Binding="{Binding ChangeSource}"
                                            Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- DETAIL PANEL -->
        <Border Grid.Row="2"
                Grid.Column="2"
                Style="{StaticResource ClassicGroupBox}"
                Padding="0">

            <Grid>
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Visible"/>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#E6F2F2"
                        BorderBrush="#005555"
                        BorderThickness="0,0,0,1"
                        Padding="10">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="SELECTED PRICE CHANGE DETAIL"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#005555"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Close"
                                Command="{Binding CloseDetailsCommand}"
                                Style="{StaticResource ClassicBtn}"
                                Width="70"
                                Height="26"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Background="#F0F0F0">

                    <StackPanel Margin="10">

                        <TextBlock Text="Document"
                                   Style="{StaticResource HeaderLabel}"
                                   Foreground="#003366"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Change No:" Style="{StaticResource InlineLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedPriceChange.PriceChangeNo}" Style="{StaticResource ReadOnlyDetailTextBox}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Changed At:" Style="{StaticResource InlineLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPriceChange.ChangedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Style="{StaticResource ReadOnlyDetailTextBox}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Changed By:" Style="{StaticResource InlineLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPriceChange.ChangedBy}" Style="{StaticResource ReadOnlyDetailTextBox}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Source:" Style="{StaticResource InlineLabel}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedPriceChange.ChangeSource}" Style="{StaticResource ReadOnlyDetailTextBox}"/>
                        </Grid>

                        <TextBlock Text="Item Snapshot"
                                   Style="{StaticResource HeaderLabel}"
                                   Foreground="#003366"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Item Code:" Style="{StaticResource InlineLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedPriceChange.ItemCode}" Style="{StaticResource ReadOnlyDetailTextBox}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="SKU:" Style="{StaticResource InlineLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPriceChange.SkuCode}" Style="{StaticResource ReadOnlyDetailTextBox}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Barcode:" Style="{StaticResource InlineLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPriceChange.Barcode}" Style="{StaticResource ReadOnlyDetailTextBox}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Item:" Style="{StaticResource InlineLabel}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedPriceChange.ItemDescription}" Style="{StaticResource ReadOnlyDetailTextBox}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Variant:" Style="{StaticResource InlineLabel}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedPriceChange.VariantDescription}" Style="{StaticResource ReadOnlyDetailTextBox}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Batch:" Style="{StaticResource InlineLabel}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedPriceChange.BatchNo}" Style="{StaticResource ReadOnlyDetailTextBox}"/>
                        </Grid>

                        <TextBlock Text="Price Before / After"
                                   Style="{StaticResource HeaderLabel}"
                                   Foreground="#003366"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="1" Text="OLD" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#666666"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="NEW" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#005500"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Minimum:" Style="{StaticResource InlineLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPriceChange.OldMinimumPrice, StringFormat=N2}" Style="{StaticResource ReadOnlyDetailTextBox}" Margin="0,0,4,4"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SelectedPriceChange.NewMinimumPrice, StringFormat=N2}" Style="{StaticResource ReadOnlyDetailTextBox}" Margin="4,0,0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Retail:" Style="{StaticResource InlineLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPriceChange.OldRetailPrice, StringFormat=N2}" Style="{StaticResource ReadOnlyDetailTextBox}" Margin="0,0,4,4"/>
                            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding SelectedPriceChange.NewRetailPrice, StringFormat=N2}" Style="{StaticResource ReadOnlyDetailTextBox}" Margin="4,0,0,4"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Wholesale:" Style="{StaticResource InlineLabel}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedPriceChange.OldWholesalePrice, StringFormat=N2}" Style="{StaticResource ReadOnlyDetailTextBox}" Margin="0,0,4,4"/>
                            <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding SelectedPriceChange.NewWholesalePrice, StringFormat=N2}" Style="{StaticResource ReadOnlyDetailTextBox}" Margin="4,0,0,4"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Maximum:" Style="{StaticResource InlineLabel}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedPriceChange.OldMaximumPrice, StringFormat=N2}" Style="{StaticResource ReadOnlyDetailTextBox}" Margin="0,0,4,0"/>
                            <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding SelectedPriceChange.NewMaximumPrice, StringFormat=N2}" Style="{StaticResource ReadOnlyDetailTextBox}" Margin="4,0,0,0"/>
                        </Grid>

                        <TextBlock Text="Reason"
                                   Style="{StaticResource HeaderLabel}"
                                   Foreground="#003366"/>

                        <TextBox Text="{Binding SelectedPriceChange.ChangeReason}"
                                 Style="{StaticResource ReadOnlyDetailTextBox}"
                                 Height="55"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,6"/>

                        <TextBox Text="{Binding SelectedPriceChange.Remarks}"
                                 Style="{StaticResource ReadOnlyDetailTextBox}"
                                 Height="65"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- FOOTER SUMMARY -->
        <Border Grid.Row="4"
                Grid.ColumnSpan="3"
                Style="{StaticResource ClassicGroupBox}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Total Rows: " FontWeight="Bold" Foreground="#555555"/>
                    <TextBlock Text="{Binding TotalRows}" FontWeight="Bold" Foreground="#000000"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Master Changes: " FontWeight="Bold" Foreground="#003366"/>
                    <TextBlock Text="{Binding MasterChangeCount}" FontWeight="Bold" Foreground="#003366"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <TextBlock Text="Batch Changes: " FontWeight="Bold" Foreground="#005555"/>
                    <TextBlock Text="{Binding BatchChangeCount}" FontWeight="Bold" Foreground="#005555"/>
                </StackPanel>

                <StackPanel Grid.Column="6"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <TextBlock Text="Latest Change: "
                               FontWeight="Bold"
                               Foreground="#555555"/>

                    <TextBlock Text="{Binding LatestChangedText}"
                               FontWeight="Bold"
                               Foreground="#003366"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>