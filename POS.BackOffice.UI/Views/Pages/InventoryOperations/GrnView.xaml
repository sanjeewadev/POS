<UserControl x:Class="POS.BackOffice.UI.Views.Pages.InventoryOperations.GrnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="1400"
             Loaded="UserControl_Loaded"
             Background="#D4D0C8"
             FontFamily="Segoe UI"
             FontSize="12">

    <UserControl.Resources>

        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#CFE8FF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E5F3FF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>

        <Style TargetType="{x:Type TextBlock}" x:Key="HeaderLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="InlineLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="ClassicInput">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="Foreground" Value="#555555"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="Foreground" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type ComboBox}" x:Key="ClassicCombo">
            <Setter Property="Height" Value="25"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="{x:Type DatePicker}" x:Key="ClassicDate">
            <Setter Property="Height" Value="25"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="ClassicBtn">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="ActionBtn" BasedOn="{StaticResource ClassicBtn}">
            <Setter Property="Background" Value="#005555"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#003333"/>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="PostBtn" BasedOn="{StaticResource ClassicBtn}">
            <Setter Property="Background" Value="#005500"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#003300"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="{x:Type Border}" x:Key="ClassicGroupBox">
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}" x:Key="BaseCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CFE8FF"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type DataGridCell}" x:Key="FrozenCell" BasedOn="{StaticResource BaseCell}">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}" x:Key="EditableCell" BasedOn="{StaticResource BaseCell}">
            <Setter Property="Background" Value="#FFFFE0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}" x:Key="CostCell" BasedOn="{StaticResource BaseCell}">
            <Setter Property="Background" Value="#FFF7ED"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="RightText">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,6,0"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="CenterText">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="BoldText">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="GridQtyBox">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFE0"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="GridMoneyBox">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFE0"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. DOCUMENT HEADER -->
        <Border Grid.Row="0" Style="{StaticResource ClassicGroupBox}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="1. GOODS RECEIVED NOTE - DOCUMENT SETUP"
                               Style="{StaticResource HeaderLabel}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               Margin="15,0"
                               VerticalAlignment="Center"
                               Foreground="#555555"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <Border Grid.Column="2"
                            Background="#DEFF9A"
                            BorderBrush="#A0A0A0"
                            BorderThickness="1"
                            Padding="12,3">
                        <TextBlock Text="{Binding DocumentStatus}" FontWeight="Bold"/>
                    </Border>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="205"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Approved PO (optional)" Style="{StaticResource InlineLabel}"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding OpenPurchaseOrders}"
                                      SelectedItem="{Binding SelectedPO, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayText"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="DisplayText"
                                      IsEnabled="{Binding IsHeaderInputEnabled}"
                                      Style="{StaticResource ClassicCombo}"/>
                            <Button Grid.Column="2"
                                    Content="LOAD"
                                    Command="{Binding LoadPoCommand}"
                                    Style="{StaticResource ActionBtn}"
                                    Height="25"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Supplier *" Style="{StaticResource InlineLabel}"/>
                        <ComboBox Margin="0,4,0,0"
                                  ItemsSource="{Binding Suppliers}"
                                  SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                                  DisplayMemberPath="SupplierName"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="SupplierName"
                                  IsEnabled="{Binding IsSupplierSelectionEnabled}"
                                  Style="{StaticResource ClassicCombo}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Supplier Invoice No *" Style="{StaticResource InlineLabel}"/>
                        <TextBox Margin="0,4,0,0"
                                 Text="{Binding SupplierInvoiceNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsHeaderInputEnabled}"
                                 Background="#FFFFE0"
                                 FontWeight="Bold"
                                 Style="{StaticResource ClassicInput}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Invoice Date" Style="{StaticResource InlineLabel}"/>
                        <DatePicker Margin="0,4,0,0"
                                    SelectedDate="{Binding InvoiceDate, Mode=TwoWay}"
                                    IsEnabled="{Binding IsHeaderInputEnabled}"
                                    Style="{StaticResource ClassicDate}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="8">
                        <TextBlock Text="Received Date" Style="{StaticResource InlineLabel}"/>
                        <DatePicker Margin="0,4,0,0"
                                    SelectedDate="{Binding ReceivedDate, Mode=TwoWay}"
                                    IsEnabled="{Binding IsHeaderInputEnabled}"
                                    Style="{StaticResource ClassicDate}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="10">
                        <TextBlock Text="Due Date" Style="{StaticResource InlineLabel}"/>
                        <DatePicker Margin="0,4,0,0"
                                    SelectedDate="{Binding DueDate, Mode=TwoWay}"
                                    IsEnabled="{Binding IsHeaderInputEnabled}"
                                    Style="{StaticResource ClassicDate}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="12">
                        <TextBlock Text="Supplier Price Mode" Style="{StaticResource InlineLabel}"/>
                        <CheckBox Margin="0,7,0,0"
                                  Content="Prices include VAT"
                                  IsChecked="{Binding SupplierPricesIncludeVat, Mode=TwoWay}"
                                  IsEnabled="{Binding IsHeaderInputEnabled}"
                                  FontWeight="Bold"
                                  Foreground="#003366"/>
                        <TextBlock Text="{Binding SupplierPriceModeText}"
                                   FontSize="10"
                                   Foreground="#555555"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding SupplierVatStatusText}"
                                   Foreground="DarkRed"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Stock Items only. Services are excluded from PO, GRN and inventory receiving."
                                   Foreground="#555555"
                                   FontSize="10"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="CONFIRM"
                            Command="{Binding ConfirmHeaderCommand}"
                            Style="{StaticResource ActionBtn}"/>
                    <Button Grid.Column="3"
                            Content="RESET"
                            Command="{Binding ResetHeaderCommand}"
                            Style="{StaticResource ClassicBtn}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="535"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 2. ITEM MATRIX -->
            <Border Grid.Column="0"
                    Style="{StaticResource ClassicGroupBox}"
                    IsEnabled="{Binding IsEntryEnabled}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="2. STOCK ITEM / VARIANT ENTRY"
                               Style="{StaticResource HeaderLabel}"
                               Foreground="#005555"/>

                    <Grid Grid.Row="1" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Scan SKU/Barcode" Style="{StaticResource InlineLabel}"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding ScanBarcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}"
                                 Background="#FFFFE0"
                                 FontWeight="Bold">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddItemCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="4"
                                Content="ADD"
                                Command="{Binding AddItemCommand}"
                                Style="{StaticResource ActionBtn}"
                                Height="25"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Choose Stock Item" Style="{StaticResource InlineLabel}"/>
                            <ComboBox Margin="0,4,0,0"
                                      ItemsSource="{Binding AvailableItems}"
                                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                      DisplayMemberPath="ItemName"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="ItemName"
                                      Style="{StaticResource ClassicCombo}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Filter variants" Style="{StaticResource InlineLabel}"/>
                            <TextBox Margin="0,4,0,0"
                                     Text="{Binding MatrixFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ClassicInput}"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding ActiveMatrixVariants}"
                              SelectedItem="{Binding SelectedMatrixVariant, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              AlternatingRowBackground="#F7F7F7"
                              Background="White"
                              Foreground="Black"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Variant / SKU"
                                                Binding="{Binding DisplayName}"
                                                IsReadOnly="True"
                                                Width="180"
                                                CellStyle="{StaticResource FrozenCell}"/>
                            <DataGridTextColumn Header="Qty"
                                                Binding="{Binding ReceivedQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}"
                                                Width="65"
                                                CellStyle="{StaticResource EditableCell}"/>
                            <DataGridTextColumn Header="Unit Cost"
                                                Binding="{Binding UnitCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                Width="80"
                                                CellStyle="{StaticResource CostCell}"/>
                            <DataGridTemplateColumn Header="Expiry" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DatePicker SelectedDate="{Binding ExpiryDate, Mode=TwoWay}"
                                                    IsEnabled="{Binding RequiresExpiry}"
                                                    Height="23"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Tax"
                                                Binding="{Binding TaxCategoryDisplayText}"
                                                IsReadOnly="True"
                                                Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="4" Margin="0,7,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Bulk Qty" Style="{StaticResource InlineLabel}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding BulkMatrixQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ClassicInput}"
                                     HorizontalContentAlignment="Right"/>
                            <Button Grid.Column="2"
                                    Content="APPLY"
                                    Command="{Binding ApplyBulkMatrixQuantityCommand}"
                                    Style="{StaticResource ClassicBtn}"
                                    Height="25"/>
                            <TextBlock Grid.Column="4" Text="Bulk Cost" Style="{StaticResource InlineLabel}"/>
                            <TextBox Grid.Column="5"
                                     Text="{Binding BulkMatrixUnitCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ClassicInput}"
                                     HorizontalContentAlignment="Right"/>
                            <Button Grid.Column="6"
                                    Content="APPLY"
                                    Command="{Binding ApplyBulkMatrixUnitCostCommand}"
                                    Style="{StaticResource ClassicBtn}"
                                    Height="25"/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="155"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Add rows first, then preview retail and wholesale changes in the dialog."
                                       Foreground="#555555"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <Button Grid.Column="1"
                                    Content="ADD MATRIX ROWS"
                                    Command="{Binding AddMatrixCommand}"
                                    Style="{StaticResource ActionBtn}"/>
                            <Button Grid.Column="3"
                                    Content="BULK SELLING PRICES..."
                                    Command="{Binding OpenBulkSellingPriceDialogCommand}"
                                    Style="{StaticResource ClassicBtn}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. GRN LINES -->
            <Border Grid.Column="2" Style="{StaticResource ClassicGroupBox}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="3. GRN LINES, VAT AND PROPOSED SELLING PRICES"
                                   Style="{StaticResource HeaderLabel}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PriceUpdateSummaryText}"
                                   Margin="15,0"
                                   VerticalAlignment="Center"
                                   Foreground="#005555"
                                   FontWeight="SemiBold"/>
                        <Button Grid.Column="2"
                                Content="REMOVE SELECTED"
                                Command="{Binding RemoveLineCommand}"
                                CommandParameter="{Binding SelectedLine}"
                                Style="{StaticResource ClassicBtn}"
                                Height="25"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Bulk Discount" Style="{StaticResource InlineLabel}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding DiscountModes}"
                                  SelectedItem="{Binding BulkDiscountMode, Mode=TwoWay}"
                                  Style="{StaticResource ClassicCombo}"/>
                        <TextBox Grid.Column="3"
                                 Text="{Binding BulkDiscountValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}"
                                 HorizontalContentAlignment="Right"/>
                        <Button Grid.Column="4"
                                Content="APPLY DISC."
                                Command="{Binding ApplyBulkDiscountValueToLinesCommand}"
                                Style="{StaticResource ClassicBtn}"
                                Height="25"/>
                        <Button Grid.Column="6"
                                Content="SELLING PRICES..."
                                Command="{Binding OpenBulkSellingPriceDialogCommand}"
                                Style="{StaticResource ActionBtn}"
                                Height="25"/>
                        <Button Grid.Column="8"
                                Content="RESET PRICES"
                                Command="{Binding ResetProposedSellingPricesCommand}"
                                Style="{StaticResource ClassicBtn}"
                                Height="25"/>
                        <Button Grid.Column="10"
                                Content="REFRESH VAT PREVIEW"
                                Command="{Binding RefreshTaxPreviewCommand}"
                                Style="{StaticResource ClassicBtn}"
                                Height="25"
                                HorizontalAlignment="Right"/>
                    </Grid>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding GrnLines}"
                              SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F7F7F7"
                              Background="White"
                              Foreground="Black"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              FrozenColumnCount="2"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item / Variant"
                                                Binding="{Binding DisplayName}"
                                                IsReadOnly="True"
                                                Width="210"
                                                CellStyle="{StaticResource FrozenCell}"/>
                            <DataGridTextColumn Header="SKU"
                                                Binding="{Binding SkuCode}"
                                                IsReadOnly="True"
                                                Width="95"
                                                CellStyle="{StaticResource FrozenCell}"/>
                            <DataGridTextColumn Header="Qty"
                                                Binding="{Binding ReceivedQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}"
                                                Width="65"
                                                CellStyle="{StaticResource EditableCell}"/>
                            <DataGridTextColumn Header="Unit Cost"
                                                Binding="{Binding UnitCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                Width="80"
                                                CellStyle="{StaticResource CostCell}"/>
                            <DataGridTemplateColumn Header="Disc. Mode" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.DiscountModes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding LineDiscountMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Height="23"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Disc. Value"
                                                Binding="{Binding LineDiscountValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                Width="80"
                                                CellStyle="{StaticResource EditableCell}"/>
                            <DataGridTextColumn Header="Tax Category"
                                                Binding="{Binding TaxCategoryDisplayText}"
                                                IsReadOnly="True"
                                                Width="135"/>
                            <DataGridTextColumn Header="Taxable"
                                                Binding="{Binding TaxableAmount, StringFormat=N2}"
                                                IsReadOnly="True"
                                                Width="85"/>
                            <DataGridTextColumn Header="VAT"
                                                Binding="{Binding VatAmount, StringFormat=N2}"
                                                IsReadOnly="True"
                                                Width="75"/>
                            <DataGridTextColumn Header="Line Total"
                                                Binding="{Binding LineTotal, StringFormat=N2}"
                                                IsReadOnly="True"
                                                Width="90"/>
                            <DataGridTextColumn Header="Landed Cost"
                                                Binding="{Binding LandedCost, StringFormat=N2}"
                                                IsReadOnly="True"
                                                Width="90"/>
                            <DataGridTextColumn Header="Expiry"
                                                Binding="{Binding ExpiryDisplayText}"
                                                IsReadOnly="True"
                                                Width="90"/>
                            <DataGridTextColumn Header="Current Retail"
                                                Binding="{Binding CurrentRetailPrice, StringFormat=N2}"
                                                IsReadOnly="True"
                                                Width="95"/>
                            <DataGridTextColumn Header="New Retail"
                                                Binding="{Binding NewRetailPrice, StringFormat=N2}"
                                                IsReadOnly="True"
                                                Width="95"/>
                            <DataGridTextColumn Header="Current W/S"
                                                Binding="{Binding CurrentWholesalePrice, StringFormat=N2}"
                                                IsReadOnly="True"
                                                Width="95"/>
                            <DataGridTextColumn Header="New W/S"
                                                Binding="{Binding NewWholesalePrice, StringFormat=N2}"
                                                IsReadOnly="True"
                                                Width="95"/>
                            <DataGridTextColumn Header="Price Update"
                                                Binding="{Binding PriceUpdateText}"
                                                IsReadOnly="True"
                                                Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3"
                            Margin="0,6,0,0"
                            Padding="6"
                            Background="#E6F2F2"
                            BorderBrush="#A0A0A0"
                            BorderThickness="1">
                        <TextBlock Text="{Binding TaxPreviewStatus}"
                                   Foreground="#003366"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. TOTALS / POSTING -->
        <Border Grid.Row="4" Style="{StaticResource ClassicGroupBox}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="4. DOCUMENT ADJUSTMENTS" Style="{StaticResource HeaderLabel}"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Bill Discount (-)" Style="{StaticResource InlineLabel}" Foreground="DarkRed"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding GlobalBillDiscount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}"
                                 Background="#FEF2F2"
                                 HorizontalContentAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Freight (+)" Style="{StaticResource InlineLabel}" Foreground="#D97706"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding FreightAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}"
                                 Background="#FFF7ED"
                                 HorizontalContentAlignment="Right"/>
                    </Grid>
                    <TextBlock Margin="0,5,0,0"
                               Text="Freight VAT remains unclassified in this phase; freight is allocated into landed cost excluding item VAT."
                               Foreground="#555555"
                               FontSize="10"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Fill="#A0A0A0" Margin="4,0"/>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="VAT TREATMENT SUMMARY" Style="{StaticResource HeaderLabel}"/>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Standard rated"/>
                        <TextBlock Text="{Binding StandardRatedAmount, StringFormat=Rs. {0:N2}}" HorizontalAlignment="Right" FontWeight="Bold"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Zero rated"/>
                        <TextBlock Text="{Binding ZeroRatedAmount, StringFormat=Rs. {0:N2}}" HorizontalAlignment="Right" FontWeight="Bold"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Exempt"/>
                        <TextBlock Text="{Binding ExemptAmount, StringFormat=Rs. {0:N2}}" HorizontalAlignment="Right" FontWeight="Bold"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Out of scope"/>
                        <TextBlock Text="{Binding OutOfScopeAmount, StringFormat=Rs. {0:N2}}" HorizontalAlignment="Right" FontWeight="Bold"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Standard taxable base" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TaxableAmountTotal, StringFormat=Rs. {0:N2}}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#003366"/>
                    </Grid>
                </StackPanel>

                <Rectangle Grid.Column="3" Width="1" Fill="#A0A0A0" Margin="4,0"/>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="DOCUMENT TOTALS" Style="{StaticResource HeaderLabel}"/>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Subtotal"/>
                        <TextBlock Text="{Binding Subtotal, StringFormat=Rs. {0:N2}}" HorizontalAlignment="Right" FontWeight="Bold"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Discounts" Foreground="DarkRed"/>
                        <TextBlock Text="{Binding TotalDiscountAmount, StringFormat=- Rs. {0:N2}}" HorizontalAlignment="Right" Foreground="DarkRed" FontWeight="Bold"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="VAT"/>
                        <TextBlock Text="{Binding TotalVatAmount, StringFormat=Rs. {0:N2}}" HorizontalAlignment="Right" FontWeight="Bold"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Freight" Foreground="#D97706"/>
                        <TextBlock Text="{Binding FreightAmount, StringFormat=+ Rs. {0:N2}}" HorizontalAlignment="Right" Foreground="#D97706" FontWeight="Bold"/>
                    </Grid>
                    <Rectangle Height="1" Fill="#808080" Margin="0,2,0,3"/>
                    <Grid>
                        <TextBlock Text="NET PAYABLE" Foreground="#003366" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="{Binding NetPayable, StringFormat=Rs. {0:N2}}" HorizontalAlignment="Right" Foreground="#005500" FontSize="18" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>

                <Rectangle Grid.Column="5" Width="1" Fill="#A0A0A0" Margin="4,0"/>

                <Grid Grid.Column="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="REMARKS / POSTING" Style="{StaticResource HeaderLabel}"/>
                    <TextBox Grid.Row="1"
                             Text="{Binding Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Height="52"
                             Style="{StaticResource ClassicInput}"/>
                    <StackPanel Grid.Row="2"
                                Margin="0,7,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="CLEAR FORM"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource ClassicBtn}"
                                Width="105"
                                Height="34"
                                Margin="0,0,8,0"/>
                        <Button Content="POST GRN"
                                Command="{Binding PostGrnCommand}"
                                Style="{StaticResource PostBtn}"
                                Width="125"
                                Height="34"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
