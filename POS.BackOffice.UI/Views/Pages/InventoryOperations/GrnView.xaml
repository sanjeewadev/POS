<UserControl x:Class="POS.BackOffice.UI.Views.Pages.InventoryOperations.GrnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="1400"
             Loaded="UserControl_Loaded"
             Background="#D4D0C8"
             FontFamily="Segoe UI"
             FontSize="12">

    <UserControl.Resources>

        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#CFE8FF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E5F3FF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>

        <Style TargetType="{x:Type TextBlock}" x:Key="HeaderLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="InlineLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="ClassicInput">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="Foreground" Value="#555555"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="Foreground" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type ComboBox}" x:Key="ClassicCombo">
            <Setter Property="Height" Value="25"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="{x:Type DatePicker}" x:Key="ClassicDate">
            <Setter Property="Height" Value="25"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="ClassicBtn">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="ActionBtn" BasedOn="{StaticResource ClassicBtn}">
            <Setter Property="Background" Value="#005555"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#003333"/>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="PostBtn" BasedOn="{StaticResource ClassicBtn}">
            <Setter Property="Background" Value="#005500"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#003300"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="{x:Type Border}" x:Key="ClassicGroupBox">
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}" x:Key="BaseCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CFE8FF"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type DataGridCell}" x:Key="FrozenCell" BasedOn="{StaticResource BaseCell}">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}" x:Key="EditableCell" BasedOn="{StaticResource BaseCell}">
            <Setter Property="Background" Value="#FFFFE0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}" x:Key="CostCell" BasedOn="{StaticResource BaseCell}">
            <Setter Property="Background" Value="#FFF7ED"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="RightText">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,6,0"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="CenterText">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="BoldText">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="GridQtyBox">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFE0"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="GridMoneyBox">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFE0"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="570"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- HEADER SETUP -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="3"
                Style="{StaticResource ClassicGroupBox}">

            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="1. GOODS RECEIVED NOTE - SUPPLIER INVOICE SETUP"
                               Style="{StaticResource HeaderLabel}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               Foreground="#666666"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="15,0"
                               TextWrapping="Wrap"/>

                    <Border Grid.Column="2"
                            Background="#DEFF9A"
                            Padding="12,3"
                            BorderBrush="#A0A0A0"
                            BorderThickness="1">

                        <TextBlock Text="{Binding DocumentStatus}"
                                   Foreground="Black"
                                   FontWeight="Bold"/>
                    </Border>
                </Grid>

                <WrapPanel Orientation="Horizontal" Margin="0,5,0,0">

                    <Border Margin="0,0,18,5"
                            Background="#E6F2F2"
                            BorderBrush="#A0A0A0"
                            BorderThickness="1"
                            Padding="6">

                        <StackPanel>
                            <TextBlock Text="Link Approved PO"
                                       Style="{StaticResource InlineLabel}"
                                       Foreground="#005555"/>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="290"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="75"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding OpenPurchaseOrders}"
                                          SelectedItem="{Binding SelectedPO, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayText"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          TextSearch.TextPath="DisplayText"
                                          IsEnabled="{Binding IsHeaderInputEnabled}"
                                          Style="{StaticResource ClassicCombo}"
                                          ToolTip="Leave blank for Direct GRN."/>

                                <Button Grid.Column="2"
                                        Content="LOAD"
                                        Command="{Binding LoadPoCommand}"
                                        Style="{StaticResource ActionBtn}"
                                        Height="25"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,0,18,5">
                        <TextBlock Text="Supplier &amp; Supplier Invoice No *"
                                   Style="{StaticResource InlineLabel}"/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="145"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding Suppliers}"
                                      SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                                      DisplayMemberPath="SupplierName"
                                      IsEnabled="{Binding IsSupplierSelectionEnabled}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="SupplierName"
                                      Style="{StaticResource ClassicCombo}"/>

                            <TextBox Grid.Column="2"
                                     Text="{Binding SupplierInvoiceNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsHeaderInputEnabled}"
                                     Style="{StaticResource ClassicInput}"
                                     Background="#FFFFE0"
                                     FontWeight="Bold">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter"
                                                Command="{Binding ConfirmHeaderCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,0,18,5">
                        <TextBlock Text="Invoice / Received / Due Dates"
                                   Style="{StaticResource InlineLabel}"/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="112"/>
                            </Grid.ColumnDefinitions>

                            <DatePicker Grid.Column="0"
                                        SelectedDate="{Binding InvoiceDate, Mode=TwoWay}"
                                        IsEnabled="{Binding IsHeaderInputEnabled}"
                                        Style="{StaticResource ClassicDate}"/>

                            <DatePicker Grid.Column="2"
                                        SelectedDate="{Binding ReceivedDate, Mode=TwoWay}"
                                        IsEnabled="{Binding IsHeaderInputEnabled}"
                                        Style="{StaticResource ClassicDate}"/>

                            <DatePicker Grid.Column="4"
                                        SelectedDate="{Binding DueDate, Mode=TwoWay}"
                                        IsEnabled="{Binding IsHeaderInputEnabled}"
                                        Style="{StaticResource ClassicDate}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,5">
                        <TextBlock Text="Header Lock"
                                   Style="{StaticResource InlineLabel}"/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="CONFIRM"
                                    Command="{Binding ConfirmHeaderCommand}"
                                    Style="{StaticResource ActionBtn}"
                                    Height="25"/>

                            <Button Grid.Column="2"
                                    Content="RESET"
                                    Command="{Binding ResetHeaderCommand}"
                                    Style="{StaticResource ClassicBtn}"
                                    Height="25"/>
                        </Grid>
                    </StackPanel>
                </WrapPanel>

                <Border Background="#FFF7CC"
                        BorderBrush="#C9A227"
                        BorderThickness="1"
                        Padding="5"
                        Margin="0,2,0,0">

                    <StackPanel>
                        <TextBlock Text="Item search stays inactive until supplier and invoice number are confirmed. Batch number is generated by the system."
                                   Foreground="Black"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SupplierVatStatusText}"
                                   Foreground="DarkRed"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- LEFT SIDE: ITEM ENTRY -->
        <Border Grid.Row="2"
                Grid.Column="0"
                Style="{StaticResource ClassicGroupBox}"
                VerticalAlignment="Stretch"
                IsEnabled="{Binding IsEntryEnabled}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="2. ITEM ENTRY CONSOLE"
                           Style="{StaticResource HeaderLabel}"
                           Foreground="#005555"/>

                <Border Grid.Row="1"
                        Background="#334155"
                        Padding="8"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        Margin="0,0,0,8">

                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Barcode:"
                                       Foreground="#DEFF9A"
                                       Style="{StaticResource InlineLabel}"/>

                            <TextBox Grid.Column="1"
                                     Text="{Binding ScanBarcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="27"
                                     FontSize="13"
                                     FontWeight="Bold">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter"
                                                Command="{Binding AddItemCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Code:"
                                       Foreground="White"
                                       Style="{StaticResource InlineLabel}"/>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableItems}"
                                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                      DisplayMemberPath="ItemCode"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="ItemCode"
                                      Height="27"
                                      Margin="0,0,10,0"/>

                            <TextBlock Grid.Column="2"
                                       Text="Name:"
                                       Foreground="White"
                                       Style="{StaticResource InlineLabel}"/>

                            <ComboBox Grid.Column="3"
                                      ItemsSource="{Binding AvailableItems}"
                                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                      DisplayMemberPath="ItemName"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="ItemName"
                                      Height="27"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- MATRIX RAPID RECEIVING -->
                <Border Grid.Row="2"
                        Background="#F0F8FF"
                        BorderBrush="#005555"
                        BorderThickness="1"
                        Padding="8">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="185"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="MATRIX RAPID RECEIVING"
                                       FontWeight="Bold"
                                       Foreground="#003366"
                                       VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                     Text="{Binding MatrixFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="25"
                                     Padding="4,0"
                                     Background="White"
                                     BorderBrush="#A0A0A0"
                                     BorderThickness="1"/>
                        </Grid>

                        <!-- MATRIX BULK BAR -->
                        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="Qty:"
                                       Style="{StaticResource InlineLabel}"/>

                            <TextBox Text="{Binding BulkMatrixQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="58"
                                     Style="{StaticResource ClassicInput}"
                                     HorizontalContentAlignment="Center"
                                     FontWeight="Bold"
                                     Background="#FFFFE0"
                                     Margin="0,0,4,0"/>

                            <Button Content="Apl"
                                    Command="{Binding ApplyBulkMatrixQuantityCommand}"
                                    Style="{StaticResource ClassicBtn}"
                                    Height="25"
                                    Padding="8,0"
                                    Margin="0,0,6,0"/>

                            <TextBlock Text="Cost:"
                                       Style="{StaticResource InlineLabel}"/>

                            <TextBox Text="{Binding BulkMatrixUnitCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="68"
                                     Style="{StaticResource ClassicInput}"
                                     HorizontalContentAlignment="Right"
                                     Background="#FFF7ED"
                                     Margin="0,0,4,0"/>

                            <Button Content="Apl"
                                    Command="{Binding ApplyBulkMatrixUnitCostCommand}"
                                    Style="{StaticResource ClassicBtn}"
                                    Height="25"
                                    Padding="8,0"
                                    Margin="0,0,6,0"/>

                            <TextBlock Text="Sell P.:"
                                       Style="{StaticResource InlineLabel}"/>

                            <TextBox Text="{Binding BulkMatrixSellingPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="68"
                                     Style="{StaticResource ClassicInput}"
                                     HorizontalContentAlignment="Right"
                                     Background="#E8F5E9"
                                     Margin="0,0,4,0"/>

                            <Button Content="Apl"
                                    Command="{Binding ApplyBulkMatrixSellingPriceCommand}"
                                    Style="{StaticResource ClassicBtn}"
                                    Height="25"
                                    Padding="8,0"
                                    Margin="0,0,6,0"/>

                            <CheckBox Content="VAT all?"
                                      IsChecked="{Binding BulkMatrixVatIncluded, Mode=TwoWay}"
                                      IsEnabled="{Binding IsVatAllowed}"
                                      VerticalAlignment="Center"
                                      FontWeight="SemiBold"
                                      ToolTip="Disabled when supplier is not VAT registered."/>
                        </WrapPanel>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding ActiveMatrixVariants}"
                                  SelectedItem="{Binding SelectedMatrixVariant, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="False"
                                  HeadersVisibility="Column"
                                  Background="White"
                                  BorderBrush="#A0A0A0"
                                  BorderThickness="1"
                                  RowHeight="30"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="#E0E0E0"
                                  VerticalGridLinesBrush="#E0E0E0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  FrozenColumnCount="1"
                                  SelectionMode="Single">

                            <DataGrid.Resources>
                                <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource BaseCell}"/>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Product"
                                                    Binding="{Binding DisplayName, Mode=OneWay}"
                                                    Width="170"
                                                    IsReadOnly="True"
                                                    CellStyle="{StaticResource FrozenCell}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BoldText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="SKU"
                                                    Binding="{Binding SkuCode, Mode=OneWay}"
                                                    Width="85"
                                                    IsReadOnly="True"/>

                                <DataGridTextColumn Header="Track"
                                                    Binding="{Binding TrackingText, Mode=OneWay}"
                                                    Width="70"
                                                    IsReadOnly="True"/>

                                <DataGridTemplateColumn Header="Rec'd Qty" Width="76">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding ReceivedQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource GridQtyBox}"
                                                     Margin="2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Recv Cost" Width="82">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding UnitCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource GridMoneyBox}"
                                                     Background="#FFF7ED"
                                                     Margin="2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Sell Price" Width="82">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding NewRetailPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource GridMoneyBox}"
                                                     Background="#E8F5E9"
                                                     Margin="2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Expiry" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DatePicker SelectedDate="{Binding ExpiryDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        IsEnabled="{Binding IsExpiryEnabled}"
                                                        Height="25"
                                                        Margin="2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="VAT Inc." Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsVatIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding DataContext.IsVatAllowed, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      ToolTip="Disabled when supplier is not VAT registered."/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Total"
                                                    Binding="{Binding LineTotal, StringFormat=N2}"
                                                    Width="85"
                                                    IsReadOnly="True"
                                                    ElementStyle="{StaticResource RightText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Button Grid.Row="3"
                        Content="ADD ACTIVE MATRIX TO GRN"
                        Command="{Binding AddMatrixCommand}"
                        Style="{StaticResource ActionBtn}"
                        Background="#0066CC"
                        BorderBrush="#004C99"
                        Height="38"
                        Margin="0,8,0,0"
                        FontSize="13"/>
            </Grid>
        </Border>

        <!-- RIGHT SIDE: GRN CART -->
        <Grid Grid.Row="2"
              Grid.Column="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- GRN NUMBER BAR -->
            <Border Grid.Row="0"
                    Background="#003366"
                    Padding="10"
                    BorderBrush="#002244"
                    BorderThickness="1">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="GRN NO:"
                                   Foreground="#A0C0E0"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,0,10,0"/>

                        <TextBlock Text="[ AUTO GENERATED ON POST ]"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="Posting updates inventory, stock buckets/batches, supplier ledger, and closes linked PO"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="#DEFF9A"
                               FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <!-- ROW ACTIONS -->
            <Border Grid.Row="1"
                    Background="#E5E5E5"
                    Padding="7"
                    BorderBrush="#A0A0A0"
                    BorderThickness="1,0,1,0">

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Selected Row Actions:"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="#666666"
                               Margin="0,0,10,0"/>

                    <Button Content="Remove Item"
                            Command="{Binding RemoveLineCommand}"
                            CommandParameter="{Binding SelectedLine}"
                            Style="{StaticResource ClassicBtn}"
                            Foreground="DarkRed"
                            Height="26"/>

                    <TextBlock Text="Bulk controls below apply only discount type/value to current GRN rows."
                               VerticalAlignment="Center"
                               Foreground="#666666"
                               FontStyle="Italic"
                               Margin="20,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- SMALL BULK TOOLBAR ABOVE MAIN TABLE -->
            <Border Grid.Row="2"
                    Background="#F0F0F0"
                    Padding="6"
                    BorderBrush="#A0A0A0"
                    BorderThickness="1,0,1,1">

                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Disc Type:"
                               Style="{StaticResource InlineLabel}"/>

                    <ComboBox ItemsSource="{Binding DiscountModes}"
                              SelectedItem="{Binding BulkDiscountMode, Mode=TwoWay}"
                              Width="85"
                              Style="{StaticResource ClassicCombo}"
                              Margin="0,0,5,0"/>

                    <Button Content="Apply Type"
                            Command="{Binding ApplyBulkDiscountModeToLinesCommand}"
                            Style="{StaticResource ClassicBtn}"
                            Height="25"
                            Margin="0,0,12,0"/>

                    <TextBlock Text="Disc Value:"
                               Style="{StaticResource InlineLabel}"/>

                    <TextBox Text="{Binding BulkDiscountValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="75"
                             Style="{StaticResource ClassicInput}"
                             HorizontalContentAlignment="Right"
                             Background="#FEF2F2"
                             Margin="0,0,5,0"/>

                    <Button Content="Apply Value"
                            Command="{Binding ApplyBulkDiscountValueToLinesCommand}"
                            Style="{StaticResource ClassicBtn}"
                            Height="25"/>
                </WrapPanel>
            </Border>

            <!-- GRN LINES -->
            <DataGrid Grid.Row="3"
                      x:Name="dgGrnLines"
                      ItemsSource="{Binding GrnLines}"
                      SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="All"
                      IsReadOnly="False"
                      HorizontalGridLinesBrush="#C0C0C0"
                      VerticalGridLinesBrush="#D0D0D0"
                      RowHeight="31"
                      HeadersVisibility="Column"
                      Background="White"
                      BorderBrush="#A0A0A0"
                      BorderThickness="1"
                      SelectionMode="Single"
                      AlternatingRowBackground="#F9F9F9"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                <DataGrid.Resources>
                    <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource BaseCell}"/>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code"
                                        Binding="{Binding ItemCode, Mode=OneWay}"
                                        Width="80"
                                        IsReadOnly="True"
                                        CellStyle="{StaticResource FrozenCell}"/>

                    <DataGridTextColumn Header="SKU"
                                        Binding="{Binding SkuCode, Mode=OneWay}"
                                        Width="105"
                                        IsReadOnly="True"
                                        CellStyle="{StaticResource FrozenCell}"/>

                    <DataGridTextColumn Header="Description"
                                        Binding="{Binding DisplayName, Mode=OneWay}"
                                        Width="240"
                                        IsReadOnly="True"
                                        CellStyle="{StaticResource FrozenCell}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BoldText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Tracking"
                                        Binding="{Binding TrackingText, Mode=OneWay}"
                                        Width="95"
                                        IsReadOnly="True"
                                        CellStyle="{StaticResource FrozenCell}"/>

                    <DataGridTemplateColumn Header="Expiry"
                                            Width="120"
                                            CellStyle="{StaticResource EditableCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding ExpiryDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding IsExpiryEnabled}"
                                            Height="25"
                                            Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Expiry Req."
                                        Binding="{Binding ExpiryRequirementText, Mode=OneWay}"
                                        Width="95"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CenterText}"/>

                    <DataGridTextColumn Header="PO Qty"
                                        Binding="{Binding OrderedQty, Mode=OneWay, StringFormat={}{0:0.###}}"
                                        Width="75"
                                        IsReadOnly="True"
                                        CellStyle="{StaticResource FrozenCell}"
                                        ElementStyle="{StaticResource CenterText}"/>

                    <DataGridTemplateColumn Header="Rec'd"
                                            Width="78"
                                            CellStyle="{StaticResource EditableCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ReceivedQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource GridQtyBox}"
                                         Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Unit Cost"
                                            Width="90"
                                            CellStyle="{StaticResource EditableCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding UnitCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource GridMoneyBox}"
                                         Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Disc Type"
                                            Width="85"
                                            CellStyle="{StaticResource EditableCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.DiscountModes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding LineDiscountMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Height="25"
                                          Background="#FFFFE0"
                                          BorderBrush="#808080"
                                          BorderThickness="1"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Disc Val"
                                            Width="80"
                                            CellStyle="{StaticResource EditableCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding LineDiscountValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource GridMoneyBox}"
                                         Foreground="DarkRed"
                                         Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Disc Amt"
                                        Binding="{Binding LineDiscount, Mode=OneWay, StringFormat=N2}"
                                        Width="80"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource RightText}"/>

                    <DataGridTemplateColumn Header="VAT %"
                                            Width="65"
                                            CellStyle="{StaticResource EditableCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding VatRatePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding DataContext.IsVatAllowed, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Style="{StaticResource GridMoneyBox}"
                                         Margin="2"
                                         ToolTip="Disabled when supplier is not VAT registered."/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="VAT Inc." Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsVatIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding DataContext.IsVatAllowed, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ToolTip="Disabled when supplier is not VAT registered."/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="VAT Amt"
                                        Binding="{Binding VatAmount, Mode=OneWay, StringFormat=N2}"
                                        Width="80"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource RightText}"/>

                    <DataGridTextColumn Header="Landed Cost"
                                        Binding="{Binding LandedCost, Mode=OneWay, StringFormat=N2}"
                                        Width="95"
                                        IsReadOnly="True"
                                        CellStyle="{StaticResource CostCell}"
                                        ElementStyle="{StaticResource RightText}"/>

                    <DataGridTextColumn Header="Line Total"
                                        Binding="{Binding LineTotal, Mode=OneWay, StringFormat=N2}"
                                        Width="100"
                                        IsReadOnly="True"
                                        CellStyle="{StaticResource FrozenCell}"
                                        ElementStyle="{StaticResource RightText}"/>

                    <DataGridTextColumn Header="Cur Retail"
                                        Binding="{Binding CurrentRetailPrice, Mode=OneWay, StringFormat=N2}"
                                        Width="85"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource RightText}"/>

                    <DataGridTemplateColumn Header="New Retail" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding NewRetailPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource GridMoneyBox}"
                                         Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Retail %" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding RetailMarkupPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource GridMoneyBox}"
                                         Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Cur W/S"
                                        Binding="{Binding CurrentWholesalePrice, Mode=OneWay, StringFormat=N2}"
                                        Width="85"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource RightText}"/>

                    <DataGridTemplateColumn Header="New W/S" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding NewWholesalePrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource GridMoneyBox}"
                                         Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="W/S %" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding WholesaleMarkupPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource GridMoneyBox}"
                                         Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="New Min" Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding NewMinimumPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource GridMoneyBox}"
                                         Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="New Max" Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding NewMaximumPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource GridMoneyBox}"
                                         Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- FOOTER -->
            <Border Grid.Row="4"
                    Background="#D4D0C8"
                    BorderBrush="#A0A0A0"
                    BorderThickness="1"
                    Margin="0,5,0,0"
                    Padding="8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="210"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">

                        <TextBlock Text="GLOBAL MODIFIERS"
                                   FontWeight="Bold"
                                   Foreground="#003366"
                                   Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Bill Disc (-)"
                                       Style="{StaticResource InlineLabel}"
                                       Foreground="DarkRed"/>

                            <TextBox Grid.Column="1"
                                     Text="{Binding GlobalBillDiscount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ClassicInput}"
                                     HorizontalContentAlignment="Right"
                                     Background="#FEF2F2"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Freight (+)"
                                       Style="{StaticResource InlineLabel}"
                                       Foreground="#D97706"/>

                            <TextBox Grid.Column="1"
                                     Text="{Binding FreightAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ClassicInput}"
                                     HorizontalContentAlignment="Right"
                                     Background="#FFF7ED"/>
                        </Grid>
                    </StackPanel>

                    <Rectangle Grid.Column="1"
                               Width="1"
                               Fill="#A0A0A0"
                               Margin="7,0"/>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center">

                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="SUBTOTAL:"
                                       Foreground="#555555"
                                       FontSize="12"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding Subtotal, StringFormat=Rs. {0:N2}}"
                                       HorizontalAlignment="Right"
                                       FontSize="12"
                                       FontWeight="Bold"/>
                        </Grid>

                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="DISCOUNTS:"
                                       Foreground="DarkRed"
                                       FontSize="12"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding TotalDiscountAmount, StringFormat=- Rs. {0:N2}}"
                                       HorizontalAlignment="Right"
                                       Foreground="DarkRed"
                                       FontSize="12"
                                       FontWeight="Bold"/>
                        </Grid>

                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="VAT:"
                                       Foreground="#555555"
                                       FontSize="12"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding TotalVatAmount, StringFormat=+ Rs. {0:N2}}"
                                       HorizontalAlignment="Right"
                                       FontSize="12"
                                       FontWeight="Bold"/>
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="FREIGHT:"
                                       Foreground="#D97706"
                                       FontSize="12"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding FreightAmount, StringFormat=+ Rs. {0:N2}}"
                                       HorizontalAlignment="Right"
                                       Foreground="#D97706"
                                       FontSize="12"
                                       FontWeight="Bold"/>
                        </Grid>

                        <Rectangle Height="2"
                                   Fill="#333333"
                                   Margin="0,0,0,5"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="NET PAYABLE:"
                                           Foreground="#003366"
                                           FontSize="13"
                                           FontWeight="Bold"/>

                                <TextBlock Text="{Binding NetPayable, StringFormat=Rs. {0:N2}}"
                                           Foreground="#005500"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Rectangle Grid.Column="3"
                               Width="1"
                               Fill="#A0A0A0"
                               Margin="7,0"/>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Remarks / Internal Notes:"
                                   Style="{StaticResource InlineLabel}"
                                   Margin="0,0,0,4"/>

                        <TextBox Text="{Binding Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="62"
                                 Style="{StaticResource ClassicInput}"/>

                        <StackPanel Margin="0,10,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom">

                            <Button Content="Clear Form"
                                    Command="{Binding ClearCommand}"
                                    Style="{StaticResource ClassicBtn}"
                                    Width="95"
                                    Height="35"
                                    Margin="0,0,10,0"/>

                            <Button Content="POST GRN"
                                    Command="{Binding PostGrnCommand}"
                                    Style="{StaticResource PostBtn}"
                                    Width="115"
                                    Height="35"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>