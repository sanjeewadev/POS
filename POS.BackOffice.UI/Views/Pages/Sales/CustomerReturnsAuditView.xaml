<UserControl x:Class="POS.BackOffice.UI.Views.Pages.Sales.CustomerReturnsAuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             FontFamily="Segoe UI" FontSize="12">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="SelectedCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource LightSelectionBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompactButton" TargetType="Button">
            <Setter Property="Height" Value="27"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/><Setter Property="Background" Value="{DynamicResource ButtonDefaultBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ActionBackgroundBrush}" Padding="9">
            <TextBlock Text="CUSTOMER RETURN HISTORY" Foreground="White" FontSize="15" FontWeight="Bold"/>
        </Border>

        <Border Grid.Row="1" Margin="0,6,0,6" Padding="7" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <DatePicker SelectedDate="{Binding StartDate}" Width="120" Height="25"/>
                <TextBlock Text="To" VerticalAlignment="Center" Margin="10,0,4,0"/>
                <DatePicker SelectedDate="{Binding EndDate}" Width="120" Height="25"/>
                <TextBlock Text="Search" VerticalAlignment="Center" Margin="10,0,4,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="230" Height="25" Padding="4,2"/>
                <Button Content="Load" Command="{Binding LoadCommand}" Style="{StaticResource CompactButton}"/>
                <Button Content="Reset" Command="{Binding ResetCommand}" Style="{StaticResource CompactButton}"/>
                <Button Content="Credit Note Preview / Print" Command="{Binding PreviewCreditNoteCommand}" Style="{StaticResource CompactButton}"/>
                <Button Content="Save Credit Note PDF" Command="{Binding ExportCreditNotePdfCommand}" Style="{StaticResource CompactButton}"/>
            </WrapPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Returns}" SelectedItem="{Binding SelectedReturn}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="25"
                  AlternatingRowBackground="{DynamicResource DataGridAlternatingRow}" CellStyle="{StaticResource SelectedCellStyle}"
                  BorderBrush="{DynamicResource BorderBrush}" GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Credit Note" Binding="{Binding CreditNoteNo}" Width="125"/>
                <DataGridTextColumn Header="Original Invoice" Binding="{Binding OriginalInvoiceNo}" Width="125"/>
                <DataGridTextColumn Header="Return Date" Binding="{Binding ReturnDate, StringFormat=yyyy-MM-dd HH:mm}" Width="135"/>
                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" MinWidth="150"/>
                <DataGridTextColumn Header="Cashier" Binding="{Binding CashierName}" Width="115"/>
                <DataGridTextColumn Header="Terminal" Binding="{Binding TerminalNo}" Width="75"/>
                <DataGridTextColumn Header="Authorized By" Binding="{Binding AuthorizedBy}" Width="110"/>
                <DataGridTextColumn Header="Refund Method" Binding="{Binding RefundMethod}" Width="105"/>
                <DataGridTextColumn Header="Taxable" Binding="{Binding TaxableAmountTotal, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn Header="VAT" Binding="{Binding TotalVatAmount, StringFormat=N2}" Width="85"/>
                <DataGridTextColumn Header="Refund" Binding="{Binding TotalRefundAmount, StringFormat=N2}" Width="95"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Margin="0,6,0,0" Padding="6" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" Margin="0,0,0,5">
                    <TextBlock Text="Customer:" FontWeight="Bold"/><TextBlock Text="{Binding SelectedDetails.CustomerName}" Margin="4,0,18,0"/>
                    <TextBlock Text="Account Credit:" FontWeight="Bold"/><TextBlock Text="{Binding SelectedDetails.AccountCreditAmount, StringFormat=N2}" Margin="4,0,18,0"/>
                    <TextBlock Text="Voucher:" FontWeight="Bold"/><TextBlock Text="{Binding SelectedDetails.GiftVoucherRefundAmount, StringFormat=N2}" Margin="4,0,18,0"/>
                    <TextBlock Text="Cash:" FontWeight="Bold"/><TextBlock Text="{Binding SelectedDetails.CashRefundAmount, StringFormat=N2}" Margin="4,0,18,0"/>
                    <TextBlock Text="Tax Snapshot:" FontWeight="Bold"/><TextBlock Text="{Binding SelectedDetails.TaxSnapshotStatus}" Margin="4,0,0,0"/>
                </WrapPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedDetails.Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          RowHeight="24" CellStyle="{StaticResource SelectedCellStyle}" GridLinesVisibility="All">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding ItemCode}" Width="100"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding ItemDescription}" Width="*" MinWidth="180"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding ItemType}" Width="80"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding QuantityReturned, StringFormat={}{0:#,##0.###}}" Width="70"/>
                        <DataGridTextColumn Header="Unit Refund" Binding="{Binding RefundValue, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="Refund" Binding="{Binding LineTotalRefund, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="Tax" Binding="{Binding TaxCategoryCode}" Width="85"/>
                        <DataGridTextColumn Header="VAT" Binding="{Binding VatAmount, StringFormat=N2}" Width="75"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding ReturnReason}" Width="160"/>
                        <DataGridTextColumn Header="Inventory" Binding="{Binding InventoryAction}" Width="115"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="2,5,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="No customer returns match the selected filters." Foreground="{DynamicResource SecondaryTextBrush}" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
            <ProgressBar Grid.Column="1" Width="120" Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>
