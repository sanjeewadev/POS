<UserControl x:Class="POS.BackOffice.UI.Views.Pages.Purchasing.PurchaseOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:POS.BackOffice.UI.Views.Pages.Purchasing"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="1400"
             Loaded="UserControl_Loaded"
             Background="#D4D0C8"
             FontFamily="Segoe UI"
             FontSize="12">

    <UserControl.Resources>

        <local:MoqColorConverter x:Key="MoqColorConverter"/>

        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#CFE8FF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E5F3FF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>

        <Style TargetType="{x:Type TextBlock}" x:Key="HeaderLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="InlineLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="ClassicInput">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="Foreground" Value="#555555"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="Foreground" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type ComboBox}" x:Key="ClassicCombo">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="{x:Type DatePicker}" x:Key="ClassicDate">
            <Setter Property="Height" Value="24"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="ClassicBtn">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CCCCCC"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="ActionBtn" BasedOn="{StaticResource ClassicBtn}">
            <Setter Property="Background" Value="#005555"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#003333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007777"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="SaveBtn" BasedOn="{StaticResource ClassicBtn}">
            <Setter Property="Background" Value="#005500"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#003300"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007700"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Border}" x:Key="ClassicGroupBox">
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}" x:Key="BaseCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CFE8FF"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type DataGridCell}" x:Key="FrozenCell" BasedOn="{StaticResource BaseCell}">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}" x:Key="EditableCell" BasedOn="{StaticResource BaseCell}">
            <Setter Property="Background" Value="#FFFFE0"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}" x:Key="CostCell" BasedOn="{StaticResource BaseCell}">
            <Setter Property="Background" Value="#FFF7ED"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="RightText">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,6,0"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="CenterText">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="GridQtyBox">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFE0"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="GridMoneyBox">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFE0"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="550"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- HEADER SETUP -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="3"
                Style="{StaticResource ClassicGroupBox}">

            <StackPanel>
                <TextBlock Text="1. PURCHASE ORDER SETUP"
                           Style="{StaticResource HeaderLabel}"/>

                <WrapPanel Orientation="Horizontal" Margin="0,3,0,0">

                    <StackPanel Margin="0,0,24,3">
                        <TextBlock Text="Supplier &amp; Code *"
                                   Style="{StaticResource InlineLabel}"/>

                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding Suppliers}"
                                      SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                                      DisplayMemberPath="SupplierName"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="SupplierName"
                                      Style="{StaticResource ClassicCombo}"/>

                            <TextBox Grid.Column="2"
                                     Text="{Binding SupplierCode, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Style="{StaticResource ClassicInput}"
                                     FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,0,24,3">
                        <TextBlock Text="Payment Terms"
                                   Style="{StaticResource InlineLabel}"/>

                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      SelectedValue="{Binding SelectedTerms, Mode=TwoWay}"
                                      SelectedValuePath="Content"
                                      Style="{StaticResource ClassicCombo}">
                                <ComboBoxItem Content="Credit"/>
                                <ComboBoxItem Content="Cash on Delivery"/>
                                <ComboBoxItem Content="Advance Payment"/>
                            </ComboBox>

                            <TextBox Grid.Column="2"
                                     Text="{Binding CreditDaysInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                     Style="{StaticResource ClassicInput}"
                                     HorizontalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,0,24,3">
                        <TextBlock Text="Order &amp; Expected Delivery"
                                   Style="{StaticResource InlineLabel}"/>

                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="128"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="128"/>
                            </Grid.ColumnDefinitions>

                            <DatePicker Grid.Column="0"
                                        SelectedDate="{Binding OrderDate, Mode=TwoWay}"
                                        Style="{StaticResource ClassicDate}"/>

                            <DatePicker Grid.Column="2"
                                        SelectedDate="{Binding ExpectedDate, Mode=TwoWay}"
                                        Style="{StaticResource ClassicDate}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,0,24,3">
                        <TextBlock Text="Requisitioner"
                                   Style="{StaticResource InlineLabel}"/>

                        <TextBox Text="{Binding CurrentUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}"
                                 Width="140"
                                 Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,3">
                        <TextBlock Text="Status"
                                   Style="{StaticResource InlineLabel}"/>

                        <TextBox Text="{Binding StatusMessage, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Style="{StaticResource ClassicInput}"
                                 Width="290"
                                 Margin="0,3,0,0"
                                 Foreground="#003366"
                                 FontWeight="SemiBold"/>
                    </StackPanel>

                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- LEFT SIDE: ITEM ENTRY -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Style="{StaticResource ClassicGroupBox}"
                VerticalAlignment="Stretch"
                IsEnabled="{Binding IsEntryEnabled}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="2. ITEM ENTRY CONSOLE"
                           Style="{StaticResource HeaderLabel}"
                           Foreground="#005555"
                           Margin="0,0,0,5"/>

                <!-- BARCODE / ITEM SEARCH -->
                <Border Grid.Row="1"
                        Background="#334155"
                        Padding="8"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        Margin="0,0,0,8">

                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Barcode/SKU:"
                                       Foreground="#DEFF9A"
                                       Style="{StaticResource InlineLabel}"/>

                            <TextBox Grid.Column="1"
                                     Text="{Binding ScanBarcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26"
                                     FontSize="13"
                                     FontWeight="Bold"
                                     ToolTip="Scan barcode or type SKU and press Enter.">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter"
                                                Command="{Binding AddItemCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Code:"
                                       Foreground="White"
                                       Style="{StaticResource InlineLabel}"/>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableItems}"
                                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                      DisplayMemberPath="ItemCode"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="ItemCode"
                                      Height="26"
                                      Margin="0,0,10,0"/>

                            <TextBlock Grid.Column="2"
                                       Text="Name:"
                                       Foreground="White"
                                       Style="{StaticResource InlineLabel}"/>

                            <ComboBox Grid.Column="3"
                                      ItemsSource="{Binding AvailableItems}"
                                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                      DisplayMemberPath="ItemName"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="ItemName"
                                      Height="26"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- MATRIX ENTRY -->
                <Border Grid.Row="2"
                        Background="#F0F8FF"
                        BorderBrush="#005555"
                        BorderThickness="1"
                        Padding="8">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="MATRIX RAPID ENTRY"
                                       FontWeight="Bold"
                                       Foreground="#003366"
                                       VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                     Text="{Binding MatrixFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="180"
                                     Height="24"
                                     Padding="4,0"
                                     Background="White"
                                     BorderBrush="#A0A0A0"
                                     BorderThickness="1"
                                     ToolTip="Search loaded variants by attributes, barcode, or supplier item code."/>
                        </Grid>

                        <!-- MATRIX BULK BAR -->
                        <WrapPanel Grid.Row="1" Margin="0,0,0,8">

                            <TextBlock Text="Qty:"
                                       Style="{StaticResource InlineLabel}"/>

                            <TextBox Text="{Binding BulkMatrixQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="65"
                                     Style="{StaticResource ClassicInput}"
                                     HorizontalContentAlignment="Center"
                                     Background="#FFFFE0"
                                     FontWeight="Bold"
                                     Margin="0,0,5,0"/>

                            <Button Content="Apply Qty"
                                    Command="{Binding ApplyBulkMatrixQuantityCommand}"
                                    Style="{StaticResource ClassicBtn}"
                                    Height="24"
                                    Padding="8,0"
                                    Margin="0,0,10,0"/>

                            <TextBlock Text="Cost:"
                                       Style="{StaticResource InlineLabel}"/>

                            <TextBox Text="{Binding BulkMatrixExpectedCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="70"
                                     Style="{StaticResource ClassicInput}"
                                     HorizontalContentAlignment="Right"
                                     Background="#FFF7ED"
                                     FontWeight="Bold"
                                     Margin="0,0,5,0"/>

                            <Button Content="Apply Cost"
                                    Command="{Binding ApplyBulkMatrixExpectedCostCommand}"
                                    Style="{StaticResource ClassicBtn}"
                                    Height="24"
                                    Padding="8,0"
                                    Margin="0,0,10,0"/>

                            <CheckBox Content="VAT Included"
                                      IsChecked="{Binding BulkMatrixVatIncluded, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      FontWeight="SemiBold"/>
                        </WrapPanel>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding ActiveMatrixVariants}"
                                  SelectedItem="{Binding SelectedMatrixVariant, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="False"
                                  HeadersVisibility="Column"
                                  Background="White"
                                  BorderBrush="#A0A0A0"
                                  BorderThickness="1"
                                  RowHeight="28"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="#E0E0E0"
                                  VerticalGridLinesBrush="#E0E0E0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  FrozenColumnCount="1"
                                  SelectionMode="Single">

                            <DataGrid.Resources>
                                <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource BaseCell}"/>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Product"
                                                    Binding="{Binding DisplayName, Mode=OneWay}"
                                                    Width="200"
                                                    IsReadOnly="True"
                                                    CellStyle="{StaticResource FrozenCell}"/>

                                <DataGridTextColumn Header="SKU"
                                                    Binding="{Binding SkuCode, Mode=OneWay}"
                                                    Width="90"
                                                    IsReadOnly="True"/>

                                <DataGridTemplateColumn Header="Qty" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding OrderQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextAlignment="Center"
                                                     FontWeight="Bold"
                                                     BorderThickness="0"
                                                     ToolTip="{Binding Moq, StringFormat=Minimum Order Qty: {0}}">
                                                <TextBox.Background>
                                                    <MultiBinding Converter="{StaticResource MoqColorConverter}">
                                                        <Binding Path="OrderQty"/>
                                                        <Binding Path="Moq"/>
                                                    </MultiBinding>
                                                </TextBox.Background>
                                            </TextBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Cost Rs." Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding ExpectedCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource GridMoneyBox}"
                                                     Background="#FFF7ED"
                                                     BorderThickness="0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridCheckBoxColumn Header="VAT Inc."
                                                        Binding="{Binding IsVatIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="75"/>

                                <DataGridTextColumn Header="Total"
                                                    Binding="{Binding LineTotal, Mode=OneWay, StringFormat=N2}"
                                                    Width="90"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource RightText}">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Button Grid.Row="3"
                        Content="ADD ACTIVE MATRIX TO PO"
                        Command="{Binding AddMatrixCommand}"
                        Style="{StaticResource ActionBtn}"
                        Background="#0066CC"
                        BorderBrush="#004C99"
                        Height="36"
                        Margin="0,8,0,0"
                        FontSize="13"/>
            </Grid>
        </Border>

        <!-- RIGHT SIDE: PO CART -->
        <Grid Grid.Row="1"
              Grid.Column="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- PO NUMBER BAR -->
            <Border Grid.Row="0"
                    Background="#003366"
                    Padding="10"
                    BorderBrush="#002244"
                    BorderThickness="1">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="PO NO:"
                                   Foreground="#A0C0E0"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,0,10,0"/>

                        <TextBlock Text="[ AUTO GENERATED ON SAVE ]"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="Approved supplier items only"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="#DEFF9A"
                               FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <!-- ROW ACTIONS -->
            <Border Grid.Row="1"
                    Background="#E5E5E5"
                    Padding="7"
                    BorderBrush="#A0A0A0"
                    BorderThickness="1,0,1,0">

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Selected Row Actions:"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="#666666"
                               Margin="0,0,10,0"/>

                    <Button Content="Remove Item"
                            Command="{Binding RemoveLineCommand}"
                            CommandParameter="{Binding SelectedLine}"
                            Style="{StaticResource ClassicBtn}"
                            Foreground="DarkRed"
                            Height="26"/>

                    <TextBlock Text="Bulk controls below apply discount type/value to current PO rows."
                               VerticalAlignment="Center"
                               Foreground="#666666"
                               FontStyle="Italic"
                               Margin="20,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- BULK TOOLBAR ABOVE MAIN TABLE -->
            <Border Grid.Row="2"
                    Background="#F0F0F0"
                    Padding="6"
                    BorderBrush="#A0A0A0"
                    BorderThickness="1,0,1,1">

                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <TextBlock Text="Disc Type:"
                               Style="{StaticResource InlineLabel}"/>

                    <ComboBox ItemsSource="{Binding DiscountModes}"
                              SelectedItem="{Binding BulkDiscountMode, Mode=TwoWay}"
                              Width="85"
                              Style="{StaticResource ClassicCombo}"
                              Margin="0,0,5,0"/>

                    <Button Content="Apply Type"
                            Command="{Binding ApplyBulkDiscountModeToLinesCommand}"
                            Style="{StaticResource ClassicBtn}"
                            Height="25"
                            Margin="0,0,12,0"/>

                    <TextBlock Text="Disc Value:"
                               Style="{StaticResource InlineLabel}"/>

                    <TextBox Text="{Binding BulkDiscountValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="75"
                             Style="{StaticResource ClassicInput}"
                             HorizontalContentAlignment="Right"
                             Background="#FEF2F2"
                             Margin="0,0,5,0"/>

                    <Button Content="Apply Value"
                            Command="{Binding ApplyBulkDiscountValueToLinesCommand}"
                            Style="{StaticResource ClassicBtn}"
                            Height="25"/>
                </WrapPanel>
            </Border>

            <!-- PO LINES -->
            <DataGrid Grid.Row="3"
                      x:Name="dgPoLines"
                      ItemsSource="{Binding PoLines}"
                      SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="All"
                      IsReadOnly="False"
                      HorizontalGridLinesBrush="#C0C0C0"
                      VerticalGridLinesBrush="#D0D0D0"
                      RowHeight="28"
                      HeadersVisibility="Column"
                      Background="White"
                      BorderBrush="#A0A0A0"
                      BorderThickness="1"
                      SelectionMode="Single"
                      AlternatingRowBackground="#F9F9F9"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      CellEditEnding="DgPoLines_CellEditEnding">

                <DataGrid.Resources>
                    <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource BaseCell}"/>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code"
                                        Binding="{Binding ItemCode, Mode=OneWay}"
                                        Width="85"
                                        IsReadOnly="True"
                                        Foreground="#666666"
                                        CellStyle="{StaticResource FrozenCell}"/>

                    <DataGridTextColumn Header="Product"
                                        Binding="{Binding DisplayName, Mode=OneWay}"
                                        Width="240"
                                        IsReadOnly="True"
                                        FontWeight="SemiBold"
                                        CellStyle="{StaticResource FrozenCell}"/>

                    <DataGridTextColumn Header="Barcode"
                                        Binding="{Binding Barcode, Mode=OneWay}"
                                        Width="115"
                                        IsReadOnly="True"/>

                    <DataGridTextColumn Header="UOM"
                                        Binding="{Binding Uom, Mode=OneWay}"
                                        Width="60"
                                        IsReadOnly="True"/>

                    <DataGridTextColumn Header="MOQ"
                                        Binding="{Binding Moq, Mode=OneWay}"
                                        Width="55"
                                        IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CenterText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Qty" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding OrderQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextAlignment="Center"
                                         FontWeight="Bold"
                                         BorderThickness="0"
                                         ToolTip="{Binding Moq, StringFormat=Minimum Order Qty: {0}}">
                                    <TextBox.Background>
                                        <MultiBinding Converter="{StaticResource MoqColorConverter}">
                                            <Binding Path="OrderQty"/>
                                            <Binding Path="Moq"/>
                                        </MultiBinding>
                                    </TextBox.Background>
                                </TextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Cost Rs." Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ExpectedCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource GridMoneyBox}"
                                         Background="#FFF7ED"
                                         BorderThickness="0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Disc Type" Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.DiscountModes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding LineDiscountMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Height="24"
                                          Background="#FFFFE0"
                                          BorderThickness="0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Disc Val" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding LineDiscountValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextAlignment="Right"
                                         Foreground="DarkRed"
                                         Background="#FFFFE0"
                                         BorderThickness="0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Disc Amt"
                                        Binding="{Binding LineDiscount, Mode=OneWay, StringFormat=N2}"
                                        Width="80"
                                        IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource RightText}">
                                <Setter Property="Foreground" Value="DarkRed"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="VAT %" Width="65">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding VatRatePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextAlignment="Right"
                                         Background="#FFFFE0"
                                         BorderThickness="0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridCheckBoxColumn Header="VAT Inc."
                                            Binding="{Binding IsVatIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Width="70"/>

                    <DataGridTextColumn Header="VAT Amt"
                                        Binding="{Binding TaxAmount, Mode=OneWay, StringFormat=N2}"
                                        Width="80"
                                        IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource RightText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Est. Total"
                                        Binding="{Binding LineTotal, Mode=OneWay, StringFormat=N2}"
                                        Width="100"
                                        IsReadOnly="True"
                                        FontWeight="Bold">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource RightText}">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- TOTALS FOOTER - GRN STYLE STRUCTURE -->
            <Border Grid.Row="4"
                    Background="#D4D0C8"
                    BorderBrush="#A0A0A0"
                    BorderThickness="1"
                    Margin="0,5,0,0"
                    Padding="8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="210"/>
                    </Grid.ColumnDefinitions>

                    <!-- GLOBAL MODIFIERS -->
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">

                        <TextBlock Text="GLOBAL MODIFIERS"
                                   FontWeight="Bold"
                                   Foreground="#003366"
                                   Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Bill Disc (-)"
                                       Style="{StaticResource InlineLabel}"
                                       Foreground="DarkRed"/>

                            <TextBox Grid.Column="1"
                                     Text="{Binding GlobalBillDiscount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ClassicInput}"
                                     HorizontalContentAlignment="Right"
                                     Background="#FEF2F2"/>
                        </Grid>

                        <TextBlock Text="Purchase Order uses estimated values. Final supplier payable is confirmed in GRN."
                                   FontSize="10"
                                   Foreground="#666666"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Rectangle Grid.Column="1"
                               Width="1"
                               Fill="#A0A0A0"
                               Margin="7,0"/>

                    <!-- TOTALS -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center">

                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="EST. SUBTOTAL:"
                                       Foreground="#555555"
                                       FontSize="12"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding Subtotal, Mode=OneWay, StringFormat=Rs. {0:N2}}"
                                       HorizontalAlignment="Right"
                                       FontSize="12"
                                       FontWeight="Bold"/>
                        </Grid>

                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="EST. DISCOUNTS:"
                                       Foreground="DarkRed"
                                       FontSize="12"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding TotalDiscountAmount, Mode=OneWay, StringFormat=- Rs. {0:N2}}"
                                       HorizontalAlignment="Right"
                                       Foreground="DarkRed"
                                       FontSize="12"
                                       FontWeight="Bold"/>
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="EST. VAT:"
                                       Foreground="#555555"
                                       FontSize="12"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding TotalTaxAmount, Mode=OneWay, StringFormat=+ Rs. {0:N2}}"
                                       HorizontalAlignment="Right"
                                       FontSize="12"
                                       FontWeight="Bold"/>
                        </Grid>

                        <Rectangle Height="2"
                                   Fill="#333333"
                                   Margin="0,0,0,6"/>

                        <StackPanel>
                            <TextBlock Text="TOTAL EST. VALUE:"
                                       Foreground="#003366"
                                       FontSize="13"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding NetPayable, Mode=OneWay, StringFormat=Rs. {0:N2}}"
                                       Foreground="#005500"
                                       FontSize="20"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Grid.Column="3"
                               Width="1"
                               Fill="#A0A0A0"
                               Margin="7,0"/>

                    <!-- REMARKS + ACTIONS -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Supplier Notes:"
                                   Style="{StaticResource InlineLabel}"
                                   Margin="0,0,0,4"/>

                        <TextBox Text="{Binding Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="62"
                                 Style="{StaticResource ClassicInput}"/>

                        <StackPanel Margin="0,10,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom">

                            <Button Content="Clear Form"
                                    Command="{Binding ClearCommand}"
                                    Style="{StaticResource ClassicBtn}"
                                    Width="95"
                                    Height="35"
                                    Margin="0,0,10,0"/>

                            <Button Content="SAVE PO"
                                    Command="{Binding SaveOrderCommand}"
                                    Style="{StaticResource SaveBtn}"
                                    Width="105"
                                    Height="35"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>