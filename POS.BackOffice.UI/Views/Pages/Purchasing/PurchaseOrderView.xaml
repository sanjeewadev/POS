<UserControl x:Class="POS.BackOffice.UI.Views.Pages.Purchasing.PurchaseOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:POS.BackOffice.UI.Views.Pages.Purchasing"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="1400"
             Loaded="UserControl_Loaded"
             Background="#D4D0C8"
             FontFamily="Segoe UI"
             FontSize="12">

    <UserControl.Resources>
        <local:MoqColorConverter x:Key="MoqColorConverter"/>

        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D0E8E8"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <Style x:Key="ClassicInput" TargetType="TextBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="ClassicCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="ClassicButton" TargetType="Button">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#707070"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ClassicButton}">
            <Setter Property="Background" Value="#0B7A75"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#075A56"/>
        </Style>

        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#9A9A9A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="GridMoneyBox" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3,0"/>
        </Style>

        <Style x:Key="RightText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="3,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#003366"
                BorderBrush="#001F3F"
                BorderThickness="1"
                Margin="0,0,0,6"
                Padding="8,4">
            <DockPanel>
                <TextBlock Text="PURCHASE ORDER"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Planned ordering only • No stock movement until GRN"
                           Foreground="#DCEBFA"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource SectionBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="1. DOCUMENT SETUP"
                           Style="{StaticResource SectionTitle}"/>

                <Grid Grid.Row="1" Margin="0,5,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Supplier" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Suppliers}"
                              SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                              DisplayMemberPath="SupplierName"
                              Style="{StaticResource ClassicCombo}"/>

                    <TextBlock Grid.Column="2" Text="Code" Style="{StaticResource FieldLabel}" Margin="10,0,5,0"/>
                    <TextBox Grid.Column="3"
                             Text="{Binding SupplierCode, Mode=OneWay}"
                             Style="{StaticResource ClassicInput}"
                             IsReadOnly="True"
                             Background="#E5E5E5"/>

                    <TextBlock Grid.Column="4" Text="PO Date" Style="{StaticResource FieldLabel}" Margin="10,0,5,0"/>
                    <DatePicker Grid.Column="5"
                                SelectedDate="{Binding OrderDate, Mode=TwoWay}"
                                Height="25"/>

                    <TextBlock Grid.Column="6" Text="Expected" Style="{StaticResource FieldLabel}" Margin="10,0,5,0"/>
                    <DatePicker Grid.Column="7"
                                SelectedDate="{Binding ExpectedDate, Mode=TwoWay}"
                                Height="25"/>

                    <CheckBox Grid.Column="8"
                              Content="Supplier prices include VAT"
                              IsChecked="{Binding IsTaxInclusive, Mode=TwoWay}"
                              IsEnabled="{Binding CanUseSupplierVatPriceMode}"
                              VerticalAlignment="Center"
                              FontWeight="SemiBold"
                              Margin="16,0,0,0"/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Terms" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Grid.Column="1"
                              SelectedValue="{Binding SelectedTerms, Mode=TwoWay}"
                              SelectedValuePath="Content"
                              Style="{StaticResource ClassicCombo}">
                        <ComboBoxItem Content="Credit"/>
                        <ComboBoxItem Content="Cash"/>
                    </ComboBox>

                    <TextBlock Grid.Column="2" Text="Credit Days" Style="{StaticResource FieldLabel}" Margin="10,0,5,0"/>
                    <TextBox Grid.Column="3"
                             Text="{Binding CreditDaysInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ClassicInput}"
                             HorizontalContentAlignment="Right"/>

                    <TextBlock Grid.Column="4" Text="Notes" Style="{StaticResource FieldLabel}" Margin="10,0,5,0"/>
                    <TextBox Grid.Column="5"
                             Text="{Binding Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ClassicInput}"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SectionBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="33"/>
                    <RowDefinition Height="33"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="2. PURCHASE ORDER LINES"
                           Style="{StaticResource SectionTitle}"/>

                <Grid Grid.Row="1" Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Scan / SKU" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding ScanBarcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ClassicInput}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddItemCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="2"
                            Content="ADD"
                            Command="{Binding AddItemCommand}"
                            Style="{StaticResource ClassicButton}"/>
                    <Button Grid.Column="3"
                            Content="ADD ITEMS/VARIANTS"
                            Command="{Binding OpenPurchasingVariantEntryDialogCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="8,0,3,0"/>
                    <TextBlock Grid.Column="4"
                               Text="{Binding SupplierPriceModeText}"
                               Foreground="#555555"
                               FontStyle="Italic"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>

                <Grid Grid.Row="2" Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="95"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Disc Type" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding DiscountModes}"
                              SelectedItem="{Binding BulkDiscountMode, Mode=TwoWay}"
                              Style="{StaticResource ClassicCombo}"/>
                    <TextBlock Grid.Column="2" Text="Disc Value" Style="{StaticResource FieldLabel}" Margin="10,0,5,0"/>
                    <TextBox Grid.Column="3"
                             Text="{Binding BulkDiscountValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ClassicInput}"
                             HorizontalContentAlignment="Right"/>
                    <Button Grid.Column="4"
                            Content="APPLY TO LINES"
                            Command="{Binding ApplyBulkDiscountValueToLinesCommand}"
                            Style="{StaticResource ClassicButton}"/>
                    <TextBlock Grid.Column="5"
                               Text="VAT category and rate come from Item Master and Tax Rate Management."
                               Foreground="#555555"
                               FontStyle="Italic"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>

                <DataGrid x:Name="DgPoLines"
                          Grid.Row="3"
                          ItemsSource="{Binding PoLines}"
                          SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          RowHeaderWidth="0"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          AlternatingRowBackground="#F7F7F7"
                          CellEditEnding="DgPoLines_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item / Variant" Binding="{Binding DisplayName}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="SKU" Binding="{Binding SkuCode}" Width="100" IsReadOnly="True" />
                        <DataGridTextColumn Header="UOM" Binding="{Binding Uom}" Width="55" IsReadOnly="True" />
                        <DataGridTextColumn Header="Tracking" Binding="{Binding TrackingText}" Width="95" IsReadOnly="True" />

                        <DataGridTemplateColumn Header="Qty" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding OrderQty, StringFormat={}{0:0.###}}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding OrderQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.###}}"
                                             FontWeight="Bold"
                                             HorizontalContentAlignment="Right">
                                        <TextBox.Background>
                                            <MultiBinding Converter="{StaticResource MoqColorConverter}">
                                                <Binding Path="OrderQty"/>
                                                <Binding Path="Moq"/>
                                            </MultiBinding>
                                        </TextBox.Background>
                                    </TextBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Expected Cost" Width="98">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ExpectedCost, StringFormat=N2}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding ExpectedCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                             Style="{StaticResource GridMoneyBox}"
                                             Background="#FFF7ED"
                                             FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Disc Type" Width="82">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LineDiscountMode}"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.DiscountModes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding LineDiscountMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Height="24"
                                              FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Disc Value" Width="78">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LineDiscountValue, StringFormat=N2}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding LineDiscountValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                             Style="{StaticResource GridMoneyBox}"
                                             Background="#FFFFE0"
                                             FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Disc Amt" Binding="{Binding LineDiscount, StringFormat=N2}" Width="78" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Bill Disc" Binding="{Binding GlobalDiscountAllocation, StringFormat=N2}" Width="78" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Tax Category" Binding="{Binding TaxCategoryDisplay}" Width="125" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Taxable" Binding="{Binding TaxableAmountPreview, StringFormat=N2}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="VAT %" Binding="{Binding VatRatePercent, StringFormat=N2}" Width="62" IsReadOnly="True"/>
                        <DataGridTextColumn Header="VAT" Binding="{Binding TaxAmount, StringFormat=N2}" Width="75" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, StringFormat=N2}" Width="95" IsReadOnly="True"/>

                        <DataGridTemplateColumn Header="" Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="REMOVE"
                                            Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Height="23"
                                            FontSize="10"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource SectionBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="215"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="460"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="3. DOCUMENT ADJUSTMENT"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Bill Discount"
                                   Style="{StaticResource FieldLabel}"
                                   Foreground="DarkRed"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding GlobalBillDiscount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ClassicInput}"
                                 HorizontalContentAlignment="Right"
                                 Background="#FEF2F2"/>
                    </Grid>
                    <TextBlock Text="Allocated proportionally across PO lines before final VAT."
                               Margin="0,6,0,0"
                               FontSize="10"
                               Foreground="#666666"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="2"
                        Background="#E9EEF3"
                        BorderBrush="#A0A0A0"
                        BorderThickness="1"
                        Padding="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="VAT SUMMARY" Style="{StaticResource SectionTitle}"/>
                        <Grid Grid.Row="1" Margin="0,3,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Standard VAT" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding StandardRatedAmount, StringFormat=N2}" Style="{StaticResource RightText}"/>
                            <TextBlock Grid.Column="2" Text="Zero Rated" Style="{StaticResource FieldLabel}" Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding ZeroRatedAmount, StringFormat=N2}" Style="{StaticResource RightText}"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Exempt" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ExemptAmount, StringFormat=N2}" Style="{StaticResource RightText}"/>
                            <TextBlock Grid.Column="2" Text="Out of Scope" Style="{StaticResource FieldLabel}" Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding OutOfScopeAmount, StringFormat=N2}" Style="{StaticResource RightText}"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="4"
                        Background="#F7F7F7"
                        BorderBrush="#A0A0A0"
                        BorderThickness="1"
                        Padding="7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SUBTOTAL" Foreground="#666666" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding Subtotal, StringFormat=N2}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="DISCOUNT" Foreground="DarkRed" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding TotalDiscountAmount, StringFormat=N2}" FontSize="14" FontWeight="Bold" Foreground="DarkRed" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TAXABLE" Foreground="#666666" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding TaxableAmountTotal, StringFormat=N2}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="VAT" Foreground="#666666" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding TotalTaxAmount, StringFormat=N2}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="ESTIMATED TOTAL" Foreground="#003366" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding NetPayable, StringFormat=Rs. {0:N2}}" FontSize="20" FontWeight="Bold" Foreground="#003366" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" LastChildFill="False" Margin="0,0,0,4">
            <TextBlock Text="After save, you can export the approved PO directly as PDF. No stock or ledger movement is created."
                       Foreground="#555555"
                       FontStyle="Italic"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left"/>
            <Button Content="CLEAR"
                    Command="{Binding ClearCommand}"
                    Style="{StaticResource ClassicButton}"
                    Width="90"
                    DockPanel.Dock="Right"/>
            <Button Content="SAVE &amp; APPROVE PO"
                    Command="{Binding SaveOrderCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Width="165"
                    DockPanel.Dock="Right"/>
        </DockPanel>

        <Border Grid.Row="5"
                Background="#E5E5E5"
                BorderBrush="#A0A0A0"
                BorderThickness="1"
                Padding="5,2">
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>
