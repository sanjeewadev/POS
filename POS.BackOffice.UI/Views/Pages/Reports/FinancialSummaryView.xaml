<UserControl x:Class="POS.BackOffice.UI.Views.Pages.Reports.FinancialSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="MetricBox" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style x:Key="FinancialCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource LightSelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Trigger></Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,7">
            <StackPanel DockPanel.Dock="Left"><TextBlock Text="Financial Summary" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource HeaderTextBrush}"/><TextBlock Text="Operational totals only — not a full accounting profit and loss statement" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
        </DockPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="7" Margin="0,0,0,7">
            <WrapPanel><TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,4,0"/><DatePicker SelectedDate="{Binding StartDate}" Width="125" Height="27"/><TextBlock Text="To" VerticalAlignment="Center" Margin="10,0,4,0"/><DatePicker SelectedDate="{Binding EndDate}" Width="125" Height="27"/><Button Content="Load" Command="{Binding LoadCommand}" Width="80" Height="27" Margin="10,0,0,0"/><Button Content="Reset" Command="{Binding ResetCommand}" Width="80" Height="27" Margin="5,0,0,0"/><Button Content="Save PDF" Command="{Binding ExportPdfCommand}" Width="90" Height="27" Margin="5,0,0,0" ToolTip="Manager or Administrator access required."/></WrapPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <GroupBox Header="Sales and Gross Profit" Margin="0,0,0,7">
                        <UniformGrid Columns="3" Margin="7">
                            <Border Style="{StaticResource MetricBox}"><StackPanel><TextBlock Text="Gross Merchandise Sales" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="{Binding GrossMerchandiseSales, StringFormat={}Rs. {0:N2}}" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource MetricBox}"><StackPanel><TextBlock Text="Discounts" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="{Binding TotalDiscounts, StringFormat={}Rs. {0:N2}}" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource MetricBox}"><StackPanel><TextBlock Text="After Discounts" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="{Binding MerchandiseSalesAfterDiscounts, StringFormat={}Rs. {0:N2}}" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource MetricBox}"><StackPanel><TextBlock Text="Customer Returns" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="{Binding CustomerReturns, StringFormat={}Rs. {0:N2}}" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource MetricBox}"><StackPanel><TextBlock Text="Net Sales" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="{Binding NetSales, StringFormat={}Rs. {0:N2}}" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource MetricBox}"><StackPanel><TextBlock Text="Gross Profit" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="{Binding GrossProfit, StringFormat={}Rs. {0:N2}}" FontWeight="Bold"/></StackPanel></Border>
                        </UniformGrid>
                    </GroupBox>
                    <GroupBox Header="Cost of Goods" Margin="0,0,0,7">
                        <UniformGrid Columns="3" Margin="7">
                            <Border Style="{StaticResource MetricBox}"><StackPanel><TextBlock Text="Sale COGS" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="{Binding SaleCostOfGoods, StringFormat={}Rs. {0:N2}}" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource MetricBox}"><StackPanel><TextBlock Text="Returned COGS" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="{Binding ReturnedCostOfGoods, StringFormat={}Rs. {0:N2}}" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource MetricBox}"><StackPanel><TextBlock Text="Net COGS" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="{Binding NetCostOfGoods, StringFormat={}Rs. {0:N2}}" FontWeight="Bold"/></StackPanel></Border>
                        </UniformGrid>
                    </GroupBox>
                    <GroupBox Header="Purchasing and Voucher Activity">
                        <UniformGrid Columns="3" Margin="7">
                            <Border Style="{StaticResource MetricBox}"><StackPanel><TextBlock Text="Posted Purchases" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="{Binding PostedPurchases, StringFormat={}Rs. {0:N2}}" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource MetricBox}"><StackPanel><TextBlock Text="Supplier Returns" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="{Binding PostedSupplierReturns, StringFormat={}Rs. {0:N2}}" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource MetricBox}"><StackPanel><TextBlock Text="Gift Voucher Issue Value" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="{Binding GiftVoucherIssueValue, StringFormat={}Rs. {0:N2}}" FontWeight="Bold" ToolTip="Shown separately and excluded from merchandise sales revenue."/></StackPanel></Border>
                        </UniformGrid>
                    </GroupBox>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <GroupBox Header="Tender Totals" Margin="0,0,0,7">
                        <DataGrid ItemsSource="{Binding TenderTotals}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" GridLinesVisibility="Horizontal" CellStyle="{StaticResource FinancialCellStyle}" Height="190">
                            <DataGrid.Columns><DataGridTextColumn Header="Tender" Binding="{Binding PaymentType}" Width="*"/><DataGridTextColumn Header="Transactions" Binding="{Binding TransactionCount}" Width="90"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}Rs. {0:N2}}" Width="115"/></DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <GroupBox Header="Cash Movements" Margin="0,0,0,7">
                        <Grid Margin="7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="Paid In"/><TextBlock Grid.Column="1" Text="{Binding PaidIn, StringFormat={}Rs. {0:N2}}" FontWeight="Bold"/>
                            <TextBlock Grid.Row="1" Text="Paid Out"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PaidOut, StringFormat={}Rs. {0:N2}}" FontWeight="Bold"/>
                            <TextBlock Grid.Row="2" Text="Float In"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FloatIn, StringFormat={}Rs. {0:N2}}" FontWeight="Bold"/>
                            <TextBlock Grid.Row="3" Text="Float Out"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FloatOut, StringFormat={}Rs. {0:N2}}" FontWeight="Bold"/>
                            <TextBlock Grid.Row="4" Text="Customer Cash Refunds"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CustomerCashRefunds, StringFormat={}Rs. {0:N2}}" FontWeight="Bold"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Activity"><Grid Margin="7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Completed Sales"/><TextBlock Grid.Column="1" Text="{Binding TotalSalesCount}" FontWeight="Bold"/><TextBlock Grid.Row="1" Text="Average Sale Value"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AverageSaleValue, StringFormat={}Rs. {0:N2}}" FontWeight="Bold"/></Grid></GroupBox>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <ProgressBar Grid.Row="3" Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </Grid>
</UserControl>
