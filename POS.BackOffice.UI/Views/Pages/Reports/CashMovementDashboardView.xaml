<UserControl x:Class="POS.BackOffice.UI.Views.Pages.Reports.CashMovementDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="{DynamicResource WindowBackgroundBrush}"
             FontFamily="Segoe UI"
             FontSize="12">

    <UserControl.Resources>
        <Style x:Key="RightAmount" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,6,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource HeaderTextBrush}"
                BorderBrush="#002244"
                BorderThickness="1"
                Padding="9,6"
                Margin="0,0,0,7">
            <TextBlock Text="PAID IN / PAID OUT (CASH MOVEMENTS)"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="Bold"/>
        </Border>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,7">
            <Border Style="{DynamicResource BoKpiCard}" BorderBrush="#3D8B40">
                <StackPanel>
                    <TextBlock Text="TOTAL PAID IN" Style="{DynamicResource BoKpiLabel}"/>
                    <TextBlock Text="{Binding TotalPaidIn, StringFormat=Rs. \{0:N2\}}"
                               Style="{DynamicResource BoKpiValue}" Foreground="#006B3C"/>
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource BoKpiCard}" BorderBrush="#A94044">
                <StackPanel>
                    <TextBlock Text="TOTAL PAID OUT" Style="{DynamicResource BoKpiLabel}"/>
                    <TextBlock Text="{Binding TotalPaidOut, StringFormat=Rs. \{0:N2\}}"
                               Style="{DynamicResource BoKpiValue}" Foreground="#A94044"/>
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource BoKpiCard}" BorderBrush="#2563A6" Margin="0">
                <StackPanel>
                    <TextBlock Text="NET DRAWER IMPACT" Style="{DynamicResource BoKpiLabel}"/>
                    <TextBlock Text="{Binding NetMovement, StringFormat=Rs. \{0:N2\}}"
                               Style="{DynamicResource BoKpiValue}" Foreground="#1F5D99"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{DynamicResource BoFilterBar}">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                    <TextBlock Text="From" Style="{DynamicResource BoInlineLabel}"/>
                    <DatePicker SelectedDate="{Binding StartDate}"
                                Style="{DynamicResource BoInputDatePicker}" Width="125"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                    <TextBlock Text="To" Style="{DynamicResource BoInlineLabel}"/>
                    <DatePicker SelectedDate="{Binding EndDate}"
                                Style="{DynamicResource BoInputDatePicker}" Width="125"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                    <TextBlock Text="Type" Style="{DynamicResource BoInlineLabel}"/>
                    <ComboBox SelectedItem="{Binding SelectedTypeFilter}"
                              Style="{DynamicResource BoInputComboBox}" Width="125">
                        <sys:String>All Types</sys:String>
                        <sys:String>Paid In</sys:String>
                        <sys:String>Paid Out</sys:String>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                    <TextBlock Text="Voucher / Remarks" Style="{DynamicResource BoInlineLabel}"/>
                    <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource BoInputTextBox}" Width="220"/>
                </StackPanel>

                <Button Content="APPLY FILTERS" Command="{Binding ApplyFiltersCommand}"
                        Style="{DynamicResource BoButton}" Margin="0,0,6,4"/>
                <Button Content="EXPORT REPORT" Command="{Binding ExportCommand}"
                        Style="{DynamicResource BoPrimaryButton}" Margin="0,0,0,4"/>
            </WrapPanel>
        </Border>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding MovementsList}"
                  Style="{DynamicResource BoDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm}" Width="135"/>
                <DataGridTextColumn Header="Voucher No." Binding="{Binding ReferenceVoucherNo}" Width="115"/>
                <DataGridTextColumn Header="Shift" Binding="{Binding ShiftSessionId}" Width="65"/>
                <DataGridTextColumn Header="Terminal" Binding="{Binding ShiftSession.TerminalNo}" Width="80"/>
                <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MovementType}" Value="Paid In">
                                    <Setter Property="Foreground" Value="#006B3C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MovementType}" Value="Paid Out">
                                    <Setter Property="Foreground" Value="#A94044"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Category" Binding="{Binding ReasonCategory}" Width="130"/>
                <DataGridTextColumn Header="Amount (Rs.)" Binding="{Binding Amount, StringFormat=N2}" Width="110" ElementStyle="{StaticResource RightAmount}"/>
                <DataGridTextColumn Header="Cashier" Binding="{Binding CashierName}" Width="115"/>
                <DataGridTextColumn Header="Authorized By" Binding="{Binding AuthorizedBy}" Width="115"/>
                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*" MinWidth="180"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
