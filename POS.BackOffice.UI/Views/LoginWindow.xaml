<Window x:Class="POS.BackOffice.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced POS - BackOffice Sign In"
        Height="430"
        Width="560"
        MinHeight="430"
        MinWidth="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="12">

    <Window.Resources>
        <Style x:Key="ClassicInput"
               TargetType="TextBox">
            <Setter Property="Height"
                    Value="30"/>
            <Setter Property="Padding"
                    Value="7,0"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Background"
                    Value="{DynamicResource WhiteBackgroundBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
        </Style>

        <Style x:Key="ClassicPassword"
               TargetType="PasswordBox">
            <Setter Property="Height"
                    Value="30"/>
            <Setter Property="Padding"
                    Value="7,0"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Background"
                    Value="{DynamicResource WhiteBackgroundBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
        </Style>

        <Style x:Key="ClassicButton"
               TargetType="Button">
            <Setter Property="Height"
                    Value="34"/>
            <Setter Property="MinWidth"
                    Value="110"/>
            <Setter Property="Padding"
                    Value="14,0"/>
            <Setter Property="Background"
                    Value="{DynamicResource ButtonDefaultBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBoxBorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource ClassicButton}">
            <Setter Property="Background"
                    Value="{DynamicResource ActionBackgroundBrush}"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ActionBackgroundBrush}"/>
            <Setter Property="MinWidth"
                    Value="145"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource ActionHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.60"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="1. BACKOFFICE SIGN IN"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource HeaderTextBrush}"/>

                    <TextBlock Text="Advanced POS System"
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{DynamicResource HighlightBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Padding="10,5"
                        VerticalAlignment="Center">
                    <TextBlock Text="SECURE LOCAL LOGIN"
                               FontWeight="Bold"
                               Foreground="{DynamicResource HeaderTextBrush}"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="2. ACCOUNT CREDENTIALS"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource HeaderTextBrush}"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Username"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="UsernameInput"
                             Grid.Column="1"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="50"
                             Style="{StaticResource ClassicInput}"/>
                </Grid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Password"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <PasswordBox x:Name="PasswordInput"
                                 Grid.Column="1"
                                 MaxLength="128"
                                 Style="{StaticResource ClassicPassword}"/>
                </Grid>

                <Border Grid.Row="4"
                        Background="{DynamicResource WhiteBackgroundBrush}"
                        BorderBrush="{DynamicResource LightBorderBrush}"
                        BorderThickness="1"
                        Padding="8"
                        Margin="0,8,0,0">
                    <TextBlock Text="Use your assigned BackOffice account. Failed login attempts are audited and temporary account lockout may apply."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>
                </Border>

                <TextBlock Grid.Row="5"
                           Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource WarningTextBrush}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           MinHeight="42"
                           Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Offline BackOffice authentication"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="EXIT"
                    Click="ExitButton_Click"
                    IsCancel="True"
                    Style="{StaticResource ClassicButton}"/>

            <Button Grid.Column="3"
                    Content="SIGN IN"
                    Command="{Binding LoginCommand}"
                    CommandParameter="{Binding ElementName=PasswordInput}"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}"/>
        </Grid>
    </Grid>
</Window>
