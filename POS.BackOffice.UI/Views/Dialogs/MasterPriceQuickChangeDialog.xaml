<Window x:Class="POS.BackOffice.UI.Views.Dialogs.MasterPriceQuickChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Change Master Price"
        Width="760"
        Height="720"
        MinWidth="700"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#D4D0C8"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#8A8A8A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Height" Value="27"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Button" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#777777"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource Button}">
            <Setter Property="Background" Value="#005555"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#003333"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Section}">
            <StackPanel>
                <TextBlock Text="QUICK CHANGE MASTER PRICE" FontSize="15" FontWeight="Bold" Foreground="#003366"/>
                <TextBlock Margin="0,4,0,0" Text="Change the standard Retail and Wholesale catalogue prices manually or calculate suggestions from cost. Nothing is saved until you confirm." Foreground="#555555" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Section}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Item" Style="{StaticResource Label}" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayDescription}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Average Cost" Style="{StaticResource Label}" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding AverageCost, StringFormat=N2}" HorizontalAlignment="Right" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="SKU / Type" Style="{StaticResource Label}" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,5"><Run Text="{Binding SkuCode}"/><Run Text="  |  "/><Run Text="{Binding ItemTypeText}"/></TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="Last Cost" Style="{StaticResource Label}" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding LastCost, StringFormat=N2}" HorizontalAlignment="Right" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Tracking" Style="{StaticResource Label}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TrackingText}" Foreground="#555555"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="Cost Basis" Style="{StaticResource Label}"/>
                <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding SelectedCost, StringFormat=N2}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Section}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="5" Text="CALCULATE FROM COST (OPTIONAL)" FontWeight="Bold" Foreground="#005555" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Cost basis" Style="{StaticResource Label}"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding CostBasisOptions}" SelectedItem="{Binding SelectedCostBasis}" Style="{StaticResource Combo}"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="Rounding" Style="{StaticResource Label}"/>
                <ComboBox Grid.Row="1" Grid.Column="4" ItemsSource="{Binding RoundingOptions}" SelectedItem="{Binding SelectedRounding}" Style="{StaticResource Combo}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Retail method" Style="{StaticResource Label}" Margin="0,6,0,0"/>
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding RetailMethodOptions}" SelectedItem="{Binding SelectedRetailMethod}" Style="{StaticResource Combo}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding RetailInputLabel}" Style="{StaticResource Label}" Margin="0,6,0,0"/>
                <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding RetailCalculationInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,6,0,0"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Wholesale method" Style="{StaticResource Label}" Margin="0,6,0,0"/>
                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding WholesaleMethodOptions}" SelectedItem="{Binding SelectedWholesaleMethod}" Style="{StaticResource Combo}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding WholesaleInputLabel}" Style="{StaticResource Label}" Margin="0,6,0,0"/>
                <DockPanel Grid.Row="3" Grid.Column="4" Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="CALCULATE" Click="Calculate_Click" Style="{StaticResource Button}" Margin="6,0,0,0"/>
                    <TextBox Text="{Binding WholesaleCalculationInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
                </DockPanel>
            </Grid>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource Section}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="145"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="5" Text="PROPOSED MASTER PRICES" FontWeight="Bold" Foreground="#003366" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Minimum" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MinimumText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="Maximum" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding MaximumText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Retail" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RetailText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="Wholesale" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding WholesaleText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Retail profit" Style="{StaticResource Label}" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,0,5"><Run Text="{Binding RetailProfit, StringFormat=N2}"/><Run Text="  ("/><Run Text="{Binding RetailMargin, StringFormat=N2}"/><Run Text="%)"/></TextBlock>
                <TextBlock Grid.Row="3" Grid.Column="3" Text="Wholesale profit" Style="{StaticResource Label}" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="3" Grid.Column="4" HorizontalAlignment="Right" Margin="0,0,0,5"><Run Text="{Binding WholesaleProfit, StringFormat=N2}"/><Run Text="  ("/><Run Text="{Binding WholesaleMargin, StringFormat=N2}"/><Run Text="%)"/></TextBlock>

                <TextBlock Grid.Row="4" Grid.ColumnSpan="5" Text="{Binding CostWarning}" Foreground="#9A4A00" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="5" Grid.ColumnSpan="5" Text="{Binding ValidationMessage}" Foreground="#B00020" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="8" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="CANCEL" Click="Cancel_Click" Style="{StaticResource Button}" MinWidth="95"/>
            <Button DockPanel.Dock="Right" Content="SAVE MASTER PRICES" Click="Save_Click" Style="{StaticResource PrimaryButton}" MinWidth="165" Margin="0,0,7,0"/>
            <TextBlock Text="Average Cost and Last Cost are read-only inventory values. Suggested prices are never saved automatically." Foreground="#555555" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460"/>
        </DockPanel>
    </Grid>
</Window>
