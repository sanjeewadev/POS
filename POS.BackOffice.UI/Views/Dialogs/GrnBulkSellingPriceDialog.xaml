<Window x:Class="POS.BackOffice.UI.Views.Dialogs.GrnBulkSellingPriceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Selling Prices"
        Width="1320"
        Height="690"
        MinWidth="980"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#D4D0C8">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="29"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PrimaryDialogButton"
               TargetType="Button"
               BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#005555"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="DialogInput" TargetType="TextBox">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="10"
                Background="White"
                BorderBrush="#808080"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="CHANGE SELLING PRICES"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#003366"/>
                <TextBlock Margin="0,4,0,0"
                           Text="Select rows, enter direct VAT-inclusive selling prices, and apply. Blank bulk fields leave that price level unchanged. Prices are committed only when the GRN posts successfully."
                           Foreground="#555555"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Padding="8"
                Background="#F0F0F0"
                BorderBrush="#A0A0A0"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Bulk values for selected rows"
                           FontWeight="Bold"
                           Foreground="#003366"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="95"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="95"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Retail Price" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtBulkRetail" Grid.Column="1" Style="{StaticResource DialogInput}" HorizontalContentAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="Wholesale" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtBulkWholesale" Grid.Column="4" Style="{StaticResource DialogInput}" HorizontalContentAlignment="Right"/>
                    <TextBlock Grid.Column="6" Text="Minimum" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtBulkMinimum" Grid.Column="7" Style="{StaticResource DialogInput}" HorizontalContentAlignment="Right"/>
                    <TextBlock Grid.Column="9" Text="Maximum" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtBulkMaximum" Grid.Column="10" Style="{StaticResource DialogInput}" HorizontalContentAlignment="Right"/>
                    <Button Grid.Column="12"
                            Content="APPLY ENTERED VALUES TO SELECTED"
                            Click="ApplyBulkValues_Click"
                            Style="{StaticResource PrimaryDialogButton}"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Background="White"
                BorderBrush="#808080"
                BorderThickness="1">
            <DataGrid x:Name="PriceGrid"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      RowHeaderWidth="0"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F7F7F7"
                      Background="White"
                      Foreground="Black"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      FrozenColumnCount="4"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Use"
                                            Binding="{Binding Apply, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Width="48"/>
                    <DataGridTextColumn Header="Item / Variant"
                                        Binding="{Binding DisplayName}"
                                        IsReadOnly="True"
                                        Width="210"/>
                    <DataGridTextColumn Header="SKU"
                                        Binding="{Binding SkuCode}"
                                        IsReadOnly="True"
                                        Width="110"/>
                    <DataGridTextColumn Header="Landed Cost"
                                        Binding="{Binding LandedCost, StringFormat=N2}"
                                        IsReadOnly="True"
                                        Width="90"/>
                    <DataGridTextColumn Header="Current Retail"
                                        Binding="{Binding CurrentRetailPrice, StringFormat=N2}"
                                        IsReadOnly="True"
                                        Width="95"/>
                    <DataGridTextColumn Header="New Retail"
                                        Binding="{Binding NewRetailPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                        Width="95"/>
                    <DataGridTextColumn Header="Current W/S"
                                        Binding="{Binding CurrentWholesalePrice, StringFormat=N2}"
                                        IsReadOnly="True"
                                        Width="95"/>
                    <DataGridTextColumn Header="New W/S"
                                        Binding="{Binding NewWholesalePrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                        Width="95"/>
                    <DataGridTextColumn Header="Current Min"
                                        Binding="{Binding CurrentMinimumPrice, StringFormat=N2}"
                                        IsReadOnly="True"
                                        Width="90"/>
                    <DataGridTextColumn Header="New Min"
                                        Binding="{Binding NewMinimumPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                        Width="90"/>
                    <DataGridTextColumn Header="Current Max"
                                        Binding="{Binding CurrentMaximumPrice, StringFormat=N2}"
                                        IsReadOnly="True"
                                        Width="90"/>
                    <DataGridTextColumn Header="New Max"
                                        Binding="{Binding NewMaximumPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                        Width="90"/>
                    <DataGridTextColumn Header="Warning"
                                        Binding="{Binding WarningText}"
                                        IsReadOnly="True"
                                        Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="6"
                Padding="8"
                Background="#F0F0F0"
                BorderBrush="#A0A0A0"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="SELECT ALL"
                        Click="SelectAll_Click"
                        Style="{StaticResource DialogButton}"/>
                <Button Grid.Column="2"
                        Content="CLEAR SELECTION"
                        Click="ClearSelection_Click"
                        Style="{StaticResource DialogButton}"/>
                <TextBlock x:Name="txtSummary"
                           Grid.Column="3"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="#003366"
                           FontWeight="SemiBold"/>
                <Button Grid.Column="4"
                        Content="CANCEL"
                        Click="Cancel_Click"
                        IsCancel="True"
                        Style="{StaticResource DialogButton}"/>
                <Button Grid.Column="6"
                        Content="APPLY PRICES"
                        Click="Apply_Click"
                        IsDefault="True"
                        Style="{StaticResource PrimaryDialogButton}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
