<Window x:Class="POS.BackOffice.UI.Views.Dialogs.StockAdjustmentHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stock Adjustment History and Reversal"
        Width="1250"
        Height="760"
        MinWidth="1000"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#D4D0C8"
        FontFamily="Segoe UI"
        FontSize="12">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="1.25*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F0F0F0"
                BorderBrush="#A0A0A0"
                BorderThickness="1"
                Padding="8"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="From" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate, Mode=TwoWay}" Height="26"/>

                <TextBlock Grid.Column="3" Text="To" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <DatePicker Grid.Column="4" SelectedDate="{Binding ToDate, Mode=TwoWay}" Height="26"/>

                <TextBlock Grid.Column="6" Text="Status" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox Grid.Column="7"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                          Height="26"/>

                <TextBlock Grid.Column="9" Text="Search" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Grid.Column="10"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="26"
                         Padding="5,0"
                         VerticalContentAlignment="Center"/>

                <Button Grid.Column="12"
                        Content="REFRESH"
                        Command="{Binding LoadHistoryCommand}"
                        Height="28"
                        Padding="18,0"
                        FontWeight="Bold"
                        Background="#005555"
                        Foreground="White"/>

                <TextBlock Grid.Column="13"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Foreground="#555555"
                           Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Adjustments}"
                  SelectedItem="{Binding SelectedAdjustment, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column"
                  Background="White"
                  BorderBrush="#808080"
                  AlternatingRowBackground="#F7F7F7">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Document" Binding="{Binding AdjustmentNo}" Width="110"/>
                <DataGridTextColumn Header="Date" Binding="{Binding AdjustmentDate, StringFormat=yyyy-MM-dd HH:mm}" Width="135"/>
                <DataGridTextColumn Header="Mode" Binding="{Binding AdjustmentMode}" Width="175"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85"/>
                <DataGridTextColumn Header="Authorized By" Binding="{Binding AuthorizedBy}" Width="110"/>
                <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*"/>
                <DataGridTextColumn Header="Lines" Binding="{Binding LineCount}" Width="55"/>
                <DataGridTextColumn Header="Increase" Binding="{Binding TotalIncreaseQty, StringFormat=N3}" Width="80"/>
                <DataGridTextColumn Header="Decrease" Binding="{Binding TotalDecreaseQty, StringFormat=N3}" Width="80"/>
                <DataGridTextColumn Header="Impact" Binding="{Binding TotalImpact, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn Header="Reversed By" Binding="{Binding CancelledBy}" Width="100"/>
                <DataGridTextColumn Header="Reversal Reason" Binding="{Binding CancellationReason}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Lines}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column"
                  Background="White"
                  BorderBrush="#808080"
                  AlternatingRowBackground="#F7F7F7">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Item" Binding="{Binding ItemCode}" Width="90"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Variant" Binding="{Binding VariantDescription}" Width="115"/>
                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="105"/>
                <DataGridTextColumn Header="System" Binding="{Binding SystemQty, StringFormat=N3}" Width="75"/>
                <DataGridTextColumn Header="Actual" Binding="{Binding ActualQty, StringFormat=N3}" Width="75"/>
                <DataGridTextColumn Header="Variance" Binding="{Binding VarianceQty, StringFormat=N3}" Width="75"/>
                <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitCost, StringFormat=N2}" Width="80"/>
                <DataGridTextColumn Header="Impact" Binding="{Binding CostImpact, StringFormat=N2}" Width="85"/>
                <DataGridTextColumn Header="Reason" Binding="{Binding ReasonCode}" Width="145"/>
                <DataGridTextColumn Header="Line Status" Binding="{Binding LineStatus}" Width="90"/>
                <DataGridTextColumn Header="Remarks" Binding="{Binding LineRemarks}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4"
                Background="#F0F0F0"
                BorderBrush="#A0A0A0"
                BorderThickness="1"
                Padding="8"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Reversal reason *"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="#991B1B"
                           Margin="0,0,8,0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding ReverseReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="28"
                         Padding="6,0"
                         VerticalContentAlignment="Center"
                         MaxLength="250"/>

                <Button Grid.Column="3"
                        Content="REVERSE SELECTED"
                        Command="{Binding ReverseSelectedCommand}"
                        IsEnabled="{Binding CanReverseSelected}"
                        Height="30"
                        Padding="18,0"
                        FontWeight="Bold"
                        Background="#B45309"
                        Foreground="White"/>

                <Button Grid.Column="5"
                        Content="CLOSE"
                        Click="Close_Click"
                        Height="30"
                        Padding="20,0"
                        FontWeight="Bold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
