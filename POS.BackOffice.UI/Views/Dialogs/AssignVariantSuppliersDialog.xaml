<Window x:Class="POS.BackOffice.UI.Views.Dialogs.AssignVariantSuppliersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign Supplier"
        Height="360"
        Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#D4D0C8"
        FontFamily="Segoe UI"
        FontSize="12"
        ShowInTaskbar="False">

    <Window.Resources>

        <Style TargetType="{x:Type TextBlock}" x:Key="HeaderLabel">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="InlineLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <Style TargetType="{x:Type TextBox}" x:Key="ClassicInput">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="{x:Type ComboBox}" x:Key="ClassicCombo">
            <Setter Property="Height" Value="27"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="ClassicBtn">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="ActionBtn" BasedOn="{StaticResource ClassicBtn}">
            <Setter Property="Background" Value="#005555"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#003333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007777"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border Margin="10"
            Background="#F0F0F0"
            BorderBrush="#A0A0A0"
            BorderThickness="1"
            Padding="14">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,12">

                <TextBlock Text="ASSIGN SUPPLIER TO SELECTED VARIANTS"
                           Style="{StaticResource HeaderLabel}"/>

                <TextBlock Text="This will assign the selected supplier to all ticked variants, using the individual cost price already set on each variant. Click SAVE FULL ITEM after this to permanently save the item."
                           Foreground="#555555"
                           TextWrapping="Wrap"
                           FontSize="11"/>
            </StackPanel>

            <!-- SELECTED COUNT -->
            <Border Grid.Row="1"
                    Background="#E0FFFF"
                    BorderBrush="#005555"
                    BorderThickness="1"
                    Padding="8"
                    Margin="0,0,0,12">

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Selected Variants:"
                               FontWeight="Bold"
                               Foreground="#003366"
                               Margin="0,0,6,0"/>

                    <TextBlock x:Name="txtSelectedVariantCount"
                               Text="0"
                               FontWeight="Bold"
                               Foreground="#A94044"/>
                </StackPanel>
            </Border>

            <!-- FORM -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Supplier *"
                           Style="{StaticResource InlineLabel}"
                           Foreground="#003366"/>

                <ComboBox x:Name="cmbSupplier"
                          Grid.Row="0"
                          Grid.Column="1"
                          Style="{StaticResource ClassicCombo}"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          TextSearch.TextPath="SupplierName"
                          ToolTip="Search supplier by code or name.">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SupplierCode}"
                                           FontWeight="Bold"
                                           Foreground="#003366"/>
                                <TextBlock Text=" - "/>
                                <TextBlock Text="{Binding SupplierName}"/>
                                <TextBlock Text="{Binding CompanyName, StringFormat= ({0})}"
                                           Foreground="#666666"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="2" 
                           Grid.Column="0"
                           Text="MOQ *"
                           Style="{StaticResource InlineLabel}"/>

                <TextBox x:Name="txtMinimumOrderQty" 
                         Grid.Row="2"
                         Grid.Column="1"
                         Style="{StaticResource ClassicInput}"
                         HorizontalContentAlignment="Right"
                         FontWeight="Bold"/>
            </Grid>

            <!-- BUTTONS -->
            <Grid Grid.Row="3"
                  Margin="0,16,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="CANCEL"
                        Click="Cancel_Click"
                        Style="{StaticResource ClassicBtn}"
                        IsCancel="True"/>

                <Button Grid.Column="3"
                        Content="APPLY"
                        Click="Apply_Click"
                        Style="{StaticResource ActionBtn}"
                        IsDefault="True"/>
            </Grid>
        </Grid>
    </Border>
</Window>