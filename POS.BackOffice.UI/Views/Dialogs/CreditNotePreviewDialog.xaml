<Window x:Class="POS.BackOffice.UI.Views.Dialogs.CreditNotePreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Credit Note Preview"
        Width="720"
        Height="780"
        MinWidth="560"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ActionBackgroundBrush}" Padding="10">
            <TextBlock Text="CREDIT NOTE PREVIEW"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="15"/>
        </Border>

        <TextBox x:Name="PreviewTextBox"
                 Grid.Row="1"
                 Margin="0,6"
                 Padding="10"
                 FontFamily="Consolas"
                 FontSize="13"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Background="White"
                 BorderBrush="{DynamicResource BorderBrush}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Print..." Width="90" Height="28" Margin="0,0,6,0" Click="Print_Click"/>
            <Button Content="Copy" Width="90" Height="28" Margin="0,0,6,0" Click="Copy_Click"/>
            <Button Content="Close" Width="90" Height="28" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
