<Window x:Class="POS.BackOffice.UI.Dialogs.SupplierClaimActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supplier Claim Action"
        Width="470"
        Height="330"
        MinWidth="470"
        MinHeight="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="10,7"
                Margin="0,0,0,10"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <TextBlock x:Name="HeadingText"
                       FontSize="15"
                       FontWeight="SemiBold"/>
        </Border>

        <TextBlock Grid.Row="1"
                   Text="Type / reason"
                   FontWeight="SemiBold"
                   Margin="0,0,0,3"/>
        <ComboBox x:Name="TypeComboBox"
                  Grid.Row="2"
                  Height="27"
                  Margin="0,0,0,8"/>
        <TextBox x:Name="ReasonTextBox"
                 Grid.Row="2"
                 Height="27"
                 Margin="0,0,0,8"
                 Visibility="Collapsed"/>

        <TextBlock x:Name="ReferenceLabel"
                   Grid.Row="3"
                   Text="Supplier reference"
                   FontWeight="SemiBold"
                   Margin="0,0,0,3"/>
        <TextBox x:Name="ReferenceTextBox"
                 Grid.Row="4"
                 Height="27"
                 Margin="0,0,0,8"/>

        <TextBlock Grid.Row="5"
                   Text="Remarks"
                   FontWeight="SemiBold"
                   Margin="0,0,0,3"/>
        <TextBox x:Name="RemarksTextBox"
                 Grid.Row="6"
                 Height="58"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Cancel"
                    Width="90"
                    Height="28"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_Click"/>
            <Button Content="Confirm"
                    Width="100"
                    Height="28"
                    IsDefault="True"
                    Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
